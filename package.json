{
  "name": "araba-incele-al-sat",
  "version": "1.0.0",
  "description": "Türkiye'nin En Modern Araç Alım-Satım ve Bilgi Platformu",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "seed": "node src/db/seed.js",
    "migrate": "knex migrate:latest --knexfile knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.js",
    "migrate:status": "knex migrate:status --knexfile knexfile.js",
    "production": "NODE_ENV=production node src/app.js",
    "vercel-build": "echo 'No build step needed'"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-flash": "^0.0.2",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "knex": "^3.1.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.20.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^9.4.3",
    "connect-sqlite3": "^0.9.15"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
