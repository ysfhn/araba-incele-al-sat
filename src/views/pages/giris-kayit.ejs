<div class="min-h-screen flex">
<div class="flex-1 flex items-center justify-center p-8">
<div class="w-full max-w-md">
<a href="/" class="flex items-center gap-2 text-primary mb-10">
<span class="material-symbols-outlined text-3xl font-bold">directions_car</span>
<h2 class="text-slate-900 text-xl font-bold">Araba İncele Al Sat</h2>
</a>
<div class="flex gap-1 bg-slate-100 p-1 rounded-xl mb-8">
<button id="tabLogin" onclick="showTab('login')" class="flex-1 py-3 rounded-xl bg-white text-slate-900 font-bold text-sm shadow-sm transition-all">Giriş Yap</button>
<button id="tabRegister" onclick="showTab('register')" class="flex-1 py-3 rounded-xl text-slate-500 font-bold text-sm hover:bg-white/50 transition-all">Kayıt Ol</button>
</div>
<div id="loginForm">
<form action="/auth/giris" method="POST" class="space-y-5">
<div>
<label class="block text-sm font-bold text-slate-700 mb-2">E-posta Adresi</label>
<div class="flex items-center bg-slate-50 border border-slate-200 rounded-xl px-4 py-3">
<span class="material-symbols-outlined text-slate-400 mr-3 text-lg">mail</span>
<input name="email" type="email" required class="bg-transparent border-none focus:ring-0 w-full text-sm placeholder:text-slate-400" placeholder="ornek@email.com"/>
</div>
</div>
<div>
<label class="block text-sm font-bold text-slate-700 mb-2">Şifre</label>
<div class="flex items-center bg-slate-50 border border-slate-200 rounded-xl px-4 py-3">
<span class="material-symbols-outlined text-slate-400 mr-3 text-lg">lock</span>
<input name="password" type="password" required minlength="6" class="bg-transparent border-none focus:ring-0 w-full text-sm placeholder:text-slate-400" placeholder="••••••••"/>
</div>
</div>
<div class="flex items-center justify-between">
<label class="flex items-center gap-2 text-sm text-slate-600">
<input type="checkbox" name="remember" class="rounded text-primary focus:ring-primary border-slate-300"/> Beni hatırla
</label>
</div>
<button type="submit" class="w-full bg-primary text-white font-bold py-3.5 rounded-xl text-sm hover:bg-primary/90 transition-all">Giriş Yap</button>
</form>
<p class="mt-4 text-center text-sm text-slate-500">Test: <strong>ahmet@email.com</strong> / <strong>123456</strong></p>
</div>
<div id="registerForm" class="hidden">
<form action="/auth/kayit" method="POST" class="space-y-5">
<div>
<label class="block text-sm font-bold text-slate-700 mb-2">Ad Soyad</label>
<div class="flex items-center bg-slate-50 border border-slate-200 rounded-xl px-4 py-3">
<span class="material-symbols-outlined text-slate-400 mr-3 text-lg">person</span>
<input name="name" type="text" required class="bg-transparent border-none focus:ring-0 w-full text-sm placeholder:text-slate-400" placeholder="Adınız Soyadınız"/>
</div>
</div>
<div>
<label class="block text-sm font-bold text-slate-700 mb-2">E-posta</label>
<div class="flex items-center bg-slate-50 border border-slate-200 rounded-xl px-4 py-3">
<span class="material-symbols-outlined text-slate-400 mr-3 text-lg">mail</span>
<input name="email" type="email" required class="bg-transparent border-none focus:ring-0 w-full text-sm placeholder:text-slate-400" placeholder="ornek@email.com"/>
</div>
</div>
<div>
<label class="block text-sm font-bold text-slate-700 mb-2">Telefon</label>
<div class="flex items-center bg-slate-50 border border-slate-200 rounded-xl px-4 py-3">
<span class="material-symbols-outlined text-slate-400 mr-3 text-lg">phone</span>
<input name="phone" type="tel" class="bg-transparent border-none focus:ring-0 w-full text-sm placeholder:text-slate-400" placeholder="0532 111 2233"/>
</div>
</div>
<div>
<label class="block text-sm font-bold text-slate-700 mb-2">Şifre</label>
<div class="flex items-center bg-slate-50 border border-slate-200 rounded-xl px-4 py-3">
<span class="material-symbols-outlined text-slate-400 mr-3 text-lg">lock</span>
<input name="password" type="password" required minlength="6" class="bg-transparent border-none focus:ring-0 w-full text-sm placeholder:text-slate-400" placeholder="En az 6 karakter"/>
</div>
</div>
<div>
<label class="block text-sm font-bold text-slate-700 mb-2">Şifre Tekrar</label>
<div class="flex items-center bg-slate-50 border border-slate-200 rounded-xl px-4 py-3">
<span class="material-symbols-outlined text-slate-400 mr-3 text-lg">lock</span>
<input name="password_confirm" type="password" required minlength="6" class="bg-transparent border-none focus:ring-0 w-full text-sm placeholder:text-slate-400" placeholder="Şifrenizi tekrar girin"/>
</div>
</div>
<div>
<label class="block text-sm font-bold text-slate-700 mb-2">Hesap Türü</label>
<div class="flex gap-3">
<label class="flex-1 flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 cursor-pointer hover:border-primary"><input type="radio" name="role" value="bireysel" checked class="text-primary focus:ring-primary"/><span class="text-sm">Bireysel</span></label>
<label class="flex-1 flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 cursor-pointer hover:border-primary"><input type="radio" name="role" value="kurumsal" class="text-primary focus:ring-primary"/><span class="text-sm">Kurumsal</span></label>
</div>
</div>
<button type="submit" class="w-full bg-primary text-white font-bold py-3.5 rounded-xl text-sm hover:bg-primary/90 transition-all">Kayıt Ol</button>
</form>
</div>
</div>
</div>
<div class="hidden lg:flex flex-1 relative bg-gradient-to-br from-primary to-blue-700 items-center justify-center p-12">
<div class="absolute inset-0 bg-black/20"></div>
<div class="relative z-10 text-center text-white max-w-md">
<span class="material-symbols-outlined text-7xl mb-6 opacity-80">directions_car</span>
<h2 class="text-3xl font-bold mb-4">Türkiye'nin En Modern Araç Platformu</h2>
<p class="text-white/80 text-lg leading-relaxed mb-8">İlan verin, araç bulun, uzman servislere ulaşın ve toplulukla bilgi paylaşın.</p>
</div>
</div>
</div>
<script>
function showTab(t){document.getElementById('loginForm').classList.toggle('hidden',t!=='login');document.getElementById('registerForm').classList.toggle('hidden',t!=='register');document.getElementById('tabLogin').className='flex-1 py-3 rounded-xl '+(t==='login'?'bg-white text-slate-900 font-bold text-sm shadow-sm':'text-slate-500 font-bold text-sm hover:bg-white/50')+' transition-all';document.getElementById('tabRegister').className='flex-1 py-3 rounded-xl '+(t==='register'?'bg-white text-slate-900 font-bold text-sm shadow-sm':'text-slate-500 font-bold text-sm hover:bg-white/50')+' transition-all';}
</script>
