<style>
  /* ── RESET ── */
  .ao-root * { box-sizing:border-box; margin:0; padding:0; }

  /* ── LAYOUT ── */
  .ao-root {
    min-height:calc(100vh - 64px);
    background:linear-gradient(135deg,#0f172a 0%,#1e293b 50%,#0f172a 100%);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding:1rem;
    position:relative; overflow:hidden;
  }

  /* Animated bg particles */
  .ao-root::before {
    content:''; position:absolute; top:-50%; left:-50%; width:200%; height:200%;
    background:radial-gradient(circle at 20% 50%, rgba(59,130,246,.08) 0%, transparent 50%),
               radial-gradient(circle at 80% 20%, rgba(139,92,246,.06) 0%, transparent 50%),
               radial-gradient(circle at 50% 80%, rgba(16,185,129,.05) 0%, transparent 50%);
    animation:ao-bg 20s ease-in-out infinite alternate;
    pointer-events:none;
  }
  @keyframes ao-bg { 0%{transform:translate(0,0)} 100%{transform:translate(-3%,3%)} }

  /* ── CHAT CONTAINER ── */
  .ao-chat {
    width:100%; max-width:640px; position:relative; z-index:1;
    display:flex; flex-direction:column; gap:0;
  }

  /* ── HEADER ── */
  .ao-head {
    text-align:center; margin-bottom:1.5rem;
  }
  .ao-head .ao-avatar {
    width:56px; height:56px; border-radius:16px; margin:0 auto .75rem;
    background:linear-gradient(135deg,#3b82f6,#8b5cf6); display:flex; align-items:center; justify-content:center;
    box-shadow:0 8px 32px rgba(59,130,246,.3);
  }
  .ao-head .ao-avatar .material-symbols-outlined { font-size:1.7rem; color:#fff; }
  .ao-head h1 { font-size:1.5rem; font-weight:800; color:#fff; letter-spacing:-.02em; }
  .ao-head p { font-size:.85rem; color:rgba(255,255,255,.5); margin-top:.25rem; }

  /* ── PROGRESS ── */
  .ao-progress {
    display:flex; align-items:center; justify-content:center; gap:.5rem; margin-bottom:1.5rem;
  }
  .ao-dot {
    width:10px; height:10px; border-radius:50%; background:rgba(255,255,255,.15); transition:all .4s;
  }
  .ao-dot.done { background:#22c55e; box-shadow:0 0 8px rgba(34,197,94,.4); }
  .ao-dot.active { background:#3b82f6; box-shadow:0 0 12px rgba(59,130,246,.5); transform:scale(1.3); }

  /* ── MESSAGE AREA ── */
  .ao-messages {
    display:flex; flex-direction:column; gap:.75rem; min-height:180px;
    max-height:calc(100vh - 340px); overflow-y:auto; padding-right:4px;
    scroll-behavior:smooth;
  }
  .ao-messages::-webkit-scrollbar { width:4px; }
  .ao-messages::-webkit-scrollbar-thumb { background:rgba(255,255,255,.15); border-radius:4px; }

  /* ── BUBBLE ── */
  .ao-msg {
    max-width:92%; padding:.85rem 1rem; border-radius:18px; font-size:.88rem; line-height:1.5;
    animation:ao-pop .35s cubic-bezier(.34,1.56,.64,1) both;
    opacity:0;
  }
  @keyframes ao-pop { 0%{opacity:0;transform:translateY(12px) scale(.96)} 100%{opacity:1;transform:translateY(0) scale(1)} }

  .ao-msg.bot {
    background:rgba(255,255,255,.08); color:#e2e8f0; border-bottom-left-radius:4px;
    backdrop-filter:blur(10px); border:1px solid rgba(255,255,255,.06); align-self:flex-start;
  }
  .ao-msg.user {
    background:linear-gradient(135deg,#3b82f6,#2563eb); color:#fff; border-bottom-right-radius:4px;
    align-self:flex-end;
  }
  .ao-msg.bot .ao-sender { font-size:.65rem; color:rgba(255,255,255,.35); margin-bottom:4px; display:flex; align-items:center; gap:4px; }
  .ao-msg.bot .ao-sender .material-symbols-outlined { font-size:.75rem; }

  /* ── TYPING INDICATOR ── */
  .ao-typing { display:flex; gap:4px; padding:8px 0 4px; align-self:flex-start; }
  .ao-typing span { width:7px; height:7px; border-radius:50%; background:rgba(255,255,255,.25); animation:ao-bounce 1.4s infinite ease-in-out; }
  .ao-typing span:nth-child(2) { animation-delay:.16s; }
  .ao-typing span:nth-child(3) { animation-delay:.32s; }
  @keyframes ao-bounce { 0%,80%,100%{transform:scale(0);opacity:.4} 40%{transform:scale(1);opacity:1} }

  /* ── OPTIONS GRID ── */
  .ao-options {
    display:grid; gap:.5rem; margin-top:.75rem;
    animation:ao-pop .4s cubic-bezier(.34,1.56,.64,1) .1s both; opacity:0;
  }
  .ao-options.cols-2 { grid-template-columns:1fr 1fr; }
  .ao-options.cols-3 { grid-template-columns:1fr 1fr 1fr; }
  .ao-options.cols-1 { grid-template-columns:1fr; }

  .ao-opt {
    padding:.75rem .85rem; border-radius:14px; cursor:pointer; font-size:.82rem; font-weight:600;
    transition:all .2s; text-align:center; border:1.5px solid rgba(255,255,255,.12);
    background:rgba(255,255,255,.05); color:#e2e8f0; backdrop-filter:blur(8px);
    display:flex; flex-direction:column; align-items:center; gap:6px;
  }
  .ao-opt:hover { background:rgba(59,130,246,.15); border-color:rgba(59,130,246,.4); transform:translateY(-2px); }
  .ao-opt:active { transform:scale(.97); }
  .ao-opt.selected { background:rgba(59,130,246,.25); border-color:#3b82f6; color:#fff; box-shadow:0 0 20px rgba(59,130,246,.2); }
  .ao-opt .ao-opt-icon { font-size:1.3rem; }
  .ao-opt .ao-opt-sub { font-size:.65rem; font-weight:400; color:rgba(255,255,255,.4); margin-top:1px; }

  /* Brand options */
  .ao-opt.brand-opt img { width:32px; height:32px; object-fit:contain; filter:brightness(0) invert(1); opacity:.7; }
  .ao-opt.brand-opt:hover img, .ao-opt.brand-opt.selected img { opacity:1; }

  /* ── SLIDER ── */
  .ao-slider-wrap { margin-top:.75rem; animation:ao-pop .4s .1s both; opacity:0; }
  .ao-slider-row { display:flex; gap:.75rem; align-items:center; }
  .ao-slider-row input[type=range] {
    flex:1; -webkit-appearance:none; appearance:none; height:6px; background:rgba(255,255,255,.12);
    border-radius:4px; outline:none;
  }
  .ao-slider-row input[type=range]::-webkit-slider-thumb {
    -webkit-appearance:none; width:22px; height:22px; border-radius:50%;
    background:linear-gradient(135deg,#3b82f6,#8b5cf6); cursor:pointer; border:2px solid #fff;
    box-shadow:0 2px 12px rgba(59,130,246,.4);
  }
  .ao-slider-val {
    font-size:1.15rem; font-weight:800; color:#fff; min-width:110px; text-align:right; white-space:nowrap;
  }
  .ao-slider-labels { display:flex; justify-content:space-between; margin-top:4px; font-size:.65rem; color:rgba(255,255,255,.3); }
  .ao-slider-confirm { margin-top:.75rem; text-align:right; }

  /* ── CONFIRM BUTTON ── */
  .ao-btn {
    display:inline-flex; align-items:center; gap:6px; padding:.65rem 1.5rem; border-radius:12px;
    font-size:.85rem; font-weight:700; cursor:pointer; transition:all .2s; border:none;
    background:linear-gradient(135deg,#3b82f6,#2563eb); color:#fff;
    box-shadow:0 4px 20px rgba(59,130,246,.3);
  }
  .ao-btn:hover { transform:translateY(-1px); box-shadow:0 6px 30px rgba(59,130,246,.4); }
  .ao-btn:active { transform:scale(.97); }
  .ao-btn.outline { background:transparent; border:1.5px solid rgba(255,255,255,.2); color:rgba(255,255,255,.7); box-shadow:none; }
  .ao-btn.outline:hover { border-color:rgba(255,255,255,.4); color:#fff; }
  .ao-btn .material-symbols-outlined { font-size:1rem; }

  /* ── RESULTS ── */
  .ao-results { animation:ao-pop .5s both; opacity:0; }
  .ao-result-card {
    display:flex; gap:.85rem; padding:.85rem; border-radius:14px;
    background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.08);
    backdrop-filter:blur(8px); margin-bottom:.6rem; transition:all .2s;
    text-decoration:none; color:inherit;
  }
  .ao-result-card:hover { background:rgba(255,255,255,.1); transform:translateX(4px); }
  .ao-result-img {
    width:90px; height:65px; border-radius:10px; background:rgba(255,255,255,.05);
    display:flex; align-items:center; justify-content:center; flex-shrink:0; overflow:hidden;
  }
  .ao-result-img img { width:100%; height:100%; object-fit:cover; }
  .ao-result-img .material-symbols-outlined { color:rgba(255,255,255,.2); font-size:1.5rem; }
  .ao-result-info { flex:1; min-width:0; }
  .ao-result-info h3 { font-size:.85rem; font-weight:700; color:#fff; margin-bottom:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .ao-result-info .ao-result-price { font-size:1rem; font-weight:800; color:#60a5fa; }
  .ao-result-info .ao-result-specs { font-size:.68rem; color:rgba(255,255,255,.4); margin-top:3px; display:flex; gap:.5rem; flex-wrap:wrap; }
  .ao-result-info .ao-result-specs span { display:inline-flex; align-items:center; gap:2px; }

  .ao-no-result { text-align:center; padding:1.5rem; color:rgba(255,255,255,.4); }
  .ao-no-result .material-symbols-outlined { font-size:2.5rem; display:block; margin-bottom:.5rem; }

  /* ── RESTART ── */
  .ao-restart {
    text-align:center; margin-top:1rem;
  }

  /* ── RESPONSIVE ── */
  @media (max-width:640px) {
    .ao-root { padding:.75rem; justify-content:flex-start; padding-top:1rem; }
    .ao-head h1 { font-size:1.15rem; }
    .ao-head .ao-avatar { width:44px; height:44px; }
    .ao-head .ao-avatar .material-symbols-outlined { font-size:1.3rem; }
    .ao-options.cols-3 { grid-template-columns:1fr 1fr; }
    .ao-msg { font-size:.82rem; }
    .ao-slider-val { font-size:.95rem; min-width:90px; }
    .ao-result-card { flex-direction:column; gap:.5rem; }
    .ao-result-img { width:100%; height:100px; }
    .ao-messages { max-height:calc(100vh - 300px); }
  }
</style>

<div class="ao-root">
  <div class="ao-chat">
    <!-- Header -->
    <div class="ao-head">
      <div class="ao-avatar"><span class="material-symbols-outlined">auto_awesome</span></div>
      <h1>Akıllı Araç Asistanı</h1>
      <p>Sana en uygun arabayı birlikte bulalım ✨</p>
    </div>

    <!-- Progress dots -->
    <div class="ao-progress" id="aoProgress"></div>

    <!-- Messages -->
    <div class="ao-messages" id="aoMessages"></div>
  </div>
</div>

<script>
(function(){
  /* ══════════════════════════════════════
     STEP CONFIG
     ══════════════════════════════════════ */
  const STEPS = [
    {
      id:'purpose',
      question:'Merhaba! 👋 Ben senin araç danışmanınım. Öncelikle, aracı ne amaçla kullanmayı planlıyorsun?',
      type:'options',
      cols:2,
      options:[
        { value:'daily', label:'Günlük Kullanım', icon:'🏙️', sub:'Şehir içi, işe gidiş-geliş' },
        { value:'family', label:'Aile Aracı', icon:'👨‍👩‍👧‍👦', sub:'Geniş iç mekan, konfor' },
        { value:'performance', label:'Performans', icon:'🏎️', sub:'Güç ve sürüş keyfi' },
        { value:'economy', label:'Ekonomik', icon:'💰', sub:'Düşük yakıt, uygun fiyat' },
      ]
    },
    {
      id:'body_type',
      question:'Harika seçim! Peki hangi kasa tipini tercih edersin?',
      type:'options',
      cols:3,
      options:[
        { value:'sedan', label:'Sedan', icon:'🚗' },
        { value:'suv', label:'SUV', icon:'🚙' },
        { value:'hatchback', label:'Hatchback', icon:'🚘' },
        { value:'station_wagon', label:'Station Wagon', icon:'🚐' },
        { value:'coupe', label:'Coupe', icon:'🏎️' },
        { value:'all', label:'Farketmez', icon:'✨' },
      ]
    },
    {
      id:'fuel',
      question:'Yakıt konusunda bir tercihin var mı?',
      type:'options',
      cols:2,
      options:[
        { value:'benzin', label:'Benzin', icon:'⛽' },
        { value:'dizel', label:'Dizel', icon:'🛢️' },
        { value:'hibrit', label:'Hibrit', icon:'🌿' },
        { value:'elektrik', label:'Elektrik', icon:'⚡' },
        { value:'all', label:'Farketmez', icon:'🔄' },
      ]
    },
    {
      id:'transmission',
      question:'Vites tercihin ne yönde?',
      type:'options',
      cols:2,
      options:[
        { value:'otomatik', label:'Otomatik', icon:'🅰️', sub:'Konfor ve kolaylık' },
        { value:'manuel', label:'Manuel', icon:'🅼', sub:'Sürüş keyfi' },
        { value:'all', label:'Farketmez', icon:'🔄' },
      ]
    },
    {
      id:'budget',
      question:'Bütçeni belirlememiz lazım. Maksimum ne kadar ayırabilirsin?',
      type:'slider',
      min:200000,
      max:10000000,
      step:50000,
      default:1500000,
      format: v => new Intl.NumberFormat('tr-TR').format(v) + ' ₺'
    },
    {
      id:'year',
      question:'Son olarak, yıl tercihin var mı?',
      type:'options',
      cols:3,
      options:[
        { value:'2024-2026', label:'2024 - 2026', icon:'🆕', sub:'Sıfır & sıfıra yakın' },
        { value:'2021-2023', label:'2021 - 2023', icon:'✅', sub:'Yeni ikinci el' },
        { value:'2018-2020', label:'2018 - 2020', icon:'👍', sub:'Uygun fiyatlı' },
        { value:'2015-2017', label:'2015 - 2017', icon:'💡', sub:'Bütçe dostu' },
        { value:'2000-2014', label:'2014 ve öncesi', icon:'🕰️', sub:'Klasik seçenekler' },
        { value:'all', label:'Farketmez', icon:'🔄' },
      ]
    }
  ];

  const FOLLOW_UP_MSGS = {
    purpose: {
      daily: 'Şehir içi kullanım için ideal araçlara bakalım! 🏙️',
      family: 'Aile için konforlu ve geniş araçlar tam sana göre! 👨‍👩‍👧‍👦',
      performance: 'Performans arayanlar için güçlü seçeneklere bakalım! 🏎️',
      economy: 'Cebini düşünen ekonomik araçları bulalım! 💰'
    },
    body_type: {
      sedan: 'Sedan iyi bir tercih, klasik ve şık! 🚗',
      suv: 'SUV\'ler hem geniş hem yüksek sürüş keyfi sunar! 🚙',
      hatchback: 'Hatchback\'ler şehirde manevra kolaylığı sağlar! 🚘',
      station_wagon: 'Station Wagon, bagaj hacmiyle fark yaratır! 🚐',
      coupe: 'Coupe\'ler sportif ve dikkat çekici! 🏎️',
      all: 'Tamam, tüm kasa tiplerine bakarız! ✨'
    },
    fuel: {
      benzin: 'Benzin motorlar güçlü ivmelenme sunar! ⛽',
      dizel: 'Dizel uzun yolda avantajlı! 🛢️',
      hibrit: 'Hibrit hem ekonomik hem çevreci! 🌿',
      elektrik: 'Elektrikli araçlar geleceğin teknolojisi! ⚡',
      all: 'Her yakıt tipine açığız! 🔄'
    },
    transmission: {
      otomatik: 'Otomatik vites konfor demek! 🅰️',
      manuel: 'Manuel vites gerçek sürüş keyfi! 🅼',
      all: 'Her ikisine de bakarız! 🔄'
    }
  };

  /* ══════════════════════════════════════
     STATE
     ══════════════════════════════════════ */
  let currentStep = 0;
  const answers = {};
  const msgBox = document.getElementById('aoMessages');
  const progressBox = document.getElementById('aoProgress');

  /* ══════════════════════════════════════
     HELPERS
     ══════════════════════════════════════ */
  function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

  function scroll() { setTimeout(() => msgBox.scrollTop = msgBox.scrollHeight, 100); }

  function renderProgress() {
    progressBox.innerHTML = '';
    STEPS.forEach((_, i) => {
      const d = document.createElement('div');
      d.className = 'ao-dot' + (i < currentStep ? ' done' : i === currentStep ? ' active' : '');
      progressBox.appendChild(d);
    });
  }

  function addBotMsg(html) {
    const div = document.createElement('div');
    div.className = 'ao-msg bot';
    div.innerHTML = '<div class="ao-sender"><span class="material-symbols-outlined">auto_awesome</span> Araç Asistanı</div>' + html;
    msgBox.appendChild(div);
    scroll();
    return div;
  }

  function addUserMsg(text) {
    const div = document.createElement('div');
    div.className = 'ao-msg user';
    div.textContent = text;
    msgBox.appendChild(div);
    scroll();
  }

  function showTyping() {
    const div = document.createElement('div');
    div.className = 'ao-typing'; div.id = 'aoTyping';
    div.innerHTML = '<span></span><span></span><span></span>';
    msgBox.appendChild(div);
    scroll();
  }
  function hideTyping() {
    const el = document.getElementById('aoTyping');
    if (el) el.remove();
  }

  /* ══════════════════════════════════════
     RENDER STEP
     ══════════════════════════════════════ */
  async function renderStep(idx) {
    if (idx >= STEPS.length) { await doSearch(); return; }
    const step = STEPS[idx];
    renderProgress();

    showTyping();
    await sleep(700 + Math.random() * 500);
    hideTyping();

    addBotMsg(step.question);
    await sleep(200);

    if (step.type === 'options') renderOptions(step);
    else if (step.type === 'slider') renderSlider(step);
  }

  /* ── Options ── */
  function renderOptions(step) {
    const wrap = document.createElement('div');
    wrap.className = 'ao-options cols-' + (step.cols || 2);

    step.options.forEach(opt => {
      const btn = document.createElement('div');
      btn.className = 'ao-opt';
      btn.innerHTML =
        '<span class="ao-opt-icon">' + opt.icon + '</span>' +
        '<span>' + opt.label + '</span>' +
        (opt.sub ? '<span class="ao-opt-sub">' + opt.sub + '</span>' : '');

      btn.addEventListener('click', () => selectOption(step, opt, wrap));
      wrap.appendChild(btn);
    });

    msgBox.appendChild(wrap);
    scroll();
  }

  async function selectOption(step, opt, wrap) {
    // Highlight
    wrap.querySelectorAll('.ao-opt').forEach(b => b.classList.remove('selected'));
    event.currentTarget.classList.add('selected');

    // Disable all
    wrap.querySelectorAll('.ao-opt').forEach(b => { b.style.pointerEvents='none'; b.style.opacity='.6'; });
    event.currentTarget.style.opacity = '1';

    answers[step.id] = opt.value;
    addUserMsg(opt.label);

    await sleep(300);

    // Follow-up
    const fup = FOLLOW_UP_MSGS[step.id];
    if (fup && fup[opt.value]) {
      showTyping(); await sleep(500); hideTyping();
      addBotMsg(fup[opt.value]);
      await sleep(300);
    }

    currentStep++;
    renderStep(currentStep);
  }

  /* ── Slider ── */
  function renderSlider(step) {
    const wrap = document.createElement('div');
    wrap.className = 'ao-slider-wrap';

    let val = step.default;
    wrap.innerHTML =
      '<div class="ao-slider-row">' +
        '<input type="range" min="' + step.min + '" max="' + step.max + '" step="' + step.step + '" value="' + val + '" id="aoSlider">' +
        '<span class="ao-slider-val" id="aoSliderVal">' + step.format(val) + '</span>' +
      '</div>' +
      '<div class="ao-slider-labels"><span>' + step.format(step.min) + '</span><span>' + step.format(step.max) + '</span></div>' +
      '<div class="ao-slider-confirm"><button class="ao-btn" id="aoSliderBtn"><span class="material-symbols-outlined">check</span> Bu Bütçeyle Devam Et</button></div>';

    msgBox.appendChild(wrap);
    scroll();

    const slider = document.getElementById('aoSlider');
    const valEl = document.getElementById('aoSliderVal');
    const btnEl = document.getElementById('aoSliderBtn');

    slider.addEventListener('input', () => {
      val = Number(slider.value);
      valEl.textContent = step.format(val);
    });

    btnEl.addEventListener('click', async () => {
      answers[step.id] = val;
      addUserMsg(step.format(val));
      wrap.style.pointerEvents = 'none'; wrap.style.opacity = '.5';

      showTyping(); await sleep(400); hideTyping();
      addBotMsg('Bütçeni not ettim! 📝 Bir kaç soru daha var...');
      await sleep(300);

      currentStep++;
      renderStep(currentStep);
    });
  }

  /* ══════════════════════════════════════
     SEARCH
     ══════════════════════════════════════ */
  async function doSearch() {
    renderProgress();
    showTyping();
    addBotMsg('Tüm bilgileri aldım! 🎯 Şimdi sana en uygun araçları arıyorum...');
    await sleep(400);
    hideTyping();
    showTyping();

    // Build query
    const params = new URLSearchParams();
    if (answers.fuel && answers.fuel !== 'all') params.set('yakit', answers.fuel);
    if (answers.transmission && answers.transmission !== 'all') params.set('vites', answers.transmission);
    if (answers.body_type && answers.body_type !== 'all') params.set('kasa', answers.body_type);
    if (answers.budget) params.set('fiyat_max', answers.budget);
    if (answers.year && answers.year !== 'all') {
      const [yMin, yMax] = answers.year.split('-');
      params.set('yil_min', yMin);
      params.set('yil_max', yMax);
    }
    if (answers.purpose) params.set('amac', answers.purpose);

    try {
      const res = await fetch('/api/akilli-oneri/search?' + params.toString());
      const data = await res.json();

      hideTyping();
      await sleep(300);

      if (data.listings && data.listings.length > 0) {
        const matchWord = data.listings.length >= 5 ? 'birçok harika' : data.listings.length + ' adet';
        addBotMsg('Sana ' + matchWord + ' araç buldum! İşte kriterlerine en uygun olanlar: 🚗✨');
        await sleep(300);
        renderResults(data.listings, data.summary);
      } else {
        addBotMsg('Maalesef tam bu kriterlere uyan bir araç bulamadım 😔 Ama benzer araçlara göz atabilirsin:');
        await sleep(300);
        if (data.alternatives && data.alternatives.length > 0) {
          renderResults(data.alternatives, null);
        } else {
          renderNoResults();
        }
      }

      renderRestart();

    } catch (e) {
      hideTyping();
      addBotMsg('Bir hata oluştu, lütfen tekrar dene 😕');
      renderRestart();
    }
  }

  function renderResults(listings, summary) {
    if (summary) {
      const sumDiv = document.createElement('div');
      sumDiv.className = 'ao-msg bot';
      sumDiv.style.fontSize = '.78rem';
      sumDiv.style.color = 'rgba(255,255,255,.55)';
      sumDiv.innerHTML = '<div class="ao-sender"><span class="material-symbols-outlined">insights</span> Analiz</div>' + summary;
      msgBox.appendChild(sumDiv);
    }

    const wrap = document.createElement('div');
    wrap.className = 'ao-results';

    listings.forEach(l => {
      const a = document.createElement('a');
      a.href = '/ilan/' + l.slug;
      a.className = 'ao-result-card';

      const fuelMap = {benzin:'⛽',dizel:'🛢️',hibrit:'🌿',elektrik:'⚡',lpg:'🔥'};
      const fuelIcon = fuelMap[l.fuel_type] || '⛽';

      a.innerHTML =
        '<div class="ao-result-img">' +
          (l.image ? '<img src="' + l.image + '" alt="' + l.brand_name + '">' : '<span class="material-symbols-outlined">directions_car</span>') +
        '</div>' +
        '<div class="ao-result-info">' +
          '<h3>' + l.brand_name + ' ' + l.model_name + '</h3>' +
          '<div class="ao-result-price">' + new Intl.NumberFormat('tr-TR').format(l.price) + ' ₺</div>' +
          '<div class="ao-result-specs">' +
            '<span>📅 ' + l.year + '</span>' +
            '<span>🛣️ ' + new Intl.NumberFormat('tr-TR').format(l.km) + ' km</span>' +
            '<span>' + fuelIcon + ' ' + l.fuel_type + '</span>' +
            '<span>📍 ' + (l.city || '') + '</span>' +
          '</div>' +
        '</div>';

      wrap.appendChild(a);
    });

    msgBox.appendChild(wrap);
    scroll();
  }

  function renderNoResults() {
    const d = document.createElement('div');
    d.className = 'ao-no-result';
    d.innerHTML = '<span class="material-symbols-outlined">search_off</span><p>Kriterlere uygun ilan bulunamadı.<br>Filtreleri genişleterek tekrar deneyebilirsin.</p>';
    msgBox.appendChild(d);
    scroll();
  }

  function renderRestart() {
    const d = document.createElement('div');
    d.className = 'ao-restart';
    d.innerHTML =
      '<button class="ao-btn outline" id="aoRestart"><span class="material-symbols-outlined">refresh</span> Yeniden Başla</button>' +
      ' <a href="/ilan/arama" class="ao-btn outline" style="margin-left:.5rem;text-decoration:none;"><span class="material-symbols-outlined">search</span> Tüm İlanlar</a>';
    msgBox.appendChild(d);
    scroll();

    document.getElementById('aoRestart').addEventListener('click', () => {
      currentStep = 0;
      Object.keys(answers).forEach(k => delete answers[k]);
      msgBox.innerHTML = '';
      renderStep(0);
    });
  }

  /* ── START ── */
  renderStep(0);

})();
</script>
