<%
function formatPrice(p) { return new Intl.NumberFormat('tr-TR').format(p) + ' ₺'; }
function formatKm(k) { return new Intl.NumberFormat('tr-TR').format(k); }
function parseProsConsList(str) {
  if (!str) return [];
  try { const arr = JSON.parse(str); if (Array.isArray(arr)) return arr; } catch(e) {}
  return str.split('\n').filter(s => s.trim());
}
const prosList = hub ? parseProsConsList(hub.pros) : [];
const consList = hub ? parseProsConsList(hub.cons) : [];
const selectedYear = typeof queryYear !== 'undefined' ? queryYear : (hub ? hub.year : null);
const selectedFuel = typeof queryFuel !== 'undefined' ? queryFuel : (hub ? hub.fuel_type : null);
const selectedTransmission = typeof queryTransmission !== 'undefined' ? queryTransmission : null;
const selectedBudget = typeof queryBudget !== 'undefined' ? queryBudget : null;
const selectedEngine = typeof queryEngine !== 'undefined' ? queryEngine : null;
const selectedPackage = typeof queryPackage !== 'undefined' ? queryPackage : null;
const selectedBodyType = typeof queryBodyType !== 'undefined' ? queryBodyType : null;
%>

<style>
  .hub-sidebar-link { display:flex; align-items:center; gap:10px; padding:8px 14px; border-radius:10px; font-size:13px; font-weight:500; color:#64748b; transition:all .15s; border-left:3px solid transparent; }
  .hub-sidebar-link:hover { background:#f8fafc; color:#334155; }
  .hub-sidebar-link.active { background:#f1f5f9; color:#1e293b; font-weight:700; border-left-color:#334155; }
  .hub-sidebar-link .material-symbols-outlined { font-size:18px; }

  .hub-section { background:#fff; border:1px solid #e2e8f0; border-radius:14px; padding:28px; }
  .hub-section-title { font-size:15px; font-weight:700; color:#1e293b; display:flex; align-items:center; gap:8px; margin-bottom:20px; }
  .hub-section-title .material-symbols-outlined { font-size:20px; color:#64748b; }

  .hub-hero { background:#1e293b; border-radius:14px; overflow:hidden; color:#fff; }
  .hub-hero-inner { padding:32px 32px 28px; }
  .hub-spec-pill { background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.12); border-radius:10px; padding:14px; text-align:center; }
  .hub-spec-pill .label { font-size:11px; color:rgba(255,255,255,0.5); margin-bottom:2px; }
  .hub-spec-pill .value { font-size:13px; font-weight:700; color:#fff; }

  .hub-table td { padding:10px 0; font-size:13px; border-bottom:1px solid #f1f5f9; }
  .hub-table tr:last-child td { border-bottom:none; }
  .hub-table td:first-child { color:#64748b; }
  .hub-table td:last-child { text-align:right; font-weight:600; color:#1e293b; }

  .hub-listing-card { border:1px solid #e2e8f0; border-radius:12px; overflow:hidden; transition:all .2s; }
  .hub-listing-card:hover { box-shadow:0 4px 20px rgba(0,0,0,0.06); border-color:#cbd5e1; }

  .hub-video-thumb { position:relative; background:#f1f5f9; border-radius:10px; aspect-ratio:16/9; display:flex; align-items:center; justify-content:center; overflow:hidden; cursor:pointer; }
  .hub-video-thumb:hover .hub-video-overlay { opacity:1; }
  .hub-video-overlay { position:absolute; inset:0; background:rgba(0,0,0,0.35); display:flex; align-items:center; justify-content:center; opacity:0; transition:opacity .2s; }

  .hub-part-row { display:flex; align-items:center; justify-content:space-between; padding:12px 16px; border:1px solid #f1f5f9; border-radius:10px; }
  .hub-part-row:hover { background:#fafbfc; }

  .hub-doc-link { display:flex; align-items:center; gap:12px; padding:12px 16px; border:1px solid #e2e8f0; border-radius:10px; transition:all .15s; }
  .hub-doc-link:hover { background:#f8fafc; border-color:#cbd5e1; }

  .hub-badge { display:inline-flex; align-items:center; gap:4px; font-size:11px; font-weight:600; padding:4px 10px; border-radius:20px; }

  .hub-rating-circle { width:52px; height:52px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:18px; font-weight:800; }

  .hub-forum-row { display:flex; align-items:center; gap:12px; padding:10px 12px; border-radius:10px; transition:background .15s; margin:0 -12px; }
  .hub-forum-row:hover { background:#f8fafc; }

  .hub-service-card { border:1px solid #e2e8f0; border-radius:12px; padding:16px; transition:all .2s; }
  .hub-service-card:hover { box-shadow:0 4px 16px rgba(0,0,0,0.05); }
</style>

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 flex gap-8">
<!-- Sidebar -->
<aside class="hidden lg:block w-52 shrink-0">
  <div class="sticky top-24 max-h-[calc(100vh-120px)] overflow-y-auto space-y-0.5 pr-2">
    <!-- Sayfa İçi Navigasyon -->
    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider px-3.5 mb-1">Sayfada</p>
    <a href="#genel-bakis" class="hub-sidebar-link active"><span class="material-symbols-outlined">dashboard</span> Genel Bakış</a>
    <a href="#teknik" class="hub-sidebar-link"><span class="material-symbols-outlined">build</span> Teknik Özellikler</a>
    <a href="#guvenlik" class="hub-sidebar-link"><span class="material-symbols-outlined">shield</span> Güvenlik</a>
    <a href="#videolar" class="hub-sidebar-link"><span class="material-symbols-outlined">play_circle</span> Videolar</a>
    <a href="#editor" class="hub-sidebar-link"><span class="material-symbols-outlined">rate_review</span> Editör Notu</a>
    <a href="#ilanlar" class="hub-sidebar-link"><span class="material-symbols-outlined">sell</span> Satılık İlanlar</a>
    <a href="#forum" class="hub-sidebar-link"><span class="material-symbols-outlined">forum</span> Forum</a>
    <a href="#servisler" class="hub-sidebar-link"><span class="material-symbols-outlined">home_repair_service</span> Servisler</a>
    <a href="#parcalar" class="hub-sidebar-link"><span class="material-symbols-outlined">settings</span> Yedek Parça</a>
    <a href="#belgeler" class="hub-sidebar-link"><span class="material-symbols-outlined">description</span> Belgeler</a>

    <!-- Diğer Modeller -->
    <% if (typeof otherModels !== 'undefined' && otherModels && otherModels.length > 0) { %>
    <div class="mt-5 pt-4 border-t border-slate-100">
      <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider px-3.5 mb-1">
        <a href="/arac/<%= brand.slug %>" class="hover:text-slate-600"><%= brand.name %> Modelleri</a>
      </p>
      <% otherModels.slice(0, 15).forEach(om => { %>
      <a href="/arac/<%= brand.slug %>/<%= om.slug %>" class="hub-sidebar-link" style="font-size:12px; padding:6px 14px;">
        <span class="w-1.5 h-1.5 rounded-full bg-slate-300 shrink-0"></span>
        <span class="truncate"><%= om.name %></span>
      </a>
      <% }) %>
      <% if (otherModels.length > 15) { %>
      <a href="/arac/<%= brand.slug %>" class="hub-sidebar-link" style="font-size:11px; color:#94a3b8; padding:6px 14px;">
        +<%= otherModels.length - 15 %> model daha →
      </a>
      <% } %>
    </div>
    <% } %>
  </div>
</aside>

<!-- Main -->
<main class="flex-1 min-w-0 space-y-6">

<!-- Breadcrumb -->
<nav class="flex items-center gap-1.5 text-xs text-slate-400">
  <a href="/" class="hover:text-slate-600">Ana Sayfa</a>
  <span class="material-symbols-outlined" style="font-size:14px">chevron_right</span>
  <a href="/arac-secim" class="hover:text-slate-600">Araç Seçim</a>
  <span class="material-symbols-outlined" style="font-size:14px">chevron_right</span>
  <a href="/arac-secim" class="hover:text-slate-600"><%= brand.name %></a>
  <span class="material-symbols-outlined" style="font-size:14px">chevron_right</span>
  <span class="text-slate-700 font-medium"><%= model.name %></span>
</nav>

<!-- Active Filters -->
<% if (selectedYear || selectedFuel || selectedTransmission || selectedBudget || selectedEngine || selectedPackage || selectedBodyType) { %>
<div class="flex items-center gap-2 flex-wrap bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5">
  <span class="text-xs font-semibold text-slate-500 flex items-center gap-1"><span class="material-symbols-outlined" style="font-size:16px">filter_alt</span> Filtreler:</span>
  <% if (selectedYear) { %>
    <span class="inline-flex items-center gap-1 bg-white border border-slate-200 text-xs font-medium text-slate-700 px-2.5 py-1 rounded-lg">
      <span class="material-symbols-outlined" style="font-size:14px">calendar_today</span> <%= selectedYear %>
    </span>
  <% } %>
  <% if (selectedBodyType) { %>
    <span class="inline-flex items-center gap-1 bg-white border border-slate-200 text-xs font-medium text-slate-700 px-2.5 py-1 rounded-lg">
      <span class="material-symbols-outlined" style="font-size:14px">directions_car</span> <%= typeof BODY_TYPE_TR !== 'undefined' && BODY_TYPE_TR[selectedBodyType] ? BODY_TYPE_TR[selectedBodyType] : selectedBodyType %>
    </span>
  <% } %>
  <% if (selectedFuel) { %>
    <span class="inline-flex items-center gap-1 bg-white border border-slate-200 text-xs font-medium text-slate-700 px-2.5 py-1 rounded-lg capitalize">
      <span class="material-symbols-outlined" style="font-size:14px">local_gas_station</span> <%= selectedFuel %>
    </span>
  <% } %>
  <% if (selectedTransmission) { %>
    <span class="inline-flex items-center gap-1 bg-white border border-slate-200 text-xs font-medium text-slate-700 px-2.5 py-1 rounded-lg">
      <span class="material-symbols-outlined" style="font-size:14px">settings</span> <%= selectedTransmission === 'otomatik' ? 'Otomatik' : selectedTransmission === 'manuel' ? 'Manuel' : 'Y. Otomatik' %>
    </span>
  <% } %>
  <% if (selectedEngine) { %>
    <span class="inline-flex items-center gap-1 bg-white border border-slate-200 text-xs font-medium text-slate-700 px-2.5 py-1 rounded-lg">
      <span class="material-symbols-outlined" style="font-size:14px">speed</span> <%= selectedEngine %>
    </span>
  <% } %>
  <% if (selectedPackage) { %>
    <span class="inline-flex items-center gap-1 bg-white border border-slate-200 text-xs font-medium text-slate-700 px-2.5 py-1 rounded-lg">
      <span class="material-symbols-outlined" style="font-size:14px">inventory_2</span> <%= selectedPackage %>
    </span>
  <% } %>
  <% if (selectedBudget) { %>
    <span class="inline-flex items-center gap-1 bg-white border border-slate-200 text-xs font-medium text-slate-700 px-2.5 py-1 rounded-lg">
      <span class="material-symbols-outlined" style="font-size:14px">payments</span> ≤ <%= new Intl.NumberFormat('tr-TR').format(selectedBudget) %> ₺
    </span>
  <% } %>
  <a href="/arac/<%= brand.slug %>/<%= model.slug %>" class="inline-flex items-center gap-1 text-xs font-semibold text-red-500 hover:text-red-700 ml-auto transition-colors">
    <span class="material-symbols-outlined" style="font-size:14px">close</span> Temizle
  </a>
</div>
<% } %>

<!-- Hero -->
<section id="genel-bakis" class="hub-hero">
  <!-- Araç Görsel Alanı -->
  <div class="relative h-56 sm:h-72 bg-gradient-to-br from-slate-700 via-slate-800 to-slate-900 flex items-center justify-center overflow-hidden">
    <% if (hub && hub.image_url) { %>
    <img src="<%= hub.image_url %>" alt="<%= brand.name %> <%= model.name %>" class="w-full h-full object-cover">
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-slate-900/20"></div>
    <% } else { %>
    <span class="material-symbols-outlined text-slate-600" style="font-size:140px">directions_car</span>
    <% } %>
    <div class="absolute bottom-4 right-4 flex gap-2 flex-wrap justify-end">
      <% if (listings && listings.length > 5) { %><span class="hub-badge bg-green-500/20 text-green-300 backdrop-blur-sm">Popüler</span><% } %>
      <% if (hub && hub._yearInfo && hub._yearInfo.category === 'classic') { %><span class="hub-badge bg-amber-500/20 text-amber-300 backdrop-blur-sm">Klasik</span><% } %>
      <% if (selectedYear) { %><span class="hub-badge bg-white/10 text-white/70 backdrop-blur-sm"><%= selectedYear %> Model</span><% } %>
      <% if (selectedBodyType) { %><span class="hub-badge bg-white/10 text-white/70 backdrop-blur-sm"><%= typeof BODY_TYPE_TR !== 'undefined' && BODY_TYPE_TR[selectedBodyType] ? BODY_TYPE_TR[selectedBodyType] : selectedBodyType %></span><% } %>
      <% if (selectedFuel) { %><span class="hub-badge bg-white/10 text-white/70 backdrop-blur-sm capitalize"><%= selectedFuel %></span><% } %>
      <% if (selectedTransmission) { %>
        <span class="hub-badge bg-white/10 text-white/70 backdrop-blur-sm"><%= selectedTransmission === 'otomatik' ? 'Otomatik' : selectedTransmission === 'manuel' ? 'Manuel' : 'Y. Otomatik' %></span>
      <% } %>
      <% if (selectedEngine) { %><span class="hub-badge bg-white/10 text-white/70 backdrop-blur-sm"><%= selectedEngine %></span><% } %>
      <% if (selectedPackage) { %><span class="hub-badge bg-white/10 text-white/70 backdrop-blur-sm"><%= selectedPackage %></span><% } %>
      <% if (selectedBudget) { %>
        <span class="hub-badge bg-white/10 text-white/70 backdrop-blur-sm">≤ <%= new Intl.NumberFormat('tr-TR').format(selectedBudget) %> ₺</span>
      <% } %>
    </div>
    <div class="absolute top-4 left-4">
      <% if (brand.logo) { %>
      <img src="<%= brand.logo %>" alt="<%= brand.name %>" class="h-8 w-auto opacity-60">
      <% } %>
    </div>
  </div>

  <div class="hub-hero-inner">
    <div class="flex items-start justify-between mb-1">
      <div>
        <h1 class="text-2xl font-bold mb-1"><%= brand.name %> <%= model.name %></h1>
        <p class="text-sm text-white/50">
          <%= hub.engine || '' %><% if (hub.transmission) { %> · <%= hub.transmission %><% } %><% if (hub.hp) { %> · <%= hub.hp %> HP<% } %>
        </p>
      </div>
      <% if (hub && hub.avg_price) { %>
      <div class="text-right shrink-0 ml-4">
        <p class="text-2xl font-bold"><%= formatPrice(hub.avg_price) %></p>
        <p class="text-xs text-white/40">Ortalama Fiyat</p>
      </div>
      <% } else if (priceStats) { %>
      <div class="text-right shrink-0 ml-4">
        <p class="text-2xl font-bold"><%= formatPrice(priceStats.avg) %></p>
        <p class="text-xs text-white/40">Ort. Fiyat · <%= priceStats.count %> ilan</p>
      </div>
      <% } %>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6">
      <div class="hub-spec-pill"><p class="label">Yakıt</p><p class="value"><%= hub.fuel_type || selectedFuel || '—' %></p></div>
      <div class="hub-spec-pill"><p class="label">Motor</p><p class="value"><%= hub.engine ? hub.engine.split(' ').slice(0,2).join(' ') : '—' %></p></div>
      <div class="hub-spec-pill"><p class="label">Vites</p><p class="value"><%= hub.transmission || '—' %></p></div>
      <div class="hub-spec-pill"><p class="label">Tüketim</p><p class="value"><%= hub.fuel_consumption || '—' %></p></div>
    </div>
  </div>
</section>

<!-- Teknik Özellikler -->
<section id="teknik" class="hub-section">
  <h2 class="hub-section-title"><span class="material-symbols-outlined">build</span> Teknik Özellikler</h2>
  <div class="grid md:grid-cols-2 gap-8">
    <div>
      <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Motor & Performans</h3>
      <table class="w-full hub-table">
        <% if (hub.engine) { %><tr><td>Motor Tipi</td><td><%= hub.engine %></td></tr><% } %>
        <% if (hub.hp) { %><tr><td>Beygir Gücü</td><td><%= hub.hp %> HP</td></tr><% } %>
        <% if (hub.torque) { %><tr><td>Tork</td><td><%= hub.torque %></td></tr><% } %>
        <% if (hub.acceleration) { %><tr><td>0-100 km/s</td><td><%= hub.acceleration %></td></tr><% } %>
        <% if (hub.top_speed) { %><tr><td>Maks. Hız</td><td><%= hub.top_speed %></td></tr><% } %>
      </table>
    </div>
    <div>
      <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Boyutlar & Ağırlık</h3>
      <table class="w-full hub-table">
        <% if (hub.length) { %><tr><td>Uzunluk</td><td><%= hub.length %></td></tr><% } %>
        <% if (hub.width) { %><tr><td>Genişlik</td><td><%= hub.width %></td></tr><% } %>
        <% if (hub.height) { %><tr><td>Yükseklik</td><td><%= hub.height %></td></tr><% } %>
        <% if (hub.wheelbase) { %><tr><td>Dingil Mesafesi</td><td><%= hub.wheelbase %></td></tr><% } %>
        <% if (hub.weight) { %><tr><td>Ağırlık</td><td><%= hub.weight %></td></tr><% } %>
        <% if (hub.trunk_volume) { %><tr><td>Bagaj Hacmi</td><td><%= hub.trunk_volume %></td></tr><% } %>
      </table>
    </div>
  </div>
</section>

<!-- Video İncelemeleri -->
<section id="videolar" class="hub-section">
  <h2 class="hub-section-title"><span class="material-symbols-outlined">play_circle</span> Video İncelemeleri</h2>
  <div class="grid md:grid-cols-2 gap-4">
    <div>
      <div class="hub-video-thumb">
        <span class="material-symbols-outlined text-5xl text-slate-300">smart_display</span>
        <div class="hub-video-overlay"><span class="material-symbols-outlined text-white text-4xl">play_arrow</span></div>
      </div>
      <p class="font-bold text-sm mt-2.5 text-slate-800"><%= selectedYear || '' %> <%= brand.name %> <%= model.name %> — Detaylı İnceleme</p>
      <p class="text-xs text-slate-400 mt-0.5">OtoTrend · Video içeriği yakında</p>
    </div>
    <div>
      <div class="hub-video-thumb">
        <span class="material-symbols-outlined text-5xl text-slate-300">smart_display</span>
        <div class="hub-video-overlay"><span class="material-symbols-outlined text-white text-4xl">play_arrow</span></div>
      </div>
      <p class="font-bold text-sm mt-2.5 text-slate-800"><%= brand.name %> <%= model.name %> — Karşılaştırma Testi</p>
      <p class="text-xs text-slate-400 mt-0.5">Araba Dünyası · Video içeriği yakında</p>
    </div>
  </div>
</section>

<!-- Güvenlik -->
<% if (hub.safety_rating || (hub.safety_features && hub.safety_features.length > 0)) { %>
<section id="guvenlik" class="hub-section">
  <h2 class="hub-section-title"><span class="material-symbols-outlined">shield</span> Güvenlik</h2>
  <div class="grid md:grid-cols-2 gap-8">
    <% if (hub.safety_rating) { %>
    <div>
      <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Euro NCAP Puanı</h3>
      <div class="flex items-center gap-3 mb-4">
        <% const safetyStars = parseInt(hub.safety_rating) || 0; %>
        <div class="flex gap-0.5">
          <% for(let i = 0; i < 5; i++) { %>
          <span class="material-symbols-outlined text-xl <%= i < safetyStars ? 'text-amber-400' : 'text-slate-200' %>" style="font-variation-settings:'FILL' 1">star</span>
          <% } %>
        </div>
        <span class="text-sm font-bold text-slate-700"><%= hub.safety_rating %></span>
      </div>
      <p class="text-xs text-slate-400">* Tahmini güvenlik puanı, segment ve model yılına göre hesaplanmıştır.</p>
    </div>
    <% } %>
    <% if (hub.safety_features && hub.safety_features.length > 0) { %>
    <div>
      <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Güvenlik Özellikleri</h3>
      <div class="flex flex-wrap gap-2">
        <% hub.safety_features.forEach(function(feature) { %>
        <span class="inline-flex items-center gap-1.5 bg-green-50 text-green-700 text-xs font-medium px-3 py-1.5 rounded-lg border border-green-100">
          <span class="material-symbols-outlined" style="font-size:14px">check_circle</span> <%= feature %>
        </span>
        <% }); %>
      </div>
    </div>
    <% } %>
  </div>
</section>
<% } %>

<!-- Editör Değerlendirmesi -->
<% if (hub.editor_rating) { %>
<section id="editor" class="hub-section">
  <h2 class="hub-section-title"><span class="material-symbols-outlined">rate_review</span> Editör Değerlendirmesi</h2>
  <div class="flex items-center gap-4 mb-5">
    <div class="hub-rating-circle <%= hub.editor_rating >= 8 ? 'bg-green-50 text-green-700' : hub.editor_rating >= 6 ? 'bg-amber-50 text-amber-700' : 'bg-red-50 text-red-700' %>"><%= hub.editor_rating %></div>
    <div>
      <p class="font-bold text-sm text-slate-900"><%= hub.editor_rating >= 9 ? 'Mükemmel' : hub.editor_rating >= 8 ? 'Çok İyi' : hub.editor_rating >= 7 ? 'İyi' : hub.editor_rating >= 6 ? 'Orta' : 'Düşük' %></p>
      <p class="text-xs text-slate-400">10 üzerinden editör puanı</p>
    </div>
  </div>
  <% if (hub.editor_review) { %>
  <p class="text-sm text-slate-600 leading-relaxed mb-5 border-l-2 border-slate-200 pl-4 italic"><%= hub.editor_review %></p>
  <% } %>
  <% if (prosList.length > 0 || consList.length > 0) { %>
  <div class="grid md:grid-cols-2 gap-6">
    <% if (prosList.length > 0) { %>
    <div class="bg-green-50/50 rounded-xl p-4">
      <h3 class="flex items-center gap-1.5 text-xs font-bold text-green-700 uppercase tracking-wider mb-3"><span class="material-symbols-outlined text-sm">add_circle</span> Artılar</h3>
      <ul class="space-y-2">
        <% prosList.forEach(pro => { %>
        <li class="flex items-start gap-2 text-sm text-slate-700"><span class="text-green-500 mt-0.5">•</span><%= pro %></li>
        <% }) %>
      </ul>
    </div>
    <% } %>
    <% if (consList.length > 0) { %>
    <div class="bg-red-50/50 rounded-xl p-4">
      <h3 class="flex items-center gap-1.5 text-xs font-bold text-red-700 uppercase tracking-wider mb-3"><span class="material-symbols-outlined text-sm">remove_circle</span> Eksiler</h3>
      <ul class="space-y-2">
        <% consList.forEach(con => { %>
        <li class="flex items-start gap-2 text-sm text-slate-700"><span class="text-red-500 mt-0.5">•</span><%= con %></li>
        <% }) %>
      </ul>
    </div>
    <% } %>
  </div>
  <% } %>
</section>
<% } %>

<!-- Satılık İlanlar -->
<section id="ilanlar" class="hub-section">
  <div class="flex items-center justify-between mb-5">
    <h2 class="hub-section-title mb-0"><span class="material-symbols-outlined">sell</span> Satılık İlanlar</h2>
    <a href="/ilan?marka=<%= brand.slug %>" class="text-xs font-bold text-slate-500 hover:text-slate-800 flex items-center gap-1 transition-colors">Tümü <span class="material-symbols-outlined" style="font-size:16px">arrow_forward</span></a>
  </div>
  <% if (listings && listings.length > 0) { %>
  <div class="grid md:grid-cols-3 gap-4">
    <% listings.forEach(l => { %>
    <a href="/ilan/<%= l.slug %>" class="hub-listing-card group">
      <div class="aspect-[4/3] bg-slate-100 flex items-center justify-center">
        <% if (l.image && l.image !== '/images/car-placeholder.svg') { %>
        <img src="<%= l.image %>" alt="<%= l.title %>" class="w-full h-full object-cover">
        <% } else { %>
        <span class="material-symbols-outlined text-4xl text-slate-300">directions_car</span>
        <% } %>
      </div>
      <div class="p-3.5">
        <p class="font-bold text-sm text-slate-800 group-hover:text-slate-600 transition-colors line-clamp-1"><%= l.title %></p>
        <p class="text-xs text-slate-400 mt-1"><%= formatKm(l.km) %> km · <%= l.transmission === 'otomatik' ? 'Otomatik' : l.transmission === 'manuel' ? 'Manuel' : 'Y. Otomatik' %> · <%= l.fuel_type %> · <%= l.city %></p>
        <p class="text-slate-900 font-bold text-sm mt-2"><%= formatPrice(l.price) %></p>
      </div>
    </a>
    <% }) %>
  </div>
  <% } else { %>
  <div class="text-center py-10 text-slate-400">
    <span class="material-symbols-outlined text-3xl mb-2 block">search_off</span>
    <p class="text-sm">Bu model için aktif ilan bulunamadı.</p>
    <a href="/ilan/ver" class="text-sm font-bold text-slate-700 hover:text-slate-900 mt-2 inline-block">İlan Verin →</a>
  </div>
  <% } %>
</section>

<!-- Forum -->
<section id="forum" class="hub-section">
  <div class="flex items-center justify-between mb-5">
    <h2 class="hub-section-title mb-0"><span class="material-symbols-outlined">forum</span> Forum Konuları</h2>
    <a href="/forum" class="text-xs font-bold text-slate-500 hover:text-slate-800 flex items-center gap-1 transition-colors">Foruma Git <span class="material-symbols-outlined" style="font-size:16px">arrow_forward</span></a>
  </div>
  <% if (forumTopics && forumTopics.length > 0) { %>
  <div class="divide-y divide-slate-100">
    <% forumTopics.forEach(t => { %>
    <a href="/forum/konu/<%= t.slug %>" class="hub-forum-row">
      <div class="w-8 h-8 bg-slate-100 rounded-lg flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-slate-400" style="font-size:18px">chat_bubble_outline</span></div>
      <div class="flex-1 min-w-0">
        <p class="font-semibold text-sm text-slate-800 truncate"><%= t.title %></p>
        <p class="text-xs text-slate-400 mt-0.5"><%= t.reply_count || 0 %> yanıt · <%= t.view_count || 0 %> görüntülenme</p>
      </div>
      <span class="material-symbols-outlined text-slate-300" style="font-size:18px">chevron_right</span>
    </a>
    <% }) %>
  </div>
  <% } else { %>
  <div class="text-center py-8 text-slate-400">
    <p class="text-sm">Bu model hakkında henüz tartışma yok.</p>
  </div>
  <% } %>
</section>

<!-- Servisler -->
<section id="servisler" class="hub-section">
  <div class="flex items-center justify-between mb-5">
    <h2 class="hub-section-title mb-0"><span class="material-symbols-outlined">home_repair_service</span> Yakın Servisler</h2>
    <a href="/servis" class="text-xs font-bold text-slate-500 hover:text-slate-800 flex items-center gap-1 transition-colors">Tümü <span class="material-symbols-outlined" style="font-size:16px">arrow_forward</span></a>
  </div>
  <% if (nearbyServices && nearbyServices.length > 0) { %>
  <div class="grid md:grid-cols-3 gap-4">
    <% nearbyServices.forEach(s => { %>
    <a href="/isletme/<%= s.slug %>" class="hub-service-card">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-10 h-10 bg-slate-100 rounded-lg flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-slate-500" style="font-size:20px">build</span></div>
        <div class="min-w-0">
          <p class="font-bold text-sm text-slate-800 truncate"><%= s.name %></p>
          <p class="text-xs text-slate-400"><%= s.type === 'servis' ? 'Yetkili Servis' : s.type === 'galeri' ? 'Galeri' : s.type %></p>
        </div>
      </div>
      <div class="flex items-center gap-1 text-xs mb-2">
        <% for(let i=0;i<5;i++){%><span class="material-symbols-outlined text-amber-400" style="font-size:14px;font-variation-settings:'FILL' 1"><%= i < Math.round(s.rating) ? 'star' : 'star_border' %></span><%}%>
        <span class="text-slate-400 ml-1"><%= s.rating %></span>
      </div>
      <% if (s.city) { %><p class="text-xs text-slate-400 flex items-center gap-1"><span class="material-symbols-outlined" style="font-size:14px">location_on</span> <%= s.city %><%= s.district ? ', ' + s.district : '' %></p><% } %>
    </a>
    <% }) %>
  </div>
  <% } else { %>
  <div class="text-center py-8 text-slate-400"><p class="text-sm">Yakınlarda servis bulunamadı.</p></div>
  <% } %>
</section>

<!-- Yedek Parça -->
