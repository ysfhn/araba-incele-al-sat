<%
function formatPrice(p) { return new Intl.NumberFormat('tr-TR').format(p) + ' ₺'; }
function formatKm(k) { return new Intl.NumberFormat('tr-TR').format(k); }
function parseProsConsList(str) {
  if (!str) return [];
  try { const arr = JSON.parse(str); if (Array.isArray(arr)) return arr; } catch(e) {}
  return str.split('\n').filter(s => s.trim());
}
const prosList = hub ? parseProsConsList(hub.pros) : [];
const consList = hub ? parseProsConsList(hub.cons) : [];
const selectedYear = typeof queryYear !== 'undefined' ? queryYear : (hub ? hub.year : null);
const selectedFuel = typeof queryFuel !== 'undefined' ? queryFuel : (hub ? hub.fuel_type : null);
%>

<div class="max-w-7xl mx-auto px-6 py-6 flex gap-8">
<!-- Sticky Sidebar -->
<aside class="hidden lg:block w-56 shrink-0">
  <div class="sticky top-24 space-y-1">
    <a href="#genel-bakis" class="sidebar-link flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-primary/10 text-primary font-bold text-sm"><span class="material-symbols-outlined text-lg">dashboard</span> Genel Bakış</a>
    <a href="#teknik" class="sidebar-link flex items-center gap-2.5 px-4 py-2.5 rounded-xl text-slate-600 hover:bg-slate-100 font-medium text-sm"><span class="material-symbols-outlined text-lg">build</span> Teknik Özellikler</a>
    <a href="#videolar" class="sidebar-link flex items-center gap-2.5 px-4 py-2.5 rounded-xl text-slate-600 hover:bg-slate-100 font-medium text-sm"><span class="material-symbols-outlined text-lg">play_circle</span> Video İncelemeleri</a>
    <a href="#editor" class="sidebar-link flex items-center gap-2.5 px-4 py-2.5 rounded-xl text-slate-600 hover:bg-slate-100 font-medium text-sm"><span class="material-symbols-outlined text-lg">rate_review</span> Editör Değerlendirmesi</a>
    <a href="#ilanlar" class="sidebar-link flex items-center gap-2.5 px-4 py-2.5 rounded-xl text-slate-600 hover:bg-slate-100 font-medium text-sm"><span class="material-symbols-outlined text-lg">sell</span> Satılık İlanlar</a>
    <a href="#forum" class="sidebar-link flex items-center gap-2.5 px-4 py-2.5 rounded-xl text-slate-600 hover:bg-slate-100 font-medium text-sm"><span class="material-symbols-outlined text-lg">forum</span> Forum Konuları</a>
    <a href="#servisler" class="sidebar-link flex items-center gap-2.5 px-4 py-2.5 rounded-xl text-slate-600 hover:bg-slate-100 font-medium text-sm"><span class="material-symbols-outlined text-lg">home_repair_service</span> Yakın Servisler</a>
    <a href="#parcalar" class="sidebar-link flex items-center gap-2.5 px-4 py-2.5 rounded-xl text-slate-600 hover:bg-slate-100 font-medium text-sm"><span class="material-symbols-outlined text-lg">settings</span> Yedek Parça</a>
    <a href="#belgeler" class="sidebar-link flex items-center gap-2.5 px-4 py-2.5 rounded-xl text-slate-600 hover:bg-slate-100 font-medium text-sm"><span class="material-symbols-outlined text-lg">description</span> Belgeler</a>
  </div>
</aside>

<!-- Main Content -->
<main class="flex-1 min-w-0 space-y-8">
<!-- Breadcrumb -->
<div class="flex items-center gap-2 text-sm text-slate-500">
  <a href="/" class="hover:text-primary">Ana Sayfa</a><span>/</span>
  <a href="/arac-secim" class="hover:text-primary">Araç Seçim</a><span>/</span>
  <a href="/arac-secim" class="hover:text-primary"><%= brand.name %></a><span>/</span>
  <span class="text-slate-900 font-medium"><%= model.name %></span>
</div>

<!-- Hero -->
<section id="genel-bakis" class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
  <div class="relative h-72 bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center">
    <span class="material-symbols-outlined text-9xl text-slate-300">directions_car</span>
    <div class="absolute bottom-4 right-4 flex gap-2">
      <% if (listings && listings.length > 5) { %><span class="bg-green-100 text-green-700 text-xs font-bold px-3 py-1 rounded-full">Popüler</span><% } %>
      <% if (selectedYear) { %><span class="bg-blue-100 text-blue-700 text-xs font-bold px-3 py-1 rounded-full"><%= selectedYear %> Model</span><% } %>
    </div>
  </div>
  <div class="p-6">
    <div class="flex items-start justify-between mb-4">
      <div>
        <h1 class="text-2xl font-bold"><%= brand.name %> <%= model.name %></h1>
        <p class="text-slate-500 mt-1">
          <% if (hub) { %><%= hub.engine || '' %> | <%= hub.transmission || '' %><% if (selectedYear) { %> | <%= selectedYear %><% } %><% } else { %>Detaylı inceleme, ilanlar ve forum tartışmaları<% } %>
        </p>
      </div>
      <% if (hub && hub.avg_price) { %>
      <div class="text-right">
        <p class="text-2xl font-bold text-primary"><%= formatPrice(hub.avg_price) %></p>
        <p class="text-xs text-slate-400">Ortalama Fiyat</p>
      </div>
      <% } else if (priceStats) { %>
      <div class="text-right">
        <p class="text-2xl font-bold text-primary"><%= formatPrice(priceStats.avg) %></p>
        <p class="text-xs text-slate-400">Ortalama Fiyat (<%= priceStats.count %> ilan)</p>
      </div>
      <% } %>
    </div>
    <!-- Quick Specs -->
    <% if (hub) { %>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6">
      <div class="bg-slate-50 rounded-xl p-4 text-center"><span class="material-symbols-outlined text-primary mb-1">local_gas_station</span><p class="text-xs text-slate-500">Yakıt</p><p class="text-sm font-bold"><%= hub.fuel_type || selectedFuel || '-' %></p></div>
      <div class="bg-slate-50 rounded-xl p-4 text-center"><span class="material-symbols-outlined text-primary mb-1">speed</span><p class="text-xs text-slate-500">Motor</p><p class="text-sm font-bold"><%= hub.engine ? hub.engine.split(' ').slice(0,2).join(' ') : '-' %> <%= hub.hp ? hub.hp + 'HP' : '' %></p></div>
      <div class="bg-slate-50 rounded-xl p-4 text-center"><span class="material-symbols-outlined text-primary mb-1">settings</span><p class="text-xs text-slate-500">Vites</p><p class="text-sm font-bold"><%= hub.transmission || '-' %></p></div>
      <div class="bg-slate-50 rounded-xl p-4 text-center"><span class="material-symbols-outlined text-primary mb-1">eco</span><p class="text-xs text-slate-500">Tüketim</p><p class="text-sm font-bold"><%= hub.fuel_consumption || '-' %></p></div>
    </div>
    <% } %>
  </div>
</section>

<!-- Teknik Özellikler -->
<% if (hub) { %>
<section id="teknik" class="bg-white rounded-2xl border border-slate-200 p-6">
  <h2 class="text-lg font-bold mb-5 flex items-center gap-2"><span class="material-symbols-outlined text-primary">build</span> Teknik Özellikler</h2>
  <div class="grid md:grid-cols-2 gap-6">
    <div>
      <h3 class="text-sm font-bold text-slate-500 uppercase tracking-wider mb-3">Motor & Performans</h3>
      <table class="w-full text-sm">
        <% if (hub.engine) { %><tr class="border-b border-slate-100"><td class="py-2.5 text-slate-500">Motor Tipi</td><td class="py-2.5 text-right font-medium"><%= hub.engine %></td></tr><% } %>
        <% if (hub.hp) { %><tr class="border-b border-slate-100"><td class="py-2.5 text-slate-500">Beygir Gücü</td><td class="py-2.5 text-right font-medium"><%= hub.hp %> HP</td></tr><% } %>
        <% if (hub.torque) { %><tr class="border-b border-slate-100"><td class="py-2.5 text-slate-500">Tork</td><td class="py-2.5 text-right font-medium"><%= hub.torque %></td></tr><% } %>
        <% if (hub.acceleration) { %><tr class="border-b border-slate-100"><td class="py-2.5 text-slate-500">0-100 km/s</td><td class="py-2.5 text-right font-medium"><%= hub.acceleration %></td></tr><% } %>
        <% if (hub.top_speed) { %><tr><td class="py-2.5 text-slate-500">Maks. Hız</td><td class="py-2.5 text-right font-medium"><%= hub.top_speed %></td></tr><% } %>
      </table>
    </div>
    <div>
      <h3 class="text-sm font-bold text-slate-500 uppercase tracking-wider mb-3">Boyutlar & Ağırlık</h3>
      <table class="w-full text-sm">
        <% if (hub.length) { %><tr class="border-b border-slate-100"><td class="py-2.5 text-slate-500">Uzunluk</td><td class="py-2.5 text-right font-medium"><%= hub.length %></td></tr><% } %>
        <% if (hub.width) { %><tr class="border-b border-slate-100"><td class="py-2.5 text-slate-500">Genişlik</td><td class="py-2.5 text-right font-medium"><%= hub.width %></td></tr><% } %>
        <% if (hub.height) { %><tr class="border-b border-slate-100"><td class="py-2.5 text-slate-500">Yükseklik</td><td class="py-2.5 text-right font-medium"><%= hub.height %></td></tr><% } %>
        <% if (hub.wheelbase) { %><tr class="border-b border-slate-100"><td class="py-2.5 text-slate-500">Dingil Mesafesi</td><td class="py-2.5 text-right font-medium"><%= hub.wheelbase %></td></tr><% } %>
        <% if (hub.weight) { %><tr><td class="py-2.5 text-slate-500">Ağırlık</td><td class="py-2.5 text-right font-medium"><%= hub.weight %></td></tr><% } %>
      </table>
    </div>
  </div>
</section>
<% } %>

<!-- Video İncelemeleri -->
<section id="videolar" class="bg-white rounded-2xl border border-slate-200 p-6">
  <h2 class="text-lg font-bold mb-5 flex items-center gap-2"><span class="material-symbols-outlined text-primary">play_circle</span> Video İncelemeleri</h2>
  <div class="grid md:grid-cols-2 gap-4">
    <div class="group cursor-pointer">
      <div class="relative bg-slate-100 rounded-xl aspect-video flex items-center justify-center overflow-hidden">
        <span class="material-symbols-outlined text-6xl text-slate-300">smart_display</span>
        <div class="absolute inset-0 bg-black/30 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity"><span class="material-symbols-outlined text-white text-5xl">play_arrow</span></div>
      </div>
      <p class="font-bold text-sm mt-2"><%= selectedYear || '' %> <%= brand.name %> <%= model.name %> - Detaylı İnceleme</p>
      <p class="text-xs text-slate-500 mt-0.5">OtoTrend • Video içeriği yakında</p>
    </div>
    <div class="group cursor-pointer">
      <div class="relative bg-slate-100 rounded-xl aspect-video flex items-center justify-center overflow-hidden">
        <span class="material-symbols-outlined text-6xl text-slate-300">smart_display</span>
        <div class="absolute inset-0 bg-black/30 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity"><span class="material-symbols-outlined text-white text-5xl">play_arrow</span></div>
      </div>
      <p class="font-bold text-sm mt-2"><%= brand.name %> <%= model.name %> - Karşılaştırma Testi</p>
      <p class="text-xs text-slate-500 mt-0.5">Araba Dünyası • Video içeriği yakında</p>
    </div>
  </div>
</section>

<!-- Editör Değerlendirmesi -->
<% if (hub && hub.editor_rating) { %>
<section id="editor" class="bg-white rounded-2xl border border-slate-200 p-6">
  <h2 class="text-lg font-bold mb-5 flex items-center gap-2"><span class="material-symbols-outlined text-primary">rate_review</span> Editör Değerlendirmesi</h2>
  <div class="flex items-center gap-4 mb-6">
    <div class="size-14 bg-primary/10 rounded-full flex items-center justify-center"><span class="text-primary text-xl font-bold"><%= hub.editor_rating %></span></div>
    <div>
      <p class="font-bold"><%= hub.editor_rating >= 9 ? 'Mükemmel' : hub.editor_rating >= 8 ? 'Çok İyi' : hub.editor_rating >= 7 ? 'İyi' : hub.editor_rating >= 6 ? 'Orta' : 'Düşük' %></p>
      <p class="text-sm text-slate-500">Editör Puanı (10 üzerinden)</p>
    </div>
  </div>
  <% if (hub.editor_review) { %>
  <p class="text-sm text-slate-600 leading-relaxed mb-6"><%= hub.editor_review %></p>
  <% } %>
  <% if (prosList.length > 0 || consList.length > 0) { %>
  <div class="grid md:grid-cols-2 gap-6">
    <% if (prosList.length > 0) { %>
    <div>
      <h3 class="flex items-center gap-2 text-sm font-bold text-green-700 mb-3"><span class="material-symbols-outlined text-lg">thumb_up</span> Artılar</h3>
      <ul class="space-y-2">
        <% prosList.forEach(pro => { %>
        <li class="flex items-start gap-2 text-sm text-slate-600"><span class="material-symbols-outlined text-green-500 text-base mt-0.5">check_circle</span><%= pro %></li>
        <% }) %>
      </ul>
    </div>
    <% } %>
    <% if (consList.length > 0) { %>
    <div>
      <h3 class="flex items-center gap-2 text-sm font-bold text-red-700 mb-3"><span class="material-symbols-outlined text-lg">thumb_down</span> Eksiler</h3>
      <ul class="space-y-2">
        <% consList.forEach(con => { %>
        <li class="flex items-start gap-2 text-sm text-slate-600"><span class="material-symbols-outlined text-red-500 text-base mt-0.5">cancel</span><%= con %></li>
        <% }) %>
      </ul>
    </div>
    <% } %>
  </div>
  <% } %>
</section>
<% } %>

<!-- Satılık İlanlar -->
<section id="ilanlar" class="bg-white rounded-2xl border border-slate-200 p-6">
  <div class="flex items-center justify-between mb-5">
    <h2 class="text-lg font-bold flex items-center gap-2"><span class="material-symbols-outlined text-primary">sell</span> Satılık İlanlar</h2>
    <a href="/ilan?marka=<%= brand.slug %>" class="text-sm text-primary font-bold hover:underline flex items-center gap-1">Tümünü Gör <span class="material-symbols-outlined text-sm">arrow_forward</span></a>
  </div>
  <% if (listings && listings.length > 0) { %>
  <div class="grid md:grid-cols-3 gap-4">
    <% listings.forEach(l => { %>
    <a href="/ilan/<%= l.slug %>" class="group border border-slate-200 rounded-xl overflow-hidden hover:shadow-lg transition-all">
      <div class="aspect-[4/3] bg-slate-100 flex items-center justify-center">
        <% if (l.image && l.image !== '/images/car-placeholder.svg') { %>
        <img src="<%= l.image %>" alt="<%= l.title %>" class="w-full h-full object-cover">
        <% } else { %>
        <span class="material-symbols-outlined text-5xl text-slate-300">directions_car</span>
        <% } %>
      </div>
      <div class="p-4">
        <p class="font-bold text-sm group-hover:text-primary transition-colors line-clamp-1"><%= l.title %></p>
        <p class="text-xs text-slate-500 mt-1"><%= formatKm(l.km) %> km • <%= l.transmission === 'otomatik' ? 'Otomatik' : l.transmission === 'manuel' ? 'Manuel' : 'Yarı Otomatik' %> • <%= l.fuel_type %> • <%= l.city %></p>
        <p class="text-primary font-bold mt-2"><%= formatPrice(l.price) %></p>
      </div>
    </a>
    <% }) %>
  </div>
  <% } else { %>
  <div class="text-center py-8 text-slate-400">
    <span class="material-symbols-outlined text-4xl mb-2 block">search_off</span>
    <p>Bu model için aktif ilan bulunamadı.</p>
    <a href="/ilan/ver" class="text-primary font-bold text-sm mt-2 inline-block">İlan Verin →</a>
  </div>
  <% } %>
</section>

<!-- Forum Konuları -->
<section id="forum" class="bg-white rounded-2xl border border-slate-200 p-6">
  <div class="flex items-center justify-between mb-5">
    <h2 class="text-lg font-bold flex items-center gap-2"><span class="material-symbols-outlined text-primary">forum</span> Forum Konuları</h2>
    <a href="/forum" class="text-sm text-primary font-bold hover:underline flex items-center gap-1">Foruma Git <span class="material-symbols-outlined text-sm">arrow_forward</span></a>
  </div>
  <% if (forumTopics && forumTopics.length > 0) { %>
  <div class="divide-y divide-slate-100">
    <% forumTopics.forEach(t => { %>
    <a href="/forum/konu/<%= t.slug %>" class="flex items-center gap-4 py-3 hover:bg-slate-50 rounded-lg px-3 -mx-3 transition-colors">
      <div class="size-10 bg-primary/10 rounded-full flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-primary text-lg">chat</span></div>
      <div class="flex-1 min-w-0">
        <p class="font-bold text-sm truncate"><%= t.title %></p>
        <p class="text-xs text-slate-500 mt-0.5"><%= t.reply_count || 0 %> yanıt • <%= t.view_count || 0 %> görüntülenme</p>
      </div>
      <span class="material-symbols-outlined text-slate-400">chevron_right</span>
    </a>
    <% }) %>
  </div>
  <% } else { %>
  <div class="text-center py-6 text-slate-400">
    <p>Bu model hakkında forum tartışması bulunamadı.</p>
  </div>
  <% } %>
</section>

<!-- Yakın Servisler -->
<section id="servisler" class="bg-white rounded-2xl border border-slate-200 p-6">
  <div class="flex items-center justify-between mb-5">
    <h2 class="text-lg font-bold flex items-center gap-2"><span class="material-symbols-outlined text-primary">home_repair_service</span> Yakın <%= brand.name %> Servisleri</h2>
    <a href="/servis" class="text-sm text-primary font-bold hover:underline flex items-center gap-1">Tümünü Gör <span class="material-symbols-outlined text-sm">arrow_forward</span></a>
  </div>
  <% if (nearbyServices && nearbyServices.length > 0) { %>
  <div class="grid md:grid-cols-3 gap-4">
    <% const serviceColors = ['red', 'blue', 'green', 'amber', 'purple']; %>
    <% nearbyServices.forEach((s, idx) => { %>
    <% const color = serviceColors[idx % serviceColors.length]; %>
    <a href="/isletme/<%= s.slug %>" class="border border-slate-200 rounded-xl p-4 hover:shadow-lg transition-all">
      <div class="flex items-center gap-3 mb-3">
        <div class="size-12 bg-<%= color %>-50 rounded-xl flex items-center justify-center"><span class="material-symbols-outlined text-<%= color %>-500">build</span></div>
        <div><p class="font-bold text-sm"><%= s.name %></p><p class="text-xs text-slate-500"><%= s.type === 'servis' ? 'Yetkili Servis' : s.type === 'galeri' ? 'Galeri' : s.type %></p></div>
      </div>
      <div class="flex items-center gap-1 text-xs text-amber-500 mb-2">
        <% for(let i=0;i<5;i++){%><span class="material-symbols-outlined text-sm" style="font-variation-settings:'FILL' 1"><%= i < Math.round(s.rating) ? 'star' : 'star_border' %></span><%}%>
        <span class="text-slate-400 ml-1"><%= s.rating %> (<%= s.review_count || 0 %> değerlendirme)</span>
      </div>
      <% if (s.city) { %><p class="text-xs text-slate-500 flex items-center gap-1"><span class="material-symbols-outlined text-xs">location_on</span> <%= s.city %><%= s.district ? ', ' + s.district : '' %></p><% } %>
    </a>
    <% }) %>
  </div>
  <% } else { %>
  <div class="text-center py-6 text-slate-400">
    <p>Yakınlarda servis bulunamadı.</p>
  </div>
  <% } %>
</section>

<!-- Yedek Parça Fiyatları -->
<section id="parcalar" class="bg-white rounded-2xl border border-slate-200 p-6">
  <h2 class="text-lg font-bold mb-5 flex items-center gap-2"><span class="material-symbols-outlined text-primary">settings</span> Yedek Parça Fiyatları</h2>
  <div class="grid md:grid-cols-2 gap-3">
    <div class="flex items-center justify-between border border-slate-100 rounded-xl p-4">
      <div class="flex items-center gap-3">
        <div class="size-10 bg-slate-50 rounded-lg flex items-center justify-center"><span class="material-symbols-outlined text-slate-500 text-lg">oil_barrel</span></div>
        <div><p class="font-bold text-sm">Motor Yağı + Filtre</p><p class="text-xs text-slate-500">Periyodik Bakım</p></div>
      </div>
      <p class="font-bold text-sm">₺1.200 - ₺2.500</p>
    </div>
    <div class="flex items-center justify-between border border-slate-100 rounded-xl p-4">
      <div class="flex items-center gap-3">
        <div class="size-10 bg-slate-50 rounded-lg flex items-center justify-center"><span class="material-symbols-outlined text-slate-500 text-lg">tire_repair</span></div>
        <div><p class="font-bold text-sm">Fren Balatası (Ön)</p><p class="text-xs text-slate-500">Aşınma Parçası</p></div>
      </div>
      <p class="font-bold text-sm">₺800 - ₺1.800</p>
    </div>
    <div class="flex items-center justify-between border border-slate-100 rounded-xl p-4">
      <div class="flex items-center gap-3">
        <div class="size-10 bg-slate-50 rounded-lg flex items-center justify-center"><span class="material-symbols-outlined text-slate-500 text-lg">air</span></div>
        <div><p class="font-bold text-sm">Hava Filtresi</p><p class="text-xs text-slate-500">Periyodik Bakım</p></div>
      </div>
      <p class="font-bold text-sm">₺350 - ₺750</p>
    </div>
    <div class="flex items-center justify-between border border-slate-100 rounded-xl p-4">
      <div class="flex items-center gap-3">
        <div class="size-10 bg-slate-50 rounded-lg flex items-center justify-center"><span class="material-symbols-outlined text-slate-500 text-lg">battery_charging_full</span></div>
        <div><p class="font-bold text-sm">Akü</p><p class="text-xs text-slate-500">Elektrik</p></div>
      </div>
      <p class="font-bold text-sm">₺3.500 - ₺6.000</p>
    </div>
  </div>
</section>

<!-- Belgeler & Kaynaklar -->
<section id="belgeler" class="bg-white rounded-2xl border border-slate-200 p-6">
  <h2 class="text-lg font-bold mb-5 flex items-center gap-2"><span class="material-symbols-outlined text-primary">description</span> Belgeler & Kaynaklar</h2>
  <div class="grid md:grid-cols-2 gap-3">
    <a href="#" class="flex items-center gap-3 border border-slate-200 rounded-xl p-4 hover:bg-slate-50 transition-colors">
      <div class="size-10 bg-red-50 rounded-lg flex items-center justify-center"><span class="material-symbols-outlined text-red-500 text-lg">picture_as_pdf</span></div>
      <div><p class="font-bold text-sm">Kullanım Kılavuzu</p><p class="text-xs text-slate-500">PDF • 12.4 MB</p></div>
      <span class="material-symbols-outlined text-slate-400 ml-auto">download</span>
    </a>
    <a href="#" class="flex items-center gap-3 border border-slate-200 rounded-xl p-4 hover:bg-slate-50 transition-colors">
      <div class="size-10 bg-blue-50 rounded-lg flex items-center justify-center"><span class="material-symbols-outlined text-blue-500 text-lg">picture_as_pdf</span></div>
