    </a>
    <a href="#" class="hub-doc-link">
      <div class="w-9 h-9 bg-blue-50 rounded-lg flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-blue-400" style="font-size:18px">picture_as_pdf</span></div>
      <div class="flex-1 min-w-0"><p class="font-semibold text-sm text-slate-800">Teknik Şartname</p><p class="text-xs text-slate-400">PDF · 3.8 MB</p></div>
      <span class="material-symbols-outlined text-slate-300" style="font-size:18px">download</span>
