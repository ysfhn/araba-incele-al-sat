<script>
// Sidebar scroll spy
document.addEventListener('DOMContentLoaded', () => {
  const links = document.querySelectorAll('.sidebar-link');
  const sections = [];
  links.forEach(link => {
    const id = link.getAttribute('href').substring(1);
    const el = document.getElementById(id);
    if (el) sections.push({ id, el, link });
  });
  function updateActive() {
    let current = sections[0];
    for (const s of sections) {
      if (s.el.getBoundingClientRect().top <= 120) current = s;
    }
    links.forEach(l => { l.className = l.className.replace('bg-primary/10 text-primary font-bold', 'text-slate-600 hover:bg-slate-100 font-medium'); });
    if (current) current.link.className = current.link.className.replace('text-slate-600 hover:bg-slate-100 font-medium', 'bg-primary/10 text-primary font-bold');
  }
  window.addEventListener('scroll', updateActive);
  updateActive();
});
</script>
