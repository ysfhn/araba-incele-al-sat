<!-- ═══════════════ JAVASCRIPT ═══════════════ -->
<script>
(function(){
  // Auto scroll mesaj container
  var mc = document.getElementById('msgContainer');
  if (mc) mc.scrollTop = mc.scrollHeight;

  // ── Randevu İptal ──
  document.querySelectorAll('[data-cancel-appointment]').forEach(function(btn){
    btn.addEventListener('click', async function(){
      if (!confirm('Randevuyu iptal etmek istiyor musunuz?')) return;
      btn.disabled = true; btn.textContent = '...';
      try {
        var res = await fetch('/api/appointments/' + btn.dataset.cancelAppointment + '/cancel', { method:'PATCH' });
        if (res.ok) location.reload(); else { alert('Hata oluştu'); btn.disabled = false; }
      } catch(e) { alert('Bağlantı hatası'); btn.disabled = false; }
    });
  });

  // ── Favori Çıkar ──
  document.querySelectorAll('[data-remove-favorite]').forEach(function(btn){
    btn.addEventListener('click', async function(){
      if (!confirm('Favoriden çıkarmak istiyor musunuz?')) return;
      btn.disabled = true;
      try {
        var res = await fetch('/api/favorites/' + btn.dataset.removeFavorite, { method:'DELETE' });
        if (res.ok) location.reload(); else { alert('Hata oluştu'); btn.disabled = false; }
      } catch(e) { alert('Bağlantı hatası'); btn.disabled = false; }
    });
  });

  // ── İlan Sil ──
  document.querySelectorAll('[data-delete-listing]').forEach(function(btn){
    btn.addEventListener('click', async function(){
      if (!confirm('Bu ilanı silmek istediğinize emin misiniz?')) return;
      btn.disabled = true;
      try {
        var res = await fetch('/api/listings/' + btn.dataset.deleteListing, { method:'DELETE' });
        if (res.ok) location.reload(); else { alert('İlan silinemedi'); btn.disabled = false; }
      } catch(e) { alert('Bağlantı hatası'); btn.disabled = false; }
    });
  });

  // ── Bildirim Okundu İşaretle ──
  document.querySelectorAll('[data-mark-read]').forEach(function(btn){
    btn.addEventListener('click', async function(){
      btn.disabled = true;
      try {
        var res = await fetch('/api/notification/' + btn.dataset.markRead + '/read', { method:'POST' });
        if (res.ok) {
          var row = document.querySelector('[data-notification-id="' + btn.dataset.markRead + '"]');
          if (row) { row.style.background = 'transparent'; }
          btn.remove();
        } else { btn.disabled = false; }
      } catch(e) { btn.disabled = false; }
    });
  });

  // ── Tümünü Okundu İşaretle ──
  var markAllBtn = document.getElementById('markAllRead');
  if (markAllBtn) {
    markAllBtn.addEventListener('click', async function(){
      markAllBtn.disabled = true; markAllBtn.textContent = '...';
      try {
        var res = await fetch('/api/notifications/read-all', { method:'POST' });
        if (res.ok) location.reload(); else { markAllBtn.disabled = false; markAllBtn.textContent = 'Tümünü Okundu İşaretle'; }
      } catch(e) { markAllBtn.disabled = false; }
    });
  }
})();
</script>
