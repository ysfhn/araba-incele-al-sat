<%
  const currentPage = typeof userPage !== 'undefined' ? userPage : 'dashboard';
  const data = typeof userData !== 'undefined' ? userData : {};
  function formatPrice(p) { return new Intl.NumberFormat('tr-TR').format(p) + ' ₺'; }
  function timeAgo(d) {
    const s = Math.floor((Date.now() - new Date(d).getTime()) / 1000);
    if (s < 60) return 'az önce';
    if (s < 3600) return Math.floor(s / 60) + ' dk önce';
    if (s < 86400) return Math.floor(s / 3600) + ' saat önce';
    return Math.floor(s / 86400) + ' gün önce';
  }
  const menuItems = [
    { key: 'dashboard', label: 'Dashboard', icon: 'dashboard', href: '/kullanici/panel' },
    { key: 'ilanlarim', label: 'İlanlarım', icon: 'directions_car', href: '/kullanici/ilanlarim' },
    { key: 'favorilerim', label: 'Favorilerim', icon: 'favorite', href: '/kullanici/favorilerim' },
    { key: 'mesajlar', label: 'Mesajlar', icon: 'mail', href: '/kullanici/mesajlar' },
    { key: 'randevular', label: 'Randevular', icon: 'calendar_month', href: '/kullanici/randevular' },
    { key: 'bildirimler', label: 'Bildirimler', icon: 'notifications', href: '/kullanici/bildirimler' },
    { key: 'profil', label: 'Profil', icon: 'person', href: '/kullanici/profil' },
  ];
%>

<style>
  .up-layout { display:flex; min-height:calc(100vh - 70px); background:#f8fafc; }

  /* ── SIDEBAR ── */
  .up-sidebar {
    width:240px; background:linear-gradient(180deg,#0f172a 0%,#1e293b 100%); color:#fff;
    padding:1.25rem 0; flex-shrink:0; position:sticky; top:56px; height:calc(100vh - 56px); overflow-y:auto;
  }
  .up-sidebar .sidebar-brand { padding:0 1.25rem 1.25rem; border-bottom:1px solid rgba(255,255,255,.1); margin-bottom:.75rem; }
  .up-sidebar .sidebar-brand h3 { font-size:1rem; margin:0; font-weight:700; }
  .up-sidebar .sidebar-brand small { color:rgba(255,255,255,.5); font-size:.72rem; display:block; margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .up-menu { list-style:none; padding:0; margin:0; }
  .up-menu li a {
    display:flex; align-items:center; gap:.6rem; padding:.65rem 1.25rem; color:rgba(255,255,255,.65);
    text-decoration:none; font-size:.82rem; transition:all .15s; border-left:3px solid transparent;
  }
  .up-menu li a:hover { background:rgba(255,255,255,.07); color:#fff; }
  .up-menu li a.active { background:rgba(255,255,255,.1); color:#fff; border-left-color:#3b82f6; font-weight:600; }
  .up-menu li a .material-symbols-outlined { font-size:1.15rem; opacity:.75; }
  .up-menu li a .badge-cnt { margin-left:auto; background:#ef4444; color:#fff; font-size:.6rem; padding:2px 6px; border-radius:10px; font-weight:700; }

  /* ── CONTENT ── */
  .up-content { flex:1; padding:1.5rem; min-width:0; }
  .up-header { margin-bottom:1.25rem; }
  .up-header h1 { font-size:1.25rem; font-weight:700; color:#0f172a; margin:0; }

  /* ── STAT CARDS ── */
  .up-stats { display:grid; grid-template-columns:repeat(2,1fr); gap:.75rem; margin-bottom:1.25rem; }
  .up-stat {
    background:#fff; border-radius:14px; padding:1rem; border:1px solid #e2e8f0;
    display:flex; align-items:center; gap:.75rem;
  }
  .up-stat .icon { width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .up-stat .icon .material-symbols-outlined { font-size:1.15rem; }
  .up-stat .icon.blue { background:#dbeafe; color:#2563eb; }
  .up-stat .icon.red { background:#fee2e2; color:#dc2626; }
  .up-stat .icon.green { background:#dcfce7; color:#16a34a; }
  .up-stat .icon.orange { background:#ffedd5; color:#ea580c; }
  .up-stat .icon.purple { background:#f3e8ff; color:#9333ea; }
  .up-stat .info { min-width:0; }
  .up-stat .info h3 { font-size:1.25rem; margin:0; font-weight:700; color:#0f172a; }
  .up-stat .info p { margin:0; font-size:.72rem; color:#64748b; }

  /* ── CARD ── */
  .up-card { background:#fff; border-radius:14px; padding:1.25rem; border:1px solid #e2e8f0; margin-bottom:1rem; }
  .up-card-h { display:flex; justify-content:space-between; align-items:center; margin-bottom:.75rem; flex-wrap:wrap; gap:.5rem; }
  .up-card-h h2 { font-size:1rem; font-weight:700; color:#0f172a; margin:0; }

  /* ── TABLE ── */
  .up-table { width:100%; border-collapse:collapse; font-size:.8rem; }
  .up-table th { background:#f8fafc; padding:.6rem; text-align:left; font-weight:600; color:#64748b; border-bottom:2px solid #e2e8f0; white-space:nowrap; }
  .up-table td { padding:.6rem; border-bottom:1px solid #f1f5f9; vertical-align:middle; }
  .up-table tr:hover { background:#f8fafc; }

  /* ── BADGE ── */
  .up-badge { display:inline-block; padding:2px 8px; border-radius:10px; font-size:.65rem; font-weight:700; }
  .up-badge.success { background:#dcfce7; color:#16a34a; }
  .up-badge.warning { background:#fef3c7; color:#d97706; }
  .up-badge.danger { background:#fee2e2; color:#dc2626; }
  .up-badge.info { background:#dbeafe; color:#2563eb; }
  .up-badge.secondary { background:#f1f5f9; color:#64748b; }

  /* ── BUTTON ── */
  .up-btn {
    padding:6px 12px; font-size:.78rem; border:none; border-radius:8px; cursor:pointer;
    font-weight:600; transition:all .15s; display:inline-flex; align-items:center; gap:4px; text-decoration:none;
  }
  .up-btn.primary { background:#2563eb; color:#fff; }
  .up-btn.primary:hover { background:#1d4ed8; }
  .up-btn.danger { background:#dc2626; color:#fff; }
  .up-btn.danger:hover { background:#b91c1c; }
  .up-btn.outline { background:transparent; border:1px solid #e2e8f0; color:#64748b; }
  .up-btn.outline:hover { background:#f8fafc; }
  .up-btn.success { background:#16a34a; color:#fff; }
  .up-btn.sm { padding:4px 8px; font-size:.7rem; }

  /* ── FORM ── */
  .up-form label { display:block; font-size:.78rem; font-weight:600; color:#475569; margin-bottom:4px; }
  .up-form input, .up-form select, .up-form textarea {
    width:100%; padding:9px 12px; border:1px solid #e2e8f0; border-radius:10px; font-size:.85rem; box-sizing:border-box;
    transition:border-color .2s, box-shadow .2s;
  }
  .up-form input:focus, .up-form select:focus, .up-form textarea:focus { outline:none; border-color:#3b82f6; box-shadow:0 0 0 3px rgba(59,130,246,.15); }
  .up-form .form-group { margin-bottom:.85rem; }
  .up-form textarea { min-height:70px; resize:vertical; }

  /* ── MISC ── */
  .up-empty { text-align:center; padding:2rem 1rem; color:#94a3b8; }
  .up-empty .material-symbols-outlined { font-size:2.5rem; margin-bottom:.35rem; display:block; }
  .up-empty p { margin:0; font-size:.85rem; }

  .msg-bubble { max-width:80%; padding:.65rem .9rem; border-radius:14px; font-size:.85rem; line-height:1.45; word-break:break-word; }
  .msg-bubble.sent { background:#2563eb; color:#fff; border-bottom-right-radius:4px; margin-left:auto; }
  .msg-bubble.received { background:#f1f5f9; color:#1e293b; border-bottom-left-radius:4px; }

  .up-grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
  .up-grid-main { display:grid; grid-template-columns:1.6fr 1fr; gap:1rem; }

  /* ── MOBILE CARDS (tablo yerine) ── */
  .up-mcard { display:none; }

  /* ═══════ RESPONSIVE ═══════ */
  @media (min-width:640px) {
    .up-stats { grid-template-columns:repeat(3,1fr); }
  }
  @media (min-width:1024px) {
    .up-stats:not([style*="grid-template"]) { grid-template-columns:repeat(4,1fr); }
  }
  @media (min-width:1024px) {
    .up-content { padding:2rem; }
    .up-stat .icon { width:46px; height:46px; }
    .up-stat .info h3 { font-size:1.4rem; }
  }

  @media (max-width:768px) {
    .up-layout { flex-direction:column; }
    .up-sidebar { width:100%; height:auto; position:static; padding:.75rem 0; }
    .up-sidebar .sidebar-brand { display:none; }
    .up-menu { display:flex; overflow-x:auto; gap:0; padding:0 .5rem; -webkit-overflow-scrolling:touch; }
    .up-menu::-webkit-scrollbar { display:none; }
    .up-menu { -ms-overflow-style:none; scrollbar-width:none; }
    .up-menu li a { padding:.5rem .75rem; white-space:nowrap; border-left:none; border-bottom:3px solid transparent; font-size:.72rem; flex-direction:column; gap:2px; text-align:center; }
    .up-menu li a .material-symbols-outlined { font-size:1rem; }
    .up-menu li a.active { border-bottom-color:#3b82f6; border-left:none; }
    .up-menu li a .badge-cnt { position:absolute; top:-2px; right:-4px; margin:0; }
    .up-menu li { position:relative; }
    .up-content { padding:.75rem; }
    .up-header h1 { font-size:1.1rem; }
    .up-grid-2, .up-grid-main { grid-template-columns:1fr; }
    .up-form .form-row { grid-template-columns:1fr; }
    /* Mobilde tablo gizle, kartları göster */
    .up-table-wrap { display:none; }
    .up-mcard { display:block; }
  }
</style>

<div class="up-layout">
  <!-- ═══════ SIDEBAR ═══════ -->
  <aside class="up-sidebar">
    <div class="sidebar-brand">
      <div style="display:flex;align-items:center;gap:.65rem;">
        <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#6366f1);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:.95rem;flex-shrink:0;"><%= userProfile.name.charAt(0).toUpperCase() %></div>
        <div style="min-width:0;">
          <h3 style="font-size:.95rem;">Hesabım</h3>
          <small><%= userProfile.name %></small>
        </div>
      </div>
    </div>
    <ul class="up-menu">
      <% menuItems.forEach(item => { %>
      <li>
        <a href="<%= item.href %>" class="<%= currentPage === item.key || (currentPage === 'mesaj-detay' && item.key === 'mesajlar') ? 'active' : '' %>">
          <span class="material-symbols-outlined"><%= item.icon %></span>
          <span><%= item.label %></span>
          <% if (item.key === 'mesajlar' && typeof stats !== 'undefined' && stats.unreadMessages > 0) { %>
            <span class="badge-cnt"><%= stats.unreadMessages %></span>
          <% } %>
        </a>
      </li>
      <% }) %>
    </ul>
  </aside>

  <!-- ═══════ MAIN CONTENT ═══════ -->
  <main class="up-content">


<!-- ╔══════════════════════════════════════╗
     ║           DASHBOARD                  ║
     ╚══════════════════════════════════════╝ -->
<% if (currentPage === 'dashboard') { %>
  <div class="up-header"><h1>📊 Dashboard</h1></div>

  <div class="up-stats" style="grid-template-columns:repeat(3,1fr);">
    <div class="up-stat"><div class="icon blue"><span class="material-symbols-outlined">directions_car</span></div><div class="info"><h3><%= stats.activeListings %></h3><p>Aktif İlan</p></div></div>
    <div class="up-stat"><div class="icon orange"><span class="material-symbols-outlined">list</span></div><div class="info"><h3><%= stats.totalListings %></h3><p>Toplam İlan</p></div></div>
    <div class="up-stat"><div class="icon red"><span class="material-symbols-outlined">favorite</span></div><div class="info"><h3><%= stats.favorites %></h3><p>Favori</p></div></div>
    <div class="up-stat"><div class="icon green"><span class="material-symbols-outlined">mail</span></div><div class="info"><h3><%= stats.unreadMessages %></h3><p>Okunmamış Mesaj</p></div></div>
    <div class="up-stat"><div class="icon purple"><span class="material-symbols-outlined">forum</span></div><div class="info"><h3><%= stats.forumReplies %></h3><p>Forum Yanıtı</p></div></div>
    <div class="up-stat"><div class="icon" style="background:#e0f2fe;color:#0284c7;"><span class="material-symbols-outlined">visibility</span></div><div class="info"><h3><%= stats.totalViews %></h3><p>Toplam Görüntülenme</p></div></div>
  </div>

  <div class="up-grid-main">
    <!-- Sol: İlanlar + Favoriler -->
    <div>
      <div class="up-card">
        <div class="up-card-h">
          <h2>🚗 Son İlanlarım</h2>
          <a href="/ilan/ver" class="up-btn primary sm"><span class="material-symbols-outlined" style="font-size:.9rem">add</span> Yeni İlan</a>
        </div>
        <% if (recentListings.length === 0) { %>
          <div class="up-empty"><span class="material-symbols-outlined">directions_car</span><p>Henüz ilanınız yok</p></div>
        <% } else { %>
          <% recentListings.forEach(l => { %>
          <a href="/ilan/<%= l.slug %>" style="display:flex;align-items:center;gap:.75rem;padding:.6rem;border-radius:10px;text-decoration:none;color:inherit;transition:background .15s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='transparent'">
            <div style="width:56px;height:40px;background:#f1f5f9;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;">
              <% if (l.image) { %>
                <img src="<%= l.image %>" alt="" style="width:100%;height:100%;object-fit:cover;">
              <% } else { %>
                <span class="material-symbols-outlined" style="color:#cbd5e1;font-size:1.3rem;">directions_car</span>
              <% } %>
            </div>
            <div style="flex:1;min-width:0;">
              <p style="font-weight:600;font-size:.82rem;color:#0f172a;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= l.brand_name %> <%= l.model_name %></p>
              <p style="font-weight:700;font-size:.8rem;color:#2563eb;margin:2px 0 0;"><%= formatPrice(l.price) %></p>
            </div>
            <span class="up-badge <%= l.status==='active'?'success':l.status==='pending'?'warning':'secondary' %>"><%= l.status==='active'?'Aktif':l.status==='pending'?'Beklemede':l.status==='sold'?'Satıldı':'Taslak' %></span>
          </a>
          <% }) %>
          <a href="/kullanici/ilanlarim" style="display:block;text-align:center;font-size:.78rem;color:#2563eb;font-weight:600;padding:.5rem;text-decoration:none;">Tüm İlanları Gör →</a>
        <% } %>
      </div>

      <div class="up-card">
        <div class="up-card-h"><h2>❤️ Favorilerim</h2><a href="/kullanici/favorilerim" class="up-btn outline sm">Tümünü Gör</a></div>
        <% if (recentFavorites.length === 0) { %>
          <div class="up-empty" style="padding:1.5rem;"><span class="material-symbols-outlined">favorite_border</span><p>Favori ilanınız yok</p></div>
        <% } else { %>
          <% recentFavorites.forEach(l => { %>
          <a href="/ilan/<%= l.slug %>" style="display:flex;align-items:center;gap:.75rem;padding:.6rem;border-radius:10px;text-decoration:none;color:inherit;transition:background .15s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='transparent'">
            <div style="width:56px;height:40px;background:#f1f5f9;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;">
              <% if (l.image) { %>
                <img src="<%= l.image %>" alt="" style="width:100%;height:100%;object-fit:cover;">
              <% } else { %>
                <span class="material-symbols-outlined" style="color:#cbd5e1;font-size:1.3rem;">directions_car</span>
              <% } %>
            </div>
            <div style="flex:1;min-width:0;">
              <p style="font-weight:600;font-size:.82rem;color:#0f172a;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= l.brand_name %> <%= l.model_name %></p>
              <p style="font-weight:700;font-size:.8rem;color:#2563eb;margin:2px 0 0;"><%= formatPrice(l.price) %></p>
            </div>
          </a>
          <% }) %>
        <% } %>
      </div>
    </div>

    <!-- Sağ: Mesajlar + Bildirimler + Forum -->
    <div>
      <div class="up-card">
        <div class="up-card-h"><h2>✉️ Mesajlar</h2><a href="/kullanici/mesajlar" class="up-btn outline sm">Tümü</a></div>
        <% if (messages.length === 0) { %>
          <div class="up-empty" style="padding:1.25rem;"><span class="material-symbols-outlined">mail</span><p>Mesaj yok</p></div>
        <% } else { %>
          <% messages.slice(0,4).forEach(m => { %>
          <div style="display:flex;align-items:start;gap:.6rem;padding:.45rem 0;border-bottom:1px solid #f1f5f9;">
            <div style="width:30px;height:30px;border-radius:50%;background:#dbeafe;display:flex;align-items:center;justify-content:center;color:#2563eb;font-weight:700;font-size:.7rem;flex-shrink:0;"><%= m.sender_name.charAt(0).toUpperCase() %></div>
            <div style="min-width:0;flex:1;">
              <p style="font-weight:600;font-size:.75rem;color:#0f172a;margin:0;"><%= m.sender_name %></p>
              <p style="font-size:.7rem;color:#64748b;margin:1px 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= m.content %></p>
              <p style="font-size:.6rem;color:#94a3b8;margin:0;"><%= timeAgo(m.created_at) %></p>
            </div>
          </div>
          <% }) %>
        <% } %>
      </div>

      <div class="up-card">
        <div class="up-card-h"><h2>🔔 Bildirimler</h2><a href="/kullanici/bildirimler" class="up-btn outline sm">Tümü</a></div>
        <% if (notifications.length === 0) { %>
          <div class="up-empty" style="padding:1.25rem;"><span class="material-symbols-outlined">notifications</span><p>Bildirim yok</p></div>
        <% } else { %>
          <% notifications.slice(0,3).forEach(n => { %>
          <div style="display:flex;align-items:start;gap:.5rem;padding:.45rem 0;border-bottom:1px solid #f1f5f9;<%= n.is_read?'':'background:#fefce8;border-radius:6px;padding:.45rem .5rem;' %>">
            <span class="material-symbols-outlined" style="font-size:1rem;color:#3b82f6;margin-top:1px;">notifications</span>
            <div style="min-width:0;flex:1;">
              <p style="font-size:.75rem;color:#1e293b;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= n.message %></p>
              <p style="font-size:.6rem;color:#94a3b8;margin:1px 0 0;"><%= timeAgo(n.created_at) %></p>
            </div>
          </div>
          <% }) %>
        <% } %>
      </div>

      <div class="up-card">
        <div class="up-card-h"><h2>💬 Forum</h2></div>
        <% if (forumActivity.length === 0) { %>
          <div class="up-empty" style="padding:1.25rem;"><span class="material-symbols-outlined">forum</span><p>Aktivite yok</p></div>
        <% } else { %>
          <% forumActivity.forEach(fa => { %>
          <a href="/forum/konu/<%= fa.topic_slug %>" style="display:block;padding:.4rem 0;border-bottom:1px solid #f1f5f9;text-decoration:none;">
            <p style="font-size:.75rem;font-weight:600;color:#2563eb;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= fa.topic_title %></p>
            <p style="font-size:.68rem;color:#64748b;margin:1px 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= fa.content %></p>
            <p style="font-size:.6rem;color:#94a3b8;margin:0;"><%= timeAgo(fa.created_at) %></p>
          </a>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>


<!-- ╔══════════════════════════════════════╗
     ║           İLANLARIM                  ║
     ╚══════════════════════════════════════╝ -->
<% } else if (currentPage === 'ilanlarim') { %>
  <div class="up-header"><h1>🚗 İlanlarım</h1></div>

  <div class="up-stats">
    <div class="up-stat"><div class="icon blue"><span class="material-symbols-outlined">list</span></div><div class="info"><h3><%= data.statusCounts?.all || 0 %></h3><p>Toplam</p></div></div>
    <div class="up-stat"><div class="icon green"><span class="material-symbols-outlined">check_circle</span></div><div class="info"><h3><%= data.statusCounts?.active || 0 %></h3><p>Aktif</p></div></div>
    <div class="up-stat"><div class="icon orange"><span class="material-symbols-outlined">pending</span></div><div class="info"><h3><%= data.statusCounts?.pending || 0 %></h3><p>Beklemede</p></div></div>
    <div class="up-stat"><div class="icon purple"><span class="material-symbols-outlined">sell</span></div><div class="info"><h3><%= data.statusCounts?.sold || 0 %></h3><p>Satıldı</p></div></div>
  </div>

  <div class="up-card">
    <div class="up-card-h">
      <div style="display:flex;gap:.35rem;flex-wrap:wrap;">
        <a href="/kullanici/ilanlarim" class="up-btn <%= !data.filters?.durum ? 'primary' : 'outline' %> sm">Tümü</a>
        <a href="/kullanici/ilanlarim?durum=active" class="up-btn <%= data.filters?.durum==='active' ? 'primary' : 'outline' %> sm">Aktif</a>
        <a href="/kullanici/ilanlarim?durum=pending" class="up-btn <%= data.filters?.durum==='pending' ? 'primary' : 'outline' %> sm">Beklemede</a>
        <a href="/kullanici/ilanlarim?durum=sold" class="up-btn <%= data.filters?.durum==='sold' ? 'primary' : 'outline' %> sm">Satıldı</a>
      </div>
      <a href="/ilan/ver" class="up-btn primary sm"><span class="material-symbols-outlined" style="font-size:.9rem">add</span> Yeni İlan</a>
    </div>

    <% if ((data.listings || []).length === 0) { %>
      <div class="up-empty"><span class="material-symbols-outlined">directions_car</span><p>İlan bulunamadı</p></div>
    <% } else { %>
      <!-- Desktop tablo -->
      <div class="up-table-wrap" style="overflow-x:auto;">
        <table class="up-table">
          <thead><tr><th>İlan</th><th>Fiyat</th><th>Durum</th><th>Görüntülenme</th><th>Tarih</th><th>İşlemler</th></tr></thead>
