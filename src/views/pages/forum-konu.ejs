<%
function timeAgo(d) { const s=Math.floor((Date.now()-new Date(d))/1000); if(s<60) return 'az önce'; if(s<3600) return Math.floor(s/60)+' dk önce'; if(s<86400) return Math.floor(s/3600)+' saat önce'; return Math.floor(s/86400)+' gün önce'; }
%>
<main class="container mx-auto px-6 py-8">
<!-- Breadcrumb -->
<div class="flex items-center text-sm text-slate-500 mb-6 gap-1">
<a href="/" class="hover:text-primary">Ana Sayfa</a><span>/</span>
<a href="/forum" class="hover:text-primary">Forum</a><span>/</span>
<span class="text-slate-800 font-medium truncate"><%= topic.title %></span>
</div>

<div class="flex flex-col lg:flex-row gap-8">
<!-- Sol: Konu & Yanıtlar -->
<div class="flex-1">
<!-- Konu Başlığı -->
<div class="bg-white rounded-2xl border border-slate-100 p-6 mb-6">
<div class="flex items-center gap-2 mb-3">
<span class="text-xs px-2 py-0.5 rounded-full font-bold bg-primary/10 text-primary"><%= topic.category_name %></span>
<% if (topic.is_pinned) { %><span class="bg-yellow-100 text-yellow-700 text-[10px] px-2 py-0.5 rounded-full font-bold">SABİT</span><% } %>
<% if (topic.is_locked) { %><span class="bg-red-100 text-red-700 text-[10px] px-2 py-0.5 rounded-full font-bold">KİLİTLİ</span><% } %>
</div>
<h1 class="text-2xl font-bold text-slate-900"><%= topic.title %></h1>
<div class="flex items-center gap-4 mt-4">
<div class="flex items-center gap-2">
<div class="size-10 bg-primary/10 rounded-full flex items-center justify-center text-primary font-bold"><%= topic.author_name.charAt(0).toUpperCase() %></div>
<div>
<p class="font-semibold text-sm text-slate-800"><%= topic.author_name %></p>
<p class="text-xs text-slate-400"><%= topic.author_role === 'admin' ? 'Yönetici' : 'Üye' %> • <%= new Date(topic.created_at).toLocaleDateString('tr-TR') %></p>
</div>
</div>
<div class="ml-auto flex gap-4 text-xs text-slate-400">
<span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">visibility</span> <%= topic.view_count %></span>
<span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">chat_bubble</span> <%= topic.reply_count %></span>
</div>
</div>
<div class="mt-6 text-slate-700 leading-relaxed whitespace-pre-line"><%= topic.content %></div>
</div>

<!-- Yanıtlar -->
<h2 class="text-lg font-bold text-slate-900 mb-4"><%= replies.length %> Yanıt</h2>
<div class="space-y-4 mb-8">
<% replies.forEach(r => { %>
<div class="bg-white rounded-xl border border-slate-100 p-5" id="reply-<%= r.id %>">
<div class="flex items-center gap-3 mb-3">
<div class="size-9 bg-slate-100 rounded-full flex items-center justify-center text-slate-600 font-bold text-sm"><%= r.author_name.charAt(0).toUpperCase() %></div>
<div>
<p class="font-semibold text-sm text-slate-800"><%= r.author_name %></p>
<p class="text-xs text-slate-400"><%= timeAgo(r.created_at) %></p>
</div>
<% if (r.is_solution) { %>
<span class="ml-auto bg-green-100 text-green-700 text-[10px] px-2 py-0.5 rounded-full font-bold flex items-center gap-1"><span class="material-symbols-outlined text-xs">check_circle</span> ÇÖZÜM</span>
<% } %>
</div>
<div class="text-slate-700 text-sm leading-relaxed whitespace-pre-line"><%= r.content %></div>
<div class="flex items-center gap-4 mt-4 pt-3 border-t border-slate-50">
<button data-like-reply="<%= r.id %>" class="flex items-center gap-1 text-xs font-semibold transition-colors <%= (userLikes || []).includes(r.id) ? 'text-primary' : 'text-slate-400 hover:text-primary' %>">
<span class="material-symbols-outlined text-sm"><%= (userLikes || []).includes(r.id) ? 'thumb_up' : 'thumb_up_off_alt' %></span> <%= r.like_count %>
</button>
</div>
</div>
<% }) %>
</div>

<!-- Yanıt Formu -->
<% if (topic.is_locked) { %>
<div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 text-center text-sm text-yellow-700">
<span class="material-symbols-outlined text-base align-middle">lock</span> Bu konu kilitlenmiş, yeni yanıt yazılamaz.
</div>
<% } else if (typeof currentUser !== 'undefined' && currentUser) { %>
<div class="bg-white rounded-2xl border border-slate-100 p-6">
<h3 class="font-bold text-slate-900 mb-4">Yanıt Yaz</h3>
<form action="/forum/konu/<%= topic.slug %>/yanit" method="POST">
<textarea name="content" rows="4" required minlength="10" placeholder="Yanıtınızı yazın (en az 10 karakter)..." class="w-full rounded-xl border-slate-200 focus:border-primary focus:ring-primary mb-4"></textarea>
<button type="submit" class="bg-primary text-white font-bold py-3 px-8 rounded-xl hover:bg-primary/90 transition-all flex items-center gap-2">
<span class="material-symbols-outlined">send</span> Yanıtla
</button>
</form>
</div>
<% } else { %>
<div class="bg-slate-50 rounded-2xl p-6 text-center">
<p class="text-slate-600 mb-3">Yanıt yazmak için giriş yapmalısınız.</p>
<a href="/giris" class="inline-block bg-primary text-white font-bold py-3 px-8 rounded-xl hover:bg-primary/90 transition-all">Giriş Yap</a>
</div>
<% } %>
</div>

<!-- Sağ: İlgili Konular -->
<aside class="lg:w-72 shrink-0">
<div class="bg-white rounded-2xl border border-slate-100 p-6 sticky top-28">
<h3 class="font-bold text-slate-900 mb-4">İlgili Konular</h3>
<div class="space-y-3">
<% (relatedTopics || []).forEach(rt => { %>
<a href="/forum/konu/<%= rt.slug %>" class="block p-2 rounded-lg hover:bg-slate-50 transition-colors">
<p class="text-sm font-semibold text-slate-800 leading-tight"><%= rt.title %></p>
<p class="text-xs text-slate-400 mt-1"><%= rt.author_name %> • <%= rt.reply_count %> yanıt</p>
</a>
<% }) %>
<% if (!relatedTopics || relatedTopics.length === 0) { %>
<p class="text-sm text-slate-400">İlgili konu bulunamadı.</p>
<% } %>
</div>
</div>
</aside>
</div>
</main>
