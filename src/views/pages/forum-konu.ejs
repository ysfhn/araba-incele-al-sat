/* ═══ YANIT FORMU ═══ */
.fk-reply-form { background:white; border:1px solid #e2e8f0; border-radius:20px; overflow:hidden; }
.fk-reply-textarea {
  width:100%; border:none; padding:20px 24px; font-size:14px; line-height:1.7;
  resize:vertical; min-height:120px; outline:none; background:transparent;
}
.fk-reply-textarea:focus { background:#fafbff; }
.fk-reply-footer { padding:16px 24px; border-top:1px solid #f1f5f9; background:#f8fafc; display:flex; align-items:center; justify-content:space-between; }
.fk-reply-submit {
  display:inline-flex; align-items:center; gap:8px; background:linear-gradient(135deg,#6366f1,#4f46e5);
  color:white; font-weight:700; font-size:14px; padding:12px 28px; border-radius:14px;
  transition:all .2s; box-shadow:0 4px 15px -3px rgba(99,102,241,0.4); border:none; cursor:pointer;
}
.fk-reply-submit:hover { transform:translateY(-1px); box-shadow:0 8px 25px -5px rgba(99,102,241,0.5); }

/* ═══ SIDEBAR ═══ */
.fk-sidebar-card { background:white; border:1px solid #e2e8f0; border-radius:16px; overflow:hidden; }
.fk-sidebar-header { padding:16px 20px; border-bottom:1px solid #f1f5f9; background:linear-gradient(135deg,#f8fafc,white); }
.fk-related-item { display:block; padding:12px 16px; border-bottom:1px solid #f8fafc; text-decoration:none; transition:background .15s; }
.fk-related-item:hover { background:#f8fafc; }
.fk-related-item:last-child { border-bottom:none; }

/* ═══ REPORT BUTTON ═══ */
.report-btn:hover { color:#ef4444 !important; background:#fef2f2 !important; }

/* ═══ RESPONSIVE ═══ */
@media (max-width: 639px) {
  .fk-topic-card .fk-topic-header, .fk-topic-card .fk-topic-body { padding:16px; }
  .fk-reply-card .p-5 { padding:14px; }
  .fk-reply-textarea { padding:14px 16px; }
  .fk-reply-footer { padding:12px 16px; flex-wrap:wrap; gap:10px; }
  .fk-reply-submit { padding:10px 20px; font-size:13px; }
  .fk-author-avatar { width:38px; height:38px; font-size:15px; }
  .fk-reply-avatar { width:34px; height:34px; font-size:13px; }
  .fk-sidebar-header { padding:12px 16px; }
  .fk-related-item { padding:10px 14px; }
}
</style>

<!-- ═══════ HERO ═══════ -->
<div class="fk-hero py-6 sm:py-8 lg:py-10">
  <div class="fk-hero-glow"></div>
  <div class="container mx-auto px-4 sm:px-6 relative z-10">
    <!-- Breadcrumb -->
    <div class="flex items-center text-xs sm:text-sm text-white/40 mb-5 gap-1 sm:gap-1.5 flex-wrap">
      <a href="/" class="hover:text-white/70 transition-colors">Ana Sayfa</a>
      <span class="material-symbols-outlined text-xs">chevron_right</span>
      <a href="/forum" class="hover:text-white/70 transition-colors">Forum</a>
      <span class="material-symbols-outlined text-xs">chevron_right</span>
      <a href="/forum?kategori=<%= topic.category_slug %>" class="hover:text-white/70 transition-colors"><%= topic.category_name %></a>
      <span class="material-symbols-outlined text-xs">chevron_right</span>
      <span class="text-white/70 font-medium truncate max-w-xs"><%= topic.title %></span>
    </div>

    <!-- Badges -->
    <div class="flex items-center gap-2 flex-wrap mb-3">
      <% if (topic.is_pinned) { %>
      <span class="inline-flex items-center gap-1 bg-amber-400/20 text-amber-300 text-[11px] font-bold px-3 py-1 rounded-lg border border-amber-400/30">
        <span class="material-symbols-outlined" style="font-size:13px">push_pin</span> Sabit Konu
      </span>
      <% } %>
      <% if (topic.is_locked) { %>
      <span class="inline-flex items-center gap-1 bg-red-400/20 text-red-300 text-[11px] font-bold px-3 py-1 rounded-lg border border-red-400/30">
        <span class="material-symbols-outlined" style="font-size:13px">lock</span> Kilitli
      </span>
      <% } %>
      <span class="inline-flex items-center gap-1 bg-indigo-400/20 text-indigo-300 text-[11px] font-bold px-3 py-1 rounded-lg border border-indigo-400/30">
        <span class="material-symbols-outlined" style="font-size:13px">folder</span> <%= topic.category_name %>
      </span>
    </div>

    <!-- Başlık -->
    <h1 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-white tracking-tight leading-tight mb-4"><%= topic.title %></h1>

    <!-- Meta -->
    <div class="flex items-center gap-3 sm:gap-5 text-xs sm:text-sm text-white/40 flex-wrap">
      <span class="flex items-center gap-1.5">
        <span class="material-symbols-outlined text-base">person</span>
        <span class="text-white/70 font-medium"><%= topic.author_name %></span>
      </span>
      <span class="flex items-center gap-1.5">
        <span class="material-symbols-outlined text-base">schedule</span>
        <%= new Date(topic.created_at).toLocaleDateString('tr-TR', { day:'numeric', month:'long', year:'numeric' }) %>
      </span>
      <span class="flex items-center gap-1.5">
        <span class="material-symbols-outlined text-base">visibility</span> <%= topic.view_count %> görüntülenme
      </span>
      <span class="flex items-center gap-1.5">
        <span class="material-symbols-outlined text-base">chat_bubble</span> <%= topic.reply_count %> yanıt
      </span>
    </div>
  </div>
</div>

<div class="container mx-auto px-4 sm:px-6 py-6 sm:py-8">
  <div class="flex flex-col lg:flex-row gap-6 sm:gap-8">
    <!-- ═══════ SOL: KONU + YANITLAR ═══════ -->
    <div class="flex-1 min-w-0">

      <!-- Ana Konu İçeriği -->
      <div class="fk-topic-card mb-8">
        <div class="fk-topic-header">
          <div class="flex items-center gap-4">
            <div class="fk-author-avatar"><%= topic.author_name.charAt(0).toUpperCase() %></div>
            <div class="flex-1">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-bold text-slate-900"><%= topic.author_name %></span>
                <% const rc = roleColors[topic.author_role] || roleColors.bireysel; %>
                <span class="fk-role-badge" style="background:<%= rc.bg %>; color:<%= rc.text %>; border:1px solid <%= rc.border %>">
                  <%= roleLabels[topic.author_role] || 'Üye' %>
                </span>
              </div>
              <p class="text-xs text-slate-400 mt-0.5">
                Üyelik: <%= new Date(topic.author_since).toLocaleDateString('tr-TR', { month:'long', year:'numeric' }) %>
                • <%= new Date(topic.created_at).toLocaleDateString('tr-TR', { day:'numeric', month:'long', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
              </p>
            </div>
          </div>
        </div>
        <div class="fk-topic-body">
          <div class="text-slate-700 leading-relaxed whitespace-pre-line text-[15px]"><%= topic.content %></div>
          <div style="margin-top:16px;padding-top:12px;border-top:1px solid #f1f5f9;display:flex;justify-content:flex-end;">
            <button class="report-btn" data-report-type="forum_topic" data-report-id="<%= topic.id %>" style="display:flex;align-items:center;gap:4px;font-size:.8rem;color:#94a3b8;background:none;border:none;cursor:pointer;padding:4px 8px;border-radius:6px;transition:all .15s;" title="Bu konuyu raporla">
              <span class="material-symbols-outlined" style="font-size:16px;">flag</span> Raporla
            </button>
          </div>
        </div>
      </div>

      <!-- ═══ YANITLAR ═══ -->
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
          <span class="material-symbols-outlined text-indigo-500">forum</span> Yanıtlar
          <span class="text-xs bg-indigo-100 text-indigo-600 px-2.5 py-0.5 rounded-full font-bold"><%= replies.length %></span>
        </h2>
      </div>

      <% if (replies.length === 0) { %>
      <div class="bg-white rounded-2xl border border-slate-100 p-10 text-center mb-8">
        <span class="material-symbols-outlined text-4xl text-slate-200 mb-2">chat_bubble_outline</span>
        <p class="text-slate-500 font-medium">Henüz yanıt yok. İlk yanıtı siz yazın!</p>
      </div>
      <% } %>

      <div class="space-y-4 mb-8">
        <% replies.forEach((r, idx) => { %>
        <div class="fk-reply-card <%= r.is_solution ? 'solution' : '' %>" id="reply-<%= r.id %>">
          <% if (r.is_solution) { %>
          <div class="px-5 py-2 bg-green-50 border-b border-green-200 flex items-center gap-2">
            <span class="material-symbols-outlined text-green-600" style="font-size:16px">check_circle</span>
            <span class="text-xs font-bold text-green-700">✓ Bu yanıt çözüm olarak işaretlendi</span>
          </div>
          <% } %>
          <div class="p-5">
            <div class="flex items-start gap-4">
              <!-- Yanıt Numarası -->
              <div class="hidden sm:flex flex-col items-center gap-1">
                <span class="text-[10px] font-bold text-slate-400 bg-slate-100 rounded-full w-7 h-7 flex items-center justify-center">#<%= idx + 1 %></span>
              </div>

              <!-- Avatar -->
              <div class="fk-reply-avatar" style="background: linear-gradient(135deg, <%= r.is_solution ? '#22c55e' : '#e2e8f0' %>, <%= r.is_solution ? '#16a34a' : '#cbd5e1' %>); color: <%= r.is_solution ? 'white' : '#475569' %>">
                <%= r.author_name.charAt(0).toUpperCase() %>
              </div>

              <div class="flex-1 min-w-0">
                <!-- Yazar Bilgisi -->
                <div class="flex items-center gap-2 flex-wrap mb-2">
                  <span class="font-bold text-sm text-slate-900"><%= r.author_name %></span>
                  <% const rrc = roleColors[r.author_role] || roleColors.bireysel; %>
                  <span class="fk-role-badge" style="background:<%= rrc.bg %>; color:<%= rrc.text %>; border:1px solid <%= rrc.border %>">
                    <%= roleLabels[r.author_role] || 'Üye' %>
                  </span>
                  <span class="text-xs text-slate-400 ml-auto"><%= timeAgo(r.created_at) %></span>
                </div>

                <!-- İçerik -->
                <div class="text-slate-700 text-sm leading-relaxed whitespace-pre-line"><%= r.content %></div>

                <!-- Aksiyonlar -->
                <div class="flex items-center gap-2 mt-4 pt-3 border-t border-slate-100">
                  <button data-like-reply="<%= r.id %>" class="fk-reply-action <%= (userLikes || []).includes(r.id) ? 'liked' : 'text-slate-400' %>">
                    <span class="material-symbols-outlined" style="font-size:16px"><%= (userLikes || []).includes(r.id) ? 'thumb_up' : 'thumb_up_off_alt' %></span>
                    <span><%= r.like_count %></span>
                  </button>
                  <button class="report-btn fk-reply-action text-slate-400" data-report-type="forum_reply" data-report-id="<%= r.id %>" title="Bu yanıtı raporla" style="margin-left:auto;">
                    <span class="material-symbols-outlined" style="font-size:16px">flag</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>

      <!-- ═══ YANIT FORMU ═══ -->
      <% if (topic.is_locked) { %>
      <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 text-center">
        <span class="material-symbols-outlined text-3xl text-amber-400 mb-2">lock</span>
        <p class="text-sm font-semibold text-amber-700">Bu konu kilitlenmiş, yeni yanıt yazılamaz.</p>
      </div>
      <% } else if (typeof currentUser !== 'undefined' && currentUser) { %>
      <div class="fk-reply-form" id="reply-form">
        <div class="px-6 py-4 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white">
          <h3 class="font-bold text-slate-900 flex items-center gap-2">
            <span class="material-symbols-outlined text-indigo-500">reply</span> Yanıt Yaz
          </h3>
        </div>
        <form action="/forum/konu/<%= topic.slug %>/yanit" method="POST">
          <textarea name="content" required minlength="10" maxlength="5000" placeholder="Yanıtınızı yazın (en az 10 karakter)..." class="fk-reply-textarea"></textarea>
          <div class="fk-reply-footer">
            <p class="text-xs text-slate-400">Saygılı ve yapıcı olun.</p>
            <button type="submit" class="fk-reply-submit">
              <span class="material-symbols-outlined text-lg">send</span> Yanıtla
            </button>
          </div>
        </form>
      </div>
      <% } else { %>
      <div class="bg-gradient-to-r from-indigo-50 to-violet-50 border border-indigo-100 rounded-2xl p-8 text-center">
        <span class="material-symbols-outlined text-4xl text-indigo-300 mb-3">login</span>
        <p class="text-slate-700 font-semibold mb-1">Yanıt yazmak için giriş yapın</p>
        <p class="text-sm text-slate-500 mb-4">Topluluğa katılarak deneyimlerinizi paylaşın</p>
        <a href="/giris" class="inline-flex items-center gap-2 bg-indigo-600 text-white font-bold py-3 px-8 rounded-xl hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-500/20">
          <span class="material-symbols-outlined">login</span> Giriş Yap
        </a>
      </div>
      <% } %>
    </div>

    <!-- ═══════ SAĞ: SIDEBAR ═══════ -->
    <aside class="lg:w-80 shrink-0 space-y-5">

      <!-- Konu Bilgileri -->
      <div class="fk-sidebar-card">
        <div class="fk-sidebar-header">
          <h3 class="font-bold text-slate-900 flex items-center gap-2 text-sm">
            <span class="material-symbols-outlined text-lg text-indigo-500">info</span> Konu Bilgileri
          </h3>
        </div>
        <div class="p-4 space-y-3">
          <div class="flex items-center justify-between text-sm">
            <span class="text-slate-500 flex items-center gap-1.5"><span class="material-symbols-outlined" style="font-size:16px">visibility</span> Görüntülenme</span>
            <span class="font-bold text-slate-800"><%= topic.view_count %></span>
          </div>
          <div class="flex items-center justify-between text-sm">
            <span class="text-slate-500 flex items-center gap-1.5"><span class="material-symbols-outlined" style="font-size:16px">chat_bubble</span> Yanıt</span>
            <span class="font-bold text-slate-800"><%= topic.reply_count %></span>
          </div>
          <div class="flex items-center justify-between text-sm">
            <span class="text-slate-500 flex items-center gap-1.5"><span class="material-symbols-outlined" style="font-size:16px">calendar_today</span> Tarih</span>
            <span class="font-bold text-slate-800"><%= new Date(topic.created_at).toLocaleDateString('tr-TR') %></span>
          </div>
          <div class="flex items-center justify-between text-sm">
            <span class="text-slate-500 flex items-center gap-1.5"><span class="material-symbols-outlined" style="font-size:16px">folder</span> Kategori</span>
            <a href="/forum?kategori=<%= topic.category_slug %>" class="font-bold text-indigo-600 hover:text-indigo-700"><%= topic.category_name %></a>
          </div>
        </div>
      </div>

      <!-- İlgili Konular -->
      <div class="fk-sidebar-card">
        <div class="fk-sidebar-header">
          <h3 class="font-bold text-slate-900 flex items-center gap-2 text-sm">
            <span class="material-symbols-outlined text-lg text-amber-500">link</span> İlgili Konular
          </h3>
        </div>
        <div>
          <% if (relatedTopics && relatedTopics.length > 0) { %>
          <% relatedTopics.forEach(rt => { %>
          <a href="/forum/konu/<%= rt.slug %>" class="fk-related-item">
            <p class="text-sm font-semibold text-slate-800 leading-tight line-clamp-2 hover:text-indigo-600 transition-colors"><%= rt.title %></p>
            <div class="flex items-center gap-2 mt-1.5 text-[11px] text-slate-400">
              <span><%= rt.author_name %></span>
              <span>•</span>
              <span class="flex items-center gap-0.5"><span class="material-symbols-outlined" style="font-size:12px">chat_bubble</span> <%= rt.reply_count %></span>
            </div>
          </a>
          <% }) %>
          <% } else { %>
          <div class="p-4 text-center">
            <p class="text-sm text-slate-400">İlgili konu bulunamadı.</p>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Foruma Dön CTA -->
      <a href="/forum" class="flex items-center justify-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-sm px-6 py-3.5 rounded-xl transition-all">
        <span class="material-symbols-outlined text-lg">arrow_back</span> Foruma Dön
      </a>

    </aside>
  </div>
</div>

<script>
// Report button delegation (inline onclick kaldırıldı)
document.addEventListener('click', function(e) {
  const btn = e.target.closest('.report-btn');
  if (btn && typeof openReportModal === 'function') {
    openReportModal(btn.dataset.reportType, parseInt(btn.dataset.reportId, 10));
  }
});
</script>
<% } %>
