<%
const typeLabels = { servis: 'Servis', galeri: 'Galeri', yedek_parca: 'Yedek Parça', ekspertiz: 'Ekspertiz' };
let parsedHours = null;
try { parsedHours = JSON.parse(business.working_hours || 'null'); } catch(e) {}
let parsedServices = [];
try { const s = JSON.parse(business.services || '[]'); if(Array.isArray(s)) parsedServices = s; } catch(e) {}
%>
<main class="container mx-auto px-6 py-8">
<div class="flex items-center text-sm text-slate-500 mb-6 gap-1">
<a href="/" class="hover:text-primary">Ana Sayfa</a><span>/</span>
<a href="/servis" class="hover:text-primary">Servis Rehberi</a><span>/</span>
<span class="text-slate-800 font-medium"><%= business.name %></span>
</div>

<div class="flex flex-col lg:flex-row gap-8">
<!-- Sol: İşletme Bilgileri -->
<div class="flex-1">
<!-- Header -->
<div class="bg-white rounded-2xl border border-slate-100 p-8 mb-6">
<div class="flex items-start gap-6">
<div class="size-20 bg-slate-100 rounded-2xl flex items-center justify-center flex-shrink-0">
<span class="material-symbols-outlined text-4xl text-slate-400">home_repair_service</span>
</div>
<div class="flex-1">
<div class="flex items-center gap-2 flex-wrap">
<h1 class="text-2xl font-bold text-slate-900"><%= business.name %></h1>
<% if (business.is_verified) { %><span class="bg-green-100 text-green-700 text-xs px-2 py-0.5 rounded-full font-bold">✓ ONAYLI</span><% } %>
<% if (business.is_premium) { %><span class="bg-yellow-100 text-yellow-700 text-xs px-2 py-0.5 rounded-full font-bold">PREMIUM</span><% } %>
</div>
<p class="text-slate-500 mt-1"><%= typeLabels[business.type] || business.type %></p>
<div class="flex items-center gap-1 mt-2 text-yellow-500">
<% for(let i=0;i<5;i++){%><span class="material-symbols-outlined"><%= i < Math.round(business.rating) ? 'star' : 'star_border' %></span><%}%>
<span class="text-slate-600 font-bold ml-2"><%= business.rating %></span>
<span class="text-slate-400 text-sm">(<%= business.review_count %> değerlendirme)</span>
</div>
</div>
</div>
</div>

<!-- Hizmetler -->
<% if (parsedServices.length > 0) { %>
<div class="bg-white rounded-2xl border border-slate-100 p-6 mb-6">
<h2 class="text-lg font-bold text-slate-900 mb-3">Sunulan Hizmetler</h2>
<div class="flex flex-wrap gap-2">
<% parsedServices.forEach(svc => { %>
<span class="bg-blue-50 text-blue-700 text-sm px-3 py-1.5 rounded-full font-medium flex items-center gap-1">
<span class="material-symbols-outlined text-sm">build</span> <%= svc %>
</span>
<% }) %>
</div>
</div>
<% } %>

<!-- Hakkında -->
<% if (business.description) { %>
<div class="bg-white rounded-2xl border border-slate-100 p-6 mb-6">
<h2 class="text-lg font-bold text-slate-900 mb-3">Hakkında</h2>
<p class="text-slate-600 leading-relaxed"><%= business.description %></p>
</div>
<% } %>

<!-- Değerlendirmeler -->
<div class="bg-white rounded-2xl border border-slate-100 p-6">
<h2 class="text-lg font-bold text-slate-900 mb-6">Değerlendirmeler</h2>

<!-- Rating Dağılımı -->
<div class="mb-8 p-4 bg-slate-50 rounded-xl">
<div class="flex items-center gap-6">
<div class="text-center">
<p class="text-4xl font-black text-slate-900"><%= business.rating %></p>
<div class="flex justify-center text-yellow-500 mt-1">
<% for(let i=0;i<5;i++){%><span class="material-symbols-outlined text-sm"><%= i < Math.round(business.rating) ? 'star' : 'star_border' %></span><%}%>
</div>
<p class="text-xs text-slate-400 mt-1"><%= business.review_count %> değerlendirme</p>
</div>
<div class="flex-1 space-y-1">
<% for(let s=5; s>=1; s--) { %>
<div class="flex items-center gap-2 text-sm">
<span class="w-3 text-slate-500"><%= s %></span>
<span class="material-symbols-outlined text-yellow-500 text-sm">star</span>
<div class="flex-1 bg-slate-200 rounded-full h-2">
<div class="bg-yellow-400 h-2 rounded-full" style="width:<%= business.review_count > 0 ? ((ratingDist[s] || 0) / business.review_count * 100) : 0 %>%"></div>
</div>
<span class="w-6 text-right text-slate-400 text-xs"><%= ratingDist[s] || 0 %></span>
</div>
<% } %>
</div>
</div>
</div>

<!-- Yorum Formu -->
<% if (typeof currentUser !== 'undefined' && currentUser) { %>
<div class="mb-6 p-4 bg-blue-50 rounded-xl border border-blue-100">
<h3 class="font-bold text-slate-800 mb-3">Değerlendirme Yap</h3>
<form id="reviewForm">
<input type="hidden" name="business_id" value="<%= business.id %>">
<div class="star-rating flex items-center gap-1 mb-3">
<input type="hidden" name="rating" value="0">
<% for(let i=1;i<=5;i++){%>
<button type="button" class="star text-gray-300 cursor-pointer" data-value="<%= i %>">
<span class="material-symbols-outlined text-2xl">star_border</span>
</button>
<%}%>
</div>
<textarea name="comment" rows="3" class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 resize-none" placeholder="Deneyiminizi paylaşın..." required></textarea>
<button type="submit" class="mt-2 bg-primary text-white font-bold py-2 px-6 rounded-xl hover:bg-primary/90 transition-all text-sm">Gönder</button>
</form>
</div>
<% } %>

<!-- Yorumlar -->
<% if (reviews.length === 0) { %>
<p class="text-center text-slate-400 py-6">Henüz değerlendirme yapılmamış.</p>
<% } else { %>
<div class="space-y-4">
<% reviews.forEach(r => { %>
<div class="border-b border-slate-100 pb-4 last:border-0">
<div class="flex items-center gap-3 mb-2">
<div class="size-9 bg-primary/10 rounded-full flex items-center justify-center text-primary font-bold text-sm"><%= r.reviewer_name.charAt(0).toUpperCase() %></div>
<div>
<p class="font-semibold text-sm text-slate-800"><%= r.reviewer_name %></p>
<div class="flex items-center gap-1 text-yellow-500">
<% for(let i=0;i<5;i++){%><span class="material-symbols-outlined text-xs"><%= i < r.rating ? 'star' : 'star_border' %></span><%}%>
<span class="text-xs text-slate-400 ml-1"><%= new Date(r.created_at).toLocaleDateString('tr-TR') %></span>
</div>
</div>
</div>
<p class="text-sm text-slate-600 ml-12"><%= r.comment %></p>
</div>
<% }) %>
</div>
<% } %>
</div>
</div>

<!-- Sağ: İletişim -->
<aside class="lg:w-80 shrink-0">
<div class="bg-white rounded-2xl border border-slate-100 p-6 sticky top-28 space-y-4">
<h3 class="font-bold text-slate-900">İletişim Bilgileri</h3>
<% if (business.phone) { %>
<div class="flex items-center gap-3 text-sm">
<span class="material-symbols-outlined text-primary">call</span>
<a href="tel:<%= business.phone %>" class="text-slate-700 hover:text-primary"><%= business.phone %></a>
</div>
<% } %>
<% if (business.email) { %>
<div class="flex items-center gap-3 text-sm">
<span class="material-symbols-outlined text-primary">mail</span>
<a href="mailto:<%= business.email %>" class="text-slate-700 hover:text-primary"><%= business.email %></a>
</div>
<% } %>
<% if (business.website) { %>
<div class="flex items-center gap-3 text-sm">
<span class="material-symbols-outlined text-primary">language</span>
<a href="<%= business.website %>" target="_blank" class="text-slate-700 hover:text-primary"><%= business.website %></a>
</div>
<% } %>
<% if (business.address) { %>
<div class="flex items-center gap-3 text-sm">
<span class="material-symbols-outlined text-primary">location_on</span>
<span class="text-slate-700"><%= business.address %></span>
</div>
<% } %>
<% if (business.city) { %>
<div class="flex items-center gap-3 text-sm">
<span class="material-symbols-outlined text-primary">apartment</span>
<span class="text-slate-700"><%= business.city %><%= business.district ? ', ' + business.district : '' %></span>
</div>
<% } %>

<!-- Çalışma Saatleri (parsed) -->
<% if (parsedHours && typeof parsedHours === 'object') { %>
<div class="border-t border-slate-100 pt-4">
<h4 class="font-semibold text-slate-800 text-sm mb-2 flex items-center gap-2">
<span class="material-symbols-outlined text-primary text-base">schedule</span> Çalışma Saatleri
</h4>
<div class="space-y-1">
<% Object.entries(parsedHours).forEach(([day, hours]) => { %>
<div class="flex justify-between text-sm">
<span class="text-slate-600"><%= day %></span>
<span class="text-slate-800 font-medium"><%= hours %></span>
</div>
<% }) %>
</div>
</div>
<% } else if (business.working_hours) { %>
<div class="flex items-center gap-3 text-sm">
<span class="material-symbols-outlined text-primary">schedule</span>
<span class="text-slate-700"><%= business.working_hours %></span>
</div>
<% } %>

<!-- Aksiyon Butonları -->
<div class="border-t border-slate-100 pt-4 space-y-3">
<% if (typeof currentUser !== 'undefined' && currentUser) { %>
<button data-book-appointment="<%= business.id %>" data-business-name="<%= business.name %>" class="w-full bg-green-600 text-white font-bold py-3 rounded-xl hover:bg-green-700 transition-all flex items-center justify-center gap-2">
<span class="material-symbols-outlined">calendar_month</span> Randevu Al
</button>
<button data-request-quote="<%= business.id %>" data-business-name="<%= business.name %>" class="w-full bg-orange-500 text-white font-bold py-3 rounded-xl hover:bg-orange-600 transition-all flex items-center justify-center gap-2">
<span class="material-symbols-outlined">request_quote</span> Teklif İste
</button>
<button data-send-message="<%= business.user_id %>" data-receiver-name="<%= business.name %>" class="w-full bg-primary text-white font-bold py-3 rounded-xl hover:bg-primary/90 transition-all flex items-center justify-center gap-2">
<span class="material-symbols-outlined">mail</span> Mesaj Gönder
</button>
<% } else { %>
<a href="/giris" class="w-full bg-primary text-white font-bold py-3 rounded-xl hover:bg-primary/90 transition-all flex items-center justify-center gap-2 block">
<span class="material-symbols-outlined">login</span> Randevu/Teklif için Giriş Yap
</a>
<% } %>
</div>
</div>
</aside>
</div>
</main>
