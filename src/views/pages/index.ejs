<%
function formatPrice(p) { return new Intl.NumberFormat('tr-TR').format(p) + ' ₺'; }
function fuelLabel(f) { const m = {benzin:'Benzin',dizel:'Dizel',elektrik:'Elektrik',hibrit:'Hibrit',lpg:'LPG'}; return m[f]||f||''; }
function transLabel(t) { const m = {otomatik:'Otomatik',manuel:'Manuel',yari_otomatik:'Yarı Otomatik'}; return m[t]||t||''; }
function formatKm(k) { return new Intl.NumberFormat('tr-TR').format(k); }
const typeLabels = {servis:'Servis',galeri:'Galeri',yedek_parca:'Yedek Parça',ekspertiz:'Ekspertiz'};
const hubBrands = ['bmw','mercedes','audi','toyota','volkswagen','tesla','porsche','volvo','honda','hyundai','kia','ford'];
%>

<!-- ═══════════════════════ HERO ═══════════════════════ -->
<section class="relative overflow-hidden">
  <div class="absolute inset-0 bg-cover bg-center" style="background-image:url('https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?w=1920&q=80');"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-slate-950/85 via-slate-900/80 to-slate-950/95 z-10"></div>
  <div class="relative z-20 w-full max-w-[1200px] mx-auto px-4 sm:px-6">
    <div class="py-10 sm:py-16 md:py-24">
      <div class="text-center mb-5 sm:mb-8">
        <h1 class="text-white text-2xl sm:text-4xl md:text-5xl lg:text-[3.4rem] font-black leading-tight tracking-tight mb-2 sm:mb-4">
          Hayalinizdeki Aracı<br/>
          <span class="bg-gradient-to-r from-primary via-blue-400 to-cyan-400 bg-clip-text text-transparent">Keşfedin</span>
        </h1>
        <p class="text-slate-300/80 text-xs sm:text-base md:text-lg max-w-xl mx-auto leading-relaxed">
          Binlerce araç ilanı, güvenilir servisler ve Türkiye'nin en büyük otomobil topluluğu tek platformda.
        </p>
      </div>
      <!-- İstatistikler -->
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-6">
        <div class="flex items-center gap-1.5 text-white/50 text-[11px] sm:text-xs font-medium">
          <span class="material-symbols-outlined text-green-400" style="font-size:14px">verified</span>
          <span><%= stats.businesses %>+ servis</span>
        </div>
        <div class="flex items-center gap-1.5 text-white/50 text-[11px] sm:text-xs font-medium">
          <span class="material-symbols-outlined text-blue-400" style="font-size:14px">directions_car</span>
          <span><%= stats.listings %>+ ilan</span>
        </div>
        <div class="flex items-center gap-1.5 text-white/50 text-[11px] sm:text-xs font-medium">
          <span class="material-symbols-outlined text-amber-400" style="font-size:14px">group</span>
          <span><%= stats.users %>+ üye</span>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════ MARKALAR ═══════════════════════ -->
<section class="bg-slate-50 border-b border-slate-100 py-4 sm:py-5">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6">

    <!-- Mobil: Yatay scroll markalar + Araç Hub butonu -->
    <div class="sm:hidden">
      <div class="flex items-center justify-between mb-2.5">
        <div class="flex items-center gap-1.5">
          <span class="material-symbols-outlined text-primary" style="font-size:16px">commute</span>
          <span class="text-[11px] font-bold text-slate-600">Popüler Markalar</span>
        </div>
      </div>
      <div class="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
        <% hubBrands.forEach(slug => {
           const b = brands.find(br => br.slug === slug);
           if (!b) return; %>
        <a href="/ilan?marka=<%= b.slug %>" class="flex flex-col items-center gap-1 min-w-[52px] group">
          <div class="size-11 rounded-xl bg-white border border-slate-200 group-active:border-primary/40 flex items-center justify-center transition-all shadow-sm">
            <% if (b.logo) { %>
              <img src="<%= b.logo %>" alt="<%= b.name %>" class="size-5 object-contain" onerror="this.style.display='none';this.nextElementSibling.style.display='block'"/>
              <span class="material-symbols-outlined text-slate-300 hidden" style="font-size:16px">directions_car</span>
            <% } else { %>
              <span class="material-symbols-outlined text-slate-300" style="font-size:16px">directions_car</span>
            <% } %>
          </div>
          <span class="text-[9px] font-semibold text-slate-500 whitespace-nowrap"><%= b.name.split('-')[0].split(' ')[0] %></span>
        </a>
        <% }) %>
      </div>
      <a href="/arac-secim" class="flex items-center justify-center gap-2 w-full mt-2 bg-slate-800 hover:bg-slate-900 text-white font-bold py-2.5 rounded-xl text-xs transition-all shadow-sm">
        <span class="material-symbols-outlined" style="font-size:16px">commute</span>
        306+ Model · Araç Hub'a Git
        <span class="material-symbols-outlined" style="font-size:14px">arrow_forward</span>
      </a>
    </div>

    <!-- Desktop: 12 marka grid + Araç Hub butonu -->
    <div class="hidden sm:block">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-primary/80" style="font-size:16px">commute</span>
          <span class="text-xs font-bold text-slate-500 uppercase tracking-widest">Popüler Markalar</span>
        </div>
      </div>
      <div class="grid grid-cols-6 md:grid-cols-12 gap-2">
        <% hubBrands.forEach(slug => {
           const b = brands.find(br => br.slug === slug);
           if (!b) return; %>
        <a href="/ilan?marka=<%= b.slug %>" class="group flex flex-col items-center justify-center gap-1 py-2.5 bg-white hover:bg-primary/5 border border-slate-200 hover:border-primary/40 rounded-xl transition-all shadow-sm">
          <% if (b.logo) { %>
            <img src="<%= b.logo %>" alt="<%= b.name %>" class="size-6 object-contain opacity-60 group-hover:opacity-100 transition-opacity" onerror="this.style.display='none';this.nextElementSibling.style.display='block'"/>
            <span class="material-symbols-outlined text-slate-300 hidden" style="font-size:18px">directions_car</span>
          <% } else { %>
            <span class="material-symbols-outlined text-slate-300 group-hover:text-primary" style="font-size:18px">directions_car</span>
          <% } %>
          <span class="text-[9px] font-semibold text-slate-400 group-hover:text-slate-700 whitespace-nowrap transition-colors"><%= b.name.split('-')[0].split(' ')[0] %></span>
        </a>
        <% }) %>
      </div>
      <div class="text-center mt-3">
        <a href="/arac-secim" class="inline-flex items-center gap-2 bg-slate-800 hover:bg-slate-900 text-white font-bold py-2.5 px-6 rounded-xl text-xs transition-all shadow-sm">
          <span class="material-symbols-outlined" style="font-size:16px">commute</span>
          306+ Model · Araç Hub'a Git
          <span class="material-symbols-outlined" style="font-size:14px">arrow_forward</span>
        </a>
      </div>
    </div>

  </div>
</section>


<!-- ═══════════════════════ AKILLI ARAMA ═══════════════════════ -->
<section class="relative overflow-hidden border-b border-slate-100">
  <div class="absolute inset-0 bg-gradient-to-r from-indigo-950 via-slate-900 to-violet-950"></div>
  <div class="absolute inset-0 opacity-30" style="background-image:radial-gradient(circle at 15% 50%,rgba(99,102,241,.5) 0,transparent 50%),radial-gradient(circle at 85% 30%,rgba(59,130,246,.4) 0,transparent 50%);"></div>
  <div class="absolute top-3 left-10 size-2 rounded-full bg-blue-400/20 animate-pulse hidden sm:block"></div>
  <div class="absolute bottom-3 right-16 size-2 rounded-full bg-purple-400/20 animate-pulse hidden sm:block" style="animation-delay:.7s"></div>
  <div class="relative z-10 max-w-[1200px] mx-auto px-4 sm:px-6 py-4 sm:py-5">

    <!-- Mobil -->
    <a href="/akilli-oneri" class="sm:hidden flex items-center gap-3 group">
      <div class="size-10 rounded-xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center flex-shrink-0 shadow-lg shadow-purple-500/25">
        <span class="material-symbols-outlined text-white" style="font-size:20px">auto_awesome</span>
      </div>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-1.5 mb-0.5">
          <p class="text-white text-sm font-bold">Akıllı Araç Asistanı</p>
          <span class="bg-gradient-to-r from-blue-500/30 to-purple-500/30 text-[8px] font-bold text-blue-300 px-1.5 py-0.5 rounded-full border border-white/10">AI</span>
        </div>
        <p class="text-white/40 text-[11px]">Birkaç soruya cevap ver, sana en uygun aracı bulalım</p>
      </div>
      <div class="size-8 rounded-lg bg-white/10 flex items-center justify-center flex-shrink-0 group-active:bg-white/20 transition-all">
        <span class="material-symbols-outlined text-white" style="font-size:18px">arrow_forward</span>
      </div>
    </a>

    <!-- Desktop -->
    <div class="hidden sm:flex items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="size-12 rounded-xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center flex-shrink-0 shadow-lg shadow-purple-500/25">
          <span class="material-symbols-outlined text-white" style="font-size:24px">auto_awesome</span>
        </div>
        <div>
          <div class="flex items-center gap-2 mb-0.5">
            <h3 class="text-white text-base font-bold">Akıllı Araç Asistanı</h3>
            <span class="bg-gradient-to-r from-blue-500/30 to-purple-500/30 text-[9px] font-bold text-blue-300 px-2 py-0.5 rounded-full border border-white/10">AI Destekli</span>
          </div>
          <p class="text-white/45 text-sm">Kullanım amacın, bütçen ve tercihlerin doğrultusunda sana özel araç önerileri al</p>
        </div>
      </div>
      <div class="flex items-center gap-3 flex-shrink-0">
        <div class="hidden lg:flex items-center gap-2">
          <% [['psychology','Analiz'],['tune','Filtre'],['recommend','Eşleşme']].forEach(([icon,text]) => { %>
          <div class="flex items-center gap-1.5 bg-white/[0.06] border border-white/[0.08] rounded-lg px-2.5 py-1.5">
            <span class="material-symbols-outlined text-blue-400/70" style="font-size:14px"><%= icon %></span>
            <span class="text-white/50 text-[10px] font-semibold"><%= text %></span>
          </div>
          <% }) %>
        </div>
        <a href="/akilli-oneri" class="inline-flex items-center gap-2 bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 text-white font-bold py-2.5 px-5 rounded-xl text-sm transition-all shadow-lg shadow-purple-500/25 group">
          <span class="material-symbols-outlined group-hover:rotate-12 transition-transform" style="font-size:16px">auto_awesome</span>
          Başlat
          <span class="material-symbols-outlined" style="font-size:16px">arrow_forward</span>
        </a>
      </div>
    </div>

  </div>
</section>


<!-- ═══════════════════════ ARAMA ═══════════════════════ -->
<section class="bg-white border-b border-slate-100 py-4 sm:py-6">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
    <form action="/ilan" method="GET" class="max-w-2xl mx-auto" id="heroSearchForm">
      <div class="flex flex-col sm:flex-row gap-1.5 sm:gap-2">
        <div class="flex-1 relative">
          <div class="flex items-center px-3 gap-2 h-11 sm:h-[50px] bg-slate-50 rounded-xl border border-slate-200 focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 transition-all">
            <span class="material-symbols-outlined text-primary" style="font-size:18px">directions_car</span>
            <input type="text" id="heroMarka" name="marka" placeholder="Marka ara..." autocomplete="off" class="w-full bg-transparent border-none focus:ring-0 text-slate-800 placeholder:text-slate-400 text-sm font-medium p-0"/>
          </div>
          <div id="heroMarkaDropdown" class="hidden absolute top-full left-0 right-0 mt-1 bg-white border border-slate-200 rounded-xl shadow-xl z-50 max-h-64 overflow-y-auto"></div>
        </div>
        <div class="flex-1 relative">
          <div class="flex items-center px-3 gap-2 h-11 sm:h-[50px] bg-slate-50 rounded-xl border border-slate-200 focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 transition-all">
            <span class="material-symbols-outlined text-primary" style="font-size:18px">location_on</span>
            <input type="text" id="heroSehir" name="sehir" placeholder="Şehir ara..." autocomplete="off" class="w-full bg-transparent border-none focus:ring-0 text-slate-800 placeholder:text-slate-400 text-sm font-medium p-0"/>
          </div>
          <div id="heroSehirDropdown" class="hidden absolute top-full left-0 right-0 mt-1 bg-white border border-slate-200 rounded-xl shadow-xl z-50 max-h-64 overflow-y-auto"></div>
        </div>
        <button type="submit" class="h-11 sm:h-[50px] px-6 bg-primary text-white font-bold rounded-xl hover:bg-blue-700 transition-all flex items-center justify-center gap-2 shadow-lg shadow-primary/25">
          <span class="material-symbols-outlined" style="font-size:20px">search</span>
          <span class="text-sm">Ara</span>
        </button>
      </div>
      <div class="flex flex-wrap items-center gap-1 mt-2 px-1">
        <span class="text-[10px] text-slate-400 font-medium mr-0.5">Popüler:</span>
        <% ['BMW','Mercedes-Benz','Audi','Toyota','Volkswagen','Tesla'].forEach(name => { %>
          <button type="button" class="hero-quick-brand text-[10px] bg-slate-100 hover:bg-primary hover:text-white text-slate-500 font-semibold px-2 py-0.5 rounded-md transition-all" data-brand="<%= name %>"><%= name %></button>
        <% }) %>
      </div>
    </form>
  </div>
</section>


<!-- ═══════════════════════ ANA İÇERİK ═══════════════════════ -->
<main class="w-full max-w-[1200px] mx-auto px-4 sm:px-6 py-6 sm:py-14 overflow-hidden box-border">

<!-- ═══════════════════════ ÖNE ÇIKAN İLANLAR ═══════════════════════ -->
<% if (featuredListings && featuredListings.length > 0) { %>
<section class="mb-8 sm:mb-16">
  <div class="flex justify-between items-end mb-3 sm:mb-6">
    <div class="min-w-0">
      <div class="flex items-center gap-1.5 mb-1">
        <span class="size-6 sm:size-7 rounded-lg bg-amber-100 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-amber-600" style="font-size:14px">star</span></span>
        <span class="text-[10px] sm:text-xs font-bold text-amber-600 uppercase tracking-wider">Öne Çıkan</span>
      </div>
      <h2 class="text-lg sm:text-2xl font-black text-slate-900">Editör Seçimi Araçlar</h2>
    </div>
    <a class="hidden sm:flex items-center gap-1.5 text-primary font-bold text-sm hover:underline flex-shrink-0" href="/ilan">
      Tüm İlanlar <span class="material-symbols-outlined" style="font-size:16px">arrow_forward</span>
    </a>
  </div>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-5">
    <% featuredListings.forEach(l => { %>
    <a href="/ilan/<%= l.slug %>" class="group bg-white rounded-xl sm:rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-100 hover:border-primary/20 hover:-translate-y-1">
      <div class="aspect-[4/3] bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center relative overflow-hidden">
        <span class="material-symbols-outlined text-3xl sm:text-5xl text-slate-300/80 group-hover:scale-110 transition-transform duration-500">directions_car</span>
        <div class="absolute top-1.5 left-1.5 sm:top-3 sm:left-3">
          <span class="bg-amber-500 text-white text-[8px] sm:text-[10px] px-1.5 py-0.5 rounded font-bold">⭐ ÖNE ÇIKAN</span>
        </div>
        <div class="absolute bottom-1.5 left-1.5 sm:bottom-2.5 sm:left-3 flex gap-1">
          <span class="bg-white/95 text-slate-700 text-[8px] sm:text-[10px] font-semibold px-1 sm:px-2 py-0.5 rounded"><%= l.year %></span>
          <span class="bg-white/95 text-slate-700 text-[8px] sm:text-[10px] font-semibold px-1 sm:px-2 py-0.5 rounded"><%= fuelLabel(l.fuel_type) %></span>
        </div>
      </div>
      <div class="p-2.5 sm:p-4">
        <h3 class="font-bold text-[11px] sm:text-sm text-slate-900 group-hover:text-primary transition-colors truncate"><%= l.brand_name %> <%= l.model_name %></h3>
        <p class="text-primary font-black text-sm sm:text-lg mt-0.5"><%= formatPrice(l.price) %></p>
        <div class="flex items-center flex-wrap gap-x-1.5 gap-y-0 sm:gap-3 mt-1 sm:mt-2.5 text-slate-400 text-[9px] sm:text-[11px] font-medium">
          <span class="flex items-center gap-0.5"><span class="material-symbols-outlined" style="font-size:10px">speed</span><%= formatKm(l.km) %></span>
          <span class="flex items-center gap-0.5"><span class="material-symbols-outlined" style="font-size:10px">settings</span><%= transLabel(l.transmission) %></span>
          <span class="flex items-center gap-0.5"><span class="material-symbols-outlined" style="font-size:10px">location_on</span><%= l.city %></span>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
</section>
<% } %>


<!-- ═══════════════════════ SON İLANLAR ═══════════════════════ -->
<% if (latestListings && latestListings.length > 0) { %>
<section class="mb-8 sm:mb-16">
  <div class="flex justify-between items-end mb-3 sm:mb-6">
    <div class="min-w-0">
      <div class="flex items-center gap-1.5 mb-1">
        <span class="size-6 sm:size-7 rounded-lg bg-blue-100 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-blue-600" style="font-size:14px">schedule</span></span>
        <span class="text-[10px] sm:text-xs font-bold text-blue-600 uppercase tracking-wider">Yeni Eklenenler</span>
      </div>
      <h2 class="text-lg sm:text-2xl font-black text-slate-900">Son Eklenen İlanlar</h2>
    </div>
    <div class="flex items-center gap-1.5 flex-shrink-0">
      <button id="latestPrev" class="size-7 sm:size-9 rounded-lg bg-white hover:bg-slate-50 flex items-center justify-center border border-slate-200">
        <span class="material-symbols-outlined text-slate-500" style="font-size:16px">chevron_left</span>
      </button>
      <button id="latestNext" class="size-7 sm:size-9 rounded-lg bg-white hover:bg-slate-50 flex items-center justify-center border border-slate-200">
        <span class="material-symbols-outlined text-slate-500" style="font-size:16px">chevron_right</span>
      </button>
    </div>
  </div>
  <div class="overflow-hidden">
    <div id="latestSlider" class="flex gap-2.5 sm:gap-4 transition-transform duration-500 ease-out">
      <% latestListings.forEach(l => { %>
      <a href="/ilan/<%= l.slug %>" class="group w-[44%] sm:w-[260px] md:w-[280px] bg-white rounded-xl sm:rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 border border-slate-100 hover:border-primary/20 flex-shrink-0">
        <div class="aspect-[4/3] bg-gradient-to-br from-slate-100 to-slate-50 flex items-center justify-center relative overflow-hidden">
          <span class="material-symbols-outlined text-3xl sm:text-5xl text-slate-300/70 group-hover:scale-110 transition-transform duration-500">directions_car</span>
          <div class="absolute bottom-1.5 left-1.5 sm:bottom-2.5 sm:left-3 flex gap-1">
            <span class="bg-white/95 text-slate-700 text-[8px] sm:text-[10px] font-semibold px-1 sm:px-2 py-0.5 rounded"><%= l.year %></span>
            <span class="bg-white/95 text-slate-700 text-[8px] sm:text-[10px] font-semibold px-1 sm:px-2 py-0.5 rounded"><%= fuelLabel(l.fuel_type) %></span>
          </div>
        </div>
        <div class="p-2.5 sm:p-4">
          <h3 class="font-bold text-[11px] sm:text-sm text-slate-900 group-hover:text-primary transition-colors truncate"><%= l.brand_name %> <%= l.model_name %></h3>
          <p class="text-primary font-black text-sm sm:text-lg mt-0.5"><%= formatPrice(l.price) %></p>
          <div class="flex items-center justify-between mt-1 sm:mt-2">
            <span class="text-slate-400 text-[9px] sm:text-[11px] flex items-center gap-0.5"><span class="material-symbols-outlined" style="font-size:10px">speed</span><%= formatKm(l.km) %></span>
            <span class="text-slate-400 text-[9px] sm:text-[11px] flex items-center gap-0.5"><span class="material-symbols-outlined" style="font-size:10px">location_on</span><%= l.city %></span>
          </div>
        </div>
      </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>


<!-- ═══════════════════════ AKILLI ÖNERİ ASİSTAN ═══════════════════════ -->
<section class="mb-8 sm:mb-16 -mx-4 sm:mx-0">
  <div class="relative bg-gradient-to-br from-indigo-950 via-slate-900 to-violet-950 sm:rounded-2xl overflow-hidden">
    <div class="absolute inset-0 opacity-30" style="background-image:radial-gradient(circle at 15% 50%,rgba(99,102,241,.5) 0,transparent 50%),radial-gradient(circle at 85% 30%,rgba(59,130,246,.4) 0,transparent 50%),radial-gradient(circle at 50% 90%,rgba(168,85,247,.3) 0,transparent 40%);"></div>
    <!-- Floating dots deco -->
    <div class="absolute top-6 left-8 size-2 rounded-full bg-blue-400/20 animate-pulse hidden sm:block"></div>
    <div class="absolute top-16 right-16 size-3 rounded-full bg-purple-400/15 animate-pulse hidden sm:block" style="animation-delay:.5s"></div>
    <div class="absolute bottom-10 left-1/4 size-2 rounded-full bg-cyan-400/20 animate-pulse hidden sm:block" style="animation-delay:1s"></div>

    <div class="relative z-10 p-5 sm:p-8 md:p-12">
      <!-- Mobil -->
      <div class="sm:hidden text-center">
        <div class="inline-flex items-center gap-1.5 bg-gradient-to-r from-blue-500/20 to-purple-500/20 border border-white/10 text-white text-[10px] font-bold px-3 py-1 rounded-full mb-3">
          <span class="material-symbols-outlined" style="font-size:12px">auto_awesome</span> AI Destekli
        </div>
        <h2 class="text-xl font-black text-white mb-1.5 leading-tight">Akıllı Araç<br/><span class="bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">Asistanı</span></h2>
        <p class="text-white/40 text-[11px] leading-relaxed mb-4">Birkaç soruya cevap ver, sana en uygun arabayı bulalım!</p>

