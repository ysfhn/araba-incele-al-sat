<%
function formatPrice(p) { return new Intl.NumberFormat('tr-TR').format(p) + ' ₺'; }
function fuelLabel(f) { const m = {benzin:'Benzin',dizel:'Dizel',elektrik:'Elektrik',hibrit:'Hibrit',lpg:'LPG'}; return m[f]||f||''; }
function transLabel(t) { const m = {otomatik:'Otomatik',manuel:'Manuel',yari_otomatik:'Yarı Otomatik'}; return m[t]||t||''; }
function formatKm(k) { return new Intl.NumberFormat('tr-TR').format(k); }
%>
<!-- Hero -->
<section class="relative h-[560px] flex items-center justify-center overflow-hidden">
<div class="absolute inset-0 bg-gradient-to-r from-slate-900/80 to-slate-900/40 z-10"></div>
<div class="absolute inset-0 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?w=1920&q=80');"></div>
<div class="relative z-20 container mx-auto px-6 text-center max-w-4xl">
<h1 class="text-white text-4xl md:text-6xl font-black leading-tight tracking-tight mb-6">
Hayalinizdeki Aracı İnceleyin, <span class="text-primary">Güvenle Alın ve Satın</span>
</h1>
<p class="text-slate-200 text-lg md:text-xl font-normal mb-10">
<%= stats.listings %> aktif ilan, <%= stats.businesses %> onaylı servis ve <%= stats.users %> üye sizi bekliyor.
</p>
<form action="/ilan" method="GET" class="bg-white p-2 rounded-2xl shadow-2xl max-w-3xl mx-auto flex flex-col md:flex-row gap-2">
<div class="flex-1 flex items-center px-4 gap-3 border-b md:border-b-0 md:border-r border-slate-100 py-2">
<span class="material-symbols-outlined text-primary">search</span>
<select name="marka" class="w-full border-none focus:ring-0 text-slate-700 text-sm">
<option value="">Marka seçin</option>
<% brands.forEach(b => { %><option value="<%= b.slug %>"><%= b.name %></option><% }) %>
</select>
</div>
<div class="flex-1 flex items-center px-4 gap-3 py-2">
<span class="material-symbols-outlined text-primary">location_on</span>
<input name="sehir" class="w-full border-none focus:ring-0 text-slate-700 placeholder:text-slate-400 text-sm" placeholder="Şehir"/>
</div>
<button type="submit" class="bg-primary text-white font-bold py-4 px-8 rounded-xl hover:bg-primary/90 transition-all flex items-center justify-center gap-2">
<span>Ara</span><span class="material-symbols-outlined">arrow_forward</span>
</button>
</form>
</div>
</section>

<main class="container mx-auto px-6 lg:px-12 py-12">
<!-- Öne Çıkan İlanlar -->
<% if (featuredListings && featuredListings.length > 0) { %>
<div class="mb-16">
<div class="flex justify-between items-end mb-8">
<div>
<h2 class="text-3xl font-bold text-slate-900">Öne Çıkan Araç İlanları</h2>
<p class="text-slate-500 mt-2">Editörlerimiz tarafından seçilen en iyi fırsatlar</p>
</div>
<a class="text-primary font-bold flex items-center gap-1 hover:underline" href="/ilan">Tümünü Gör <span class="material-symbols-outlined text-sm">open_in_new</span></a>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
<% featuredListings.forEach(l => { %>
<div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-slate-100">
<div class="h-48 bg-slate-100 flex items-center justify-center relative">
<span class="material-symbols-outlined text-6xl text-slate-300">directions_car</span>
<% if (l.is_featured) { %><div class="absolute top-3 left-3 bg-primary text-white text-[10px] px-2 py-1 rounded-full font-bold">ÖNE ÇIKAN</div><% } %>
<div class="absolute top-3 right-3 bg-white/90 backdrop-blur rounded-full p-1.5 cursor-pointer" data-favorite="<%= l.id %>">
<span class="material-symbols-outlined text-slate-600">favorite</span>
</div>
</div>
<div class="p-5">
<h3 class="font-bold text-lg text-slate-900"><%= l.brand_name %> <%= l.model_name %></h3>
<p class="text-primary font-bold text-xl mt-1"><%= formatPrice(l.price) %></p>
<div class="flex items-center gap-3 mt-4 text-slate-500 text-sm">
<span class="flex items-center gap-1"><span class="material-symbols-outlined text-base">speed</span> <%= formatKm(l.km) %> km</span>
<span class="flex items-center gap-1"><span class="material-symbols-outlined text-base">calendar_today</span> <%= l.year %></span>
</div>
<a href="/ilan/<%= l.slug %>" class="block w-full mt-5 py-2.5 rounded-xl bg-slate-50 text-slate-900 font-bold text-sm border border-slate-200 hover:bg-slate-100 transition-all text-center">İncele</a>
</div>
</div>
<% }) %>
</div>
</div>
<% } %>

<!-- Son İlanlar -->
<% if (latestListings && latestListings.length > 0) { %>
<div class="mb-16">
<div class="flex justify-between items-end mb-8">
<div>
<h2 class="text-3xl font-bold text-slate-900">Son Eklenen İlanlar</h2>
<p class="text-slate-500 mt-2">Platformumuza yeni eklenen araç ilanları</p>
</div>
<a class="text-primary font-bold flex items-center gap-1 hover:underline" href="/ilan">Tümünü Gör</a>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
<% latestListings.forEach(l => { %>
<div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-slate-100">
<div class="h-48 bg-slate-100 flex items-center justify-center">
<span class="material-symbols-outlined text-6xl text-slate-300">directions_car</span>
</div>
<div class="p-5">
<h3 class="font-bold text-lg text-slate-900"><%= l.brand_name %> <%= l.model_name %></h3>
<p class="text-primary font-bold text-xl mt-1"><%= formatPrice(l.price) %></p>
<div class="flex items-center gap-3 mt-4 text-slate-500 text-sm">
<span class="flex items-center gap-1"><span class="material-symbols-outlined text-base">speed</span> <%= formatKm(l.km) %> km</span>
<span class="flex items-center gap-1"><span class="material-symbols-outlined text-base">calendar_today</span> <%= l.year %></span>
</div>
<a href="/ilan/<%= l.slug %>" class="block w-full mt-5 py-2.5 rounded-xl bg-slate-50 text-slate-900 font-bold text-sm border border-slate-200 hover:bg-slate-100 transition-all text-center">İncele</a>
</div>
</div>
<% }) %>
</div>
</div>
<% } %>

<!-- Nasıl Çalışır -->
<div class="mb-20 bg-primary/5 rounded-3xl p-8 md:p-12 border border-primary/10">
<div class="text-center mb-12">
<h2 class="text-3xl font-bold text-slate-900">Platform Nasıl Çalışır?</h2>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
<div class="flex flex-col items-center text-center">
<div class="size-16 rounded-2xl bg-primary text-white flex items-center justify-center mb-4 shadow-lg shadow-primary/30"><span class="material-symbols-outlined text-3xl">pageview</span></div>
<h4 class="font-bold text-lg">Keşfet & Karşılaştır</h4>
<p class="text-slate-500 mt-2 text-sm">Detaylı incelemeler ve ilanlar arasından size en uygun olanı bulun.</p>
</div>
<div class="flex flex-col items-center text-center">
<div class="size-16 rounded-2xl bg-primary text-white flex items-center justify-center mb-4 shadow-lg shadow-primary/30"><span class="material-symbols-outlined text-3xl">verified_user</span></div>
<h4 class="font-bold text-lg">Ekspertiz & Güven</h4>
<p class="text-slate-500 mt-2 text-sm">Bağımsız servislerimizde aracın durumunu onaylatın.</p>
</div>
<div class="flex flex-col items-center text-center">
<div class="size-16 rounded-2xl bg-primary text-white flex items-center justify-center mb-4 shadow-lg shadow-primary/30"><span class="material-symbols-outlined text-3xl">handshake</span></div>
<h4 class="font-bold text-lg">Güvenli Satın Al</h4>
<p class="text-slate-500 mt-2 text-sm">Ödeme ve devir işlemlerini platform güvencesiyle tamamlayın.</p>
</div>
</div>
</div>

<!-- Forum & Servisler -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-20">
<div>
<div class="flex justify-between items-center mb-6">
<h2 class="text-2xl font-bold text-slate-900 flex items-center gap-2"><span class="material-symbols-outlined text-primary">forum</span> Popüler Forum Tartışmaları</h2>
<a class="text-primary text-sm font-bold" href="/forum">Forum'a Git</a>
</div>
<div class="space-y-4">
<% (forumTopics || []).forEach(t => { %>
<a href="/forum/konu/<%= t.slug %>" class="bg-white p-4 rounded-xl border border-slate-100 hover:border-primary/30 transition-colors flex gap-4 items-start block">
<div class="bg-slate-100 rounded-lg p-2 flex flex-col items-center min-w-12">
<span class="material-symbols-outlined text-slate-400 text-sm">chat_bubble</span>
<span class="font-bold text-slate-700"><%= t.reply_count %></span>
</div>
<div>
<h4 class="font-bold text-slate-800 hover:text-primary"><%= t.title %></h4>
<p class="text-xs text-slate-400 mt-1"><%= t.author_name %> • <%= t.category_name %> • <%= t.view_count %> görüntülenme</p>
</div>
</a>
<% }) %>
</div>
</div>
<div>
<div class="flex justify-between items-center mb-6">
<h2 class="text-2xl font-bold text-slate-900 flex items-center gap-2"><span class="material-symbols-outlined text-primary">build</span> Öne Çıkan Servisler</h2>
<a class="text-primary text-sm font-bold" href="/servis">Servis Bul</a>
</div>
<div class="space-y-4">
<% (topServices || []).forEach(s => { %>
<a href="/servis/<%= s.slug %>" class="bg-white p-4 rounded-xl border border-slate-100 flex items-center gap-4 block">
<div class="size-16 bg-slate-100 rounded-xl flex items-center justify-center text-slate-400"><span class="material-symbols-outlined text-3xl">home_repair_service</span></div>
<div class="flex-1">
<div class="flex items-center gap-2">
<h4 class="font-bold text-slate-800"><%= s.name %></h4>
<% if (s.is_verified) { %><span class="bg-green-100 text-green-700 text-[10px] px-2 py-0.5 rounded-full font-bold">ONAYLI</span><% } %>
</div>
<div class="flex items-center gap-1 mt-1 text-yellow-500">
<% for(let i=0;i<5;i++){%><span class="material-symbols-outlined text-sm"><%= i < Math.round(s.rating) ? 'star' : 'star_border' %></span><%}%>
<span class="text-xs text-slate-400 ml-1">(<%= s.rating %> - <%= s.review_count %> Değerlendirme)</span>
</div>
<p class="text-xs text-slate-500 mt-1"><%= s.city || '' %> • <%= s.type %></p>
</div>
</a>
<% }) %>
</div>
</div>
</div>

<!-- CTA -->
<div class="mt-20 bg-primary rounded-3xl p-10 md:p-16 text-white flex flex-col md:flex-row items-center justify-between gap-8">
<div class="max-w-2xl text-center md:text-left">
<h2 class="text-3xl md:text-4xl font-bold mb-4"><%= stats.users %> otomobil tutkununa katılın</h2>
<p class="text-white/80 text-lg">En güncel ilanlardan haberdar olun, forumdaki tartışmalara katılın.</p>
</div>
<a href="/giris" class="bg-white text-primary font-bold py-4 px-10 rounded-2xl hover:bg-slate-50 transition-all shadow-xl">Ücretsiz Katıl</a>
</div>
</main>
