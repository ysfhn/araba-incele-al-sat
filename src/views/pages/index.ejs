<!-- ═══════════════════════ JS ═══════════════════════ -->
<script>
(function(){
  var allBrands = <%- JSON.stringify(brands.map(b=>({name:b.name,slug:b.slug,logo:b.logo}))) %>;
  var MI = document.getElementById('heroMarka');
  var MD = document.getElementById('heroMarkaDropdown');
  function rbd(l){
    if(!l.length){MD.classList.add('hidden');return;}
    MD.innerHTML=l.map(function(b){
      var lg=b.logo?'<img src="'+b.logo+'" class="size-6 object-contain" onerror="this.style.display=\'none\'">':'<span class="material-symbols-outlined text-slate-400">directions_car</span>';
      return '<div class="flex items-center gap-3 px-4 py-2.5 hover:bg-primary/5 cursor-pointer" data-s="'+b.slug+'" data-n="'+b.name+'"><div class="size-7 flex items-center justify-center">'+lg+'</div><span class="text-sm font-medium text-slate-700">'+b.name+'</span></div>';
    }).join('');
    MD.classList.remove('hidden');
    MD.querySelectorAll('[data-s]').forEach(function(el){el.onclick=function(){MI.value=this.dataset.n;MI.dataset.selectedSlug=this.dataset.s;MD.classList.add('hidden');};});
  }
  MI.onfocus=function(){rbd(allBrands.slice(0,10));};
  MI.oninput=function(){var q=this.value.toLowerCase().trim();this.dataset.selectedSlug='';rbd(q?allBrands.filter(function(b){return b.name.toLowerCase().indexOf(q)>=0;}):allBrands.slice(0,10));};

  var SI=document.getElementById('heroSehir');
  var SD=document.getElementById('heroSehirDropdown');
  var cities=["Adana","Adıyaman","Afyonkarahisar","Ağrı","Aksaray","Amasya","Ankara","Antalya","Ardahan","Artvin","Aydın","Balıkesir","Bartın","Batman","Bayburt","Bilecik","Bingöl","Bitlis","Bolu","Burdur","Bursa","Çanakkale","Çankırı","Çorum","Denizli","Diyarbakır","Düzce","Edirne","Elazığ","Erzincan","Erzurum","Eskişehir","Gaziantep","Giresun","Gümüşhane","Hakkari","Hatay","Iğdır","Isparta","İstanbul","İzmir","Kahramanmaraş","Karabük","Karaman","Kars","Kastamonu","Kayseri","Kırıkkale","Kırklareli","Kırşehir","Kilis","Kocaeli","Konya","Kütahya","Malatya","Manisa","Mardin","Mersin","Muğla","Muş","Nevşehir","Niğde","Ordu","Osmaniye","Rize","Sakarya","Samsun","Siirt","Sinop","Sivas","Şanlıurfa","Şırnak","Tekirdağ","Tokat","Trabzon","Tunceli","Uşak","Van","Yalova","Yozgat","Zonguldak"];
  function rcd(l){
    if(!l.length){SD.classList.add('hidden');return;}
    SD.innerHTML=l.map(function(c){return '<div class="flex items-center gap-3 px-4 py-2.5 hover:bg-primary/5 cursor-pointer" data-c="'+c+'"><span class="material-symbols-outlined text-slate-400 text-sm">location_on</span><span class="text-sm font-medium text-slate-700">'+c+'</span></div>';}).join('');
    SD.classList.remove('hidden');
    SD.querySelectorAll('[data-c]').forEach(function(el){el.onclick=function(){SI.value=this.dataset.c;SD.classList.add('hidden');};});
  }
  SI.onfocus=function(){rcd(cities.slice(0,10));};
  SI.oninput=function(){var q=this.value.toLowerCase().trim();rcd(q?cities.filter(function(c){return c.toLowerCase().indexOf(q)>=0;}):cities.slice(0,10));};

  document.addEventListener('click',function(e){
    if(!MI.contains(e.target)&&!MD.contains(e.target))MD.classList.add('hidden');
    if(!SI.contains(e.target)&&!SD.contains(e.target))SD.classList.add('hidden');
  });
  document.getElementById('heroSearchForm').onsubmit=function(){var s=MI.dataset.selectedSlug;if(s)MI.value=s;};
  document.querySelectorAll('.hero-quick-brand').forEach(function(btn){
    btn.onclick=function(){var b=allBrands.find(function(x){return x.name===btn.dataset.brand;});if(b){MI.value=b.name;MI.dataset.selectedSlug=b.slug;MD.classList.add('hidden');}};
  });

  var sl=document.getElementById('latestSlider'),pv=document.getElementById('latestPrev'),nx=document.getElementById('latestNext');
  if(sl&&pv&&nx){
    var pos=0;
    nx.onclick=function(){var cw=sl.querySelector('a');var w=cw?cw.offsetWidth+10:170;pos=Math.min(pos+w,Math.max(0,sl.scrollWidth-sl.parentElement.offsetWidth));sl.style.transform='translateX(-'+pos+'px)';};
    pv.onclick=function(){var cw=sl.querySelector('a');var w=cw?cw.offsetWidth+10:170;pos=Math.max(pos-w,0);sl.style.transform='translateX(-'+pos+'px)';};
  }
})();
</script>
<style>
.scrollbar-hide::-webkit-scrollbar{display:none}
.scrollbar-hide{-ms-overflow-style:none;scrollbar-width:none}
</style>
