<!-- ═══════════════════════ JAVASCRIPT ═══════════════════════ -->
<script>
(function(){
  // ──── Arama Autocomplete Verileri ────
  const allBrands = <%- JSON.stringify(brands.map(b => ({name:b.name, slug:b.slug, logo:b.logo}))) %>;
  const allCities = <%- JSON.stringify(cities) %>;

  // ──── Marka Autocomplete ────
  const markaInput = document.getElementById('heroMarka');
  const markaDropdown = document.getElementById('heroMarkaDropdown');

  function renderBrandDropdown(list) {
    if (list.length === 0) {
      markaDropdown.classList.add('hidden');
      return;
    }
    markaDropdown.innerHTML = list.map(b => {
      const logoHtml = b.logo
        ? '<img src="' + b.logo + '" alt="" class="size-6 object-contain" onerror="this.style.display=\'none\'">'
        : '<span class="material-symbols-outlined text-slate-400 text-lg">directions_car</span>';
      return '<div class="flex items-center gap-3 px-4 py-2.5 hover:bg-primary/5 cursor-pointer transition-colors" data-slug="' + b.slug + '" data-name="' + b.name + '">' +
        '<div class="size-7 flex items-center justify-center">' + logoHtml + '</div>' +
        '<span class="text-sm font-medium text-slate-700">' + b.name + '</span></div>';
    }).join('');
    markaDropdown.classList.remove('hidden');
    markaDropdown.querySelectorAll('[data-slug]').forEach(el => {
      el.addEventListener('click', function() {
        markaInput.value = this.dataset.name;
        markaInput.dataset.selectedSlug = this.dataset.slug;
        markaDropdown.classList.add('hidden');
      });
    });
  }

  markaInput.addEventListener('focus', () => renderBrandDropdown(allBrands.slice(0, 10)));
  markaInput.addEventListener('input', function() {
    const q = this.value.toLowerCase().trim();
    this.dataset.selectedSlug = '';
    if (!q) { renderBrandDropdown(allBrands.slice(0, 10)); return; }
    renderBrandDropdown(allBrands.filter(b => b.name.toLowerCase().includes(q)));
  });

  // ──── Şehir Autocomplete ────
  const sehirInput = document.getElementById('heroSehir');
  const sehirDropdown = document.getElementById('heroSehirDropdown');

  // Türkiye'nin tüm 81 ili
  const turkishCities = ["Adana","Adıyaman","Afyonkarahisar","Ağrı","Aksaray","Amasya","Ankara","Antalya","Ardahan","Artvin","Aydın","Balıkesir","Bartın","Batman","Bayburt","Bilecik","Bingöl","Bitlis","Bolu","Burdur","Bursa","Çanakkale","Çankırı","Çorum","Denizli","Diyarbakır","Düzce","Edirne","Elazığ","Erzincan","Erzurum","Eskişehir","Gaziantep","Giresun","Gümüşhane","Hakkari","Hatay","Iğdır","Isparta","İstanbul","İzmir","Kahramanmaraş","Karabük","Karaman","Kars","Kastamonu","Kayseri","Kırıkkale","Kırklareli","Kırşehir","Kilis","Kocaeli","Konya","Kütahya","Malatya","Manisa","Mardin","Mersin","Muğla","Muş","Nevşehir","Niğde","Ordu","Osmaniye","Rize","Sakarya","Samsun","Siirt","Sinop","Sivas","Şanlıurfa","Şırnak","Tekirdağ","Tokat","Trabzon","Tunceli","Uşak","Van","Yalova","Yozgat","Zonguldak"];

  function renderCityDropdown(list) {
    if (list.length === 0) { sehirDropdown.classList.add('hidden'); return; }
    sehirDropdown.innerHTML = list.map(c =>
      '<div class="flex items-center gap-3 px-4 py-2.5 hover:bg-primary/5 cursor-pointer transition-colors" data-city="' + c + '">' +
      '<span class="material-symbols-outlined text-slate-400 text-sm">location_on</span>' +
      '<span class="text-sm font-medium text-slate-700">' + c + '</span></div>'
    ).join('');
    sehirDropdown.classList.remove('hidden');
    sehirDropdown.querySelectorAll('[data-city]').forEach(el => {
      el.addEventListener('click', function() {
        sehirInput.value = this.dataset.city;
        sehirDropdown.classList.add('hidden');
      });
    });
  }

  sehirInput.addEventListener('focus', () => renderCityDropdown(turkishCities.slice(0, 10)));
  sehirInput.addEventListener('input', function() {
    const q = this.value.toLowerCase().trim();
    if (!q) { renderCityDropdown(turkishCities.slice(0, 10)); return; }
    renderCityDropdown(turkishCities.filter(c => c.toLowerCase().includes(q)));
  });

  // Dropdown dışına tıklanınca kapat
  document.addEventListener('click', function(e) {
    if (!markaInput.contains(e.target) && !markaDropdown.contains(e.target)) markaDropdown.classList.add('hidden');
    if (!sehirInput.contains(e.target) && !sehirDropdown.contains(e.target)) sehirDropdown.classList.add('hidden');
  });

  // Form submit — slug kullan
  document.getElementById('heroSearchForm').addEventListener('submit', function(e) {
    const slug = markaInput.dataset.selectedSlug;
    if (slug) markaInput.value = slug;
  });

  // Hızlı marka butonları
  document.querySelectorAll('.hero-quick-brand').forEach(btn => {
    btn.addEventListener('click', function() {
      const name = this.dataset.brand;
      const b = allBrands.find(x => x.name === name);
      if (b) {
        markaInput.value = b.name;
        markaInput.dataset.selectedSlug = b.slug;
        markaDropdown.classList.add('hidden');
      }
    });
  });

  // ──── Son İlanlar Slider ────
  const slider = document.getElementById('latestSlider');
  const prevBtn = document.getElementById('latestPrev');
  const nextBtn = document.getElementById('latestNext');
  if (slider && prevBtn && nextBtn) {
    let scrollPos = 0;
    const cardW = window.innerWidth < 640 ? 220 : 320;
    nextBtn.addEventListener('click', () => {
      scrollPos = Math.min(scrollPos + cardW, slider.scrollWidth - slider.parentElement.offsetWidth);
      slider.style.transform = 'translateX(-' + scrollPos + 'px)';
    });
    prevBtn.addEventListener('click', () => {
      scrollPos = Math.max(scrollPos - cardW, 0);
      slider.style.transform = 'translateX(-' + scrollPos + 'px)';
    });
  }
})();
</script>

<style>
.scrollbar-hide::-webkit-scrollbar { display: none; }
.scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
.line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
</style>
