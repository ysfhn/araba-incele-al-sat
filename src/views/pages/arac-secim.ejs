<style>
.wiz-header { background: #f8fafc; border-bottom: 1px solid #e2e8f0; }
.wiz-progress-step { display:flex; align-items:center; gap:8px; }
.wiz-progress-num {
  width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center;
  font-size:13px; font-weight:700; transition:all .3s;
}
.wiz-progress-num.pending { background:#f1f5f9; color:#94a3b8; }
.wiz-progress-num.active { background:#1e293b; color:white; }
.wiz-progress-num.done { background:#22c55e; color:white; }
.wiz-progress-line { width:40px; height:2px; border-radius:2px; transition:background .3s; }
.wiz-card { background:white; border:1px solid #e2e8f0; border-radius:16px; }
.wiz-back-btn {
  display:inline-flex; align-items:center; gap:4px; font-size:13px; font-weight:600;
  color:#64748b; padding:8px 14px; border-radius:10px; transition:all .15s; border:1px solid #e2e8f0;
}
.wiz-back-btn:hover { background:#f1f5f9; color:#334155; }
.wiz-type-btn {
  display:flex; flex-direction:column; align-items:center; gap:8px;
  padding:20px 12px; border-radius:14px; border:2px solid #e2e8f0;
  background:white; transition:all .2s; cursor:pointer; text-align:center;
}
.wiz-type-btn:hover { border-color:#94a3b8; background:#f8fafc; }
.wiz-type-btn.selected { border-color:#1e293b; background:#f8fafc; box-shadow:0 0 0 1px #1e293b; }
.wiz-type-btn .wiz-type-icon {
  width:48px; height:48px; border-radius:12px; background:#f1f5f9;
  display:flex; align-items:center; justify-content:center; transition:all .2s;
}
.wiz-type-btn:hover .wiz-type-icon { background:#e2e8f0; }
.wiz-type-btn.selected .wiz-type-icon { background:#1e293b; color:white; }
.wiz-brand-btn {
  display:flex; flex-direction:column; align-items:center; gap:6px;
  padding:16px 8px; border-radius:12px; border:2px solid transparent;
  background:#f8fafc; transition:all .2s; cursor:pointer;
}
.wiz-brand-btn:hover { border-color:#cbd5e1; background:white; }
.wiz-brand-btn.selected { border-color:#1e293b; background:white; box-shadow:0 0 0 1px #1e293b; }
.wiz-model-btn {
  padding:14px 16px; border-radius:12px; border:2px solid #e2e8f0;
  background:white; transition:all .2s; cursor:pointer; text-align:left;
}
.wiz-model-btn:hover { border-color:#94a3b8; }
.wiz-model-btn.selected { border-color:#1e293b; background:#f8fafc; box-shadow:0 0 0 1px #1e293b; }
.wiz-year-btn {
  padding:14px; border-radius:12px; border:2px solid #e2e8f0;
  background:white; transition:all .2s; cursor:pointer; text-align:center;
  font-weight:700; font-size:15px; color:#334155;
}
.wiz-year-btn:hover { border-color:#94a3b8; }
.wiz-year-btn.selected { border-color:#1e293b; background:#1e293b; color:white; }
.wiz-fuel-btn {
  display:flex; flex-direction:column; align-items:center; gap:8px;
  padding:20px 12px; border-radius:14px; border:2px solid #e2e8f0;
  background:white; transition:all .2s; cursor:pointer; text-align:center;
}
.wiz-fuel-btn:hover { border-color:#94a3b8; }
.wiz-fuel-btn.selected { border-color:#1e293b; background:#f8fafc; box-shadow:0 0 0 1px #1e293b; }
.wiz-fuel-icon { width:44px; height:44px; border-radius:10px; display:flex; align-items:center; justify-content:center; }
.wiz-search-box {
  display:flex; align-items:center; gap:8px; background:#f8fafc;
  border:1px solid #e2e8f0; border-radius:12px; padding:10px 16px;
}
.wiz-search-box input {
  border:none; background:transparent; outline:none; width:100%;
  font-size:14px; color:#334155;
}
.wiz-search-box input::placeholder { color:#94a3b8; }
.wiz-summary-tag {
  display:inline-flex; align-items:center; gap:6px;
  background:#f1f5f9; color:#334155; font-size:13px; font-weight:600;
  padding:6px 14px; border-radius:20px;
}
.wiz-summary-tag .material-symbols-outlined { font-size:16px; color:#64748b; }
</style>

