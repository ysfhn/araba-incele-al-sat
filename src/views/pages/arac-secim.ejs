<script>
const state = { type: null, typeName: '', brandId: null, brandSlug: '', brandName: '', modelId: null, modelSlug: '', modelName: '', year: null, fuel: null, fuelName: '' };
const allBrands = <%- JSON.stringify(brands) %>;

function goToStep(n) {
  document.querySelectorAll('.step-panel').forEach(p => p.classList.add('hidden'));
  document.getElementById('step' + n).classList.remove('hidden');
  updateProgress(n);
}

function updateProgress(current) {
  document.querySelectorAll('.wiz-progress-step').forEach(step => {
    const s = parseInt(step.dataset.step);
    const num = step.querySelector('.wiz-progress-num');
    const label = step.querySelector('span:last-child');
    if (s < current) {
      num.className = 'wiz-progress-num done';
      num.innerHTML = '<span class="material-symbols-outlined" style="font-size:16px">check</span>';
      if (label) { label.className = 'hidden sm:inline text-sm font-semibold text-green-600'; }
    } else if (s === current) {
      num.className = 'wiz-progress-num active';
      num.textContent = s;
      if (label) { label.className = 'hidden sm:inline text-sm font-semibold text-slate-700'; }
    } else {
      num.className = 'wiz-progress-num pending';
      num.textContent = s;
      if (label) { label.className = 'hidden sm:inline text-sm font-medium text-slate-400'; }
    }
  });
  document.querySelectorAll('.wiz-progress-line').forEach(line => {
    const l = parseInt(line.dataset.line);
    line.className = 'wiz-progress-line ' + (l < current ? 'bg-green-400' : 'bg-slate-200');
  });
}

function updateSummary() {
  const tags = [];
  if (state.typeName) tags.push({ label: state.typeName, icon: 'directions_car' });
  if (state.brandName) tags.push({ label: state.brandName, icon: 'star' });
  if (state.modelName) tags.push({ label: state.modelName, icon: 'commute' });
  if (state.year) tags.push({ label: state.year + ' Model', icon: 'calendar_today' });
  if (state.fuelName) tags.push({ label: state.fuelName, icon: 'local_gas_station' });
  const container = document.getElementById('selectionTags');
  if (tags.length === 0) {
    container.innerHTML = '<span class="text-sm text-slate-400">Henüz seçim yapılmadı</span>';
  } else {
    container.innerHTML = tags.map(t =>
      '<span class="wiz-summary-tag"><span class="material-symbols-outlined">' + t.icon + '</span>' + t.label + '</span>'
    ).join('');
  }
}

// Step 1: Tür seçimi
document.querySelectorAll('.type-btn').forEach(btn => {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.type-btn').forEach(b => b.classList.remove('selected'));
    this.classList.add('selected');
    state.type = this.dataset.type;
    state.typeName = this.querySelector('.font-semibold') ? this.querySelector('.font-semibold').textContent : this.querySelector('span:last-child').textContent;
    state.brandId = null; state.brandSlug = ''; state.brandName = '';
    state.modelId = null; state.modelSlug = ''; state.modelName = '';
    state.year = null; state.fuel = null; state.fuelName = '';
    updateSummary();
    setTimeout(() => { loadBrands(); goToStep(2); }, 250);
  });
});

function loadBrands() {
  const grid = document.getElementById('brandGrid');
  const renderBrands = (list) => {
    if (list.length === 0) {
      grid.innerHTML = '<p class="text-slate-400 col-span-full text-center py-8">Marka bulunamadı.</p>';
      return;
    }
    grid.innerHTML = list.map(b => {
      const logoHtml = b.logo
        ? '<img src="' + b.logo + '" alt="' + b.name + '" class="w-8 h-8 object-contain" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'" /><span class="material-symbols-outlined text-lg text-slate-400" style="display:none">directions_car</span>'
        : '<span class="material-symbols-outlined text-lg text-slate-400">directions_car</span>';
      return '<button type="button" data-brand-id="' + b.id + '" data-brand-slug="' + b.slug + '" class="wiz-brand-btn brand-btn">' +
        '<div class="w-10 h-10 flex items-center justify-center">' + logoHtml + '</div>' +
        '<span class="font-semibold text-xs text-slate-700 text-center leading-tight">' + b.name + '</span></button>';
    }).join('');
    grid.querySelectorAll('.brand-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        grid.querySelectorAll('.brand-btn').forEach(b => b.classList.remove('selected'));
        this.classList.add('selected');
        state.brandId = this.dataset.brandId;
        state.brandSlug = this.dataset.brandSlug;
        state.brandName = this.querySelector('.font-semibold').textContent;
        state.modelId = null; state.modelSlug = ''; state.modelName = '';
        state.year = null; state.fuel = null; state.fuelName = '';
        updateSummary();
        setTimeout(() => { loadModels(); goToStep(3); }, 250);
      });
    });
  };
  renderBrands(allBrands);

  const searchInput = document.getElementById('brandSearch');
  if (searchInput) {
    searchInput.value = '';
    searchInput.addEventListener('input', function() {
      const q = this.value.toLowerCase().trim();
      const filtered = q ? allBrands.filter(b => b.name.toLowerCase().includes(q)) : allBrands;
      renderBrands(filtered);
    });
  }
}

async function loadModels() {
  const grid = document.getElementById('modelGrid');
  document.getElementById('modelSubtitle').textContent = state.brandName + ' modelleri';
  grid.innerHTML = '<p class="text-slate-400 col-span-full text-center py-8">Yükleniyor...</p>';
  try {
    const res = await fetch('/api/models/' + state.brandId);
    let models = await res.json();
    if (state.type) {
      const filtered = models.filter(m => m.body_type === state.type);
      if (filtered.length > 0) models = filtered;
    }
    if (models.length === 0) {
      grid.innerHTML = '<p class="text-slate-400 col-span-full text-center py-8">Bu markada seçtiğiniz türde model bulunamadı.</p>';
      return;
    }
    grid.innerHTML = models.map(m =>
      '<button type="button" data-model-id="' + m.id + '" data-model-slug="' + m.slug + '" class="wiz-model-btn model-btn">' +
      '<p class="font-semibold text-sm text-slate-800">' + m.name + '</p>' +
      (m.body_type ? '<p class="text-xs text-slate-400 mt-0.5 capitalize">' + m.body_type + '</p>' : '') +
      '</button>'
    ).join('');
    grid.querySelectorAll('.model-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        grid.querySelectorAll('.model-btn').forEach(b => b.classList.remove('selected'));
        this.classList.add('selected');
        state.modelId = this.dataset.modelId;
        state.modelSlug = this.dataset.modelSlug;
        state.modelName = this.querySelector('p').textContent;
        state.year = null; state.fuel = null; state.fuelName = '';
        updateSummary();
        setTimeout(() => { loadYears(); goToStep(4); }, 250);
      });
    });
  } catch(e) {
    grid.innerHTML = '<p class="text-red-400 col-span-full text-center py-8">Hata oluştu, tekrar deneyin.</p>';
  }
}

function loadYears() {
  const grid = document.getElementById('yearGrid');
  document.getElementById('yearSubtitle').textContent = state.brandName + ' ' + state.modelName + ' — yıl seçin';
  const currentYear = new Date().getFullYear();
  const years = [];
  for (let y = currentYear + 1; y >= currentYear - 15; y--) years.push(y);
  grid.innerHTML = years.map(y =>
    '<button type="button" data-year="' + y + '" class="wiz-year-btn year-btn">' + y + '</button>'
  ).join('');
  grid.querySelectorAll('.year-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      grid.querySelectorAll('.year-btn').forEach(b => b.classList.remove('selected'));
      this.classList.add('selected');
      state.year = parseInt(this.dataset.year);
      state.fuel = null; state.fuelName = '';
      updateSummary();
      setTimeout(() => { goToStep(5); }, 250);
    });
  });
}

// Step 5: Yakıt türü
document.querySelectorAll('.fuel-btn').forEach(btn => {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.fuel-btn').forEach(b => b.classList.remove('selected'));
    this.classList.add('selected');
    state.fuel = this.dataset.fuel;
    state.fuelName = this.querySelector('.font-semibold').textContent;
    updateSummary();
    setTimeout(() => {
      window.location.href = '/arac/' + state.brandSlug + '/' + state.modelSlug + '?yil=' + state.year + '&yakit=' + state.fuel;
    }, 400);
  });
});
</script>
