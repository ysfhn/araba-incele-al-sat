<main class="container mx-auto px-6 py-8 max-w-4xl">
<div class="flex items-center text-sm text-slate-500 mb-6 gap-1">
<a href="/" class="hover:text-primary">Ana Sayfa</a><span>/</span><span class="text-slate-800 font-medium">İlan Ver</span>
</div>

<div class="bg-white rounded-2xl border border-slate-100 p-8">
<h1 class="text-2xl font-bold text-slate-900 mb-2">Araç İlanı Oluştur</h1>
<p class="text-slate-500 mb-8">Aracınızın bilgilerini girerek hemen ilan verebilirsiniz.</p>

<%- include('../partials/flash') %>

<form action="/ilan/ver" method="POST" class="space-y-6" id="ilanForm">

<!-- ═══ BÖLÜM 1: Marka / Model / Yıl (Temel Cascade) ═══ -->
<div style="background:#f8fafb;border-radius:12px;padding:1.25rem;border:1px solid #e8ecf0;">
<h2 style="font-size:.95rem;font-weight:700;color:#1a1f36;margin:0 0 1rem;display:flex;align-items:center;gap:.5rem;"><span class="material-symbols-outlined" style="font-size:1.1rem;color:#1a73e8;">directions_car</span> Araç Bilgileri</h2>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
<div>
<label class="block text-sm font-semibold text-slate-700 mb-1">Marka <span class="text-red-500">*</span></label>
<select name="brand_id" id="brand_id" required class="w-full rounded-xl border-slate-200 focus:border-primary focus:ring-primary">
<option value="">Marka seçin</option>
<% brands.forEach(b => { %><option value="<%= b.id %>" data-slug="<%= b.slug %>"><%= b.name %></option><% }) %>
</select>
</div>
<div>
<label class="block text-sm font-semibold text-slate-700 mb-1">Model <span class="text-red-500">*</span></label>
<select name="model_id" id="model_id" required class="w-full rounded-xl border-slate-200 focus:border-primary focus:ring-primary">
<option value="">Önce marka seçin</option>
</select>
</div>
<div>
<label class="block text-sm font-semibold text-slate-700 mb-1">Model Yılı <span class="text-red-500">*</span></label>
<select name="year" id="year_select" required class="w-full rounded-xl border-slate-200 focus:border-primary focus:ring-primary">
<option value="">Önce model seçin</option>
</select>
</div>
</div>
</div>

<!-- ═══ BÖLÜM 2: Teknik Cascade (Yakıt → Şanzıman → Motor → Paket) ═══ -->
<div id="techSection" style="background:#f8fafb;border-radius:12px;padding:1.25rem;border:1px solid #e8ecf0;display:none;">
<h2 style="font-size:.95rem;font-weight:700;color:#1a1f36;margin:0 0 1rem;display:flex;align-items:center;gap:.5rem;"><span class="material-symbols-outlined" style="font-size:1.1rem;color:#e8710a;">build</span> Teknik Özellikler</h2>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
<div>
<label class="block text-sm font-semibold text-slate-700 mb-1">Yakıt Tipi <span class="text-red-500">*</span></label>
<select name="fuel_type" id="fuel_select" required class="w-full rounded-xl border-slate-200 focus:border-primary focus:ring-primary">
<option value="">Yükleniyor...</option>
</select>
</div>
<div>
<label class="block text-sm font-semibold text-slate-700 mb-1">Şanzıman <span class="text-red-500">*</span></label>
<select name="transmission" id="transmission_select" required class="w-full rounded-xl border-slate-200 focus:border-primary focus:ring-primary">
<option value="">Önce yakıt seçin</option>
</select>
</div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
<div>
<label class="block text-sm font-semibold text-slate-700 mb-1">Motor Tipi</label>
<select name="engine_type" id="engine_select" class="w-full rounded-xl border-slate-200 focus:border-primary focus:ring-primary">
<option value="">Önce şanzıman seçin</option>
</select>
</div>
<div>
<label class="block text-sm font-semibold text-slate-700 mb-1">Paket / Donanım</label>
<select name="package" id="package_select" class="w-full rounded-xl border-slate-200 focus:border-primary focus:ring-primary">
<option value="">Önce motor seçin</option>
</select>
</div>
</div>
<!-- Otomatik doldurulan gizli alanlar -->
<input type="hidden" name="hp" id="hp_hidden"/>
<input type="hidden" name="cc" id="cc_hidden"/>
</div>

<!-- ═══ BÖLÜM 3: Ek Bilgiler (Kasa, KM, Renk, Çekiş) ═══ -->
<div id="extraSection" style="background:#f8fafb;border-radius:12px;padding:1.25rem;border:1px solid #e8ecf0;display:none;">
<h2 style="font-size:.95rem;font-weight:700;color:#1a1f36;margin:0 0 1rem;display:flex;align-items:center;gap:.5rem;"><span class="material-symbols-outlined" style="font-size:1.1rem;color:#7c3aed;">tune</span> Ek Bilgiler</h2>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
<div>
<label class="block text-sm font-semibold text-slate-700 mb-1">Gövde Tipi</label>
<select name="body_type" class="w-full rounded-xl border-slate-200 focus:border-primary focus:ring-primary">
<option value="">Seçin</option>
<option value="Sedan">Sedan</option><option value="HB">Hatchback</option><option value="SUV">SUV</option>
<option value="Coupe">Coupe</option><option value="Cabrio">Cabrio</option><option value="Station Wagon">Station Wagon</option>
<option value="MPV">MPV</option><option value="Pick-up">Pick-up</option><option value="Van">Van</option>
</select>
</div>
<div>
<label class="block text-sm font-semibold text-slate-700 mb-1">Kilometre <span class="text-red-500">*</span></label>
<input name="km" type="number" min="0" required placeholder="ör: 50000" class="w-full rounded-xl border-slate-200 focus:border-primary focus:ring-primary"/>
</div>
<div>
<label class="block text-sm font-semibold text-slate-700 mb-1">Renk</label>
<select name="color" class="w-full rounded-xl border-slate-200 focus:border-primary focus:ring-primary">
<option value="">Seçin</option>
<option value="Beyaz">⬜ Beyaz</option><option value="Siyah">⬛ Siyah</option><option value="Gri">🔲 Gri</option>
<option value="Kırmızı">🟥 Kırmızı</option><option value="Mavi">🟦 Mavi</option><option value="Lacivert">🔵 Lacivert</option>
<option value="Yeşil">🟩 Yeşil</option><option value="Sarı">🟨 Sarı</option><option value="Turuncu">🟧 Turuncu</option>
<option value="Kahverengi">🟫 Kahverengi</option><option value="Bej">🏖️ Bej</option><option value="Gümüş">🪙 Gümüş</option>
<option value="Bordo">🍷 Bordo</option><option value="Diğer">Diğer</option>
</select>
</div>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
<div>
<label class="block text-sm font-semibold text-slate-700 mb-1">Çekiş Tipi</label>
<select name="drive_type" class="w-full rounded-xl border-slate-200 focus:border-primary focus:ring-primary">
<option value="">Seçin</option>
<option value="FWD">Önden Çekiş (FWD)</option><option value="RWD">Arkadan İtiş (RWD)</option><option value="AWD">4x4 (AWD)</option>
</select>
</div>
</div>
</div>

<!-- ═══ BÖLÜM 4: Durum & Konum ═══ -->
<div style="background:#f8fafb;border-radius:12px;padding:1.25rem;border:1px solid #e8ecf0;">
<h2 style="font-size:.95rem;font-weight:700;color:#1a1f36;margin:0 0 1rem;display:flex;align-items:center;gap:.5rem;"><span class="material-symbols-outlined" style="font-size:1.1rem;color:#1e8e3e;">location_on</span> Durum & Konum</h2>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
<div>
<label class="block text-sm font-semibold text-slate-700 mb-1">İl <span class="text-red-500">*</span></label>
<select name="city" id="citySelect" required class="w-full rounded-xl border-slate-200 focus:border-primary focus:ring-primary">
<option value="">Seçin</option>
<option>Adana</option><option>Adıyaman</option><option>Afyonkarahisar</option><option>Ağrı</option>
<option>Aksaray</option><option>Amasya</option><option>Ankara</option><option>Antalya</option>
<option>Artvin</option><option>Aydın</option><option>Balıkesir</option><option>Bartın</option>
<option>Batman</option><option>Bayburt</option><option>Bilecik</option><option>Bingöl</option>
<option>Bitlis</option><option>Bolu</option><option>Burdur</option><option>Bursa</option>
<option>Çanakkale</option><option>Çankırı</option><option>Çorum</option><option>Denizli</option>
<option>Diyarbakır</option><option>Düzce</option><option>Edirne</option><option>Elazığ</option>
<option>Erzincan</option><option>Erzurum</option><option>Eskişehir</option><option>Gaziantep</option>
<option>Giresun</option><option>Gümüşhane</option><option>Hakkari</option><option>Hatay</option>
<option>Iğdır</option><option>Isparta</option><option>İstanbul</option><option>İzmir</option>
<option>Kahramanmaraş</option><option>Karabük</option><option>Karaman</option><option>Kars</option>
<option>Kastamonu</option><option>Kayseri</option><option>Kırıkkale</option><option>Kırklareli</option>
<option>Kırşehir</option><option>Kilis</option><option>Kocaeli</option><option>Konya</option>
<option>Kütahya</option><option>Malatya</option><option>Manisa</option><option>Mardin</option>
<option>Mersin</option><option>Muğla</option><option>Muş</option><option>Nevşehir</option>
<option>Niğde</option><option>Ordu</option><option>Osmaniye</option><option>Rize</option>
<option>Sakarya</option><option>Samsun</option><option>Siirt</option><option>Sinop</option>
<option>Sivas</option><option>Şanlıurfa</option><option>Şırnak</option><option>Tekirdağ</option>
<option>Tokat</option><option>Trabzon</option><option>Tunceli</option><option>Uşak</option>
<option>Van</option><option>Yalova</option><option>Yozgat</option><option>Zonguldak</option>
</select>
</div>
<div>
<label class="block text-sm font-semibold text-slate-700 mb-1">İlçe</label>
<input name="district" type="text" placeholder="ör: Kadıköy" class="w-full rounded-xl border-slate-200 focus:border-primary focus:ring-primary"/>
</div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
<label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-50 transition-colors">
<input type="checkbox" name="damage_free" value="1" checked class="w-5 h-5 rounded text-primary focus:ring-primary"/>
<div><span class="text-sm font-semibold text-slate-700">Boyasız / Hasarsız</span><p class="text-xs text-slate-400 mt-0.5">Araç boyasız ve hasarsız durumda</p></div>
</label>
<label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-50 transition-colors">
<input type="checkbox" name="trade_in" value="1" class="w-5 h-5 rounded text-primary focus:ring-primary"/>
<div><span class="text-sm font-semibold text-slate-700">Takasa Açık</span><p class="text-xs text-slate-400 mt-0.5">Takas tekliflerini değerlendiriyorum</p></div>
</label>
</div>
</div>

<!-- ═══ BÖLÜM 5: Fiyat & İlan Bilgileri ═══ -->
<div style="background:#f8fafb;border-radius:12px;padding:1.25rem;border:1px solid #e8ecf0;">
<h2 style="font-size:.95rem;font-weight:700;color:#1a1f36;margin:0 0 1rem;display:flex;align-items:center;gap:.5rem;"><span class="material-symbols-outlined" style="font-size:1.1rem;color:#9334e6;">sell</span> Fiyat & Detaylar</h2>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
<div>
<label class="block text-sm font-semibold text-slate-700 mb-1">Fiyat (₺) <span class="text-red-500">*</span></label>
<input id="priceDisplay" type="text" inputmode="numeric" required placeholder="ör: 500.000" class="w-full rounded-xl border-slate-200 focus:border-primary focus:ring-primary" oninput="formatPriceInput(this)" autocomplete="off"/>
<input name="price" type="hidden" id="priceHidden"/>
<p class="text-xs text-slate-400 mt-1" id="priceFormatted"></p>
</div>
<div>
<label class="block text-sm font-semibold text-slate-700 mb-1">İlan Başlığı (opsiyonel)</label>
<input name="title" type="text" placeholder="Otomatik oluşturulur" class="w-full rounded-xl border-slate-200 focus:border-primary focus:ring-primary"/>
</div>
</div>
<div class="mt-4">
<label class="block text-sm font-semibold text-slate-700 mb-1">Açıklama</label>
<textarea name="description" rows="5" placeholder="Aracınız hakkında detaylı bilgi verin..." class="w-full rounded-xl border-slate-200 focus:border-primary focus:ring-primary"></textarea>
</div>
</div>

<!-- ═══ BÖLÜM 6: Araç Fotoğrafları ═══ -->
<div style="background:#f8fafb;border-radius:12px;padding:1.25rem;border:1px solid #e8ecf0;">
<h2 style="font-size:.95rem;font-weight:700;color:#1a1f36;margin:0 0 1rem;display:flex;align-items:center;gap:.5rem;"><span class="material-symbols-outlined" style="font-size:1.1rem;color:#0891b2;">photo_camera</span> Araç Fotoğrafları</h2>
<p style="margin:0 0 .75rem;font-size:.8rem;color:#64748b;">En fazla <strong>10</strong> fotoğraf yükleyebilirsiniz. İlk fotoğraf kapak görseli olarak kullanılır. Sürükle-bırak veya tıklayarak ekleyin.</p>

<div id="imageUploadArea" style="border:2px dashed #cbd5e1;border-radius:12px;padding:2rem;text-align:center;cursor:pointer;transition:all .2s;background:#fff;" ondragover="event.preventDefault();this.style.borderColor='#1a73e8';this.style.background='#eff6ff';" ondragleave="this.style.borderColor='#cbd5e1';this.style.background='#fff';" ondrop="handleDrop(event)" onclick="document.getElementById('imageFileInput').click()">
<span class="material-symbols-outlined" style="font-size:3rem;color:#94a3b8;">cloud_upload</span>
<p style="margin:.5rem 0 0;font-size:.9rem;color:#64748b;font-weight:600;">Fotoğrafları sürükleyin veya tıklayın</p>
<p style="margin:.25rem 0 0;font-size:.75rem;color:#94a3b8;">JPG, PNG, WebP — Maks. 5 MB / fotoğraf</p>
</div>
<input type="file" id="imageFileInput" multiple accept="image/jpeg,image/png,image/webp" style="display:none" onchange="handleFiles(this.files)"/>

<!-- Yüklenen fotoğraf önizlemeleri -->
<div id="imagePreviewGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:.75rem;margin-top:1rem;"></div>

<!-- Gizli alanlar (base64 verileri) -->
<div id="imageHiddenInputs"></div>
</div>

<!-- Bilgi Notu -->
<div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:12px;padding:1rem 1.25rem;display:flex;gap:.75rem;align-items:start;">
<span class="material-symbols-outlined" style="color:#3b82f6;font-size:1.25rem;margin-top:2px;">info</span>
<div>
<p style="margin:0;font-size:.85rem;color:#1e40af;font-weight:600;">İlan Oluşturma Bilgisi</p>
<p style="margin:.25rem 0 0;font-size:.8rem;color:#3b82f6;">İlanınız admin ekibimiz tarafından incelendikten sonra yayına alınacaktır.</p>
</div>
</div>

<button type="submit" class="w-full bg-primary text-white font-bold py-4 rounded-xl hover:bg-primary/90 transition-all text-lg flex items-center justify-center gap-2">
<span class="material-symbols-outlined">publish</span> İlanı Gönder
</button>
</form>
</div>
</main>

<script>
// ═══════════════════════════════════════
//  CASCADE SELECTİON ENGİNE
// ═══════════════════════════════════════
const $ = s => document.querySelector(s);
const brandSel = $('#brand_id');
const modelSel = $('#model_id');
const yearSel  = $('#year_select');
const fuelSel  = $('#fuel_select');
const transSel = $('#transmission_select');
const engineSel = $('#engine_select');
const pkgSel   = $('#package_select');
const techSec  = $('#techSection');
const extraSec = $('#extraSection');

let currentBrandSlug = '';
let currentModelSlug = '';
let cascadeData = null;   // cached /variants/cascade response
let allEngines = [];      // full engine objects from cascade

// ── Helper: populate select, auto-select if single option ──
function fillSelect(sel, items, placeholder, valueFn, labelFn) {
  sel.innerHTML = '';
  if (!items || items.length === 0) {
    sel.innerHTML = `<option value="">${placeholder}</option>`;
    sel.disabled = true;
    return;
  }
  sel.disabled = false;
  if (items.length === 1) {
    // Tek seçenek → otomatik seç
    sel.innerHTML = `<option value="${valueFn(items[0])}">${labelFn(items[0])}</option>`;
    sel.value = valueFn(items[0]);
    sel.dispatchEvent(new Event('change'));
    return;
  }
  sel.innerHTML = `<option value="">${placeholder}</option>` + items.map(i => `<option value="${valueFn(i)}">${labelFn(i)}</option>`).join('');
}

// ── 1) Marka değişince → Model yükle ──
brandSel.addEventListener('change', async function() {
  const opt = this.options[this.selectedIndex];
  currentBrandSlug = opt?.dataset?.slug || '';
  modelSel.innerHTML = '<option value="">Yükleniyor...</option>';
  yearSel.innerHTML = '<option value="">Önce model seçin</option>';
  techSec.style.display = 'none';
  extraSec.style.display = 'none';
  resetCascade();

  if (!this.value) { modelSel.innerHTML = '<option value="">Önce marka seçin</option>'; return; }
  try {
    const res = await fetch('/api/models/' + this.value);
    const models = await res.json();
    modelSel.innerHTML = '<option value="">Model seçin</option>' + models.map(m =>
      `<option value="${m.id}" data-slug="${m.slug}">${m.name}${m.body_type ? ' ('+m.body_type+')' : ''}</option>`
    ).join('');
  } catch(e) { modelSel.innerHTML = '<option value="">Hata oluştu</option>'; }
});

// ── 2) Model değişince → Yıl + Cascade yükle ──
modelSel.addEventListener('change', async function() {
  const opt = this.options[this.selectedIndex];
  currentModelSlug = opt?.dataset?.slug || '';
  yearSel.innerHTML = '<option value="">Yükleniyor...</option>';
  techSec.style.display = 'none';
  extraSec.style.display = 'none';
  resetCascade();

  if (!this.value || !currentBrandSlug || !currentModelSlug) {
    yearSel.innerHTML = '<option value="">Önce model seçin</option>';
    return;
  }

  try {
    // Cascade endpoint'ten tüm veriyi çek
    const res = await fetch(`/api/variants/cascade/${currentBrandSlug}/${currentModelSlug}`);
    if (res.ok) {
      cascadeData = await res.json();
      // Yılları doldur
      fillSelect(yearSel, cascadeData.years, 'Yıl seçin', y => y, y => y);
    } else {
      // Varyant verisi yoksa — statik yıl listesi göster
      cascadeData = null;
      const years = [];
      for (let y = 2026; y >= 1980; y--) years.push(y);
      fillSelect(yearSel, years, 'Yıl seçin', y => y, y => y);
    }
  } catch(e) {
    cascadeData = null;
    yearSel.innerHTML = '<option value="">Hata oluştu</option>';
  }
});

// ── 3) Yıl değişince → Yakıt tiplerini göster ──
yearSel.addEventListener('change', function() {
  if (!this.value) { techSec.style.display = 'none'; extraSec.style.display = 'none'; return; }

  if (cascadeData && cascadeData.fuels) {
    fillSelect(fuelSel, cascadeData.fuels, 'Yakıt seçin', f => f.key, f => f.label);
    techSec.style.display = 'block';
    extraSec.style.display = 'block';
  } else {
    // Varyant verisi yoksa statik seçenekler göster
    const staticFuels = [
      {key:'benzin',label:'Benzin'},{key:'dizel',label:'Dizel'},{key:'elektrik',label:'Elektrik'},
      {key:'hibrit',label:'Hibrit'},{key:'lpg',label:'LPG'}
    ];
    fillSelect(fuelSel, staticFuels, 'Yakıt seçin', f => f.key, f => f.label);
    techSec.style.display = 'block';
    extraSec.style.display = 'block';
    // Statik modda şanzıman da hemen göster
    const staticTrans = [{key:'otomatik',label:'Otomatik'},{key:'manuel',label:'Manuel'},{key:'yari-otomatik',label:'Yarı Otomatik'}];
    fillSelect(transSel, staticTrans, 'Şanzıman seçin', t => t.key, t => t.label);
    engineSel.innerHTML = '<option value="">-</option>';
    pkgSel.innerHTML = '<option value="">-</option>';
  }
});

// ── 4) Yakıt değişince → Şanzıman güncelle ──
fuelSel.addEventListener('change', async function() {
  if (!this.value || !cascadeData) {
    if (!cascadeData) return; // statik mod
    transSel.innerHTML = '<option value="">Önce yakıt seçin</option>';
    return;
  }
  try {
    const res = await fetch(`/api/variants/cascade/${currentBrandSlug}/${currentModelSlug}?fuel=${this.value}`);
    const data = await res.json();
    fillSelect(transSel, data.transmissions, 'Şanzıman seçin', t => t.key, t => t.label);
    allEngines = data.engines || [];
  } catch(e) { transSel.innerHTML = '<option value="">Hata</option>'; }
});

// ── 5) Şanzıman değişince → Motor güncelle ──
transSel.addEventListener('change', async function() {
  if (!this.value || !cascadeData) {
    if (!cascadeData) return;
    engineSel.innerHTML = '<option value="">Önce şanzıman seçin</option>';
    return;
  }
  try {
    const res = await fetch(`/api/variants/cascade/${currentBrandSlug}/${currentModelSlug}?fuel=${fuelSel.value}&transmission=${this.value}`);
    const data = await res.json();
    allEngines = data.engines || [];
    fillSelect(engineSel, allEngines, 'Motor seçin', e => e.engine, e => e.engine + (e.hp ? ' (' + e.hp + ' HP)' : ''));
  } catch(e) { engineSel.innerHTML = '<option value="">Hata</option>'; }
});

// ── 6) Motor değişince → HP/CC otomatik doldur + Paket güncelle ──
engineSel.addEventListener('change', async function() {
  const selected = allEngines.find(e => e.engine === this.value);
  if (selected) {
    $('#hp_hidden').value = selected.hp || '';
    $('#cc_hidden').value = selected.cc || '';
  } else {
    $('#hp_hidden').value = '';
    $('#cc_hidden').value = '';
  }

  if (!this.value || !cascadeData) {
    if (!cascadeData) return;
    pkgSel.innerHTML = '<option value="">Önce motor seçin</option>';
    return;
  }
  try {
    const res = await fetch(`/api/variants/packages/${currentBrandSlug}/${currentModelSlug}?fuel=${fuelSel.value}&transmission=${transSel.value}&engine=${encodeURIComponent(this.value)}`);
    const data = await res.json();
    fillSelect(pkgSel, data.packages, 'Paket seçin', p => p, p => p);
  } catch(e) { pkgSel.innerHTML = '<option value="">Hata</option>'; }
});

function resetCascade() {
  fuelSel.innerHTML = '<option value="">Önce model seçin</option>';
  transSel.innerHTML = '<option value="">Önce yakıt seçin</option>';
  engineSel.innerHTML = '<option value="">Önce şanzıman seçin</option>';
  pkgSel.innerHTML = '<option value="">Önce motor seçin</option>';
  $('#hp_hidden').value = '';
  $('#cc_hidden').value = '';
  allEngines = [];
  cascadeData = null;
}

// Fiyat formatlama
function formatPriceInput(input) {
  // Sadece rakamları al
  var raw = input.value.replace(/[^0-9]/g, '');
  // Başındaki sıfırları sil
  raw = raw.replace(/^0+/, '');
  // Gizli input'a saf sayıyı yaz
  document.getElementById('priceHidden').value = raw;
  // Görüntülenen input'a formatlı yaz
  if (raw) {
    input.value = parseInt(raw).toLocaleString('tr-TR');
    document.getElementById('priceFormatted').textContent = '≈ ' + parseInt(raw).toLocaleString('tr-TR') + ' ₺';
  } else {
    input.value = '';
    document.getElementById('priceFormatted').textContent = '';
  }
}

// ═══════════════════════════════════════
//  FOTOĞRAF YÜKLEME SİSTEMİ
// ═══════════════════════════════════════
const MAX_IMAGES = 10;
const MAX_FILE_SIZE = 5 * 1024 * 1024; // 5MB
const MAX_DIMENSION = 1200; // Resize büyük resimleri
const JPEG_QUALITY = 0.7; // Sıkıştırma kalitesi
let uploadedImages = []; // [{id, dataUrl}]

function handleDrop(e) {
  e.preventDefault();
  const area = document.getElementById('imageUploadArea');
  area.style.borderColor = '#cbd5e1';
  area.style.background = '#fff';
  if (e.dataTransfer.files.length) handleFiles(e.dataTransfer.files);
}

function handleFiles(fileList) {
  const files = Array.from(fileList);
  for (const file of files) {
    if (uploadedImages.length >= MAX_IMAGES) {
      alert(`En fazla ${MAX_IMAGES} fotoğraf yükleyebilirsiniz.`);
      break;
    }
    if (!['image/jpeg','image/png','image/webp'].includes(file.type)) {
      alert(`"${file.name}" desteklenmeyen format. JPG, PNG veya WebP kullanın.`);
      continue;
    }
    if (file.size > MAX_FILE_SIZE) {
      alert(`"${file.name}" çok büyük (${(file.size/1024/1024).toFixed(1)} MB). Maks. 5 MB.`);
      continue;
    }
    compressAndAdd(file);
  }
}

function compressAndAdd(file) {
  const reader = new FileReader();
  reader.onload = function(e) {
    const img = new Image();
    img.onload = function() {
      // Canvas ile resize + compress
      const canvas = document.createElement('canvas');
      let w = img.width, h = img.height;
      if (w > MAX_DIMENSION || h > MAX_DIMENSION) {
        if (w > h) { h = Math.round(h * MAX_DIMENSION / w); w = MAX_DIMENSION; }
        else { w = Math.round(w * MAX_DIMENSION / h); h = MAX_DIMENSION; }
      }
      canvas.width = w;
      canvas.height = h;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0, w, h);
      const dataUrl = canvas.toDataURL('image/jpeg', JPEG_QUALITY);
      const id = 'img_' + Date.now() + '_' + Math.random().toString(36).slice(2,6);
      uploadedImages.push({ id, dataUrl });
      renderPreviews();
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}

function renderPreviews() {
  const grid = document.getElementById('imagePreviewGrid');
  const hiddens = document.getElementById('imageHiddenInputs');
  grid.innerHTML = '';
  hiddens.innerHTML = '';

  uploadedImages.forEach((item, i) => {
    // Hidden input
    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'images';
    input.value = item.dataUrl;
    hiddens.appendChild(input);

    // Preview card
    const card = document.createElement('div');
    card.style.cssText = 'position:relative;border-radius:10px;overflow:hidden;aspect-ratio:4/3;background:#f1f5f9;border:2px solid ' + (i===0?'#1a73e8':'#e2e8f0') + ';';
    card.innerHTML = `
      <img src="${item.dataUrl}" style="width:100%;height:100%;object-fit:cover;"/>
      ${i===0 ? '<span style="position:absolute;top:4px;left:4px;background:#1a73e8;color:#fff;font-size:.6rem;padding:2px 6px;border-radius:6px;font-weight:700;">KAPAK</span>' : ''}
      <button type="button" onclick="removeImage('${item.id}')" style="position:absolute;top:4px;right:4px;background:rgba(0,0,0,.6);color:#fff;border:none;width:24px;height:24px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:14px;line-height:1;">&times;</button>
      ${i > 0 ? '<button type="button" onclick="moveImageToFirst(\''+item.id+'\')" style="position:absolute;bottom:4px;left:4px;background:rgba(0,0,0,.55);color:#fff;border:none;font-size:.55rem;padding:2px 6px;border-radius:6px;cursor:pointer;">Kapak Yap</button>' : ''}
    `;
    grid.appendChild(card);
  });

  // Yükleme alanı gizle/göster
  const area = document.getElementById('imageUploadArea');
  if (uploadedImages.length >= MAX_IMAGES) {
    area.style.display = 'none';
  } else {
    area.style.display = 'block';
  }
}

function removeImage(id) {
  uploadedImages = uploadedImages.filter(img => img.id !== id);
  renderPreviews();
}

function moveImageToFirst(id) {
  const idx = uploadedImages.findIndex(img => img.id === id);
  if (idx > 0) {
    const [item] = uploadedImages.splice(idx, 1);
    uploadedImages.unshift(item);
    renderPreviews();
  }
}

// Form gönderilmeden önce toplam boyut kontrolü
document.getElementById('ilanForm').addEventListener('submit', function(e) {
  if (uploadedImages.length > 0) {
    const totalSize = uploadedImages.reduce((sum, img) => sum + img.dataUrl.length, 0);
    // Vercel limit ~4.5MB, güvenli sınır 4MB
    if (totalSize > 4 * 1024 * 1024) {
      const sizeMB = (totalSize / 1024 / 1024).toFixed(1);
      if (!confirm(`Toplam fotoğraf boyutu ${sizeMB} MB. Sunucu limiti nedeniyle bazı fotoğraflar kaldırılabilir. Daha az fotoğraf yüklemek ister misiniz?`)) {
        e.preventDefault();
        return;
      }
    }
  }
});

// Düzenleme modunda mevcut resimleri yükle
<% if (editMode && images && images.length > 0) { %>
(function() {
  const existingImages = <%- JSON.stringify(images.filter(img => img.url !== '/images/car-placeholder.svg').map(img => img.url)) %>;
  existingImages.forEach((url, i) => {
    const id = 'existing_' + i;
    uploadedImages.push({ id, dataUrl: url });
  });
  if (uploadedImages.length > 0) renderPreviews();
})();
<% } %>
</script>
