        .brand-card:hover{box-shadow:0 4px 16px rgba(0,0,0,.1);}
        .brand-header{display:flex;align-items:center;gap:1rem;padding:1rem 1.25rem;cursor:pointer;user-select:none;transition:background .15s;}
        .brand-header:hover{background:#f8f9fa;}
        .brand-logo{width:40px;height:40px;border-radius:8px;object-fit:contain;background:#f8f9fa;padding:4px;flex-shrink:0;border:1px solid #eee;}
        .brand-logo-placeholder{width:40px;height:40px;border-radius:8px;background:#e8f0fe;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-weight:700;color:#1a73e8;font-size:1rem;}
        .brand-info{flex:1;min-width:0;}
        .brand-info h3{margin:0;font-size:.95rem;font-weight:700;color:#1a1f36;}
        .brand-info .brand-meta{display:flex;gap:1rem;font-size:.75rem;color:#999;margin-top:2px;}
        .brand-meta span{display:flex;align-items:center;gap:3px;}
        .brand-meta .material-icons{font-size:.85rem;}
        .brand-expand{width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:50%;transition:all .2s;color:#999;}
        .brand-expand.open{transform:rotate(180deg);color:#1a73e8;}
        .brand-models{display:none;padding:0 1.25rem 1rem;border-top:1px solid #f0f0f0;}
        .brand-models.show{display:block;}
        .model-row{display:flex;align-items:center;gap:.75rem;padding:.6rem .5rem;border-bottom:1px solid #f5f5f5;font-size:.85rem;transition:background .15s;}
        .model-row:hover{background:#f8f9ff;}
        .model-row:last-child{border-bottom:none;}
        .model-row .model-name{flex:1;font-weight:600;color:#1a1f36;}
        .model-row .model-info{display:flex;gap:1rem;color:#999;font-size:.75rem;}
        .model-row .model-info span{display:flex;align-items:center;gap:3px;}
        .add-model-inline{display:flex;gap:.5rem;padding:.75rem .5rem;align-items:end;}
        .add-model-inline input,.add-model-inline select{padding:7px 10px;border:1px solid #ddd;border-radius:6px;font-size:.8rem;}
        .add-model-inline input{flex:1;}
        .search-brands{margin-bottom:1rem;padding:10px 14px;border:1px solid #ddd;border-radius:10px;width:100%;font-size:.9rem;box-sizing:border-box;}
        .search-brands:focus{outline:none;border-color:#1a73e8;box-shadow:0 0 0 3px rgba(26,115,232,.1);}
        .brand-stats-bar{display:flex;gap:1rem;margin-bottom:1.5rem;}
        .brand-stat{background:#fff;border-radius:10px;padding:.75rem 1.25rem;display:flex;align-items:center;gap:.75rem;box-shadow:0 1px 4px rgba(0,0,0,.06);flex:1;}
        .brand-stat .material-icons{font-size:1.5rem;opacity:.5;}
        .brand-stat h4{margin:0;font-size:1.2rem;font-weight:700;color:#1a1f36;}.brand-stat p{margin:0;font-size:.7rem;color:#999;}
      </style>

      <div class="admin-header">
        <h1>🏷️ Marka & Model Yönetimi</h1>
        <button class="btn-sm btn-primary" onclick="openBrandModal()"><span class="material-icons">add</span> Yeni Marka</button>
      </div>

      <div class="brand-stats-bar">
        <div class="brand-stat"><span class="material-icons" style="color:#1a73e8;">category</span><div><h4><%= (data.brands||[]).length %></h4><p>Marka</p></div></div>
        <div class="brand-stat"><span class="material-icons" style="color:#1e8e3e;">directions_car</span><div><h4><%= (data.models||[]).length %></h4><p>Model</p></div></div>
        <div class="brand-stat"><span class="material-icons" style="color:#e8710a;">hub</span><div><h4><%= (data.models||[]).reduce((s,m)=>s+m.hub_count,0) %></h4><p>Hub</p></div></div>
      </div>

      <input type="text" class="search-brands" id="brandSearch" placeholder="🔍 Marka ara..." oninput="filterBrands(this.value)">

      <div id="brandList">
      <% (data.brands || []).forEach(b => { 
        const bModels = data.modelsByBrand[b.id] || [];
      %>
        <div class="brand-card" data-brand-name="<%= b.name.toLowerCase() %>">
          <div class="brand-header" onclick="toggleBrand(<%= b.id %>)">
            <% if (b.logo) { %>
              <img src="<%= b.logo %>" alt="<%= b.name %>" class="brand-logo" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
              <div class="brand-logo-placeholder" style="display:none;"><%= b.name.charAt(0) %></div>
            <% } else { %>
              <div class="brand-logo-placeholder"><%= b.name.charAt(0) %></div>
            <% } %>
            <div class="brand-info">
              <h3><%= b.name %></h3>
              <div class="brand-meta">
                <span><span class="material-icons">directions_car</span> <%= b.model_count %> model</span>
                <span><span class="material-icons">list_alt</span> <%= b.listing_count %> ilan</span>
                <span><span class="material-icons">hub</span> <%= b.hub_count %> hub</span>
                <span style="color:#bbb;"><code><%= b.slug %></code></span>
              </div>
            </div>
            <div class="action-btns" style="margin-right:.5rem;" onclick="event.stopPropagation()">
              <button class="btn-sm btn-primary" data-edit-brand="<%= b.id %>" data-brand-name="<%= b.name %>" data-brand-logo="<%= b.logo || '' %>" title="Düzenle"><span class="material-icons">edit</span></button>
              <button class="btn-sm btn-danger" data-admin-delete-brand data-brand-id="<%= b.id %>" title="Sil"><span class="material-icons">delete</span></button>
            </div>
            <div class="brand-expand" id="expand_<%= b.id %>"><span class="material-icons">expand_more</span></div>
          </div>
          <div class="brand-models" id="models_<%= b.id %>">
            <% if (bModels.length === 0) { %>
              <p style="color:#999;text-align:center;padding:1rem;font-size:.85rem;">Henüz model eklenmemiş</p>
            <% } else { bModels.forEach(m => { %>
              <div class="model-row">
                <span class="material-icons" style="font-size:1rem;color:#ccc;">subdirectory_arrow_right</span>
                <span class="model-name"><%= m.name %></span>
                <div class="model-info">
                  <span><%= m.body_type || '-' %></span>
                  <span><span class="material-icons">list_alt</span> <%= m.listing_count %></span>
                  <span><span class="material-icons">hub</span> <%= m.hub_count %></span>
                </div>
                <div class="action-btns">
                  <button class="btn-sm btn-primary" data-edit-model="<%= m.id %>" data-model-brand="<%= m.brand_id %>" data-model-name="<%= m.name %>" data-model-body="<%= m.body_type || '' %>" title="Düzenle" style="padding:3px 8px;"><span class="material-icons" style="font-size:.8rem;">edit</span></button>
                  <button class="btn-sm btn-danger" data-admin-delete-model data-model-id="<%= m.id %>" title="Sil" style="padding:3px 8px;"><span class="material-icons" style="font-size:.8rem;">delete</span></button>
                </div>
              </div>
            <% }) } %>
            <!-- Inline Model Ekleme -->
            <div class="add-model-inline">
              <input type="text" placeholder="Model adı..." id="inline_model_name_<%= b.id %>">
              <select id="inline_model_body_<%= b.id %>">
                <option value="">Gövde Tipi</option>
                <option value="Sedan">Sedan</option><option value="HB">HB</option><option value="SUV">SUV</option>
                <option value="Coupe">Coupe</option><option value="Cabrio">Cabrio</option><option value="Station Wagon">SW</option>
                <option value="MPV">MPV</option><option value="Pick-up">Pick-up</option><option value="Van">Van</option>
              </select>
              <button class="btn-sm btn-success" onclick="addModelInline(<%= b.id %>)" title="Model Ekle"><span class="material-icons" style="font-size:.9rem;">add</span></button>
            </div>
          </div>
        </div>
      <% }) %>
      </div>

      <!-- MARKA MODAL (gelişmiş) -->
      <div class="admin-modal-overlay" id="brandModal">
        <div class="admin-modal" style="max-width:500px;">
          <button class="close-modal" onclick="closeBrandModal()">&times;</button>
          <h3 id="brandModalTitle">Yeni Marka</h3>
          <form id="brandForm">
            <input type="hidden" id="brand_edit_id">
            <div class="form-group"><label>Marka Adı *</label><input type="text" id="brand_name" required placeholder="ör: Toyota"></div>
            <div class="form-group">
              <label>Logo URL</label>
              <input type="text" id="brand_logo" placeholder="https://... veya /images/brands/..." oninput="previewBrandLogo(this.value)">
              <div id="brandLogoPreview" style="margin-top:8px;display:none;"><img id="brandLogoImg" src="" style="width:48px;height:48px;object-fit:contain;border-radius:8px;border:1px solid #eee;background:#f8f9fa;padding:4px;"></div>
              <div style="margin-top:8px;">
                <p style="font-size:.7rem;color:#999;margin:0 0 6px;">Hızlı seçim (carlogos.org):</p>
                <div id="brandLogoSuggestions" style="display:flex;flex-wrap:wrap;gap:6px;"></div>
              </div>
            </div>
            <div class="modal-actions">
              <button type="button" class="btn-sm btn-outline" onclick="closeBrandModal()">İptal</button>
              <button type="submit" class="btn-sm btn-primary"><span class="material-icons" style="font-size:.9rem;">save</span> Kaydet</button>
            </div>
          </form>
        </div>
      </div>

      <!-- MODEL MODAL -->
      <div class="admin-modal-overlay" id="modelModal">
        <div class="admin-modal" style="max-width:480px;">
          <button class="close-modal" onclick="closeModelModal()">&times;</button>
          <h3 id="modelModalTitle">Yeni Model</h3>
          <form id="modelForm">
            <input type="hidden" id="model_edit_id">
            <div class="form-group">
              <label>Marka *</label>
              <select id="model_brand_id" required>
                <option value="">Seçin...</option>
                <% (data.brands || []).forEach(b => { %>
                  <option value="<%= b.id %>"><%= b.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group"><label>Model Adı *</label><input type="text" id="model_name" required placeholder="ör: Corolla"></div>
            <div class="form-group">
              <label>Gövde Tipi</label>
              <select id="model_body_type">
                <option value="">Seçin</option>
                <option value="Sedan">Sedan</option><option value="HB">HB</option><option value="SUV">SUV</option>
                <option value="Coupe">Coupe</option><option value="Cabrio">Cabrio</option><option value="Station Wagon">Station Wagon</option>
                <option value="MPV">MPV</option><option value="Pick-up">Pick-up</option><option value="Van">Van</option>
              </select>
            </div>
            <div class="modal-actions">
              <button type="button" class="btn-sm btn-outline" onclick="closeModelModal()">İptal</button>
              <button type="submit" class="btn-sm btn-primary"><span class="material-icons" style="font-size:.9rem;">save</span> Kaydet</button>
            </div>
          </form>
        </div>
      </div>

    <!-- ═══════════════════════════════════════════ -->
    <!--  FORUM                                      -->
    <!-- ═══════════════════════════════════════════ -->
    <% } else if (currentPage === 'forum') { %>
      <div class="admin-header">
        <h1>💬 Forum Yönetimi</h1>
        <button class="btn-sm btn-primary" onclick="openCategoryModal()"><span class="material-icons">add</span> Kategori Ekle</button>
      </div>

      <!-- KATEGORİLER -->
      <div class="admin-card" style="margin-bottom:1.5rem;">
        <div class="admin-card-header">
          <h2>📂 Kategoriler</h2>
          <button class="btn-sm btn-primary" onclick="openCategoryModal()"><span class="material-icons">add</span> Yeni</button>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:10px;">
          <% (data.categories || []).forEach(cat => { %>
          <div style="background:#f8f9fa;border-radius:10px;padding:10px 16px;display:flex;align-items:center;gap:10px;border:1px solid #eee;">
            <span class="material-icons" style="font-size:1.2rem;color:<%= cat.color || '#1775d3' %>"><%= cat.icon || 'forum' %></span>
            <div>
              <strong style="font-size:.85rem;"><%= cat.name %></strong>
              <span style="font-size:.7rem;color:#999;margin-left:4px;">(<%= cat.topic_count %> konu)</span>
              <% if (cat.description) { %><br><small style="color:#999;font-size:.7rem;"><%= cat.description %></small><% } %>
            </div>
            <div class="action-btns" style="margin-left:8px;">
              <button class="btn-sm btn-outline" style="padding:3px 6px;" onclick="openCategoryModal({id:<%= cat.id %>,name:'<%= cat.name.replace(/'/g,"\\\'" )%>',description:'<%= (cat.description||'').replace(/'/g,"\\\'" )%>',icon:'<%= cat.icon||'forum' %>',color:'<%= cat.color||'#1775d3' %>'})">
                <span class="material-icons" style="font-size:.8rem;">edit</span>
              </button>
              <button class="btn-sm btn-danger" style="padding:3px 6px;" data-admin-delete-category data-category-id="<%= cat.id %>">
                <span class="material-icons" style="font-size:.8rem;">delete</span>
              </button>
            </div>
          </div>
          <% }) %>
          <% if (!data.categories || data.categories.length === 0) { %>
            <p style="color:#999;font-size:.85rem;">Henüz kategori yok</p>
          <% } %>
        </div>
      </div>

      <div class="admin-card">
        <div class="admin-card-header"><h2>Forum Konuları</h2></div>
        <div style="overflow-x:auto;">
          <table class="admin-table">
            <thead>
              <tr><th>ID</th><th>Başlık</th><th>Kategori</th><th>Yazar</th><th>Yanıt</th><th>Sabitlenmiş</th><th>Kilitli</th><th>Tarih</th><th>İşlemler</th></tr>
            </thead>
            <tbody>
              <% (data.topics || []).forEach(t => { %>
                <tr>
                  <td>#<%= t.id %></td>
                  <td><a href="/forum/konu/<%= t.slug || t.id %>" target="_blank" style="color:#1a73e8;text-decoration:none;font-weight:600;"><%= t.title %></a></td>
                  <td><span class="badge badge-info"><%= t.category_name %></span></td>
                  <td><%= t.author_name %></td>
                  <td><%= t.reply_count || 0 %></td>
                  <td>
                    <button class="btn-sm <%= t.is_pinned ? 'btn-warning' : 'btn-outline' %>" data-admin-pin-topic data-topic-id="<%= t.id %>" data-pinned="<%= t.is_pinned %>">
                      <span class="material-icons">push_pin</span>
                    </button>
                  </td>
                  <td>
                    <button class="btn-sm <%= t.is_locked ? 'btn-danger' : 'btn-outline' %>" data-admin-lock-topic data-topic-id="<%= t.id %>" data-locked="<%= t.is_locked %>">
                      <span class="material-icons"><%= t.is_locked ? 'lock' : 'lock_open' %></span>
                    </button>
                  </td>
                  <td><%= timeAgo(t.created_at) %></td>
                  <td>
                    <div class="action-btns">
                      <button class="btn-sm btn-danger" data-admin-delete-topic data-topic-id="<%= t.id %>" title="Sil">
                        <span class="material-icons">delete</span>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FORUM KATEGORİ MODAL -->
      <div class="admin-modal-overlay" id="categoryModal">
        <div class="admin-modal">
          <button class="close-modal" onclick="closeCategoryModal()">&times;</button>
          <h3 id="categoryModalTitle">Yeni Forum Kategorisi</h3>
          <form id="categoryForm">
            <input type="hidden" id="category_edit_id">
            <div class="form-group"><label>Kategori Adı *</label><input type="text" id="category_name" required placeholder="ör: Genel Tartışma"></div>
            <div class="form-group"><label>Açıklama</label><textarea id="category_description" rows="2"></textarea></div>
            <div class="form-row">
              <div class="form-group"><label>İkon</label><input type="text" id="category_icon" placeholder="ör: forum" value="forum"></div>
              <div class="form-group"><label>Renk</label><input type="color" id="category_color" value="#1775d3"></div>
            </div>
            <div class="modal-actions">
              <button type="button" class="btn-sm btn-outline" onclick="closeCategoryModal()">İptal</button>
              <button type="submit" class="btn-sm btn-primary">Kaydet</button>
            </div>
          </form>
        </div>
      </div>

    <!-- ═══════════════════════════════════════════ -->
    <!--  MODERASYON                                 -->
    <!-- ═══════════════════════════════════════════ -->
    <% } else if (currentPage === 'moderasyon') { %>
      <div class="admin-header"><h1>🛡️ Moderasyon Merkezi</h1></div>

      <!-- Durum Stat Kartları -->
      <div class="stats-grid" style="margin-bottom:1.5rem;">
        <a href="/admin/moderasyon" class="stat-card" style="text-decoration:none;color:inherit;border:2px solid <%=!data.filters?.durum?'#1a73e8':'transparent'%>;">
          <div class="stat-icon blue"><span class="material-icons">list_alt</span></div>
          <div class="stat-info"><h3><%= data.statusCounts.all %></h3><p>Tümü</p></div>
        </a>
        <a href="/admin/moderasyon?durum=pending" class="stat-card" style="text-decoration:none;color:inherit;border:2px solid <%=data.filters?.durum==='pending'?'#e8710a':'transparent'%>;">
          <div class="stat-icon orange"><span class="material-icons">hourglass_top</span></div>
          <div class="stat-info"><h3><%= data.statusCounts.pending %></h3><p>Beklemede</p></div>
        </a>
        <a href="/admin/moderasyon?durum=approved" class="stat-card" style="text-decoration:none;color:inherit;border:2px solid <%=data.filters?.durum==='approved'?'#1e8e3e':'transparent'%>;">
          <div class="stat-icon green"><span class="material-icons">verified</span></div>
          <div class="stat-info"><h3><%= data.statusCounts.approved %></h3><p>İçerik Uygun</p></div>
        </a>
        <a href="/admin/moderasyon?durum=rejected" class="stat-card" style="text-decoration:none;color:inherit;border:2px solid <%=data.filters?.durum==='rejected'?'#d93025':'transparent'%>;">
          <div class="stat-icon red"><span class="material-icons">gavel</span></div>
          <div class="stat-info"><h3><%= data.statusCounts.rejected %></h3><p>Kaldırılan</p></div>
        </a>
      </div>

      <!-- Tür Filtreleri -->
      <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;align-items:center;">
        <span style="font-size:.8rem;font-weight:600;color:#666;margin-right:4px;">Tür:</span>
        <a href="/admin/moderasyon<%= data.filters?.durum ? '?durum=' + data.filters.durum : '' %>" class="btn-sm <%= !data.filters?.tur ? 'btn-primary' : 'btn-outline' %>" style="text-decoration:none;">Tümü</a>
        <a href="/admin/moderasyon?tur=listing<%= data.filters?.durum ? '&durum=' + data.filters.durum : '' %>" class="btn-sm <%= data.filters?.tur==='listing' ? 'btn-primary' : 'btn-outline' %>" style="text-decoration:none;">
          🚗 İlan <% if(data.typeCounts.listing>0){%><span style="background:#e8f0fe;color:#1a73e8;font-size:10px;padding:1px 5px;border-radius:8px;margin-left:2px;"><%= data.typeCounts.listing %></span><%}%>
        </a>
        <a href="/admin/moderasyon?tur=forum_topic<%= data.filters?.durum ? '&durum=' + data.filters.durum : '' %>" class="btn-sm <%= data.filters?.tur==='forum_topic' ? 'btn-primary' : 'btn-outline' %>" style="text-decoration:none;">
          💬 Konu <% if(data.typeCounts.forum_topic>0){%><span style="background:#e8f0fe;color:#1a73e8;font-size:10px;padding:1px 5px;border-radius:8px;margin-left:2px;"><%= data.typeCounts.forum_topic %></span><%}%>
        </a>
        <a href="/admin/moderasyon?tur=forum_reply<%= data.filters?.durum ? '&durum=' + data.filters.durum : '' %>" class="btn-sm <%= data.filters?.tur==='forum_reply' ? 'btn-primary' : 'btn-outline' %>" style="text-decoration:none;">
          💭 Yanıt <% if(data.typeCounts.forum_reply>0){%><span style="background:#e8f0fe;color:#1a73e8;font-size:10px;padding:1px 5px;border-radius:8px;margin-left:2px;"><%= data.typeCounts.forum_reply %></span><%}%>
        </a>
        <a href="/admin/moderasyon?tur=review<%= data.filters?.durum ? '&durum=' + data.filters.durum : '' %>" class="btn-sm <%= data.filters?.tur==='review' ? 'btn-primary' : 'btn-outline' %>" style="text-decoration:none;">
          ⭐ Yorum <% if(data.typeCounts.review>0){%><span style="background:#e8f0fe;color:#1a73e8;font-size:10px;padding:1px 5px;border-radius:8px;margin-left:2px;"><%= data.typeCounts.review %></span><%}%>
        </a>
        <a href="/admin/moderasyon?tur=business<%= data.filters?.durum ? '&durum=' + data.filters.durum : '' %>" class="btn-sm <%= data.filters?.tur==='business' ? 'btn-primary' : 'btn-outline' %>" style="text-decoration:none;">
          🏢 İşletme <% if(data.typeCounts.business>0){%><span style="background:#e8f0fe;color:#1a73e8;font-size:10px;padding:1px 5px;border-radius:8px;margin-left:2px;"><%= data.typeCounts.business %></span><%}%>
        </a>
      </div>

      <!-- Toplu İşlem Bar -->
      <div id="modBulkBar" style="display:none;background:#1a1f36;color:#fff;padding:12px 20px;border-radius:12px;margin-bottom:16px;align-items:center;gap:12px;flex-wrap:wrap;">
        <span style="font-size:.85rem;"><strong id="modSelectedCount">0</strong> öğe seçildi</span>
        <div style="margin-left:auto;display:flex;gap:8px;">
          <button onclick="bulkModAction('rejected')" class="btn-sm btn-danger" style="color:#fff;">
            <span class="material-icons" style="font-size:14px;">gavel</span> Tümünü Kaldır
          </button>
          <button onclick="bulkModAction('approved')" class="btn-sm btn-success" style="color:#fff;">
            <span class="material-icons" style="font-size:14px;">verified</span> Tümünü Uygun Bul
          </button>
          <button onclick="clearModSelection()" class="btn-sm btn-outline" style="border-color:rgba(255,255,255,.3);color:#fff;">
            <span class="material-icons" style="font-size:14px;">close</span> İptal
          </button>
        </div>
      </div>

      <div class="admin-card">
        <% if (!data.queue || data.queue.length === 0) { %>
          <div style="text-align:center;padding:3rem;">
            <span class="material-icons" style="font-size:3rem;color:#c8e6c9;">verified_user</span>
            <p style="color:#999;margin-top:.75rem;font-size:.95rem;">
              <% if (data.filters?.durum || data.filters?.tur) { %>
                Bu filtreyle eşleşen rapor bulunamadı.
              <% } else { %>
                Moderasyon kuyruğu boş, her şey yolunda! ✅
              <% } %>
            </p>
          </div>
        <% } else { %>
          <!-- Tümünü Seç (sadece pending varsa) -->
          <% const pendingItems = data.queue.filter(q => q.status === 'pending'); %>
          <% if (pendingItems.length > 0) { %>
          <div style="padding:12px 16px;border-bottom:1px solid #eee;display:flex;align-items:center;gap:8px;">
            <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:.8rem;color:#666;">
              <input type="checkbox" id="modSelectAll" onchange="toggleModSelectAll(this)"> Tümünü Seç (<%= pendingItems.length %> bekleyen)
            </label>
          </div>
          <% } %>

          <% data.queue.forEach(mq => { %>
          <div class="mod-item" data-mod-id="<%= mq.id %>" data-status="<%= mq.status %>" style="padding:16px;border-bottom:1px solid #f0f0f0;transition:all .2s;<%= mq.status==='pending'?'':'opacity:.65;' %>">
            <div style="display:flex;gap:12px;align-items:start;">
              
              <!-- Checkbox (sadece pending için) -->
              <% if (mq.status === 'pending') { %>
              <div style="padding-top:2px;">
                <input type="checkbox" class="mod-checkbox" data-mod-id="<%= mq.id %>" onchange="updateModSelection()">
              </div>
              <% } %>

              <!-- Tür İkonu -->
              <div style="width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;
                <% if (mq.type==='listing') { %>background:#e8f0fe;color:#1a73e8;
                <% } else if (mq.type==='forum_topic' || mq.type==='forum_reply') { %>background:#ede9fe;color:#7c3aed;
                <% } else if (mq.type==='review') { %>background:#fef3c7;color:#d97706;
                <% } else if (mq.type==='business') { %>background:#e6f4ea;color:#1e8e3e;
                <% } else { %>background:#f3f4f6;color:#6b7280;<% } %>">
                <span class="material-icons" style="font-size:1.2rem;">
                  <% if (mq.type==='listing') { %>directions_car
                  <% } else if (mq.type==='forum_topic') { %>forum
                  <% } else if (mq.type==='forum_reply') { %>chat_bubble
                  <% } else if (mq.type==='review') { %>star
                  <% } else if (mq.type==='business') { %>store
                  <% } else { %>flag<% } %>
                </span>
              </div>

              <!-- İçerik -->
              <div style="flex:1;min-width:0;">
                <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:4px;">
                  <span style="font-size:.7rem;font-weight:700;text-transform:uppercase;padding:2px 8px;border-radius:6px;
                    <% if (mq.type==='listing') { %>background:#e8f0fe;color:#1a73e8;
                    <% } else if (mq.type==='forum_topic') { %>background:#ede9fe;color:#7c3aed;
                    <% } else if (mq.type==='forum_reply') { %>background:#fae8ff;color:#a855f7;
                    <% } else if (mq.type==='review') { %>background:#fef3c7;color:#d97706;
                    <% } else { %>background:#e6f4ea;color:#1e8e3e;<% } %>">
                    <%= ({listing:'İlan',business:'İşletme',forum_topic:'Forum Konu',forum_reply:'Forum Yanıt',review:'Değerlendirme'})[mq.type] || mq.type %>
                  </span>
                  <span style="font-size:.7rem;color:#999;">#<%= mq.id %></span>
                  <% if (mq.status === 'pending') { %><span class="badge badge-warning" style="font-size:.65rem;">⏳ Beklemede</span>
                  <% } else if (mq.status === 'approved') { %><span class="badge badge-success" style="font-size:.65rem;">✅ İçerik Uygun</span>
                  <% } else { %><span class="badge badge-danger" style="font-size:.65rem;">🔨 İçerik Kaldırıldı</span><% } %>
                </div>

                <!-- İçerik Detay -->
                <div style="background:#f8f9fa;border-radius:8px;padding:10px 12px;margin:6px 0;">
                  <p style="margin:0;font-size:.85rem;font-weight:600;color:#1a1f36;">
                    <% if (mq.item_link && mq.item_link !== '#') { %>
                      <a href="<%= mq.item_link %>" target="_blank" style="color:#1a73e8;text-decoration:none;"><%= mq.item_detail || 'İçerik #' + mq.item_id %> ↗</a>
                    <% } else { %>
                      <%= mq.item_detail || 'İçerik #' + mq.item_id %>
                    <% } %>
                  </p>
                </div>

                <!-- Rapor Nedeni -->
                <div style="display:flex;align-items:start;gap:6px;margin-top:6px;">
                  <span class="material-icons" style="font-size:14px;color:#d93025;margin-top:1px;">flag</span>
                  <span style="font-size:.8rem;color:#555;"><%= mq.reason || 'Uygunsuz içerik' %></span>
                </div>

                <!-- Meta -->
                <div style="display:flex;align-items:center;gap:12px;margin-top:8px;flex-wrap:wrap;">
                  <span style="font-size:.75rem;color:#999;display:flex;align-items:center;gap:3px;">
                    <span class="material-icons" style="font-size:13px;">person</span>
                    Bildiren: <strong><%= mq.reported_by_name || 'Anonim' %></strong>
                    <% if (mq.reported_by_email) { %><span style="color:#bbb;">(<%= mq.reported_by_email %>)</span><% } %>
                  </span>
                  <span style="font-size:.75rem;color:#999;display:flex;align-items:center;gap:3px;">
                    <span class="material-icons" style="font-size:13px;">schedule</span>
                    <%= timeAgo(mq.created_at) %>
                  </span>
                  <% if (mq.reviewed_by_name) { %>
                  <span style="font-size:.75rem;color:#999;display:flex;align-items:center;gap:3px;">
                    <span class="material-icons" style="font-size:13px;">admin_panel_settings</span>
                    İnceleyen: <strong><%= mq.reviewed_by_name %></strong>
                  </span>
                  <% } %>
                </div>
              </div>

              <!-- Aksiyon Butonları -->
              <div style="display:flex;gap:6px;flex-shrink:0;align-items:start;">
                <% if (mq.status === 'pending') { %>
                  <% if (mq.item_link && mq.item_link !== '#') { %>
                  <a href="<%= mq.item_link %>" target="_blank" class="btn-sm btn-outline" title="İçeriği Görüntüle" style="text-decoration:none;">
                    <span class="material-icons">visibility</span>
                  </a>
                  <% } %>
                  <button class="btn-sm btn-danger" data-moderation-action="rejected" data-id="<%= mq.id %>" title="Şikayeti Onayla — İçeriği Kaldır">
                    <span class="material-icons">gavel</span> Kaldır
                  </button>
                  <button class="btn-sm btn-success" data-moderation-action="approved" data-id="<%= mq.id %>" title="Şikayeti Reddet — İçerik Uygun">
                    <span class="material-icons">verified</span> Uygun
                  </button>
                <% } else { %>
                  <span style="font-size:.75rem;color:#999;padding:6px 0;">İşlendi</span>
                <% } %>
              </div>
            </div>
          </div>
          <% }) %>
        <% } %>
      </div>

    <% } %>
  </main>
</div>

<script>
// ═══════════════════════════════════════════════
//  Hub modelleri filtrele
// ═══════════════════════════════════════════════
const allModels = <%- JSON.stringify(typeof data !== 'undefined' && data.models ? data.models : []) %>;

function filterModels(brandId, selectEl, selectedModelId) {
  if (!selectEl) return;
  selectEl.innerHTML = '<option value="">Model seçin...</option>';
  allModels.filter(m => String(m.brand_id) === String(brandId)).forEach(m => {
    const opt = document.createElement('option');
    opt.value = m.id; opt.textContent = m.name;
    if (selectedModelId && String(m.id) === String(selectedModelId)) opt.selected = true;
    selectEl.appendChild(opt);
  });
}

const hubBrandSel = document.getElementById('hub_brand_id');
if (hubBrandSel) hubBrandSel.addEventListener('change', () => filterModels(hubBrandSel.value, document.getElementById('hub_model_id')));

// ═══════════════════════════════════════════════
//  Modal: Hub
// ═══════════════════════════════════════════════
function openHubModal(hub) {
  const modal = document.getElementById('hubModal');
  if (!modal) return;
  modal.classList.add('show');
  const fields = ['id','year','avg_price','fuel_type','engine','hp','torque','transmission','acceleration','top_speed','fuel_consumption','length','width','height','wheelbase','weight','editor_rating','editor_review','pros','cons','image_url'];
  if (hub) {
    document.getElementById('hubModalTitle').textContent = 'Hub Düzenle: ' + (hub.brand_name||'') + ' ' + (hub.model_name||'');
    document.getElementById('hub_id').value = hub.id;
    document.getElementById('hub_brand_id').value = hub.brand_id;
    filterModels(hub.brand_id, document.getElementById('hub_model_id'), hub.model_id);
    fields.forEach(f => { const el = document.getElementById('hub_'+f); if (el && hub[f] != null) el.value = hub[f]; });
    // Görsel önizleme
    updateHubImagePreview(hub.image_url || '');
  } else {
    document.getElementById('hubModalTitle').textContent = 'Yeni Araç Hub';
    document.getElementById('hubForm').reset();
    document.getElementById('hub_id').value = '';
    updateHubImagePreview('');
  }
}
function closeHubModal() { const m = document.getElementById('hubModal'); if(m) m.classList.remove('show'); }

// Belirli bir model için hub modal aç (otomatik hub'dan manuel hub'a geçiş)
function openHubModalForModel(brandId, modelId, modelName) {
  const modal = document.getElementById('hubModal');
  if (!modal) return;
  modal.classList.add('show');
  document.getElementById('hubModalTitle').textContent = 'Manuel Hub Oluştur: ' + modelName;
  document.getElementById('hubForm').reset();
  document.getElementById('hub_id').value = '';
  document.getElementById('hub_brand_id').value = brandId;
  filterModels(brandId, document.getElementById('hub_model_id'), modelId);
  updateHubImagePreview('');
}

// Otomatik üretilen hub içeriğini API'den çekip modal'da düzenlemeye aç
async function editGeneratedHub(brandId, modelId) {
  try {
    const res = await fetch('/api/admin/hubs/generated/' + brandId + '/' + modelId);
    if (!res.ok) { alert('İçerik yüklenemedi'); return; }
    const generated = await res.json();
    const modal = document.getElementById('hubModal');
    if (!modal) return;
    modal.classList.add('show');
    document.getElementById('hubModalTitle').textContent = '✏️ Otomatik Hub Düzenle: ' + (generated.brand_name || '') + ' ' + (generated.model_name || '');
    document.getElementById('hubForm').reset();
    document.getElementById('hub_id').value = ''; // Yeni kayıt olarak kaydedilecek (POST)
    document.getElementById('hub_brand_id').value = brandId;
    filterModels(brandId, document.getElementById('hub_model_id'), modelId);
    // Alanları generated verisiyle doldur
    const fields = ['year','avg_price','fuel_type','engine','hp','torque','transmission','acceleration','top_speed','fuel_consumption','length','width','height','wheelbase','weight','editor_rating','editor_review','pros','cons','image_url'];
    fields.forEach(f => {
      const el = document.getElementById('hub_' + f);
      if (el && generated[f] != null) {
        // pros/cons JSON array ise virgüllü string'e çevir
        if ((f === 'pros' || f === 'cons') && typeof generated[f] === 'string') {
          try { const arr = JSON.parse(generated[f]); if (Array.isArray(arr)) { el.value = arr.join(', '); return; } } catch(e) {}
        }
        el.value = generated[f];
      }
    });
    updateHubImagePreview(generated.image_url || '');
  } catch(err) {
    console.error('Generated hub yükleme hatası:', err);
    alert('Bağlantı hatası');
  }
}

function updateHubImagePreview(url) {
  const preview = document.getElementById('hub_image_preview');
  const img = document.getElementById('hub_image_preview_img');
  if (!preview || !img) return;
  if (url && url.trim()) {
    img.src = url.trim();
    preview.style.display = 'block';
    img.onerror = () => { preview.style.display = 'none'; };
  } else {
    preview.style.display = 'none';
    img.src = '';
  }
}

// Görsel URL değiştiğinde önizleme güncelle
const hubImageInput = document.getElementById('hub_image_url');
if (hubImageInput) {
  hubImageInput.addEventListener('input', function() {
    updateHubImagePreview(this.value);
  });
}

// Hub accordion toggle
function toggleHubBrand(brandId) {
  const models = document.getElementById('hubModels_' + brandId);
  const expand = document.getElementById('hubExpand_' + brandId);
  if (!models) return;
  models.classList.toggle('show');
  expand.classList.toggle('open');
}

// Hub arama - marka ve model filtreleme
function filterHubBrands(query) {
  const q = query.toLowerCase();
  document.querySelectorAll('.hub-card').forEach(card => {
    const brandName = card.dataset.hubBrandName || '';
    const modelNames = card.dataset.hubModels || '';
    const match = brandName.includes(q) || modelNames.includes(q);
    card.style.display = match ? '' : 'none';
    // Model bazlı filtreleme
    if (match && q.length > 0) {
      card.querySelectorAll('.hub-row').forEach(row => {
        const modelSearch = row.dataset.hubModelSearch || '';
        row.style.display = (brandName.includes(q) || modelSearch.includes(q)) ? '' : 'none';
      });
      // Eşleşen card'ın accordion'ını aç
      const brandId = card.querySelector('.hub-brand-header')?.getAttribute('onclick')?.match(/\d+/)?.[0];
      if (brandId) {
        const models = document.getElementById('hubModels_' + brandId);
        const expand = document.getElementById('hubExpand_' + brandId);
        if (models && !models.classList.contains('show')) {
          models.classList.add('show');
          expand?.classList.add('open');
        }
      }
    } else if (q.length === 0) {
      card.querySelectorAll('.hub-row').forEach(row => { row.style.display = ''; });
    }
  });
}

// Inline hub ekleme (marka altından model seçip hızlıca)
async function addHubInline(brandId) {
  const selectEl = document.getElementById('inline_hub_model_' + brandId);
  if (!selectEl || !selectEl.value) { selectEl?.focus(); return; }
  const modelId = selectEl.value;
  try {
    const res = await fetch('/api/admin/hubs', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ brand_id: brandId, model_id: modelId })
    });
    const d = await res.json();
    if (d.success || d.id) { location.reload(); } else { alert(d.error || 'Hata oluştu'); }
  } catch(err) { alert('Bağlantı hatası'); }
}

// Hub düzenle butonları - event delegation
document.querySelectorAll('[data-edit-hub]').forEach(btn => {
  btn.addEventListener('click', function() {
    try {
      const hub = JSON.parse(this.getAttribute('data-edit-hub'));
      openHubModal(hub);
    } catch(e) { console.error('Hub parse hatası:', e); }
  });
});

document.getElementById('hubForm')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const id = document.getElementById('hub_id').value;
  const body = {};
  ['brand_id','model_id','year','avg_price','fuel_type','engine','hp','torque','transmission','acceleration','top_speed','fuel_consumption','length','width','height','wheelbase','weight','editor_rating','editor_review','pros','cons','image_url'].forEach(f => {
    const el = document.getElementById('hub_'+f);
    if (el) body[f] = el.value || null;
  });
  const url = id ? '/api/admin/hubs/' + id : '/api/admin/hubs';
  const method = id ? 'PUT' : 'POST';
  try {
    const res = await fetch(url, { method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const d = await res.json();
    if (d.success || d.id) { location.reload(); } else { alert(d.error || 'Hata oluştu'); }
  } catch(err) { alert('Bağlantı hatası'); }
});

// ═══════════════════════════════════════════════
//  Modal: Marka (gelişmiş - logo destekli)
// ═══════════════════════════════════════════════
function openBrandModal(brand) {
  const modal = document.getElementById('brandModal');
  if (!modal) return;
  modal.classList.add('show');
  if (brand) {
    document.getElementById('brandModalTitle').textContent = 'Marka Düzenle';
    document.getElementById('brand_edit_id').value = brand.id;
    document.getElementById('brand_name').value = brand.name;
    document.getElementById('brand_logo').value = brand.logo || '';
    previewBrandLogo(brand.logo || '');
    suggestLogos(brand.name);
  } else {
    document.getElementById('brandModalTitle').textContent = 'Yeni Marka';
    document.getElementById('brandForm').reset();
    document.getElementById('brand_edit_id').value = '';
    document.getElementById('brandLogoPreview').style.display = 'none';
    document.getElementById('brandLogoSuggestions').innerHTML = '';
  }
}
function closeBrandModal() { const m = document.getElementById('brandModal'); if(m) m.classList.remove('show'); }

function previewBrandLogo(url) {
  const prev = document.getElementById('brandLogoPreview');
  const img = document.getElementById('brandLogoImg');
  if (url) { img.src = url; prev.style.display = 'block'; } else { prev.style.display = 'none'; }
}

function suggestLogos(name) {
  const container = document.getElementById('brandLogoSuggestions');
  if (!container) return;
  const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const suggestions = [
    { label: 'carlogos.org', url: `https://www.carlogos.org/car-logos/${slug}-logo.png` },
  ];
  container.innerHTML = suggestions.map(s =>
    `<button type="button" style="padding:4px 8px;font-size:.7rem;border:1px solid #ddd;border-radius:4px;background:#fff;cursor:pointer;display:flex;align-items:center;gap:4px;" onclick="document.getElementById('brand_logo').value='${s.url}';previewBrandLogo('${s.url}')"><img src="${s.url}" style="width:20px;height:20px;object-fit:contain;" onerror="this.parentElement.style.display='none'"> ${s.label}</button>`
  ).join('');
}

// Marka adı yazılınca otomatik logo öner
document.getElementById('brand_name')?.addEventListener('input', function() {
  suggestLogos(this.value);
});

// Event delegation for edit brand buttons
document.querySelectorAll('[data-edit-brand]').forEach(btn => {
  btn.addEventListener('click', () => {
    openBrandModal({ id: btn.dataset.editBrand, name: btn.dataset.brandName, logo: btn.dataset.brandLogo });
  });
});

document.getElementById('brandForm')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const id = document.getElementById('brand_edit_id').value;
  const name = document.getElementById('brand_name').value;
  const logo = document.getElementById('brand_logo').value || null;
  const url = id ? '/api/admin/brands/' + id : '/api/admin/brands';
  const method = id ? 'PUT' : 'POST';
  try {
    const res = await fetch(url, { method, headers: {'Content-Type':'application/json'}, body: JSON.stringify({ name, logo }) });
    const d = await res.json();
    if (d.success || d.id) { location.reload(); } else { alert(d.error || 'Hata oluştu'); }
  } catch(err) { alert('Bağlantı hatası'); }
});

// ═══════════════════════════════════════════════
//  Accordion: Marka altındaki modeller
// ═══════════════════════════════════════════════
function toggleBrand(brandId) {
  const models = document.getElementById('models_' + brandId);
  const expand = document.getElementById('expand_' + brandId);
  if (!models) return;
  models.classList.toggle('show');
  expand.classList.toggle('open');
}

function filterBrands(query) {
  const q = query.toLowerCase();
  document.querySelectorAll('.brand-card').forEach(card => {
    card.style.display = card.dataset.brandName.includes(q) ? '' : 'none';
  });
}

async function addModelInline(brandId) {
  const nameEl = document.getElementById('inline_model_name_' + brandId);
  const bodyEl = document.getElementById('inline_model_body_' + brandId);
  const name = nameEl.value.trim();
  if (!name) { nameEl.focus(); return; }
  try {
    const res = await fetch('/api/admin/models', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ brand_id: brandId, name, body_type: bodyEl.value || null })
    });
    const d = await res.json();
    if (d.success || d.id) { location.reload(); } else { alert(d.error || 'Hata oluştu'); }
  } catch(err) { alert('Bağlantı hatası'); }
}

// ═══════════════════════════════════════════════
//  Modal: Model
// ═══════════════════════════════════════════════
function openModelModal(model) {
  const modal = document.getElementById('modelModal');
  if (!modal) return;
  modal.classList.add('show');
  if (model) {
    document.getElementById('modelModalTitle').textContent = 'Model Düzenle';
    document.getElementById('model_edit_id').value = model.id;
    document.getElementById('model_brand_id').value = model.brand_id;
    document.getElementById('model_name').value = model.name;
    document.getElementById('model_body_type').value = model.body_type || '';
  } else {
    document.getElementById('modelModalTitle').textContent = 'Yeni Model';
    document.getElementById('modelForm').reset();
    document.getElementById('model_edit_id').value = '';
  }
}
function closeModelModal() { const m = document.getElementById('modelModal'); if(m) m.classList.remove('show'); }

// Event delegation for edit model buttons
document.querySelectorAll('[data-edit-model]').forEach(btn => {
  btn.addEventListener('click', () => {
    openModelModal({ id: btn.dataset.editModel, brand_id: btn.dataset.modelBrand, name: btn.dataset.modelName, body_type: btn.dataset.modelBody });
  });
});

document.getElementById('modelForm')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const id = document.getElementById('model_edit_id').value;
  const body = { brand_id: document.getElementById('model_brand_id').value, name: document.getElementById('model_name').value, body_type: document.getElementById('model_body_type').value || null };
  const url = id ? '/api/admin/models/' + id : '/api/admin/models';
  const method = id ? 'PUT' : 'POST';
  try {
    const res = await fetch(url, { method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const d = await res.json();
    if (d.success || d.id) { location.reload(); } else { alert(d.error || 'Hata oluştu'); }
  } catch(err) { alert('Bağlantı hatası'); }
});

// ═══════════════════════════════════════════════
//  Moderasyon: Toplu İşlem
// ═══════════════════════════════════════════════
function updateModSelection() {
  const checked = document.querySelectorAll('.mod-checkbox:checked');
  const bar = document.getElementById('modBulkBar');
  const count = document.getElementById('modSelectedCount');
  if (checked.length > 0) {
    bar.style.display = 'flex';
    count.textContent = checked.length;
  } else {
    bar.style.display = 'none';
  }
}

function toggleModSelectAll(masterCb) {
  document.querySelectorAll('.mod-checkbox').forEach(cb => { cb.checked = masterCb.checked; });
  updateModSelection();
}

function clearModSelection() {
  document.querySelectorAll('.mod-checkbox').forEach(cb => { cb.checked = false; });
  const selectAll = document.getElementById('modSelectAll');
  if (selectAll) selectAll.checked = false;
  updateModSelection();
}

async function bulkModAction(status) {
  const ids = Array.from(document.querySelectorAll('.mod-checkbox:checked')).map(cb => Number(cb.dataset.modId));
  if (ids.length === 0) return;
  const label = status === 'rejected' ? 'kaldırmak (şikayetleri onaylamak)' : 'uygun bulmak (şikayetleri reddetmek)';
  if (!confirm(`Seçilen ${ids.length} içeriği ${label} istiyor musunuz?`)) return;
  try {
    const res = await fetch('/api/admin/moderation/bulk', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ids, status })
    });
    const d = await res.json();
    if (d.success) { showToast(d.message, 'success'); setTimeout(() => location.reload(), 800); }
    else { showToast(d.error || 'Hata', 'error'); }
  } catch { showToast('Bağlantı hatası', 'error'); }
}

// ═══════════════════════════════════════════════
//  Modal: Forum Kategorisi
// ═══════════════════════════════════════════════
function openCategoryModal(cat) {
  const modal = document.getElementById('categoryModal');
  if (!modal) return;
  modal.classList.add('show');
  if (cat) {
    document.getElementById('categoryModalTitle').textContent = 'Kategori Düzenle';
    document.getElementById('category_edit_id').value = cat.id;
    document.getElementById('category_name').value = cat.name;
    document.getElementById('category_description').value = cat.description || '';
    document.getElementById('category_icon').value = cat.icon || 'forum';
    document.getElementById('category_color').value = cat.color || '#1775d3';
  } else {
    document.getElementById('categoryModalTitle').textContent = 'Yeni Forum Kategorisi';
    document.getElementById('categoryForm').reset();
    document.getElementById('category_edit_id').value = '';
  }
}
function closeCategoryModal() { const m = document.getElementById('categoryModal'); if(m) m.classList.remove('show'); }

document.getElementById('categoryForm')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const id = document.getElementById('category_edit_id').value;
  const body = { name: document.getElementById('category_name').value, description: document.getElementById('category_description').value, icon: document.getElementById('category_icon').value, color: document.getElementById('category_color').value };
  const url = id ? '/api/admin/forum/categories/' + id : '/api/admin/forum/categories';
  const method = id ? 'PUT' : 'POST';
  try {
    const res = await fetch(url, { method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const d = await res.json();
    if (d.success || d.id) { location.reload(); } else { alert(d.error || 'Hata oluştu'); }
  } catch(err) { alert('Bağlantı hatası'); }
});

// Kategori silme
document.querySelectorAll('[data-admin-delete-category]').forEach(btn => {
  btn.addEventListener('click', async () => {
    const id = btn.dataset.categoryId;
    if (!confirm('Bu kategoriyi silmek istediğinize emin misiniz?\n\nKategorideki konular etkilenebilir.')) return;
    try {
      const res = await fetch('/api/admin/forum/categories/' + id, { method: 'DELETE' });
      const d = await res.json();
      if (d.success) { location.reload(); } else { alert(d.error || 'Silinemedi'); }
    } catch(err) { alert('Bağlantı hatası'); }
  });
});
</script>
