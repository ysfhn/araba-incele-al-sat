                <td><%= a.user_name %><br><small style="color:#999"><%= a.user_email %></small></td>
                <td><% if (a.service_type) { %><span style="background:#f0f9ff;color:#0369a1;font-size:.7rem;padding:2px 8px;border-radius:6px;white-space:nowrap;"><%= a.service_type %></span><% } else { %><span style="color:#ccc;">—</span><% } %></td>
                <td><% if (a.vehicle_info) { %><span style="font-size:.8rem;font-weight:600;"><%= a.vehicle_info %></span><% } else { %><span style="color:#ccc;">—</span><% } %></td>
                <td style="white-space:nowrap;">
                  <span style="font-weight:600;"><%= a.date %></span><br>
                  <small style="color:#666;">🕐 <%= a.time %></small>
                </td>
