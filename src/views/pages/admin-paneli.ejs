        <div class="pagination">
          <% for (let p = 1; p <= data.totalPages; p++) { %>
            <a href="/admin/randevular?sayfa=<%= p %>&durum=<%= data.filters?.durum || '' %>&arama=<%= data.filters?.arama || '' %>" class="<%= p === data.page ? 'active' : '' %>"><%= p %></a>
          <% } %>
        </div>
        <% } %>
      </div>

    <!-- ═══════════════════════════════════════════ -->
