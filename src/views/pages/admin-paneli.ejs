          <% if (data.pendingBusinessCount > 0) { %><span style="background:#ef4444;color:#fff;font-size:10px;font-weight:700;padding:1px 6px;border-radius:10px;margin-left:4px;"><%= data.pendingBusinessCount %></span><% } %>
        </a>
        <a href="/admin/isletmeler?durum=verified" class="btn-sm <%= data.filters?.durum==='verified' ? 'btn-success' : 'btn-outline' %>" style="text-decoration:none;">✅ Onaylı (<%= data.verifiedBusinessCount %>)</a>
