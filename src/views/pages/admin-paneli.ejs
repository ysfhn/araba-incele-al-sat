          <div class="stat-icon purple"><span class="material-icons">event</span></div>
          <div class="stat-info"><h3><%= data.totalCount %></h3><p>Toplam</p></div>
        </div>
        <div class="stat-card">
          <div class="stat-icon orange"><span class="material-icons">pending</span></div>
          <div class="stat-info"><h3><%= data.statusCounts?.pending || 0 %></h3><p>Bekleyen</p></div>
        </div>
        <div class="stat-card">
          <div class="stat-icon blue"><span class="material-icons">check_circle</span></div>
          <div class="stat-info"><h3><%= data.statusCounts?.confirmed || 0 %></h3><p>Onaylanan</p></div>
