            <option value="">Tüm Türler</option>
            <option value="servis" <%= data.filters?.tur==='servis'?'selected':'' %>>Servis</option>
            <option value="galeri" <%= data.filters?.tur==='galeri'?'selected':'' %>>Galeri</option>
            <option value="yedek_parca" <%= data.filters?.tur==='yedek_parca'?'selected':'' %>>Yedek Parça</option>
            <option value="ekspertiz" <%= data.filters?.tur==='ekspertiz'?'selected':'' %>>Ekspertiz</option>
          </select>
          <button type="submit" class="btn-sm btn-primary"><span class="material-icons">search</span> Ara</button>
        </form>

