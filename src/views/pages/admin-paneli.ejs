<%
  const currentPage = typeof adminPage !== 'undefined' ? adminPage : 'dashboard';
  const data = typeof adminData !== 'undefined' ? adminData : {};
  function timeAgo(date) {
    const diff = Date.now() - new Date(date).getTime();
    const mins = Math.floor(diff/60000);
    if (mins < 1) return 'Az önce';
    if (mins < 60) return mins + ' dk önce';
    const hours = Math.floor(mins/60);
    if (hours < 24) return hours + ' saat önce';
    const days = Math.floor(hours/24);
    if (days < 30) return days + ' gün önce';
    return new Date(date).toLocaleDateString('tr-TR');
  }
  function formatPrice(p) { return p ? Number(p).toLocaleString('tr-TR') + ' ₺' : '-'; }
  const menuItems = [
    { key: 'dashboard', label: 'Dashboard', icon: 'dashboard', href: '/admin/panel' },
    { key: 'kullanicilar', label: 'Kullanıcılar', icon: 'people', href: '/admin/kullanicilar' },
    { key: 'ilanlar', label: 'İlanlar', icon: 'directions_car', href: '/admin/ilanlar' },
    { key: 'isletmeler', label: 'İşletmeler', icon: 'business', href: '/admin/isletmeler' },
    { key: 'randevular', label: 'Randevular', icon: 'calendar_month', href: '/admin/randevular' },
    { key: 'teklifler', label: 'Teklifler', icon: 'request_quote', href: '/admin/teklifler' },
    { key: 'degerlendirmeler', label: 'Değerlendirmeler', icon: 'reviews', href: '/admin/degerlendirmeler' },
    { key: 'hublar', label: 'Araç Hub', icon: 'hub', href: '/admin/hublar' },
    { key: 'markalar', label: 'Markalar/Modeller', icon: 'category', href: '/admin/markalar' },
    { key: 'forum', label: 'Forum', icon: 'forum', href: '/admin/forum' },
    { key: 'moderasyon', label: 'Moderasyon', icon: 'shield', href: '/admin/moderasyon' },
  ];
%>

<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

<style>
  .admin-layout { display: flex; min-height: calc(100vh - 70px); background: #f0f2f5; }
  .admin-sidebar {
    width: 260px; background: linear-gradient(180deg, #1a1f36 0%, #252b48 100%); color: #fff;
    padding: 1.5rem 0; flex-shrink: 0; position: sticky; top: 70px; height: calc(100vh - 70px); overflow-y: auto;
  }
  .admin-sidebar .sidebar-brand { padding: 0 1.5rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,.1); margin-bottom: 1rem; }
  .admin-sidebar .sidebar-brand h3 { font-size: 1.1rem; margin: 0; font-weight: 700; letter-spacing: 0.5px; }
  .admin-sidebar .sidebar-brand small { color: rgba(255,255,255,.5); font-size: 0.75rem; }
  .sidebar-menu { list-style: none; padding: 0; margin: 0; }
  .sidebar-menu li a {
    display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1.5rem; color: rgba(255,255,255,.7);
    text-decoration: none; font-size: 0.9rem; transition: all .2s; border-left: 3px solid transparent;
  }
  .sidebar-menu li a:hover { background: rgba(255,255,255,.08); color: #fff; }
  .sidebar-menu li a.active { background: rgba(255,255,255,.12); color: #fff; border-left-color: #4f8cff; font-weight: 600; }
  .sidebar-menu li a .material-icons { font-size: 1.25rem; opacity: .8; }
  .sidebar-menu li a .badge-count {
    margin-left: auto; background: #ff4757; color: #fff; font-size: 0.7rem; padding: 2px 7px;
    border-radius: 10px; font-weight: 700;
  }

  .admin-content { flex: 1; padding: 2rem; overflow-x: auto; }
  .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem; }
  .admin-header h1 { font-size: 1.5rem; font-weight: 700; color: #1a1f36; margin: 0; }

  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
  .stat-card {
    background: #fff; border-radius: 12px; padding: 1.25rem; box-shadow: 0 2px 8px rgba(0,0,0,.06);
    display: flex; align-items: center; gap: 1rem;
  }
  .stat-card .stat-icon {
    width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem;
  }
  .stat-card .stat-icon.blue { background: #e8f0fe; color: #1a73e8; }
  .stat-card .stat-icon.green { background: #e6f4ea; color: #1e8e3e; }
  .stat-card .stat-icon.orange { background: #fef3e0; color: #e8710a; }
  .stat-card .stat-icon.red { background: #fce8e6; color: #d93025; }
  .stat-card .stat-icon.purple { background: #f3e8fd; color: #9334e6; }
  .stat-card .stat-info h3 { font-size: 1.5rem; margin: 0; font-weight: 700; color: #1a1f36; }
  .stat-card .stat-info p { margin: 0; font-size: 0.8rem; color: #666; }

  .admin-card {
    background: #fff; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,.06); margin-bottom: 1.5rem;
  }
  .admin-card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: .5rem; }
  .admin-card-header h2 { font-size: 1.15rem; font-weight: 700; color: #1a1f36; margin: 0; }

  .admin-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .admin-table th { background: #f8f9fa; padding: 0.75rem; text-align: left; font-weight: 600; color: #555; border-bottom: 2px solid #eee; white-space: nowrap; }
  .admin-table td { padding: 0.75rem; border-bottom: 1px solid #f0f0f0; vertical-align: middle; }
  .admin-table tr:hover { background: #f8f9ff; }

  .badge {
    display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
  }
  .badge-success { background: #e6f4ea; color: #1e8e3e; }
  .badge-warning { background: #fef3e0; color: #e8710a; }
  .badge-danger { background: #fce8e6; color: #d93025; }
  .badge-info { background: #e8f0fe; color: #1a73e8; }
  .badge-secondary { background: #eee; color: #666; }

  .btn-sm {
    padding: 5px 12px; font-size: 0.75rem; border: none; border-radius: 6px; cursor: pointer;
    font-weight: 600; transition: all .2s; display: inline-flex; align-items: center; gap: 4px;
  }
  .btn-sm .material-icons { font-size: 0.9rem; }
  .btn-primary { background: #1a73e8; color: #fff; }
  .btn-primary:hover { background: #1557b0; }
  .btn-success { background: #1e8e3e; color: #fff; }
  .btn-success:hover { background: #167c34; }
  .btn-warning { background: #e8710a; color: #fff; }
  .btn-warning:hover { background: #c96008; }
  .btn-danger { background: #d93025; color: #fff; }
  .btn-danger:hover { background: #b7271e; }
  .btn-outline { background: transparent; border: 1px solid #ddd; color: #555; }
  .btn-outline:hover { background: #f5f5f5; }

  .filter-bar { display: flex; gap: 0.75rem; margin-bottom: 1.25rem; flex-wrap: wrap; align-items: center; }
  .filter-bar input, .filter-bar select {
    padding: 8px 14px; border: 1px solid #ddd; border-radius: 8px; font-size: 0.85rem; background: #fff;
  }
  .filter-bar input:focus, .filter-bar select:focus { outline: none; border-color: #4f8cff; box-shadow: 0 0 0 3px rgba(79,140,255,.15); }

  .activity-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 0; border-bottom: 1px solid #f0f0f0; }
  .activity-item:last-child { border: none; }
  .activity-icon {
    width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: 1rem; flex-shrink: 0;
  }
  .activity-item .activity-text { flex: 1; font-size: 0.85rem; color: #333; }
  .activity-item .activity-time { font-size: 0.75rem; color: #999; white-space: nowrap; }

  .pagination { display: flex; gap: 0.5rem; justify-content: center; margin-top: 1.5rem; }
  .pagination a {
    padding: 6px 14px; border: 1px solid #ddd; border-radius: 6px; text-decoration: none; color: #555; font-size: 0.85rem;
  }
  .pagination a.active { background: #1a73e8; color: #fff; border-color: #1a73e8; }
  .pagination a:hover:not(.active) { background: #f5f5f5; }

  .action-btns { display: flex; gap: 4px; flex-wrap: wrap; }

  .admin-modal-overlay {
    display: none; position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 9999;
    justify-content: center; align-items: center;
  }
  .admin-modal-overlay.show { display: flex; }
  .admin-modal {
    background: #fff; border-radius: 16px; padding: 2rem; width: 90%; max-width: 600px; max-height: 85vh;
    overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,.2); position: relative;
  }
  .admin-modal h3 { margin: 0 0 1.5rem; font-size: 1.2rem; font-weight: 700; color: #1a1f36; }
  .admin-modal .form-group { margin-bottom: 1rem; }
  .admin-modal label { display: block; font-size: 0.8rem; font-weight: 600; color: #555; margin-bottom: 4px; }
  .admin-modal input, .admin-modal select, .admin-modal textarea {
    width: 100%; padding: 10px 14px; border: 1px solid #ddd; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box;
  }
  .admin-modal textarea { min-height: 80px; resize: vertical; }
  .admin-modal .modal-actions { display: flex; gap: .75rem; justify-content: flex-end; margin-top: 1.5rem; }
  .admin-modal .close-modal {
    position: absolute; top: 1rem; right: 1rem; background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #999;
  }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

  @media (max-width: 768px) {
    .admin-layout { flex-direction: column; }
    .admin-sidebar { width: 100%; height: auto; position: static; padding: 1rem 0; }
    .sidebar-menu { display: flex; overflow-x: auto; gap: 0; padding: 0 .5rem; }
    .sidebar-menu li a { padding: .6rem 1rem; white-space: nowrap; border-left: none; border-bottom: 3px solid transparent; font-size: .8rem; }
    .sidebar-menu li a.active { border-bottom-color: #4f8cff; }
    .admin-content { padding: 1rem; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>

<div class="admin-layout">
  <!-- SIDEBAR -->
  <aside class="admin-sidebar">
    <div class="sidebar-brand">
      <h3>🔧 Admin Paneli</h3>
      <small>Araba İncele Al Sat</small>
    </div>
    <ul class="sidebar-menu">
      <% menuItems.forEach(item => { %>
        <li>
          <a href="<%= item.href %>" class="<%= currentPage === item.key ? 'active' : '' %>">
            <span class="material-icons"><%= item.icon %></span>
            <%= item.label %>
            <% if (item.key === 'moderasyon' && typeof stats !== 'undefined' && stats.pendingModeration > 0) { %>
              <span class="badge-count"><%= stats.pendingModeration %></span>
            <% } %>
          </a>
        </li>
      <% }) %>
    </ul>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="admin-content">

    <!-- ═══════════════════════════════════════════ -->
    <!--  DASHBOARD                                  -->
    <!-- ═══════════════════════════════════════════ -->
    <% if (currentPage === 'dashboard') { %>
      <div class="admin-header"><h1>📊 Dashboard</h1></div>

      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon blue"><span class="material-icons">people</span></div>
          <div class="stat-info"><h3><%= stats.totalUsers %></h3><p>Toplam Kullanıcı</p></div>
        </div>
        <div class="stat-card">
          <div class="stat-icon green"><span class="material-icons">directions_car</span></div>
          <div class="stat-info"><h3><%= stats.activeListings %></h3><p>Aktif İlan</p></div>
        </div>
        <div class="stat-card">
          <div class="stat-icon orange"><span class="material-icons">pending_actions</span></div>
          <div class="stat-info"><h3><%= stats.pendingListings %></h3><p>Onay Bekleyen İlan</p></div>
        </div>
        <div class="stat-card">
          <div class="stat-icon purple"><span class="material-icons">business</span></div>
          <div class="stat-info"><h3><%= stats.businesses %></h3><p>İşletme (<%= stats.verifiedBusinesses %> onaylı)</p></div>
        </div>
        <div class="stat-card">
          <div class="stat-icon red"><span class="material-icons">shield</span></div>
          <div class="stat-info"><h3><%= stats.pendingModeration %></h3><p>Moderasyon Bekleyen</p></div>
        </div>
        <div class="stat-card">
          <div class="stat-icon blue"><span class="material-icons">forum</span></div>
          <div class="stat-info"><h3><%= stats.forumTopics %></h3><p>Forum Konusu</p></div>
        </div>
        <div class="stat-card">
          <div class="stat-icon green"><span class="material-icons">email</span></div>
          <div class="stat-info"><h3><%= stats.totalMessages %></h3><p>Mesaj</p></div>
        </div>
        <div class="stat-card">
          <div class="stat-icon orange"><span class="material-icons">event</span></div>
          <div class="stat-info"><h3><%= stats.totalAppointments %></h3><p>Randevu</p></div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;">
        <div class="admin-card">
          <div class="admin-card-header"><h2>Son Aktiviteler</h2></div>
          <% recentActivity.forEach(a => { %>
            <div class="activity-item">
              <div class="activity-icon" style="background:<%= a.type==='user'?'#e8f0fe':a.type==='listing'?'#e6f4ea':'#f3e8fd' %>;color:<%= a.type==='user'?'#1a73e8':a.type==='listing'?'#1e8e3e':'#9334e6' %>">
                <span class="material-icons"><%= a.type==='user'?'person_add':a.type==='listing'?'directions_car':'store' %></span>
              </div>
              <span class="activity-text">
                <strong><%= a.type==='user'?'Yeni kullanıcı':a.type==='listing'?'Yeni ilan':'Yeni işletme' %>:</strong> <%= a.detail %>
              </span>
              <span class="activity-time"><%= timeAgo(a.created_at) %></span>
            </div>
          <% }) %>
          <% if (recentActivity.length === 0) { %>
            <p style="color:#999;text-align:center;padding:1rem;">Henüz aktivite yok</p>
          <% } %>
        </div>

        <div class="admin-card">
          <div class="admin-card-header">
            <h2>Moderasyon Kuyruğu</h2>
            <a href="/admin/moderasyon" class="btn-sm btn-outline">Tümünü Gör</a>
          </div>
          <% moderationQueue.forEach(mq => { %>
            <div class="activity-item">
              <div class="activity-icon" style="background:#fce8e6;color:#d93025;">
                <span class="material-icons">report</span>
              </div>
              <span class="activity-text">
                <strong><%= mq.type %>:</strong> <%= mq.item_detail || 'İçerik #' + mq.item_id %>
                <% if (mq.reason) { %><br><small style="color:#999"><%= mq.reason %></small><% } %>
              </span>
              <div class="action-btns">
                <button class="btn-sm btn-success" data-moderation-action="approved" data-id="<%= mq.id %>">
                  <span class="material-icons">check</span>
                </button>
                <button class="btn-sm btn-danger" data-moderation-action="rejected" data-id="<%= mq.id %>">
                  <span class="material-icons">close</span>
                </button>
              </div>
            </div>
          <% }) %>
          <% if (moderationQueue.length === 0) { %>
            <p style="color:#999;text-align:center;padding:1rem;">Bekleyen moderasyon yok ✅</p>
          <% } %>
        </div>
      </div>

    <!-- ═══════════════════════════════════════════ -->
    <!--  KULLANICILAR                               -->
    <!-- ═══════════════════════════════════════════ -->
    <% } else if (currentPage === 'kullanicilar') { %>
      <div class="admin-header"><h1>👥 Kullanıcı Yönetimi</h1></div>

      <div class="admin-card">
        <form class="filter-bar" method="GET" action="/admin/kullanicilar">
          <input type="text" name="arama" placeholder="İsim veya e-posta ara..." value="<%= data.filters?.arama || '' %>">
          <select name="rol">
            <option value="">Tüm Roller</option>
            <option value="bireysel" <%= data.filters?.rol==='bireysel'?'selected':'' %>>Bireysel</option>
            <option value="kurumsal" <%= data.filters?.rol==='kurumsal'?'selected':'' %>>Kurumsal</option>
            <option value="admin" <%= data.filters?.rol==='admin'?'selected':'' %>>Admin</option>
          </select>
          <button type="submit" class="btn-sm btn-primary"><span class="material-icons">search</span> Ara</button>
        </form>

        <div style="overflow-x:auto;">
          <table class="admin-table">
            <thead>
              <tr>
                <th>ID</th><th>İsim</th><th>E-posta</th><th>Rol</th><th>Onay</th><th>Kayıt</th><th>İşlemler</th>
              </tr>
            </thead>
            <tbody>
              <% (data.users || []).forEach(u => { %>
                <tr>
                  <td>#<%= u.id %></td>
                  <td><strong><%= u.name %></strong></td>
                  <td><%= u.email %></td>
                  <td>
                    <select class="btn-sm btn-outline" data-admin-user-role data-user-id="<%= u.id %>" style="font-size:.75rem;">
                      <option value="bireysel" <%= u.role==='bireysel'?'selected':'' %>>Bireysel</option>
                      <option value="kurumsal" <%= u.role==='kurumsal'?'selected':'' %>>Kurumsal</option>
                      <option value="admin" <%= u.role==='admin'?'selected':'' %>>Admin</option>
                    </select>
                  </td>
                  <td>
                    <button class="btn-sm <%= u.is_verified ? 'btn-success' : 'btn-outline' %>" data-admin-verify-user data-user-id="<%= u.id %>" data-verified="<%= u.is_verified %>">
                      <span class="material-icons"><%= u.is_verified ? 'verified' : 'cancel' %></span>
                    </button>
                  </td>
                  <td><%= timeAgo(u.created_at) %></td>
                  <td>
                    <div class="action-btns">
                      <button class="btn-sm btn-danger" data-admin-delete-user data-user-id="<%= u.id %>" title="Sil">
                        <span class="material-icons">delete</span>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <% if (data.totalPages > 1) { %>
          <div class="pagination">
            <% for (let i = 1; i <= data.totalPages; i++) { %>
              <a href="/admin/kullanicilar?sayfa=<%= i %>&arama=<%= data.filters?.arama||'' %>&rol=<%= data.filters?.rol||'' %>" class="<%= data.page === i ? 'active' : '' %>"><%= i %></a>
            <% } %>
          </div>
        <% } %>
        <p style="font-size:.8rem;color:#999;margin-top:.5rem;text-align:center;">Toplam <%= data.totalCount %> kullanıcı</p>
      </div>

    <!-- ═══════════════════════════════════════════ -->
    <!--  İLANLAR                                    -->
    <!-- ═══════════════════════════════════════════ -->
    <% } else if (currentPage === 'ilanlar') { %>
      <div class="admin-header"><h1>🚗 İlan Yönetimi</h1></div>

      <div class="admin-card">
        <form class="filter-bar" method="GET" action="/admin/ilanlar">
          <input type="text" name="arama" placeholder="İlan veya marka ara..." value="<%= data.filters?.arama || '' %>">
          <select name="durum">
            <option value="">Tüm Durumlar</option>
            <option value="active" <%= data.filters?.durum==='active'?'selected':'' %>>Aktif</option>
            <option value="pending" <%= data.filters?.durum==='pending'?'selected':'' %>>Beklemede</option>
            <option value="rejected" <%= data.filters?.durum==='rejected'?'selected':'' %>>Reddedildi</option>
            <option value="sold" <%= data.filters?.durum==='sold'?'selected':'' %>>Satıldı</option>
          </select>
          <button type="submit" class="btn-sm btn-primary"><span class="material-icons">search</span> Ara</button>
        </form>

        <div style="overflow-x:auto;">
          <table class="admin-table">
            <thead>
              <tr>
                <th>ID</th><th>İlan Başlığı</th><th>Marka/Model</th><th>Fiyat</th><th>Satıcı</th><th>Durum</th><th>Öne Çıkan</th><th>Tarih</th><th>İşlemler</th>
              </tr>
            </thead>
            <tbody>
              <% (data.listings || []).forEach(l => { %>
                <tr>
                  <td>#<%= l.id %></td>
                  <td><a href="/ilan/<%= l.id %>" target="_blank" style="color:#1a73e8;text-decoration:none;font-weight:600;"><%= l.title %></a></td>
                  <td><%= l.brand_name %> <%= l.model_name %></td>
                  <td style="font-weight:700;color:#1e8e3e;"><%= formatPrice(l.price) %></td>
                  <td><%= l.seller_name %></td>
                  <td>
                    <% if (l.status === 'active') { %><span class="badge badge-success">Aktif</span>
                    <% } else if (l.status === 'pending') { %><span class="badge badge-warning">Beklemede</span>
                    <% } else if (l.status === 'rejected') { %><span class="badge badge-danger">Reddedildi</span>
                    <% } else { %><span class="badge badge-secondary"><%= l.status %></span><% } %>
                  </td>
                  <td>
                    <button class="btn-sm <%= l.is_featured ? 'btn-warning' : 'btn-outline' %>" data-admin-feature data-listing-id="<%= l.id %>" data-featured="<%= l.is_featured %>">
                      <span class="material-icons"><%= l.is_featured ? 'star' : 'star_border' %></span>
                    </button>
                  </td>
                  <td><%= timeAgo(l.created_at) %></td>
                  <td>
                    <div class="action-btns">
                      <% if (l.status === 'pending') { %>
                        <button class="btn-sm btn-success" data-admin-listing-status="active" data-listing-id="<%= l.id %>" title="Onayla">
                          <span class="material-icons">check_circle</span>
                        </button>
                        <button class="btn-sm btn-danger" data-admin-listing-status="rejected" data-listing-id="<%= l.id %>" title="Reddet">
                          <span class="material-icons">block</span>
                        </button>
                      <% } else if (l.status === 'active') { %>
                        <button class="btn-sm btn-warning" data-admin-listing-status="pending" data-listing-id="<%= l.id %>" title="Askıya Al">
                          <span class="material-icons">pause_circle</span>
                        </button>
                      <% } else { %>
                        <button class="btn-sm btn-success" data-admin-listing-status="active" data-listing-id="<%= l.id %>" title="Aktifleştir">
                          <span class="material-icons">check_circle</span>
                        </button>
                      <% } %>
                      <button class="btn-sm btn-danger" data-admin-delete-listing data-listing-id="<%= l.id %>" title="Sil">
                        <span class="material-icons">delete</span>
