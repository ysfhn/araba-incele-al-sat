                  <td>
                    <button class="btn-sm <%= b.is_verified ? 'btn-success' : 'btn-outline' %>" data-admin-verify-business data-business-id="<%= b.id %>" data-verified="<%= b.is_verified %>">
                      <span class="material-icons"><%= b.is_verified ? 'verified' : 'cancel' %></span>
                      <%= b.is_verified ? 'Onaylı' : 'Onaysız' %>
                    </button>
                  </td>
                  <td>
                    <button class="btn-sm <%= b.is_premium ? 'btn-warning' : 'btn-outline' %>" data-admin-premium-business data-business-id="<%= b.id %>" data-premium="<%= b.is_premium %>">
                      <span class="material-icons"><%= b.is_premium ? 'workspace_premium' : 'star_border' %></span>
                    </button>
                  </td>
                  <td><%= b.rating ? Number(b.rating).toFixed(1) + ' ⭐' : '-' %></td>
                  <td><%= timeAgo(b.created_at) %></td>
                  <td>
                    <div class="action-btns">
                      <button class="btn-sm btn-danger" data-admin-delete-business data-business-id="<%= b.id %>" title="Sil">
                        <span class="material-icons">delete</span>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <% if (data.totalPages > 1) { %>
        <div class="pagination">
          <% for (let p = 1; p <= data.totalPages; p++) { %>
            <a href="/admin/isletmeler?sayfa=<%= p %>&arama=<%= data.filters?.arama || '' %>&tur=<%= data.filters?.tur || '' %>" class="<%= p === data.page ? 'active' : '' %>"><%= p %></a>
          <% } %>
        </div>
        <% } %>
      </div>

    <!-- ═══════════════════════════════════════════ -->
    <!--  RANDEVULAR (Admin)                          -->
    <!-- ═══════════════════════════════════════════ -->
