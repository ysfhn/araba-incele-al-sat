                <td>
                  <% const qStat = {pending:'Bekleyen',quoted:'Yanıtlandı',accepted:'Kabul Edildi',rejected:'Reddedildi'}; %>
                  <% const qBadge = {pending:'badge-warning',quoted:'badge-success',accepted:'badge-info',rejected:'badge-danger'}; %>
                  <span class="badge <%= qBadge[q.status] || 'badge-secondary' %>"><%= qStat[q.status] || q.status %></span>
                </td>
                <td style="max-width:180px;"><%= q.quote_amount ? new Intl.NumberFormat('tr-TR').format(q.quote_amount) + ' ₺' : '-' %></td>
                <td><%= timeAgo(q.created_at) %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <% if (data.totalPages > 1) { %>
        <div class="pagination">
          <% for (let p = 1; p <= data.totalPages; p++) { %>
            <a href="/admin/teklifler?sayfa=<%= p %>&durum=<%= data.filters?.durum || '' %>&arama=<%= data.filters?.arama || '' %>" class="<%= p === data.page ? 'active' : '' %>"><%= p %></a>
          <% } %>
        </div>
        <% } %>
      </div>

    <!-- ═══════════════════════════════════════════ -->
    <!--  DEĞERLENDİRMELER (Admin)                    -->
    <!-- ═══════════════════════════════════════════ -->
    <% } else if (currentPage === 'degerlendirmeler') { %>
      <div class="admin-header"><h1>⭐ Değerlendirme Yönetimi</h1></div>

      <!-- Özet Kartları -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon purple"><span class="material-icons">reviews</span></div>
          <div class="stat-info"><h3><%= data.totalCount %></h3><p>Toplam Değerlendirme</p></div>
        </div>
        <div class="stat-card">
          <div class="stat-icon orange"><span class="material-icons">star</span></div>
          <div class="stat-info"><h3><%= data.avgRating %></h3><p>Ortalama Puan</p></div>
        </div>
        <!-- Puan Dağılımı Bar -->
        <div class="stat-card" style="grid-column: span 2;">
          <div style="width:100%;">
            <p style="font-size:.75rem;color:#64748b;font-weight:600;margin-bottom:8px;">Puan Dağılımı</p>
            <% const totalReviewsForBar = Object.values(data.ratingDist || {}).reduce((a,b) => a+b, 0) || 1; %>
            <% for (let s = 5; s >= 1; s--) { %>
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
                <span style="font-size:.7rem;font-weight:700;width:12px;text-align:right;"><%= s %></span>
                <span class="material-icons" style="font-size:12px;color:#f59e0b;">star</span>
                <div style="flex:1;height:8px;background:#f1f5f9;border-radius:4px;overflow:hidden;">
                  <div style="height:100%;width:<%= Math.round(((data.ratingDist?.[s]||0)/totalReviewsForBar)*100) %>%;background:linear-gradient(90deg,#facc15,#f59e0b);border-radius:4px;"></div>
                </div>
                <span style="font-size:.7rem;color:#94a3b8;width:24px;"><%= data.ratingDist?.[s] || 0 %></span>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="admin-card">
        <!-- Filtreler -->
        <form class="filter-bar" method="GET" action="/admin/degerlendirmeler" style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;">
          <input type="text" name="arama" placeholder="İşletme, kullanıcı veya yorum ara..." value="<%= data.filters?.arama || '' %>" style="flex:1;min-width:180px;">
          <select name="puan" style="padding:6px 10px;border-radius:8px;border:1px solid #e2e8f0;font-size:.8rem;">
            <option value="">Tüm Puanlar</option>
            <% for(let s=5;s>=1;s--){ %><option value="<%= s %>" <%= data.filters?.puan == s ? 'selected' : '' %>><%= s %> Yıldız</option><% } %>
          </select>
          <select name="isletme" style="padding:6px 10px;border-radius:8px;border:1px solid #e2e8f0;font-size:.8rem;">
            <option value="">Tüm İşletmeler</option>
            <% (data.businessList || []).forEach(bl => { %>
              <option value="<%= bl.id %>" <%= data.filters?.isletme == bl.id ? 'selected' : '' %>><%= bl.name %> (<%= bl.review_count %>)</option>
            <% }) %>
          </select>
          <button type="submit" class="btn-sm btn-primary"><span class="material-icons">search</span> Filtrele</button>
          <% if (data.filters?.arama || data.filters?.puan || data.filters?.isletme) { %>
            <a href="/admin/degerlendirmeler" class="btn-sm btn-outline" style="text-decoration:none;"><span class="material-icons">clear</span> Temizle</a>
          <% } %>
        </form>

        <div style="overflow-x:auto;">
          <table class="admin-table">
            <thead>
              <tr>
                <th>ID</th><th>İşletme</th><th>Kullanıcı</th><th>Puan</th><th>Hizmet</th><th>Yorum</th><th>Tarih</th><th>İşlem</th>
              </tr>
            </thead>
            <tbody>
              <% if (!data.reviews || data.reviews.length === 0) { %>
              <tr><td colspan="8" style="text-align:center;padding:2rem;color:#94a3b8;"><span class="material-icons" style="font-size:2rem;display:block;margin-bottom:4px;">rate_review</span>Henüz değerlendirme yok</td></tr>
              <% } %>
              <% (data.reviews || []).forEach(r => { %>
              <tr>
                <td>#<%= r.id %></td>
                <td><a href="/servis/<%= (r.business_name || '').toLowerCase().replace(/\s+/g,'-').replace(/[^a-z0-9ğüşıöç-]/g,'') %>" target="_blank" style="color:#1a73e8;text-decoration:none;font-weight:600;"><%= r.business_name %> ↗</a></td>
                <td><%= r.reviewer_name %><br><small style="color:#999"><%= r.reviewer_email %></small></td>
                <td>
                  <div style="display:flex;align-items:center;gap:2px;">
                    <% for(let i=0;i<5;i++){%><span class="material-icons" style="font-size:14px;color:<%= i < r.rating ? '#f59e0b' : '#ddd' %>">star</span><%}%>
                  </div>
                </td>
                <td><% if (r.service_type) { %><span style="background:#f0f9ff;color:#0369a1;font-size:.7rem;padding:2px 8px;border-radius:6px;white-space:nowrap;"><%= r.service_type %></span><% } else { %><span style="color:#ccc;">—</span><% } %></td>
                <td style="max-width:250px;" title="<%= (r.comment || '').replace(/"/g, '&quot;') %>">
                  <%= (r.comment || '').substring(0, 80) %><% if ((r.comment || '').length > 80) { %>…<% } %>
                </td>
                <td style="white-space:nowrap;"><%= timeAgo(r.created_at) %></td>
                <td>
                  <div class="action-btns">
                    <button class="btn-sm btn-danger" data-admin-delete-review data-review-id="<%= r.id %>" title="Sil">
                      <span class="material-icons">delete</span>
                    </button>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <% if (data.totalPages > 1) { %>
        <div class="pagination">
          <% for (let p = 1; p <= data.totalPages; p++) { %>
            <a href="/admin/degerlendirmeler?sayfa=<%= p %>&arama=<%= data.filters?.arama || '' %>&puan=<%= data.filters?.puan || '' %>&isletme=<%= data.filters?.isletme || '' %>" class="<%= p === data.page ? 'active' : '' %>"><%= p %></a>
          <% } %>
        </div>
        <% } %>
      </div>

    <!-- ═══════════════════════════════════════════ -->
    <!--  ARAÇ HUB                                   -->
    <!-- ═══════════════════════════════════════════ -->
    <% } else if (currentPage === 'hublar') { %>
      <style>
        .hub-card{background:#fff;border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,.06);margin-bottom:12px;overflow:hidden;transition:box-shadow .2s;}
        .hub-card:hover{box-shadow:0 4px 16px rgba(0,0,0,.1);}
        .hub-brand-header{display:flex;align-items:center;gap:1rem;padding:1rem 1.25rem;cursor:pointer;user-select:none;transition:background .15s;}
        .hub-brand-header:hover{background:#f8f9fa;}
        .hub-brand-logo{width:40px;height:40px;border-radius:8px;object-fit:contain;background:#f8f9fa;padding:4px;flex-shrink:0;border:1px solid #eee;}
        .hub-brand-logo-ph{width:40px;height:40px;border-radius:8px;background:#e8f0fe;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-weight:700;color:#1a73e8;font-size:1rem;}
        .hub-brand-info{flex:1;min-width:0;}
        .hub-brand-info h3{margin:0;font-size:.95rem;font-weight:700;color:#1a1f36;}
        .hub-brand-info .hub-brand-meta{display:flex;gap:1rem;font-size:.75rem;color:#999;margin-top:2px;}
        .hub-brand-meta span{display:flex;align-items:center;gap:3px;}
        .hub-brand-meta .material-icons{font-size:.85rem;}
        .hub-expand{width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:50%;transition:all .2s;color:#999;}
        .hub-expand.open{transform:rotate(180deg);color:#1a73e8;}
        .hub-models-list{display:none;padding:0 1.25rem 1rem;border-top:1px solid #f0f0f0;}
        .hub-models-list.show{display:block;}
        .hub-row{display:flex;align-items:center;gap:.75rem;padding:.75rem .5rem;border-bottom:1px solid #f5f5f5;font-size:.85rem;transition:background .15s;}
        .hub-row:hover{background:#f8f9ff;}
        .hub-row:last-child{border-bottom:none;}
        .hub-row-img{width:56px;height:38px;border-radius:6px;object-fit:cover;flex-shrink:0;background:#f0f2f5;}
        .hub-row-img-ph{width:56px;height:38px;border-radius:6px;background:#f0f2f5;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#cbd5e1;}
        .hub-row .hub-name{flex:1;min-width:0;}
        .hub-row .hub-name strong{font-weight:700;color:#1a1f36;font-size:.88rem;}
        .hub-row .hub-name small{display:block;color:#999;font-size:.72rem;margin-top:1px;}
        .hub-row .hub-specs{display:flex;gap:.75rem;color:#666;font-size:.75rem;flex-wrap:wrap;}
        .hub-row .hub-specs span{display:flex;align-items:center;gap:3px;white-space:nowrap;}
        .hub-row .hub-specs .material-icons{font-size:.85rem;color:#999;}
        .hub-row .hub-price{font-weight:700;color:#1a73e8;font-size:.85rem;white-space:nowrap;}
        .hub-row .hub-rating{display:flex;align-items:center;gap:3px;font-weight:700;font-size:.8rem;color:#e8710a;white-space:nowrap;}
        .hub-row .hub-rating .material-icons{font-size:.9rem;color:#e8710a;}
        .search-hubs{margin-bottom:1rem;padding:10px 14px;border:1px solid #ddd;border-radius:10px;width:100%;font-size:.9rem;box-sizing:border-box;}
        .search-hubs:focus{outline:none;border-color:#1a73e8;box-shadow:0 0 0 3px rgba(26,115,232,.1);}
        .hub-stats-bar{display:flex;gap:1rem;margin-bottom:1.5rem;}
        .hub-stat{background:#fff;border-radius:10px;padding:.75rem 1.25rem;display:flex;align-items:center;gap:.75rem;box-shadow:0 1px 4px rgba(0,0,0,.06);flex:1;}
        .hub-stat .material-icons{font-size:1.5rem;opacity:.5;}
        .hub-stat h4{margin:0;font-size:1.2rem;font-weight:700;color:#1a1f36;}.hub-stat p{margin:0;font-size:.7rem;color:#999;}
        .hub-add-inline{display:flex;gap:.5rem;padding:.75rem .5rem;align-items:end;border-top:1px dashed #e5e7eb;}
        .hub-add-inline select{padding:7px 10px;border:1px solid #ddd;border-radius:6px;font-size:.8rem;flex:1;}
      </style>

      <div class="admin-header">
        <h1>🔧 Araç Hub Yönetimi</h1>
        <button class="btn-sm btn-primary" onclick="openHubModal()"><span class="material-icons">add</span> Yeni Hub</button>
      </div>

      <!-- İstatistik çubuğu -->
      <div class="hub-stats-bar">
        <div class="hub-stat"><span class="material-icons" style="color:#1a73e8;">hub</span><div><h4><%= data.totalModels || 0 %></h4><p>Toplam Model Hub</p></div></div>
        <div class="hub-stat"><span class="material-icons" style="color:#1e8e3e;">category</span><div><h4><%= (data.brands||[]).length %></h4><p>Marka</p></div></div>
        <div class="hub-stat"><span class="material-icons" style="color:#e8710a;">edit_note</span><div><h4><%= (data.hubs||[]).length %></h4><p>Manuel Hub</p></div></div>
        <div class="hub-stat"><span class="material-icons" style="color:#7c3aed;">auto_awesome</span><div><h4><%= data.autoGeneratedCount || 0 %></h4><p>Otomatik Üretilen</p></div></div>
      </div>

      <!-- Arama -->
      <input type="text" class="search-hubs" id="hubSearch" placeholder="🔍 Marka veya model ara..." oninput="filterHubBrands(this.value)">

      <!-- Marka bazlı accordion listesi — TÜM markalar ve modeller -->
      <div id="hubBrandList">
      <% 
        const hubsByBrand = data.hubsByBrand || {};
        const allModelsByBrand = data.allModelsByBrand || {};
        // Modeli olan TÜM markaları göster
        (data.brands || []).filter(b => allModelsByBrand[b.id] && allModelsByBrand[b.id].length > 0).forEach(b => { 
          const brandModels = allModelsByBrand[b.id] || [];
          const manualCount = brandModels.filter(m => m.hasManualHub).length;
          const autoCount = brandModels.length - manualCount;
      %>
        <div class="hub-card" data-hub-brand-name="<%= b.name.toLowerCase() %>" data-hub-models="<%= brandModels.map(m=>m.name.toLowerCase()).join(',') %>">
          <div class="hub-brand-header" onclick="toggleHubBrand(<%= b.id %>)">
            <% if (b.logo) { %>
              <img src="<%= b.logo %>" alt="<%= b.name %>" class="hub-brand-logo" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
              <div class="hub-brand-logo-ph" style="display:none;"><%= b.name.charAt(0) %></div>
            <% } else { %>
              <div class="hub-brand-logo-ph"><%= b.name.charAt(0) %></div>
            <% } %>
            <div class="hub-brand-info">
              <h3><%= b.name %></h3>
              <div class="hub-brand-meta">
                <span><span class="material-icons">directions_car</span> <%= brandModels.length %> model</span>
                <% if (manualCount > 0) { %><span><span class="material-icons">edit_note</span> <%= manualCount %> manuel</span><% } %>
                <span><span class="material-icons">auto_awesome</span> <%= autoCount %> otomatik</span>
              </div>
            </div>
            <div class="hub-expand" id="hubExpand_<%= b.id %>"><span class="material-icons">expand_more</span></div>
          </div>
          <div class="hub-models-list" id="hubModels_<%= b.id %>">
            <% brandModels.forEach(m => { 
              const h = m.manualHub;
            %>
              <div class="hub-row" data-hub-model-search="<%= m.name.toLowerCase() %>">
                <% if (h && h.image_url) { %>
                  <img src="<%= h.image_url %>" alt="<%= m.name %>" class="hub-row-img" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                  <div class="hub-row-img-ph" style="display:none;"><span class="material-icons" style="font-size:1rem;">directions_car</span></div>
                <% } else { %>
                  <div class="hub-row-img-ph"><span class="material-icons" style="font-size:1rem;">directions_car</span></div>
                <% } %>
                <div class="hub-name">
                  <strong><%= m.name %></strong>
                  <small>
                    <% if (m.hasManualHub) { %>
                      <span style="color:#1e8e3e;font-weight:600;">● Manuel Hub</span>
                      <% if (h) { %>
                        <%= h.year || '' %><%= h.year && h.fuel_type ? ' · ' : '' %><%= h.fuel_type || '' %><%= (h.year || h.fuel_type) && h.engine ? ' · ' : '' %><%= h.engine || '' %>
                      <% } %>
                    <% } else { %>
                      <span style="color:#7c3aed;font-weight:600;">● Otomatik Hub</span>
                      <%= m.body_type || '' %>
                    <% } %>
                  </small>
                </div>
                <div class="hub-specs">
                  <% if (h && h.hp) { %><span><span class="material-icons">speed</span> <%= h.hp %> HP</span><% } %>
                  <% if (h && h.transmission) { %><span><span class="material-icons">settings</span> <%= h.transmission %></span><% } %>
                </div>
                <% if (h && h.avg_price) { %><span class="hub-price"><%= formatPrice(h.avg_price) %></span><% } %>
                <% if (h && h.editor_rating) { %><span class="hub-rating"><span class="material-icons">star</span> <%= h.editor_rating %>/10</span><% } %>
                <div class="action-btns">
                  <a href="/arac/<%= m.brand_slug || b.slug %>/<%= m.slug %>" target="_blank" class="btn-sm btn-outline" title="Hub'ı Görüntüle" style="text-decoration:none;padding:3px 8px;">
                    <span class="material-icons" style="font-size:.8rem;">visibility</span>
                  </a>
                  <% if (m.hasManualHub && h) { %>
                    <button class="btn-sm btn-primary" data-edit-hub='<%- JSON.stringify(h).replace(/'/g, "&#39;") %>' title="Düzenle" style="padding:3px 8px;">
                      <span class="material-icons" style="font-size:.8rem;">edit</span>
                    </button>
                    <button class="btn-sm btn-danger" data-admin-delete-hub data-hub-id="<%= h.id %>" title="Sil" style="padding:3px 8px;">
                      <span class="material-icons" style="font-size:.8rem;">delete</span>
                    </button>
                  <% } else { %>
                    <button class="btn-sm btn-primary" onclick="editGeneratedHub(<%= b.id %>, <%= m.id %>)" title="Otomatik İçeriği Düzenle" style="padding:3px 8px;">
                      <span class="material-icons" style="font-size:.8rem;">edit</span>
                    </button>
                    <button class="btn-sm btn-success" onclick="openHubModalForModel(<%= b.id %>, <%= m.id %>, '<%= m.name %>')" title="Boş Manuel Hub Oluştur" style="padding:3px 8px;">
                      <span class="material-icons" style="font-size:.8rem;">add</span>
                    </button>
                  <% } %>
                </div>
              </div>
            <% }) %>
            <!-- Inline Hub Ekleme: marka için model seç — artık tüm modeller listeleniyor, bu isteğe bağlı -->
          </div>
        </div>
      <% }) %>
      </div>

      <% if (!data.brands || data.brands.length === 0) { %>
        <div class="admin-card" style="text-align:center;padding:3rem;">
          <span class="material-icons" style="font-size:3rem;color:#cbd5e1;">hub</span>
          <p style="color:#999;margin-top:.75rem;">Henüz marka/model kaydı yok.</p>
        </div>
      <% } %>

      <!-- HUB MODAL -->
      <div class="admin-modal-overlay" id="hubModal">
        <div class="admin-modal">
          <button class="close-modal" onclick="closeHubModal()">&times;</button>
          <h3 id="hubModalTitle">Yeni Araç Hub</h3>
          <form id="hubForm">
            <input type="hidden" id="hub_id">
            <div class="form-row">
              <div class="form-group">
                <label>Marka *</label>
                <select id="hub_brand_id" required>
                  <option value="">Seçin...</option>
                  <% (data.brands || []).forEach(b => { %>
                    <option value="<%= b.id %>"><%= b.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="form-group">
                <label>Model *</label>
                <select id="hub_model_id" required>
                  <option value="">Önce marka seçin...</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label>Araç Görseli (URL)</label>
              <input type="url" id="hub_image_url" placeholder="https://images.unsplash.com/... veya başka bir görsel URL'si">
              <div id="hub_image_preview" style="margin-top:8px;display:none;">
                <img id="hub_image_preview_img" src="" alt="Önizleme" style="max-width:100%;max-height:180px;border-radius:8px;object-fit:cover;border:1px solid #e2e8f0;">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group"><label>Yıl</label><input type="number" id="hub_year" min="1990" max="2030"></div>
              <div class="form-group"><label>Ortalama Fiyat (₺)</label><input type="number" id="hub_avg_price"></div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Yakıt Tipi</label>
                <select id="hub_fuel_type"><option value="">Seçin</option><option value="Benzin">Benzin</option><option value="Dizel">Dizel</option><option value="Benzin & LPG">Benzin & LPG</option><option value="Hibrit">Hibrit</option><option value="Elektrik">Elektrik</option></select>
              </div>
              <div class="form-group"><label>Motor</label><input type="text" id="hub_engine" placeholder="ör: 1.6 TDI"></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label>HP</label><input type="number" id="hub_hp"></div>
              <div class="form-group"><label>Tork (Nm)</label><input type="number" id="hub_torque"></div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Şanzıman</label>
                <select id="hub_transmission"><option value="">Seçin</option><option value="Manuel">Manuel</option><option value="Otomatik">Otomatik</option><option value="Yarı Otomatik">Yarı Otomatik</option></select>
              </div>
              <div class="form-group"><label>0-100 km/s (sn)</label><input type="number" step="0.1" id="hub_acceleration"></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label>Maks. Hız (km/s)</label><input type="number" id="hub_top_speed"></div>
              <div class="form-group"><label>Yakıt Tüketimi (L/100km)</label><input type="number" step="0.1" id="hub_fuel_consumption"></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label>Uzunluk (mm)</label><input type="number" id="hub_length"></div>
              <div class="form-group"><label>Genişlik (mm)</label><input type="number" id="hub_width"></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label>Yükseklik (mm)</label><input type="number" id="hub_height"></div>
              <div class="form-group"><label>Dingil Mesafesi (mm)</label><input type="number" id="hub_wheelbase"></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label>Ağırlık (kg)</label><input type="number" id="hub_weight"></div>
              <div class="form-group"><label>Editör Puanı (1-10)</label><input type="number" id="hub_editor_rating" min="1" max="10" step="0.1"></div>
            </div>
            <div class="form-group"><label>Editör Yorumu</label><textarea id="hub_editor_review" rows="3"></textarea></div>
            <div class="form-row">
              <div class="form-group"><label>Artılar (virgülle ayırın)</label><textarea id="hub_pros" rows="2"></textarea></div>
              <div class="form-group"><label>Eksiler (virgülle ayırın)</label><textarea id="hub_cons" rows="2"></textarea></div>
            </div>
            <div class="modal-actions">
              <button type="button" class="btn-sm btn-outline" onclick="closeHubModal()">İptal</button>
              <button type="submit" class="btn-sm btn-primary" id="hubSubmitBtn">Kaydet</button>
