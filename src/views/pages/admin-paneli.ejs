                <th>ID</th><th>İşletme Adı</th><th>Tür</th><th>Sahip</th><th>Onay</th><th>Premium</th><th>Puan</th><th>Tarih</th><th>İşlemler</th>
              </tr>
            </thead>
            <tbody>
              <% (data.businesses || []).forEach(b => { %>
                <tr>
                  <td>#<%= b.id %></td>
