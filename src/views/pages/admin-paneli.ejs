                  <span class="badge <%= apBadge[a.status] || 'badge-secondary' %>" style="font-size:.7rem;"><%= apStat[a.status] || a.status %></span>
                </td>
                <td>
                  <% if (a.status === 'pending') { %>
                  <div class="action-btns" style="gap:4px;">
                    <button class="btn-sm btn-success" data-admin-appt-status data-appt-id="<%= a.id %>" data-status="confirmed" title="Onayla" style="padding:3px 6px;">
                      <span class="material-icons" style="font-size:.85rem;">check</span>
                    </button>
                    <button class="btn-sm btn-danger" data-admin-appt-status data-appt-id="<%= a.id %>" data-status="cancelled" title="İptal Et" style="padding:3px 6px;">
                      <span class="material-icons" style="font-size:.85rem;">close</span>
                    </button>
                  </div>
                  <% } else if (a.status === 'confirmed') { %>
                  <div class="action-btns" style="gap:4px;">
                    <button class="btn-sm btn-success" data-admin-appt-status data-appt-id="<%= a.id %>" data-status="completed" title="Tamamlandı" style="padding:3px 6px;">
                      <span class="material-icons" style="font-size:.85rem;">task_alt</span>
                    </button>
                    <button class="btn-sm btn-danger" data-admin-appt-status data-appt-id="<%= a.id %>" data-status="cancelled" title="İptal Et" style="padding:3px 6px;">
                      <span class="material-icons" style="font-size:.85rem;">close</span>
                    </button>
                  </div>
                  <% } else { %>
                  <span style="color:#ccc;font-size:.75rem;">—</span>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
