                    <div class="action-btns">
                      <% if (u.id !== currentUser.id) { %>
                        <button class="btn-sm btn-danger" data-admin-delete-user data-user-id="<%= u.id %>" title="Kullanıcıyı Sil">
                          <span class="material-icons">delete</span>
                        </button>
                      <% } else { %>
                        <span style="font-size:.7rem;color:#999;" title="Kendinizi silemezsiniz">—</span>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>

        <% if (data.totalPages > 1) { %>
          <div class="pagination">
            <% for (let i = 1; i <= data.totalPages; i++) { %>
              <a href="/admin/kullanicilar?sayfa=<%= i %>&arama=<%= data.filters?.arama||'' %>&rol=<%= data.filters?.rol||'' %>&onay=<%= data.filters?.onay||'' %>" class="<%= data.page === i ? 'active' : '' %>"><%= i %></a>
