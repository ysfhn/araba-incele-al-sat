<%
function formatPrice(p) { return new Intl.NumberFormat('tr-TR').format(p) + ' ₺'; }
function formatKm(k) { return new Intl.NumberFormat('tr-TR').format(k); }
function fuelLabel(f) { const m={benzin:'Benzin',dizel:'Dizel',elektrik:'Elektrik',hibrit:'Hibrit',lpg:'LPG'}; return m[f]||f||''; }
function transLabel(t) { const m={otomatik:'Otomatik',manuel:'Manuel',yari_otomatik:'Yarı Otomatik'}; return m[t]||t||''; }
function timeAgo(d) { const s=Math.floor((Date.now()-new Date(d))/1000); if(s<60) return 'az önce'; if(s<3600) return Math.floor(s/60)+' dk önce'; if(s<86400) return Math.floor(s/3600)+' saat önce'; return Math.floor(s/86400)+' gün önce'; }
%>
<main class="container mx-auto px-6 py-8">
<!-- Breadcrumb -->
<div class="flex items-center text-sm text-slate-500 mb-6 gap-1">
<a href="/" class="hover:text-primary">Ana Sayfa</a><span>/</span>
<a href="/ilan" class="hover:text-primary">İlanlar</a><span>/</span>
<span class="text-slate-800 font-medium"><%= listing.brand_name %> <%= listing.model_name %></span>
</div>

<div class="flex flex-col lg:flex-row gap-8">
<!-- Sol: Görseller + Detay -->
<div class="flex-1">
<!-- Görseller -->
<div class="bg-white rounded-2xl border border-slate-100 overflow-hidden mb-6">
<div class="h-96 bg-slate-100 flex items-center justify-center relative">
<% if (images && images.length > 0 && images[0].url !== '/images/car-placeholder.svg') { %>
<img src="<%= images[0].url %>" alt="<%= listing.title %>" class="w-full h-full object-cover"/>
<% } else { %>
<span class="material-symbols-outlined text-[120px] text-slate-300">directions_car</span>
<% } %>
<% if (listing.is_featured) { %><div class="absolute top-4 left-4 bg-primary text-white text-xs px-3 py-1.5 rounded-full font-bold">ÖNE ÇIKAN İLAN</div><% } %>
</div>
<% if (images && images.length > 1) { %>
<div class="flex gap-2 p-4 overflow-x-auto">
<% images.forEach((img, i) => { %>
<div class="w-24 h-16 bg-slate-100 rounded-lg overflow-hidden flex-shrink-0 border-2 <%= i===0?'border-primary':'border-transparent' %>">
<img src="<%= img.url %>" class="w-full h-full object-cover"/>
</div>
<% }) %>
</div>
<% } %>
</div>

<!-- Araç Bilgileri -->
<div class="bg-white rounded-2xl border border-slate-100 p-6 mb-6">
<div class="flex items-start justify-between mb-4">
<div>
<h1 class="text-2xl font-bold text-slate-900"><%= listing.title %></h1>
<p class="text-slate-500 text-sm mt-1"><%= listing.brand_name %> <%= listing.model_name %> • <%= listing.year %></p>
</div>
<p class="text-3xl font-black text-primary"><%= formatPrice(listing.price) %></p>
</div>

<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 py-6 border-y border-slate-100">
<div class="text-center">
<span class="material-symbols-outlined text-primary text-2xl">speed</span>
<p class="text-lg font-bold text-slate-900 mt-1"><%= formatKm(listing.km) %></p>
<p class="text-xs text-slate-500">Kilometre</p>
</div>
<div class="text-center">
<span class="material-symbols-outlined text-primary text-2xl">calendar_today</span>
<p class="text-lg font-bold text-slate-900 mt-1"><%= listing.year %></p>
<p class="text-xs text-slate-500">Model Yılı</p>
</div>
<div class="text-center">
<span class="material-symbols-outlined text-primary text-2xl">local_gas_station</span>
<p class="text-lg font-bold text-slate-900 mt-1"><%= fuelLabel(listing.fuel_type) %></p>
<p class="text-xs text-slate-500">Yakıt</p>
</div>
<div class="text-center">
<span class="material-symbols-outlined text-primary text-2xl">settings</span>
<p class="text-lg font-bold text-slate-900 mt-1"><%= transLabel(listing.transmission) %></p>
<p class="text-xs text-slate-500">Vites</p>
</div>
</div>

<div class="grid grid-cols-2 gap-4 mt-6 text-sm">
<% if (listing.hp) { %><div class="flex justify-between py-2 border-b border-slate-50"><span class="text-slate-500">Beygir Gücü</span><span class="font-semibold"><%= listing.hp %> HP</span></div><% } %>
<% if (listing.color) { %><div class="flex justify-between py-2 border-b border-slate-50"><span class="text-slate-500">Renk</span><span class="font-semibold"><%= listing.color %></span></div><% } %>
<% if (listing.city) { %><div class="flex justify-between py-2 border-b border-slate-50"><span class="text-slate-500">Konum</span><span class="font-semibold"><%= listing.city %></span></div><% } %>
<div class="flex justify-between py-2 border-b border-slate-50"><span class="text-slate-500">Görüntülenme</span><span class="font-semibold"><%= listing.view_count %></span></div>
</div>
</div>

<!-- Özellikler -->
<% if (features && features.length > 0) { %>
<div class="bg-white rounded-2xl border border-slate-100 p-6 mb-6">
<h2 class="text-lg font-bold text-slate-900 mb-4">Araç Özellikleri</h2>
<div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
<% features.forEach(f => { %>
<div class="flex items-center gap-2 text-sm text-slate-700">
<span class="material-symbols-outlined text-green-500 text-base">check_circle</span> <%= f %>
</div>
<% }) %>
</div>
</div>
<% } %>

<!-- Açıklama -->
<% if (listing.description) { %>
<div class="bg-white rounded-2xl border border-slate-100 p-6 mb-6">
<h2 class="text-lg font-bold text-slate-900 mb-4">Açıklama</h2>
<p class="text-slate-600 leading-relaxed whitespace-pre-line"><%= listing.description %></p>
</div>
<% } %>
</div>

<!-- Sağ: Satıcı & Aksiyonlar -->
<div class="lg:w-80 shrink-0 space-y-6">
<!-- Favori / Paylaş -->
<div class="bg-white rounded-2xl border border-slate-100 p-5 flex gap-3">
<button data-favorite="<%= listing.id %>" class="flex-1 py-3 rounded-xl border border-slate-200 font-bold text-sm flex items-center justify-center gap-2 hover:bg-red-50 hover:border-red-200 transition-all <%= isFavorited?'bg-red-50 border-red-300 text-red-600':'text-slate-700' %>">
<span class="material-symbols-outlined text-base"><%= isFavorited?'favorite':'favorite_border' %></span> <%= isFavorited?'Favorilerde':'Favorile' %>
</button>
<button class="py-3 px-4 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 transition-all" onclick="navigator.share?.({url:location.href, title:'<%= listing.title %>'})">
<span class="material-symbols-outlined text-base">share</span>
</button>
</div>

<!-- Satıcı Bilgileri -->
<div class="bg-white rounded-2xl border border-slate-100 p-6">
<h3 class="font-bold text-slate-900 mb-4">Satıcı Bilgileri</h3>
<div class="flex items-center gap-3 mb-4">
<div class="size-12 bg-primary/10 rounded-full flex items-center justify-center text-primary font-bold text-lg"><%= listing.seller_name ? listing.seller_name.charAt(0).toUpperCase() : '?' %></div>
<div>
<p class="font-bold text-slate-800"><%= listing.seller_name %></p>
<p class="text-xs text-slate-500"><%= listing.seller_role === 'kurumsal' ? 'Kurumsal Satıcı' : 'Bireysel Satıcı' %></p>
</div>
</div>
<% if (typeof currentUser !== 'undefined' && currentUser) { %>
<% if (listing.seller_phone) { %>
<a href="tel:<%= listing.seller_phone %>" class="w-full bg-green-600 text-white font-bold py-3 rounded-xl hover:bg-green-700 transition-all flex items-center justify-center gap-2 mb-3">
<span class="material-symbols-outlined">call</span> <%= listing.seller_phone %>
</a>
<% } %>
<button data-send-message="<%= listing.user_id %>" data-receiver-name="<%= listing.seller_name %>" data-listing-id="<%= listing.id %>" class="w-full bg-primary text-white font-bold py-3 rounded-xl hover:bg-primary/90 transition-all flex items-center justify-center gap-2">
<span class="material-symbols-outlined">chat</span> Mesaj Gönder
</button>
<% } else { %>
<a href="/giris" class="w-full bg-primary text-white font-bold py-3 rounded-xl hover:bg-primary/90 transition-all flex items-center justify-center gap-2 block">
<span class="material-symbols-outlined">login</span> İletişim için Giriş Yap
</a>
<% } %>
</div>

<!-- İlan Numarası -->
<div class="bg-slate-50 rounded-2xl p-5 text-sm text-slate-500 space-y-2">
<div class="flex justify-between"><span>İlan No</span><span class="font-mono font-bold text-slate-700">#<%= listing.id %></span></div>
<div class="flex justify-between"><span>Yayın Tarihi</span><span class="font-semibold text-slate-700"><%= new Date(listing.created_at).toLocaleDateString('tr-TR') %></span></div>
<div class="flex justify-between"><span>Görüntülenme</span><span class="font-semibold text-slate-700"><%= listing.view_count %></span></div>
</div>

<!-- Satıcının Diğer İlanları -->
<% if (sellerListings && sellerListings.length > 0) { %>
<div class="bg-white rounded-2xl border border-slate-100 p-6">
<h3 class="font-bold text-slate-900 mb-4">Satıcının Diğer İlanları</h3>
<div class="space-y-3">
<% sellerListings.forEach(sl => { %>
<a href="/ilan/<%= sl.slug %>" class="flex gap-3 items-center p-2 rounded-lg hover:bg-slate-50 transition-all">
<div class="w-16 h-12 bg-slate-100 rounded-lg flex items-center justify-center flex-shrink-0">
<span class="material-symbols-outlined text-slate-300">directions_car</span>
</div>
<div>
<p class="font-semibold text-sm text-slate-800"><%= sl.brand_name %> <%= sl.model_name %></p>
<p class="text-primary font-bold text-sm"><%= formatPrice(sl.price) %></p>
</div>
</a>
<% }) %>
</div>
</div>
<% } %>
</div>
</div>

<!-- Benzer İlanlar -->
<% if (similarListings && similarListings.length > 0) { %>
<div class="mt-12">
<h2 class="text-2xl font-bold text-slate-900 mb-6">Benzer İlanlar</h2>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
<% similarListings.forEach(l => { %>
<div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-slate-100">
<div class="h-40 bg-slate-100 flex items-center justify-center">
<span class="material-symbols-outlined text-5xl text-slate-300">directions_car</span>
</div>
<div class="p-4">
<h3 class="font-bold text-slate-900"><%= l.brand_name %> <%= l.model_name %></h3>
<p class="text-primary font-bold mt-1"><%= formatPrice(l.price) %></p>
<div class="flex gap-3 mt-2 text-xs text-slate-500">
<span><%= formatKm(l.km) %> km</span><span><%= l.year %></span>
</div>
<a href="/ilan/<%= l.slug %>" class="block w-full mt-3 py-2 rounded-lg bg-slate-50 text-sm font-bold text-slate-700 border border-slate-200 hover:bg-slate-100 text-center">İncele</a>
</div>
</div>
<% }) %>
</div>
</div>
<% } %>
</main>
