<%
function formatPrice(p) { return new Intl.NumberFormat('tr-TR').format(p) + ' ₺'; }
function formatKm(k) { return new Intl.NumberFormat('tr-TR').format(k); }
function fuelLabel(f) { const m={benzin:'Benzin',dizel:'Dizel',elektrik:'Elektrik',hibrit:'Hibrit',lpg:'LPG'}; return m[f]||f||''; }
function transLabel(t) { const m={otomatik:'Otomatik',manuel:'Manuel',yari_otomatik:'Yarı Otomatik'}; return m[t]||t||''; }
function timeAgo(d) { const s=Math.floor((Date.now()-new Date(d))/1000); if(s<60) return 'az önce'; if(s<3600) return Math.floor(s/60)+' dk önce'; if(s<86400) return Math.floor(s/3600)+' saat önce'; return Math.floor(s/86400)+' gün önce'; }
%>

<style>
  .det-section { background:#fff; border:1px solid #e2e8f0; border-radius:14px; padding:24px; margin-bottom:20px; }
  .det-gallery { border-radius:14px; overflow:hidden; border:1px solid #e2e8f0; margin-bottom:20px; background:#fff; }
  .det-gallery-main { height:400px; background:#f1f5f9; display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden; cursor:pointer; }
  .det-gallery-main img { width:100%; height:100%; object-fit:cover; transition:transform .3s; }
  .det-gallery-main:hover img { transform:scale(1.02); }
  .det-gallery-thumbs { display:flex; gap:8px; padding:12px; overflow-x:auto; }
  .det-gallery-thumb { width:80px; height:56px; border-radius:10px; overflow:hidden; flex-shrink:0; border:2px solid transparent; cursor:pointer; transition:border-color .15s; opacity:.7; }
  .det-gallery-thumb.active, .det-gallery-thumb:hover { border-color:#1e293b; opacity:1; }
  .det-gallery-thumb img { width:100%; height:100%; object-fit:cover; }

  .det-stat { text-align:center; padding:16px 8px; }
  .det-stat-icon { width:40px; height:40px; border-radius:10px; background:#f8fafc; display:flex; align-items:center; justify-content:center; margin:0 auto 8px; }
  .det-stat-icon .material-symbols-outlined { font-size:20px; color:#64748b; }
  .det-stat-val { font-size:15px; font-weight:700; color:#1e293b; }
  .det-stat-label { font-size:11px; color:#94a3b8; margin-top:2px; }

  .det-row { display:flex; justify-content:space-between; padding:10px 0; border-bottom:1px solid #f1f5f9; font-size:13px; }
  .det-row-key { color:#94a3b8; }
  .det-row-val { color:#1e293b; font-weight:600; }

  .det-feature { display:flex; align-items:center; gap:6px; font-size:13px; color:#475569; padding:6px 12px; background:#f8fafc; border-radius:8px; border:1px solid #f1f5f9; }
  .det-feature .material-symbols-outlined { font-size:16px; color:#22c55e; }

  .det-seller-card { background:#fff; border:1px solid #e2e8f0; border-radius:14px; padding:20px; }
  .det-seller-avatar { width:44px; height:44px; border-radius:12px; background:#f1f5f9; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:16px; color:#64748b; }
  .det-call-btn { width:100%; padding:11px; border-radius:10px; font-weight:700; font-size:13px; border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:6px; transition:all .15s; }
  .det-call-btn.green { background:#16a34a; color:#fff; }
  .det-call-btn.green:hover { background:#15803d; }
  .det-call-btn.dark { background:#1e293b; color:#fff; }
  .det-call-btn.dark:hover { background:#334155; }

  .det-meta { background:#f8fafc; border:1px solid #f1f5f9; border-radius:14px; padding:16px 20px; }
  .det-meta-row { display:flex; justify-content:space-between; font-size:12px; padding:4px 0; }
  .det-meta-row span:first-child { color:#94a3b8; }
  .det-meta-row span:last-child { color:#1e293b; font-weight:600; }

  .det-fav-btn { flex:1; padding:10px; border-radius:10px; border:1px solid #e2e8f0; font-weight:600; font-size:13px; display:flex; align-items:center; justify-content:center; gap:6px; cursor:pointer; transition:all .2s; background:#fff; color:#475569; }
  .det-fav-btn:hover { background:#fef2f2; border-color:#fecaca; color:#dc2626; }
  .det-fav-btn.active { background:#fef2f2; border-color:#f87171; color:#dc2626; box-shadow:0 0 0 3px rgba(248,113,113,0.15); }
  .det-fav-btn.active .material-symbols-outlined { font-variation-settings:'FILL' 1; }
  .det-share-btn { padding:10px 14px; border-radius:10px; border:1px solid #e2e8f0; cursor:pointer; transition:all .15s; background:#fff; color:#64748b; display:flex; align-items:center; justify-content:center; }
  .det-share-btn:hover { background:#f8fafc; border-color:#cbd5e1; }

  .det-similar-card { border:1px solid #e2e8f0; border-radius:12px; overflow:hidden; background:#fff; transition:all .2s; }
  .det-similar-card:hover { box-shadow:0 4px 20px rgba(0,0,0,0.06); border-color:#cbd5e1; }
  .det-badge { position:absolute; top:10px; left:10px; background:#1e293b; color:#fff; font-size:10px; font-weight:700; padding:4px 10px; border-radius:6px; }
</style>

<main class="max-w-7xl mx-auto px-6 py-6">

<!-- Breadcrumb -->
<nav class="flex items-center gap-1.5 text-xs text-slate-400 mb-6">
  <a href="/" class="hover:text-slate-600">Ana Sayfa</a>
  <span class="material-symbols-outlined" style="font-size:14px">chevron_right</span>
  <a href="/ilan" class="hover:text-slate-600">İlanlar</a>
  <span class="material-symbols-outlined" style="font-size:14px">chevron_right</span>
  <span class="text-slate-700 font-medium"><%= listing.brand_name %> <%= listing.model_name %></span>
</nav>

<div class="flex flex-col lg:flex-row gap-6">

<!-- Sol: Görseller + Detay -->
<div class="flex-1 min-w-0">

  <!-- Galeri -->
  <div class="det-gallery">
    <div class="det-gallery-main" id="mainImage">
      <% if (images && images.length > 0 && images[0].url !== '/images/car-placeholder.svg') { %>
      <img src="<%= images[0].url %>" alt="<%= listing.title %>" id="mainImg"/>
      <% } else { %>
      <span class="material-symbols-outlined text-slate-300" style="font-size:96px">directions_car</span>
      <% } %>
      <% if (listing.is_featured) { %><span class="det-badge">ÖNE ÇIKAN</span><% } %>
    </div>
    <% if (images && images.length > 1) { %>
    <div class="det-gallery-thumbs">
      <% images.forEach((img, i) => { %>
      <div class="det-gallery-thumb <%= i===0?'active':'' %>" onclick="changeImage('<%= img.url %>', this)">
        <img src="<%= img.url %>" alt="Görsel <%= i+1 %>"/>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>

  <!-- Başlık + Fiyat -->
  <div class="det-section">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-5">
      <div>
        <h1 class="text-xl font-bold text-slate-800 leading-tight"><%= listing.title %></h1>
        <p class="text-sm text-slate-400 mt-1"><%= listing.brand_name %> <%= listing.model_name %> · <%= listing.year %></p>
      </div>
      <p class="text-2xl font-black text-slate-900 whitespace-nowrap"><%= formatPrice(listing.price) %></p>
    </div>

    <!-- Özet istatistikler -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-0 border border-slate-100 rounded-12" style="border-radius:12px; overflow:hidden;">
      <div class="det-stat" style="border-right:1px solid #f1f5f9;">
        <div class="det-stat-icon"><span class="material-symbols-outlined">speed</span></div>
        <p class="det-stat-val"><%= formatKm(listing.km) %></p>
        <p class="det-stat-label">Kilometre</p>
      </div>
      <div class="det-stat" style="border-right:1px solid #f1f5f9;">
        <div class="det-stat-icon"><span class="material-symbols-outlined">calendar_today</span></div>
        <p class="det-stat-val"><%= listing.year %></p>
        <p class="det-stat-label">Model Yılı</p>
      </div>
      <div class="det-stat" style="border-right:1px solid #f1f5f9;">
        <div class="det-stat-icon"><span class="material-symbols-outlined">local_gas_station</span></div>
        <p class="det-stat-val"><%= fuelLabel(listing.fuel_type) %></p>
        <p class="det-stat-label">Yakıt</p>
      </div>
      <div class="det-stat">
        <div class="det-stat-icon"><span class="material-symbols-outlined">settings</span></div>
        <p class="det-stat-val"><%= transLabel(listing.transmission) %></p>
        <p class="det-stat-label">Vites</p>
      </div>
    </div>

    <!-- Detay satırları -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 mt-5">
      <% if (listing.hp) { %><div class="det-row"><span class="det-row-key">Beygir Gücü</span><span class="det-row-val"><%= listing.hp %> HP</span></div><% } %>
      <% if (listing.color) { %><div class="det-row"><span class="det-row-key">Renk</span><span class="det-row-val"><%= listing.color %></span></div><% } %>
      <% if (listing.city) { %><div class="det-row"><span class="det-row-key">Konum</span><span class="det-row-val"><%= listing.city %></span></div><% } %>
      <div class="det-row"><span class="det-row-key">Görüntülenme</span><span class="det-row-val"><%= listing.view_count %></span></div>
    </div>
  </div>

  <!-- Özellikler -->
  <% if (features && features.length > 0) { %>
  <div class="det-section">
    <h2 class="text-sm font-bold text-slate-800 mb-4 flex items-center gap-2">
      <span class="material-symbols-outlined text-slate-400" style="font-size:18px">checklist</span> Araç Özellikleri
    </h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
      <% features.forEach(feat => { %>
      <div class="det-feature">
        <span class="material-symbols-outlined">check_circle</span> <%= feat %>
      </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- Açıklama -->
  <% if (listing.description) { %>
  <div class="det-section">
    <h2 class="text-sm font-bold text-slate-800 mb-3 flex items-center gap-2">
      <span class="material-symbols-outlined text-slate-400" style="font-size:18px">description</span> Açıklama
    </h2>
    <p class="text-sm text-slate-500 leading-relaxed whitespace-pre-line"><%= listing.description %></p>
  </div>
  <% } %>

</div>

<!-- Sağ: Satıcı & Aksiyonlar -->
<div class="lg:w-72 shrink-0 space-y-4">

  <!-- Favori / Paylaş -->
  <div class="flex gap-2">
    <button data-favorite="<%= listing.id %>" class="det-fav-btn <%= isFavorited?'active':'' %>">
      <span class="material-symbols-outlined" style="font-size:18px"><%= isFavorited?'favorite':'favorite_border' %></span>
      <%= isFavorited?'Favorilerde':'Favorile' %>
    </button>
    <button class="det-share-btn" onclick="navigator.share?.({url:location.href, title:'<%= listing.title %>'})">
      <span class="material-symbols-outlined" style="font-size:18px">share</span>
    </button>
    <button class="det-share-btn" onclick="openReportModal('listing', <%= listing.id %>)" title="Bu ilanı raporla">
      <span class="material-symbols-outlined" style="font-size:18px;color:#d93025;">flag</span>
    </button>
  </div>

  <!-- Satıcı -->
  <div class="det-seller-card">
    <p class="text-xs font-semibold text-slate-400 mb-3">Satıcı Bilgileri</p>
    <div class="flex items-center gap-3 mb-4">
      <div class="det-seller-avatar"><%= listing.seller_name ? listing.seller_name.charAt(0).toUpperCase() : '?' %></div>
      <div>
        <p class="font-bold text-sm text-slate-800"><%= listing.seller_name %></p>
        <p class="text-xs text-slate-400"><%= listing.seller_role === 'kurumsal' ? 'Kurumsal Satıcı' : 'Bireysel Satıcı' %></p>
      </div>
    </div>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <% if (listing.seller_phone) { %>
      <a href="tel:<%= listing.seller_phone %>" class="det-call-btn green mb-2">
        <span class="material-symbols-outlined" style="font-size:18px">call</span> <%= listing.seller_phone %>
      </a>
      <% } %>
      <button data-send-message="<%= listing.user_id %>" data-receiver-name="<%= listing.seller_name %>" data-listing-id="<%= listing.id %>" class="det-call-btn dark">
        <span class="material-symbols-outlined" style="font-size:18px">chat</span> Mesaj Gönder
      </button>
    <% } else { %>
      <a href="/giris" class="det-call-btn dark">
        <span class="material-symbols-outlined" style="font-size:18px">login</span> İletişim için Giriş Yap
      </a>
    <% } %>
  </div>

  <!-- İlan Meta -->
  <div class="det-meta space-y-1">
    <div class="det-meta-row"><span>İlan No</span><span class="font-mono">#<%= listing.id %></span></div>
    <div class="det-meta-row"><span>Yayın Tarihi</span><span><%= new Date(listing.created_at).toLocaleDateString('tr-TR') %></span></div>
    <div class="det-meta-row"><span>Görüntülenme</span><span><%= listing.view_count %></span></div>
  </div>

  <!-- Satıcının Diğer İlanları -->
  <% if (sellerListings && sellerListings.length > 0) { %>
  <div class="det-seller-card">
    <p class="text-xs font-semibold text-slate-400 mb-3">Satıcının Diğer İlanları</p>
    <div class="space-y-2">
      <% sellerListings.forEach(sl => { %>
      <a href="/ilan/<%= sl.slug %>" class="flex gap-3 items-center p-2 rounded-10 hover:bg-slate-50 transition-all" style="border-radius:10px">
        <div class="w-14 h-10 bg-slate-100 rounded-lg flex items-center justify-center flex-shrink-0">
          <span class="material-symbols-outlined text-slate-300" style="font-size:20px">directions_car</span>
        </div>
        <div>
          <p class="font-semibold text-xs text-slate-700"><%= sl.brand_name %> <%= sl.model_name %></p>
          <p class="font-bold text-xs text-slate-900"><%= formatPrice(sl.price) %></p>
        </div>
      </a>
      <% }) %>
    </div>
  </div>
  <% } %>

</div>
</div>

<!-- Benzer İlanlar -->
<% if (similarListings && similarListings.length > 0) { %>
<div class="mt-10 mb-4">
  <h2 class="text-base font-bold text-slate-800 mb-4 flex items-center gap-2">
    <span class="material-symbols-outlined text-slate-400" style="font-size:20px">compare_arrows</span> Benzer İlanlar
  </h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <% similarListings.forEach(l => { %>
    <div class="det-similar-card">
      <div class="h-36 bg-slate-100 flex items-center justify-center overflow-hidden">
        <% if (l.image && l.image !== '/images/car-placeholder.svg') { %>
        <img src="<%= l.image %>" alt="<%= l.brand_name %> <%= l.model_name %>" class="w-full h-full object-cover"/>
        <% } else { %>
        <span class="material-symbols-outlined text-4xl text-slate-300">directions_car</span>
        <% } %>
      </div>
      <div class="p-3">
        <p class="font-bold text-sm text-slate-800"><%= l.brand_name %> <%= l.model_name %></p>
        <p class="font-bold text-sm text-slate-900 mt-1"><%= formatPrice(l.price) %></p>
        <div class="flex gap-3 mt-1.5 text-xs text-slate-400">
          <span><%= formatKm(l.km) %> km</span><span><%= l.year %></span>
        </div>
        <a href="/ilan/<%= l.slug %>" class="block w-full mt-3 py-2 rounded-8 bg-slate-50 text-xs font-semibold text-slate-700 border border-slate-200 hover:bg-slate-100 text-center" style="border-radius:8px">İncele</a>
      </div>
    </div>
    <% }) %>
  </div>
</div>
<% } %>

</main>

<script>
function changeImage(url, thumb) {
  const mainImg = document.getElementById('mainImg');
  if (mainImg) mainImg.src = url;
  document.querySelectorAll('.det-gallery-thumb').forEach(t => t.classList.remove('active'));
  if (thumb) thumb.classList.add('active');
}
</script>
