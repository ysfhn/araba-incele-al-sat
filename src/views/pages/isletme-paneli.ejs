<%
  const currentPage = typeof businessPage !== 'undefined' && businessPage ? businessPage : 'dashboard';
  const data = typeof businessData !== 'undefined' && businessData ? businessData : {};
  function timeAgo(d) { const s=Math.floor((Date.now()-new Date(d))/1000); if(s<60) return 'az önce'; if(s<3600) return Math.floor(s/60)+' dk önce'; if(s<86400) return Math.floor(s/3600)+' saat önce'; return Math.floor(s/86400)+' gün önce'; }
  function formatPrice(p) { return p ? Number(p).toLocaleString('tr-TR') + ' ₺' : '-'; }
  const menuItems = [
    { key: 'dashboard', label: 'Dashboard', icon: 'dashboard', href: '/isletme/panel' },
    { key: 'randevular', label: 'Randevular', icon: 'calendar_today', href: '/isletme/randevular' },
    { key: 'teklifler', label: 'Teklifler', icon: 'request_quote', href: '/isletme/teklifler' },
    { key: 'degerlendirmeler', label: 'Değerlendirmeler', icon: 'reviews', href: '/isletme/degerlendirmeler' },
    { key: 'profil', label: 'Profil Düzenle', icon: 'settings', href: '/isletme/profil' },
  ];
%>
<style>
  .biz-layout{display:flex;min-height:calc(100vh - 70px);background:#f0f2f5;}
  .biz-sidebar{width:260px;background:linear-gradient(180deg,#0f4c3a 0%,#1a7a5e 100%);color:#fff;padding:1.5rem 0;flex-shrink:0;position:sticky;top:70px;height:calc(100vh - 70px);overflow-y:auto;}
  .biz-sidebar .sidebar-brand{padding:0 1.5rem 1.5rem;border-bottom:1px solid rgba(255,255,255,.1);margin-bottom:1rem;}
  .biz-sidebar .sidebar-brand h3{font-size:1.1rem;margin:0;font-weight:700;}
  .biz-sidebar .sidebar-brand small{color:rgba(255,255,255,.5);font-size:.75rem;}
  .biz-menu{list-style:none;padding:0;margin:0;}
  .biz-menu li a{display:flex;align-items:center;gap:.75rem;padding:.75rem 1.5rem;color:rgba(255,255,255,.7);text-decoration:none;font-size:.9rem;transition:all .2s;border-left:3px solid transparent;}
  .biz-menu li a:hover{background:rgba(255,255,255,.08);color:#fff;}
  .biz-menu li a.active{background:rgba(255,255,255,.12);color:#fff;border-left-color:#4ade80;font-weight:600;}
  .biz-menu li a .material-symbols-outlined{font-size:1.25rem;opacity:.8;}
  .biz-content{flex:1;padding:2rem;overflow-x:auto;}
  .biz-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:2rem;flex-wrap:wrap;gap:1rem;}
  .biz-header h1{font-size:1.5rem;font-weight:700;color:#1a1f36;margin:0;}
  .stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;margin-bottom:2rem;}
  .stat-card{background:#fff;border-radius:12px;padding:1.25rem;box-shadow:0 2px 8px rgba(0,0,0,.06);display:flex;align-items:center;gap:1rem;}
  .stat-card .stat-icon{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;}
  .stat-card .stat-icon.blue{background:#e8f0fe;color:#1a73e8;}.stat-card .stat-icon.green{background:#e6f4ea;color:#1e8e3e;}.stat-card .stat-icon.orange{background:#fef3e0;color:#e8710a;}.stat-card .stat-icon.yellow{background:#fef9e7;color:#b7950b;}.stat-card .stat-icon.purple{background:#f3e8fd;color:#9334e6;}.stat-card .stat-icon.red{background:#fce8e6;color:#d93025;}
  .stat-card .stat-info h3{font-size:1.5rem;margin:0;font-weight:700;color:#1a1f36;}.stat-card .stat-info p{margin:0;font-size:.8rem;color:#666;}
  .biz-card{background:#fff;border-radius:12px;padding:1.5rem;box-shadow:0 2px 8px rgba(0,0,0,.06);margin-bottom:1.5rem;}
  .biz-card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:.5rem;}
  .biz-card-header h2{font-size:1.15rem;font-weight:700;color:#1a1f36;margin:0;}
  .biz-table{width:100%;border-collapse:collapse;font-size:.85rem;}
  .biz-table th{background:#f8f9fa;padding:.75rem;text-align:left;font-weight:600;color:#555;border-bottom:2px solid #eee;white-space:nowrap;}
  .biz-table td{padding:.75rem;border-bottom:1px solid #f0f0f0;vertical-align:middle;}
  .biz-table tr:hover{background:#f8f9ff;}
  .badge{display:inline-block;padding:3px 10px;border-radius:12px;font-size:.7rem;font-weight:700;text-transform:uppercase;}
  .badge-success{background:#e6f4ea;color:#1e8e3e;}.badge-warning{background:#fef3e0;color:#e8710a;}.badge-danger{background:#fce8e6;color:#d93025;}.badge-info{background:#e8f0fe;color:#1a73e8;}.badge-secondary{background:#eee;color:#666;}
  .btn-sm{padding:5px 12px;font-size:.75rem;border:none;border-radius:6px;cursor:pointer;font-weight:600;transition:all .2s;display:inline-flex;align-items:center;gap:4px;text-decoration:none;}
  .btn-sm .material-symbols-outlined{font-size:.9rem;}
  .btn-primary{background:#1a73e8;color:#fff;}.btn-success{background:#1e8e3e;color:#fff;}.btn-warning{background:#e8710a;color:#fff;}.btn-danger{background:#d93025;color:#fff;}.btn-outline{background:transparent;border:1px solid #ddd;color:#555;}
  .action-btns{display:flex;gap:4px;flex-wrap:wrap;}
  .form-group{margin-bottom:1rem;}.form-group label{display:block;font-size:.8rem;font-weight:600;color:#555;margin-bottom:4px;}
  .form-group input,.form-group select,.form-group textarea{width:100%;padding:10px 14px;border:1px solid #ddd;border-radius:8px;font-size:.9rem;box-sizing:border-box;}
  .form-group textarea{min-height:80px;resize:vertical;}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem;}
  .quote-response-area{margin-top:.75rem;padding:.75rem;background:#f8f9fa;border-radius:8px;}
  @media(max-width:768px){.biz-layout{flex-direction:column;}.biz-sidebar{width:100%;height:auto;position:static;padding:1rem 0;}.biz-menu{display:flex;overflow-x:auto;gap:0;padding:0 .5rem;}.biz-menu li a{padding:.6rem 1rem;white-space:nowrap;border-left:none;border-bottom:3px solid transparent;font-size:.8rem;}.biz-menu li a.active{border-bottom-color:#4ade80;}.biz-content{padding:1rem;}.form-row{grid-template-columns:1fr;}}
</style>

<% if (!business) { %>
<main class="container mx-auto px-6 py-12">
  <div class="bg-white rounded-2xl border border-slate-100 p-12 text-center">
    <span class="material-symbols-outlined text-6xl text-slate-300 mb-4">store</span>
    <h2 class="text-xl font-bold text-slate-700 mb-2">İşletme Bulunamadı</h2>
    <p class="text-slate-500">Hesabınıza bağlı bir işletme kaydı bulunmamaktadır.</p>
  </div>
</main>
<% } else { %>
<div class="biz-layout">
  <aside class="biz-sidebar">
    <div class="sidebar-brand">
      <h3>🏪 <%= business.name %></h3>
      <small>İşletme Yönetim Paneli</small>
    </div>
    <ul class="biz-menu">
      <% menuItems.forEach(item => { %>
        <li><a href="<%= item.href %>" class="<%= currentPage === item.key ? 'active' : '' %>"><span class="material-symbols-outlined"><%= item.icon %></span> <%= item.label %></a></li>
      <% }) %>
    </ul>
  </aside>
  <main class="biz-content">

    <% if (currentPage === 'dashboard') { %>
      <div class="biz-header"><h1>📊 Dashboard</h1></div>
      <div class="stats-grid">
        <div class="stat-card"><div class="stat-icon blue"><span class="material-symbols-outlined">calendar_today</span></div><div class="stat-info"><h3><%= stats.todayAppointments %></h3><p>Bugünkü Randevu</p></div></div>
        <div class="stat-card"><div class="stat-icon orange"><span class="material-symbols-outlined">pending_actions</span></div><div class="stat-info"><h3><%= stats.pendingAppointments %></h3><p>Bekleyen Randevu</p></div></div>
        <div class="stat-card"><div class="stat-icon purple"><span class="material-symbols-outlined">request_quote</span></div><div class="stat-info"><h3><%= stats.pendingQuotes %></h3><p>Bekleyen Teklif</p></div></div>
        <div class="stat-card"><div class="stat-icon yellow"><span class="material-symbols-outlined">star</span></div><div class="stat-info"><h3><%= stats.avgRating %></h3><p>Ortalama Puan</p></div></div>
        <div class="stat-card"><div class="stat-icon green"><span class="material-symbols-outlined">rate_review</span></div><div class="stat-info"><h3><%= stats.reviewCount %></h3><p>Değerlendirme</p></div></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;">
        <div class="biz-card">
          <div class="biz-card-header"><h2>📅 Bugünkü Randevular</h2><a href="/isletme/randevular" class="btn-sm btn-outline">Tümü</a></div>
          <% if (todayAppointments.length === 0) { %><p style="color:#999;text-align:center;padding:1.5rem;">Bugün randevu yok ✅</p>
          <% } else { todayAppointments.forEach(a => { %>
            <div style="display:flex;align-items:center;gap:.75rem;padding:.6rem 0;border-bottom:1px solid #f0f0f0;">
              <div style="min-width:50px;text-align:center;"><strong style="color:#1a73e8;"><%= a.time %></strong></div>
              <div style="flex:1;"><p style="margin:0;font-weight:600;font-size:.9rem;"><%= a.customer_name %></p><p style="margin:0;font-size:.75rem;color:#999;"><%= a.service_type || 'Genel Servis' %></p></div>
              <span class="badge <%=a.status==='confirmed'?'badge-success':a.status==='pending'?'badge-warning':a.status==='completed'?'badge-info':'badge-danger'%>"><%=a.status==='confirmed'?'Onaylı':a.status==='pending'?'Bekliyor':a.status==='completed'?'Tamamlandı':'İptal'%></span>
            </div>
          <% }) } %>
        </div>
        <div class="biz-card">
          <div class="biz-card-header"><h2>💰 Bekleyen Teklifler</h2><a href="/isletme/teklifler" class="btn-sm btn-outline">Tümü</a></div>
          <% if (quoteRequests.length === 0) { %><p style="color:#999;text-align:center;padding:1.5rem;">Bekleyen teklif yok ✅</p>
          <% } else { quoteRequests.forEach(qr => { %>
            <div style="display:flex;align-items:center;gap:.75rem;padding:.6rem 0;border-bottom:1px solid #f0f0f0;">
              <div style="width:36px;height:36px;background:#fef3e0;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><span class="material-symbols-outlined" style="font-size:1rem;color:#e8710a;">person</span></div>
              <div style="flex:1;min-width:0;"><p style="margin:0;font-weight:600;font-size:.85rem;"><%= qr.customer_name %></p><p style="margin:0;font-size:.75rem;color:#999;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= qr.description || 'Teklif isteği' %></p></div>
              <span style="font-size:.7rem;color:#999;"><%= timeAgo(qr.created_at) %></span>
            </div>
          <% }) } %>
        </div>
      </div>
      <div class="biz-card" style="margin-top:1.5rem;">
        <div class="biz-card-header"><h2>⭐ Son Değerlendirmeler</h2><a href="/isletme/degerlendirmeler" class="btn-sm btn-outline">Tümü</a></div>
        <% if (recentReviews.length === 0) { %><p style="color:#999;text-align:center;padding:1.5rem;">Henüz değerlendirme yok</p>
        <% } else { recentReviews.forEach(r => { %>
          <div style="display:flex;align-items:start;gap:.75rem;padding:.75rem 0;border-bottom:1px solid #f0f0f0;">
            <div style="width:36px;height:36px;background:#e8f0fe;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-weight:700;color:#1a73e8;font-size:.8rem;"><%= r.reviewer_name.charAt(0).toUpperCase() %></div>
            <div style="flex:1;"><div style="display:flex;align-items:center;gap:.5rem;"><strong style="font-size:.85rem;"><%= r.reviewer_name %></strong><span style="color:#f59e0b;font-size:.75rem;"><% for(let i=0;i<5;i++){%><%=i<r.rating?'★':'☆'%><%}%></span></div>
            <p style="margin:.25rem 0 0;font-size:.85rem;color:#555;"><%= r.comment %></p><span style="font-size:.7rem;color:#999;"><%= timeAgo(r.created_at) %></span></div>
          </div>
        <% }) } %>
      </div>

    <% } else if (currentPage === 'randevular') { %>
      <div class="biz-header"><h1>📅 Randevu Yönetimi</h1></div>
      <div class="stats-grid" style="margin-bottom:1.5rem;">
        <a href="/isletme/randevular" class="stat-card" style="text-decoration:none;border:2px solid <%=!data.filters?.durum?'#1a73e8':'transparent'%>;"><div class="stat-icon blue"><span class="material-symbols-outlined">event_note</span></div><div class="stat-info"><h3><%= data.statusCounts.all %></h3><p>Tümü</p></div></a>
        <a href="/isletme/randevular?durum=pending" class="stat-card" style="text-decoration:none;border:2px solid <%=data.filters?.durum==='pending'?'#e8710a':'transparent'%>;"><div class="stat-icon orange"><span class="material-symbols-outlined">hourglass_top</span></div><div class="stat-info"><h3><%= data.statusCounts.pending %></h3><p>Bekleyen</p></div></a>
        <a href="/isletme/randevular?durum=confirmed" class="stat-card" style="text-decoration:none;border:2px solid <%=data.filters?.durum==='confirmed'?'#1e8e3e':'transparent'%>;"><div class="stat-icon green"><span class="material-symbols-outlined">check_circle</span></div><div class="stat-info"><h3><%= data.statusCounts.confirmed %></h3><p>Onaylı</p></div></a>
        <a href="/isletme/randevular?durum=completed" class="stat-card" style="text-decoration:none;border:2px solid <%=data.filters?.durum==='completed'?'#1a73e8':'transparent'%>;"><div class="stat-icon blue"><span class="material-symbols-outlined">task_alt</span></div><div class="stat-info"><h3><%= data.statusCounts.completed %></h3><p>Tamamlanan</p></div></a>
        <a href="/isletme/randevular?durum=cancelled" class="stat-card" style="text-decoration:none;border:2px solid <%=data.filters?.durum==='cancelled'?'#d93025':'transparent'%>;"><div class="stat-icon red"><span class="material-symbols-outlined">cancel</span></div><div class="stat-info"><h3><%= data.statusCounts.cancelled %></h3><p>İptal</p></div></a>
      </div>
      <div class="biz-card">
        <div style="overflow-x:auto;">
          <table class="biz-table">
            <thead><tr><th>ID</th><th>Müşteri</th><th>Servis</th><th>Araç</th><th>Tarih</th><th>Saat</th><th>Not</th><th>Durum</th><th>İşlemler</th></tr></thead>
            <tbody>
              <% (data.appointments || []).forEach(a => { %>
              <tr>
                <td>#<%= a.id %></td>
                <td><strong><%= a.customer_name %></strong><% if(a.customer_phone){%><br><small style="color:#999"><%= a.customer_phone %></small><%}%></td>
                <td><%= a.service_type || '-' %></td>
                <td><%= a.vehicle_info || '-' %></td>
                <td><%= a.date %></td>
                <td><%= a.time %></td>
                <td style="max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= a.notes || '-' %></td>
                <td><span class="badge <%=a.status==='confirmed'?'badge-success':a.status==='pending'?'badge-warning':a.status==='completed'?'badge-info':'badge-danger'%>"><%=a.status==='confirmed'?'Onaylı':a.status==='pending'?'Bekliyor':a.status==='completed'?'Tamamlandı':'İptal'%></span></td>
                <td><div class="action-btns">
                  <% if(a.status==='pending'){%>
                    <form method="POST" action="/isletme/randevu/<%= a.id %>/durum" style="display:inline;"><input type="hidden" name="status" value="confirmed"><button type="submit" class="btn-sm btn-success" title="Onayla"><span class="material-symbols-outlined">check</span></button></form>
                    <form method="POST" action="/isletme/randevu/<%= a.id %>/durum" style="display:inline;"><input type="hidden" name="status" value="cancelled"><button type="submit" class="btn-sm btn-danger" title="İptal"><span class="material-symbols-outlined">close</span></button></form>
                  <%}else if(a.status==='confirmed'){%>
                    <form method="POST" action="/isletme/randevu/<%= a.id %>/durum" style="display:inline;"><input type="hidden" name="status" value="completed"><button type="submit" class="btn-sm btn-primary" title="Tamamla"><span class="material-symbols-outlined">task_alt</span></button></form>
                    <form method="POST" action="/isletme/randevu/<%= a.id %>/durum" style="display:inline;"><input type="hidden" name="status" value="cancelled"><button type="submit" class="btn-sm btn-danger" title="İptal"><span class="material-symbols-outlined">close</span></button></form>
                  <%}%>
                </div></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% if(!data.appointments||data.appointments.length===0){%><p style="color:#999;text-align:center;padding:2rem;">Randevu bulunamadı.</p><%}%>
      </div>

    <% } else if (currentPage === 'teklifler') { %>
      <div class="biz-header"><h1>💰 Teklif İstekleri</h1></div>
      <div class="biz-card">
        <div style="overflow-x:auto;">
          <table class="biz-table">
            <thead><tr><th>ID</th><th>Müşteri</th><th>Hizmet</th><th>Araç</th><th>Açıklama</th><th>Durum</th><th>Teklif</th><th>Tarih</th><th>İşlemler</th></tr></thead>
            <tbody>
              <% (data.quotes || []).forEach(q => { %>
              <tr>
                <td>#<%= q.id %></td>
                <td><strong><%= q.customer_name %></strong><% if(q.customer_phone){%><br><small style="color:#999"><%= q.customer_phone %></small><%}%></td>
                <td><%= q.service_type || '-' %></td>
                <td><%= q.vehicle_info || '-' %></td>
                <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= q.description||'' %>"><%= q.description || '-' %></td>
                <td><span class="badge <%=q.status==='quoted'?'badge-success':q.status==='pending'?'badge-warning':q.status==='accepted'?'badge-info':'badge-danger'%>"><%=q.status==='quoted'?'Teklif Verildi':q.status==='pending'?'Bekliyor':q.status==='accepted'?'Kabul Edildi':'Reddedildi'%></span></td>
                <td style="font-weight:700;color:#1e8e3e;"><%= q.quoted_price ? formatPrice(q.quoted_price) : '-' %></td>
                <td><%= timeAgo(q.created_at) %></td>
                <td>
                  <% if(q.status==='pending'){%>
                  <div class="action-btns">
                    <button class="btn-sm btn-success" onclick="toggleQuoteForm(<%= q.id %>)" title="Teklif Ver"><span class="material-symbols-outlined">send</span></button>
                    <form method="POST" action="/isletme/teklif/<%= q.id %>/yanit" style="display:inline;"><input type="hidden" name="status" value="rejected"><button type="submit" class="btn-sm btn-danger" title="Reddet"><span class="material-symbols-outlined">close</span></button></form>
                  </div>
                  <div class="quote-response-area hidden" id="quoteForm_<%= q.id %>">
                    <form method="POST" action="/isletme/teklif/<%= q.id %>/yanit" style="display:flex;gap:.5rem;align-items:end;">
                      <input type="hidden" name="status" value="quoted">
                      <div style="flex:1;"><label style="font-size:.75rem;font-weight:600;color:#555;">Teklif Tutarı (₺)</label><input type="number" name="quote_amount" required placeholder="ör: 5000" style="width:100%;padding:8px;border:1px solid #ddd;border-radius:6px;font-size:.85rem;"></div>
                      <button type="submit" class="btn-sm btn-primary" style="height:38px;">Gönder</button>
                    </form>
                  </div>
                  <%}%>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% if(!data.quotes||data.quotes.length===0){%><p style="color:#999;text-align:center;padding:2rem;">Teklif isteği bulunamadı.</p><%}%>
      </div>

    <% } else if (currentPage === 'degerlendirmeler') { %>
      <div class="biz-header"><h1>⭐ Değerlendirmeler</h1></div>
      <div class="biz-card">
        <div style="display:flex;align-items:center;gap:2rem;flex-wrap:wrap;">
          <div style="text-align:center;">
            <p style="font-size:3rem;font-weight:800;color:#1a1f36;margin:0;"><%= business.rating %></p>
            <div style="color:#f59e0b;font-size:1.2rem;"><% for(let i=0;i<5;i++){%><%=i<Math.round(business.rating)?'★':'☆'%><%}%></div>
            <p style="font-size:.8rem;color:#999;margin:.25rem 0 0;"><%= business.review_count %> değerlendirme</p>
          </div>
          <div style="flex:1;min-width:200px;">
            <% for(let s=5;s>=1;s--){%>
            <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:4px;">
              <span style="width:16px;font-size:.8rem;color:#555;"><%= s %></span><span style="color:#f59e0b;font-size:.8rem;">★</span>
              <div style="flex:1;background:#e5e7eb;border-radius:4px;height:8px;"><div style="background:#f59e0b;height:8px;border-radius:4px;width:<%=business.review_count>0?((data.ratingDist[s]||0)/business.review_count*100):0%>%;"></div></div>
              <span style="width:24px;text-align:right;font-size:.75rem;color:#999;"><%= data.ratingDist[s] || 0 %></span>
            </div>
            <%}%>
          </div>
        </div>
      </div>
      <div class="biz-card">
        <div class="biz-card-header"><h2>Tüm Değerlendirmeler (<%= (data.reviews||[]).length %>)</h2></div>
        <% if(!data.reviews||data.reviews.length===0){%><p style="color:#999;text-align:center;padding:2rem;">Henüz değerlendirme yok.</p>
        <% } else { data.reviews.forEach(r => { %>
          <div style="display:flex;align-items:start;gap:.75rem;padding:1rem 0;border-bottom:1px solid #f0f0f0;">
            <div style="width:40px;height:40px;background:#e8f0fe;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-weight:700;color:#1a73e8;font-size:.9rem;"><%= r.reviewer_name.charAt(0).toUpperCase() %></div>
            <div style="flex:1;">
              <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;"><strong style="font-size:.9rem;"><%= r.reviewer_name %></strong><span style="color:#f59e0b;font-size:.8rem;"><% for(let i=0;i<5;i++){%><%=i<r.rating?'★':'☆'%><%}%></span><span style="font-size:.7rem;color:#999;"><%= new Date(r.created_at).toLocaleDateString('tr-TR') %></span></div>
              <% if(r.service_type){%><span class="badge badge-info" style="margin-top:.25rem;"><%= r.service_type %></span><%}%>
              <p style="margin:.5rem 0 0;font-size:.9rem;color:#555;line-height:1.5;"><%= r.comment %></p>
            </div>
          </div>
        <% }) } %>
      </div>

    <% } else if (currentPage === 'profil') { %>
      <div class="biz-header"><h1>⚙️ İşletme Profili Düzenle</h1></div>
      <div class="biz-card">
        <form method="POST" action="/isletme/profil">
          <div class="form-row">
            <div class="form-group"><label>İşletme Adı *</label><input type="text" name="name" value="<%= business.name %>" required></div>
            <div class="form-group"><label>İşletme Türü</label><select name="type" disabled><option value="servis" <%=business.type==='servis'?'selected':''%>>Servis</option><option value="galeri" <%=business.type==='galeri'?'selected':''%>>Galeri</option><option value="yedek_parca" <%=business.type==='yedek_parca'?'selected':''%>>Yedek Parça</option><option value="ekspertiz" <%=business.type==='ekspertiz'?'selected':''%>>Ekspertiz</option></select></div>
          </div>
          <div class="form-group"><label>Açıklama</label><textarea name="description" rows="3"><%= business.description || '' %></textarea></div>
          <div class="form-row">
            <div class="form-group"><label>Telefon</label><input type="text" name="phone" value="<%= business.phone || '' %>"></div>
            <div class="form-group"><label>E-posta</label><input type="email" name="email" value="<%= business.email || '' %>"></div>
          </div>
          <div class="form-group"><label>Adres</label><input type="text" name="address" value="<%= business.address || '' %>"></div>
          <div class="form-row">
            <div class="form-group"><label>İl</label><input type="text" name="city" value="<%= business.city || '' %>"></div>
            <div class="form-group"><label>İlçe</label><input type="text" name="district" value="<%= business.district || '' %>"></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>Website</label><input type="text" name="website" value="<%= business.website || '' %>" placeholder="https://..."></div>
            <div class="form-group"><label>Çalışma Saatleri (JSON)</label><input type="text" name="working_hours" value='<%= business.working_hours || "" %>' placeholder='{"Pzt-Cuma":"08:00-18:00","Cmt":"09:00-14:00"}'></div>
          </div>
          <div class="form-group"><label>Hizmetler (virgülle ayırın)</label><input type="text" name="services" value="<% try{const svc=JSON.parse(business.services||'[]');%><%=Array.isArray(svc)?svc.join(', '):(business.services||'')%><%}catch(e){%><%=business.services||''%><%}%>" placeholder="ör: Motor Bakımı, Fren Servisi, Yağ Değişimi"></div>
          <div style="display:flex;justify-content:flex-end;gap:.75rem;margin-top:1.5rem;">
            <a href="/isletme/panel" class="btn-sm btn-outline" style="padding:10px 24px;font-size:.9rem;">İptal</a>
            <button type="submit" class="btn-sm btn-success" style="padding:10px 24px;font-size:.9rem;"><span class="material-symbols-outlined">save</span> Kaydet</button>
          </div>
        </form>
      </div>
    <% } %>

  </main>
</div>
<script>function toggleQuoteForm(id){const el=document.getElementById('quoteForm_'+id);if(el)el.classList.toggle('hidden');}</script>
<% } %>
