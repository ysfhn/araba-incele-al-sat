<%
const f = filters || {};
const typeMap = {servis:'Servis',galeri:'Galeri',yedek_parca:'Yedek Parça',ekspertiz:'Ekspertiz'};
const typeIcons = {servis:'build',galeri:'directions_car',yedek_parca:'settings',ekspertiz:'verified'};
const typeColors = {servis:'blue',galeri:'emerald',yedek_parca:'amber',ekspertiz:'violet'};
const validTypes = Object.keys(typeMap);
// Geçersiz tur parametresini temizle
if (f.tur && !validTypes.includes(f.tur)) f.tur = '';
const premiumList = businesses.filter(b => b.is_premium);
const regularList = businesses.filter(b => !b.is_premium);
function parseServices(s) { try { return Array.isArray(JSON.parse(s)) ? JSON.parse(s) : []; } catch { return []; } }
function buildFilterUrl(exclude) {
  const p = [];
  if (exclude !== 'arama' && f.arama) p.push('arama=' + encodeURIComponent(f.arama));
  if (exclude !== 'tur' && f.tur) p.push('tur=' + encodeURIComponent(f.tur));
  if (exclude !== 'sehir' && f.sehir) p.push('sehir=' + encodeURIComponent(f.sehir));
  return '/servis' + (p.length ? '?' + p.join('&') : '');
}
%>

<style>
.sr-hero { background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 50%, #1a4480 100%); position: relative; overflow: hidden; }
.sr-hero::before { content:''; position:absolute; inset:0; background:radial-gradient(circle at 20% 50%, rgba(59,130,246,.15) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(99,102,241,.1) 0%, transparent 40%); }
.sr-hero::after { content:''; position:absolute; inset:0; background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E"); }
.sr-cat-btn { transition: all .25s ease; }
.sr-cat-btn:hover, .sr-cat-btn.active { transform: translateY(-2px); box-shadow: 0 8px 25px -5px rgba(0,0,0,.15); }
.sr-card { transition: all .3s cubic-bezier(.4,0,.2,1); border: 1px solid #f1f5f9; }
.sr-card:hover { transform: translateY(-4px); box-shadow: 0 20px 40px -12px rgba(0,0,0,.12); border-color: #e2e8f0; }
.sr-premium-card { background: linear-gradient(135deg, #fefce8 0%, #fff7ed 50%, #fffbeb 100%); border: 2px solid #fbbf24; }
.sr-premium-card:hover { border-color: #f59e0b; box-shadow: 0 20px 40px -12px rgba(245,158,11,.2); }
.sr-premium-glow { position:absolute; top:-1px; right:-1px; width:80px; height:80px; background:linear-gradient(135deg, #fbbf24, #f59e0b); clip-path:polygon(100% 0,0 0,100% 100%); }
.sr-badge { backdrop-filter: blur(8px); }
.sr-rating-bar { height: 4px; border-radius: 2px; background: #f1f5f9; overflow: hidden; }
.sr-rating-fill { height: 100%; background: linear-gradient(90deg, #facc15, #f59e0b); border-radius: 2px; }
.sr-service-chip { font-size: .7rem; padding: 3px 10px; border-radius: 20px; background: #f1f5f9; color: #475569; white-space: nowrap; }
.sr-stat-icon { width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }

@media (max-width:640px) {
  .sr-cat-btn { padding:14px 12px; border-radius:14px; gap:10px; }
  .sr-cat-btn .sr-stat-icon { width:34px; height:34px; border-radius:8px; }
  .sr-cat-btn .sr-stat-icon .material-symbols-outlined { font-size:20px; }
  .sr-premium-card .p-6, .sr-premium-card > div { padding:16px; }
  .sr-premium-card .w-16 { width:44px; height:44px; border-radius:12px; }
  .sr-premium-card .w-16 .material-symbols-outlined { font-size:24px; }
  .sr-service-chip { font-size:.65rem; padding:2px 8px; }
}
</style>

<!-- ═══════════════ HERO ═══════════════ -->
<section class="sr-hero py-16 md:py-20">
  <div class="relative z-10 container mx-auto px-6 text-center max-w-4xl">
    <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur border border-white/20 text-white/90 text-xs font-medium px-4 py-2 rounded-full mb-6">
      <span class="material-symbols-outlined text-sm text-blue-300">verified</span>
      <span><%= businesses.length %> onaylı işletme listeleniyor</span>
    </div>
    <h1 class="text-white text-3xl sm:text-4xl md:text-5xl font-black tracking-tight mb-4">
      Güvenilir <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-300 to-cyan-300">Oto Servis</span> & İşletmeler
    </h1>
    <p class="text-slate-300 text-base md:text-lg max-w-2xl mx-auto mb-10">
      Aracınız için onaylı servisler, galeriler, yedek parça mağazaları ve ekspertiz merkezlerini tek yerden keşfedin.
    </p>

    <!-- Arama Barı -->
    <form method="GET" action="/servis" class="max-w-3xl mx-auto">
      <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-2xl p-2 flex flex-col sm:flex-row gap-2">
        <div class="flex-1 relative">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xl">search</span>
          <input name="arama" type="text" value="<%= f.arama || '' %>" placeholder="İşletme adı veya hizmet ara..." class="w-full bg-white rounded-xl pl-10 pr-4 py-3 text-sm text-slate-800 placeholder:text-slate-400 border-0 focus:ring-2 focus:ring-blue-400"/>
        </div>
        <select name="tur" class="bg-white rounded-xl px-4 py-3 text-sm text-slate-700 border-0 focus:ring-2 focus:ring-blue-400 sm:w-44">
          <option value="">Tüm Türler</option>
          <option value="servis" <%= f.tur==='servis'?'selected':'' %>>🔧 Servis</option>
          <option value="galeri" <%= f.tur==='galeri'?'selected':'' %>>🚗 Galeri</option>
          <option value="yedek_parca" <%= f.tur==='yedek_parca'?'selected':'' %>>⚙️ Yedek Parça</option>
          <option value="ekspertiz" <%= f.tur==='ekspertiz'?'selected':'' %>>✅ Ekspertiz</option>
        </select>
        <select name="sehir" class="bg-white rounded-xl px-4 py-3 text-sm text-slate-700 border-0 focus:ring-2 focus:ring-blue-400 sm:w-40">
          <option value="">Tüm Şehirler</option>
          <% cities.forEach(c => { %><option value="<%= c %>" <%= f.sehir===c?'selected':'' %>><%= c %></option><% }) %>
        </select>
        <button type="submit" class="bg-gradient-to-r from-blue-500 to-blue-600 text-white font-bold py-3 px-8 rounded-xl hover:from-blue-600 hover:to-blue-700 transition-all flex items-center justify-center gap-2 shadow-lg shadow-blue-500/25">
          <span class="material-symbols-outlined text-xl">search</span>
          <span class="sm:inline hidden">Ara</span>
        </button>
      </div>
    </form>
  </div>
</section>

<!-- ═══════════════ KATEGORİ BUTONLARI ═══════════════ -->
<section class="container mx-auto px-6 -mt-8 relative z-20 mb-10">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
    <a href="/servis?tur=servis" class="sr-cat-btn bg-white rounded-2xl p-3.5 sm:p-5 flex items-center gap-3 sm:gap-4 shadow-sm <%= f.tur==='servis' ? 'ring-2 ring-blue-500 active' : '' %>">
      <div class="sr-stat-icon bg-blue-50 text-blue-600"><span class="material-symbols-outlined">build</span></div>
      <div><p class="font-bold text-slate-900 text-xs sm:text-sm">Servisler</p><p class="text-[10px] sm:text-xs text-slate-500 hidden sm:block">Bakım & Onarım</p></div>
    </a>
    <a href="/servis?tur=galeri" class="sr-cat-btn bg-white rounded-2xl p-3.5 sm:p-5 flex items-center gap-3 sm:gap-4 shadow-sm <%= f.tur==='galeri' ? 'ring-2 ring-emerald-500 active' : '' %>">
      <div class="sr-stat-icon bg-emerald-50 text-emerald-600"><span class="material-symbols-outlined">directions_car</span></div>
      <div><p class="font-bold text-slate-900 text-xs sm:text-sm">Galeriler</p><p class="text-[10px] sm:text-xs text-slate-500 hidden sm:block">Araç Alım & Satım</p></div>
    </a>
    <a href="/servis?tur=yedek_parca" class="sr-cat-btn bg-white rounded-2xl p-3.5 sm:p-5 flex items-center gap-3 sm:gap-4 shadow-sm <%= f.tur==='yedek_parca' ? 'ring-2 ring-amber-500 active' : '' %>">
      <div class="sr-stat-icon bg-amber-50 text-amber-600"><span class="material-symbols-outlined">settings</span></div>
      <div><p class="font-bold text-slate-900 text-xs sm:text-sm">Yedek Parça</p><p class="text-[10px] sm:text-xs text-slate-500 hidden sm:block">Orijinal & Muadil</p></div>
    </a>
    <a href="/servis?tur=ekspertiz" class="sr-cat-btn bg-white rounded-2xl p-3.5 sm:p-5 flex items-center gap-3 sm:gap-4 shadow-sm <%= f.tur==='ekspertiz' ? 'ring-2 ring-violet-500 active' : '' %>">
      <div class="sr-stat-icon bg-violet-50 text-violet-600"><span class="material-symbols-outlined">verified</span></div>
      <div><p class="font-bold text-slate-900 text-xs sm:text-sm">Ekspertiz</p><p class="text-[10px] sm:text-xs text-slate-500 hidden sm:block">Araç Kontrol</p></div>
    </a>
  </div>
</section>

<main class="container mx-auto px-6 pb-16">

<!-- Aktif Filtreler -->
<% if (f.arama || f.tur || f.sehir) { %>
<div class="flex flex-wrap items-center gap-2 mb-6">
  <span class="text-sm text-slate-500">Aktif filtreler:</span>
  <% if (f.arama) { %>
    <span class="inline-flex items-center gap-1 bg-blue-50 text-blue-700 text-xs font-medium px-3 py-1.5 rounded-full">
      <span class="material-symbols-outlined text-sm">search</span> "<%= f.arama %>"
      <a href="<%= buildFilterUrl('arama') %>" class="ml-1 hover:text-blue-900">✕</a>
    </span>
  <% } %>
  <% if (f.tur) { %>
    <span class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 text-xs font-medium px-3 py-1.5 rounded-full">
      <span class="material-symbols-outlined text-sm">category</span> <%= typeMap[f.tur] %>
      <a href="<%= buildFilterUrl('tur') %>" class="ml-1 hover:text-emerald-900">✕</a>
    </span>
  <% } %>
  <% if (f.sehir) { %>
    <span class="inline-flex items-center gap-1 bg-amber-50 text-amber-700 text-xs font-medium px-3 py-1.5 rounded-full">
      <span class="material-symbols-outlined text-sm">location_on</span> <%= f.sehir %>
      <a href="<%= buildFilterUrl('sehir') %>" class="ml-1 hover:text-amber-900">✕</a>
    </span>
  <% } %>
  <a href="/servis" class="text-xs text-red-500 hover:text-red-700 font-medium ml-2">Tümünü Temizle</a>
</div>
<% } %>

<!-- Sonuç Sayısı -->
<div class="flex items-center justify-between mb-6">
  <p class="text-sm text-slate-500"><span class="font-bold text-slate-800"><%= businesses.length %></span> işletme bulundu</p>
</div>

<% if (businesses.length === 0) { %>
<!-- ═══════════════ BOŞ DURUM ═══════════════ -->
<div class="bg-white rounded-3xl p-16 text-center border border-slate-100 shadow-sm">
  <div class="w-20 h-20 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-6">
    <span class="material-symbols-outlined text-4xl text-slate-400">search_off</span>
  </div>
  <h3 class="text-xl font-bold text-slate-800 mb-2">İşletme bulunamadı</h3>
  <p class="text-slate-500 mb-6 max-w-md mx-auto">Arama kriterlerinize uygun işletme bulunamadı. Filtrelerinizi değiştirerek tekrar deneyin.</p>
  <a href="/servis" class="inline-flex items-center gap-2 bg-primary text-white font-bold py-2.5 px-6 rounded-xl hover:bg-primary/90 transition-all">
    <span class="material-symbols-outlined text-lg">refresh</span> Filtreleri Temizle
  </a>
</div>

<% } else { %>

<!-- ═══════════════ PREMİUM İŞLETMELER ═══════════════ -->
<% if (premiumList.length > 0) { %>
<div class="mb-10">
  <div class="flex items-center gap-3 mb-5">
    <div class="flex items-center gap-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white text-xs font-bold px-3 py-1.5 rounded-full">
      <span class="material-symbols-outlined text-sm">workspace_premium</span> PREMİUM
    </div>
    <h2 class="text-lg font-bold text-slate-800">Öne Çıkan İşletmeler</h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
    <% premiumList.forEach(b => { %>
    <a href="/servis/<%= b.slug %>" class="sr-premium-card rounded-2xl overflow-hidden block relative group">
      <div class="sr-premium-glow">
        <span class="material-symbols-outlined text-white text-sm absolute top-2 right-2">workspace_premium</span>
      </div>
      <div class="p-6">
        <div class="flex gap-5">
          <!-- İkon -->
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center flex-shrink-0 shadow-lg shadow-amber-200/50">
            <span class="material-symbols-outlined text-white text-3xl"><%= typeIcons[b.type] || 'store' %></span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between mb-1">
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-amber-700 transition-colors"><%= b.name %></h3>
            </div>
            <div class="flex items-center gap-2 mb-2">
              <span class="inline-flex items-center gap-1 bg-amber-100/80 text-amber-700 text-[10px] px-2 py-0.5 rounded-full font-bold"><%= typeMap[b.type] || b.type %></span>
              <% if (b.is_verified) { %><span class="inline-flex items-center gap-0.5 bg-green-100 text-green-700 text-[10px] px-2 py-0.5 rounded-full font-bold"><span class="material-symbols-outlined" style="font-size:10px">check_circle</span> Onaylı</span><% } %>
            </div>
            <p class="text-sm text-slate-600 line-clamp-2 mb-3"><%= b.description || '' %></p>

            <!-- Rating -->
            <div class="flex items-center gap-3 mb-3">
              <div class="flex items-center gap-0.5">
                <% const pRating = Number(b.rating) || 0; for(let i=0;i<5;i++){%><span class="material-symbols-outlined text-base <%= i < Math.round(pRating) ? 'text-amber-400' : 'text-slate-200' %>"><%= i < Math.round(pRating) ? 'star' : 'star_border' %></span><%}%>
              </div>
              <span class="text-sm font-bold text-slate-800"><%= pRating.toFixed(1) %></span>
              <span class="text-xs text-slate-400">(<%= b.review_count || 0 %> değerlendirme)</span>
            </div>

            <!-- Alt Bilgiler -->
            <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
              <% if (b.city) { %><span class="inline-flex items-center gap-1"><span class="material-symbols-outlined text-sm text-slate-400">location_on</span> <%= b.city %><%= b.district ? ', ' + b.district : '' %></span><% } %>
              <% if (b.phone && typeof currentUser !== 'undefined' && currentUser) { %><span class="inline-flex items-center gap-1"><span class="material-symbols-outlined text-sm text-slate-400">call</span> <%= b.phone %></span><% } %>
            </div>

            <!-- Hizmetler -->
            <% const pSvcs = parseServices(b.services); if (pSvcs.length > 0) { %>
            <div class="flex flex-wrap gap-1.5 mt-3">
              <% pSvcs.slice(0,4).forEach(s => { %><span class="sr-service-chip bg-amber-50 text-amber-700"><%= s %></span><% }) %>
              <% if (pSvcs.length > 4) { %><span class="sr-service-chip">+<%= pSvcs.length - 4 %></span><% } %>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
</div>
<% } %>

<!-- ═══════════════ TÜM İŞLETMELER ═══════════════ -->
<% if (regularList.length > 0 || (premiumList.length > 0 && regularList.length > 0)) { %>
<div class="flex items-center gap-3 mb-5">
  <h2 class="text-lg font-bold text-slate-800"><%= premiumList.length > 0 ? 'Diğer İşletmeler' : 'Tüm İşletmeler' %></h2>
  <span class="text-xs text-slate-400 bg-slate-100 px-2.5 py-1 rounded-full font-medium"><%= (premiumList.length > 0 ? regularList : businesses).length %> sonuç</span>
</div>
<% } %>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
  <% (premiumList.length > 0 ? regularList : businesses).forEach((b, idx) => { %>
  <a href="/servis/<%= b.slug %>" class="sr-card bg-white rounded-2xl overflow-hidden block group">
    <!-- Üst Renk Bandı -->
    <div class="h-32 relative overflow-hidden" style="background: linear-gradient(135deg, 
      <%= typeColors[b.type]==='blue' ? '#dbeafe, #bfdbfe' : typeColors[b.type]==='emerald' ? '#d1fae5, #a7f3d0' : typeColors[b.type]==='amber' ? '#fef3c7, #fde68a' : '#ede9fe, #ddd6fe' %>);">
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="w-16 h-16 rounded-2xl bg-white/80 backdrop-blur flex items-center justify-center shadow-sm">
          <span class="material-symbols-outlined text-3xl" style="color: <%= typeColors[b.type]==='blue' ? '#2563eb' : typeColors[b.type]==='emerald' ? '#059669' : typeColors[b.type]==='amber' ? '#d97706' : '#7c3aed' %>"><%= typeIcons[b.type] || 'store' %></span>
        </div>
      </div>
      <!-- Tür Etiketi -->
      <div class="absolute top-3 left-3">
        <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2.5 py-1 rounded-lg sr-badge" style="background: <%= typeColors[b.type]==='blue' ? 'rgba(37,99,235,.1)' : typeColors[b.type]==='emerald' ? 'rgba(5,150,105,.1)' : typeColors[b.type]==='amber' ? 'rgba(217,119,6,.1)' : 'rgba(124,58,237,.1)' %>; color: <%= typeColors[b.type]==='blue' ? '#2563eb' : typeColors[b.type]==='emerald' ? '#059669' : typeColors[b.type]==='amber' ? '#d97706' : '#7c3aed' %>">
          <%= typeMap[b.type] || b.type %>
        </span>
      </div>
      <% if (b.is_verified) { %>
      <div class="absolute top-3 right-3">
        <span class="inline-flex items-center gap-0.5 bg-green-500/90 text-white text-[10px] font-bold px-2 py-1 rounded-lg sr-badge">
          <span class="material-symbols-outlined" style="font-size:11px">check_circle</span> Onaylı
        </span>
      </div>
      <% } %>
    </div>

    <div class="p-5">
      <h3 class="font-bold text-base text-slate-900 mb-1.5 group-hover:text-primary transition-colors"><%= b.name %></h3>

      <!-- Rating -->
      <div class="flex items-center gap-2 mb-2.5">
        <div class="flex items-center gap-0.5">
          <% const rRating = Number(b.rating) || 0; for(let i=0;i<5;i++){%><span class="material-symbols-outlined text-sm <%= i < Math.round(rRating) ? 'text-amber-400' : 'text-slate-200' %>"><%= i < Math.round(rRating) ? 'star' : 'star_border' %></span><%}%>
        </div>
        <span class="text-xs font-bold text-slate-700"><%= rRating.toFixed(1) %></span>
        <span class="text-xs text-slate-400">(<%= b.review_count || 0 %>)</span>
      </div>

      <p class="text-sm text-slate-500 line-clamp-2 mb-3 leading-relaxed"><%= b.description || 'Detaylar için tıklayın.' %></p>

      <!-- Konum & Telefon -->
      <div class="flex flex-col gap-1.5 text-xs text-slate-500 mb-3">
        <% if (b.city) { %>
        <span class="inline-flex items-center gap-1.5">
          <span class="material-symbols-outlined text-sm text-slate-400">location_on</span>
          <%= b.city %><%= b.district ? ' / ' + b.district : '' %>
        </span>
        <% } %>
        <% if (b.phone && typeof currentUser !== 'undefined' && currentUser) { %>
        <span class="inline-flex items-center gap-1.5">
          <span class="material-symbols-outlined text-sm text-slate-400">call</span>
          <%= b.phone %>
        </span>
        <% } %>
      </div>

      <!-- Hizmetler -->
      <% const svcs = parseServices(b.services); if (svcs.length > 0) { %>
      <div class="flex flex-wrap gap-1.5 pt-3 border-t border-slate-100">
        <% svcs.slice(0,3).forEach(s => { %><span class="sr-service-chip"><%= s %></span><% }) %>
        <% if (svcs.length > 3) { %><span class="sr-service-chip bg-blue-50 text-blue-600 font-medium">+<%= svcs.length - 3 %></span><% } %>
      </div>
      <% } %>
    </div>
  </a>
  <% }) %>
</div>

<% } %>

</main>

<!-- ═══════════════ İŞLETME KAYIT CTA ═══════════════ -->
<section class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 py-16">
  <div class="container mx-auto px-6 text-center max-w-3xl">
    <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 text-white/80 text-xs font-medium px-4 py-2 rounded-full mb-6">
      <span class="material-symbols-outlined text-sm">storefront</span> İşletme Sahibi misiniz?
    </div>
    <h2 class="text-white text-2xl md:text-3xl font-bold mb-4">İşletmenizi Hemen Kaydedin</h2>
    <p class="text-slate-400 mb-8 max-w-xl mx-auto">Binlerce araç sahibine ulaşın, randevu alın ve işletmenizi büyütün. Premium üyelikle öne çıkın.</p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/giris" class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-bold py-3 px-8 rounded-xl hover:from-blue-600 hover:to-blue-700 transition-all shadow-lg shadow-blue-500/25">
