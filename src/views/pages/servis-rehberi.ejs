<%
const f = filters || {};
%>
<main class="container mx-auto px-6 py-8">
<div class="flex items-center text-sm text-slate-500 mb-6 gap-1">
<a href="/" class="hover:text-primary">Ana Sayfa</a><span>/</span><span class="text-slate-800 font-medium">Servis Rehberi</span>
</div>

<h1 class="text-3xl font-bold text-slate-900 mb-2">Servis Rehberi</h1>
<p class="text-slate-500 mb-8">Onaylı ve güvenilir servis & bakım işletmelerini keşfedin.</p>

<!-- Filtreler -->
<form method="GET" action="/servis" class="bg-white rounded-2xl border border-slate-100 p-6 mb-8">
<div class="flex flex-wrap gap-4 items-end">
<div class="flex-1 min-w-48">
<label class="text-xs font-semibold text-slate-500 mb-1 block">Arama</label>
<input name="arama" type="text" value="<%= f.arama || '' %>" placeholder="İşletme adı ara..." class="w-full rounded-lg border-slate-200 text-sm"/>
</div>
<div class="w-48">
<label class="text-xs font-semibold text-slate-500 mb-1 block">Tür</label>
<select name="tur" class="w-full rounded-lg border-slate-200 text-sm">
<option value="">Tümü</option>
<option value="servis" <%= f.tur==='servis'?'selected':'' %>>Servis</option>
<option value="galeri" <%= f.tur==='galeri'?'selected':'' %>>Galeri</option>
<option value="yedek_parca" <%= f.tur==='yedek_parca'?'selected':'' %>>Yedek Parça</option>
<option value="ekspertiz" <%= f.tur==='ekspertiz'?'selected':'' %>>Ekspertiz</option>
</select>
</div>
<div class="w-48">
<label class="text-xs font-semibold text-slate-500 mb-1 block">Şehir</label>
<select name="sehir" class="w-full rounded-lg border-slate-200 text-sm">
<option value="">Tümü</option>
<% cities.forEach(c => { %><option value="<%= c %>" <%= f.sehir===c?'selected':'' %>><%= c %></option><% }) %>
</select>
</div>
<button type="submit" class="bg-primary text-white font-bold py-2.5 px-6 rounded-lg hover:bg-primary/90 transition-all">Filtrele</button>
</div>
</form>

<!-- İşletme Listesi -->
<% if (businesses.length === 0) { %>
<div class="bg-white rounded-2xl p-12 text-center border border-slate-100">
<span class="material-symbols-outlined text-6xl text-slate-300 mb-4">search_off</span>
<h3 class="text-xl font-bold text-slate-700 mb-2">İşletme bulunamadı</h3>
<p class="text-slate-500">Filtrelerinizi değiştirerek tekrar deneyin.</p>
</div>
<% } else { %>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
<% businesses.forEach(b => { %>
<a href="/servis/<%= b.slug %>" class="bg-white rounded-2xl border border-slate-100 overflow-hidden hover:shadow-md transition-shadow block">
<div class="h-40 bg-slate-100 flex items-center justify-center">
<span class="material-symbols-outlined text-6xl text-slate-300">home_repair_service</span>
</div>
<div class="p-5">
<div class="flex items-center gap-2 mb-2">
<h3 class="font-bold text-lg text-slate-900"><%= b.name %></h3>
<% if (b.is_premium) { %><span class="bg-yellow-100 text-yellow-700 text-[10px] px-2 py-0.5 rounded-full font-bold">PREMIUM</span><% } %>
<% if (b.is_verified) { %><span class="bg-green-100 text-green-700 text-[10px] px-2 py-0.5 rounded-full font-bold">✓ ONAYLI</span><% } %>
</div>
<div class="flex items-center gap-1 text-yellow-500 mb-2">
<% for(let i=0;i<5;i++){%><span class="material-symbols-outlined text-sm"><%= i < Math.round(b.rating) ? 'star' : 'star_border' %></span><%}%>
<span class="text-xs text-slate-400 ml-1"><%= b.rating %> (<%= b.review_count %> değerlendirme)</span>
</div>
<p class="text-sm text-slate-500 line-clamp-2"><%= b.description || '' %></p>
<div class="flex items-center gap-3 mt-3 text-xs text-slate-400">
<% if (b.city) { %><span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">location_on</span> <%= b.city %></span><% } %>
<span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">category</span> <%= {servis:'Servis',galeri:'Galeri',yedek_parca:'Yedek Parça',ekspertiz:'Ekspertiz'}[b.type] || b.type %></span>
</div>
</div>
</a>
<% }) %>
</div>
<% } %>
</main>
