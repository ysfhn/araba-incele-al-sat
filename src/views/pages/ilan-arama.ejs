<%
function formatPrice(p) { return new Intl.NumberFormat('tr-TR').format(p) + ' ₺'; }
function formatKm(k) { return new Intl.NumberFormat('tr-TR').format(k); }
function fuelLabel(f) { const m={benzin:'Benzin',dizel:'Dizel',elektrik:'Elektrik',hibrit:'Hibrit',lpg:'LPG'}; return m[f]||f||''; }
function transLabel(t) { const m={otomatik:'Otomatik',manuel:'Manuel',yari_otomatik:'Yarı Otomatik'}; return m[t]||t||''; }
const f = filters || {};
%>
<main class="container mx-auto px-6 py-8">
<!-- Breadcrumb -->
<div class="flex items-center text-sm text-slate-500 mb-6 gap-1">
<a href="/" class="hover:text-primary">Ana Sayfa</a><span>/</span><span class="text-slate-800 font-medium">İlan Arama</span>
</div>

<div class="flex flex-col lg:flex-row gap-8">
<!-- Filtreler -->
<aside class="lg:w-72 shrink-0">
<form method="GET" action="/ilan" class="bg-white rounded-2xl border border-slate-100 p-6 space-y-5 sticky top-28">
<h3 class="font-bold text-lg text-slate-900 flex items-center gap-2"><span class="material-symbols-outlined text-primary">tune</span> Filtreler</h3>

<div>
<label class="text-xs font-semibold text-slate-500 mb-1 block">Marka</label>
<select name="marka" class="w-full rounded-lg border-slate-200 text-sm">
<option value="">Tümü</option>
<% brands.forEach(b => { %><option value="<%= b.slug %>" <%= f.marka===b.slug?'selected':'' %>><%= b.name %></option><% }) %>
</select>
</div>

<div class="grid grid-cols-2 gap-2">
<div>
<label class="text-xs font-semibold text-slate-500 mb-1 block">Yıl Min</label>
<input name="yil_min" type="number" placeholder="2000" value="<%= f.yil_min||'' %>" class="w-full rounded-lg border-slate-200 text-sm"/>
</div>
<div>
<label class="text-xs font-semibold text-slate-500 mb-1 block">Yıl Max</label>
<input name="yil_max" type="number" placeholder="2025" value="<%= f.yil_max||'' %>" class="w-full rounded-lg border-slate-200 text-sm"/>
</div>
</div>

<div class="grid grid-cols-2 gap-2">
<div>
<label class="text-xs font-semibold text-slate-500 mb-1 block">Fiyat Min</label>
<input name="fiyat_min" type="number" placeholder="0" value="<%= f.fiyat_min||'' %>" class="w-full rounded-lg border-slate-200 text-sm"/>
</div>
<div>
<label class="text-xs font-semibold text-slate-500 mb-1 block">Fiyat Max</label>
<input name="fiyat_max" type="number" placeholder="10000000" value="<%= f.fiyat_max||'' %>" class="w-full rounded-lg border-slate-200 text-sm"/>
</div>
</div>

<div>
<label class="text-xs font-semibold text-slate-500 mb-1 block">Yakıt Tipi</label>
<select name="yakit" class="w-full rounded-lg border-slate-200 text-sm">
<option value="">Tümü</option>
<option value="benzin" <%= f.yakit==='benzin'?'selected':'' %>>Benzin</option>
<option value="dizel" <%= f.yakit==='dizel'?'selected':'' %>>Dizel</option>
<option value="elektrik" <%= f.yakit==='elektrik'?'selected':'' %>>Elektrik</option>
<option value="hibrit" <%= f.yakit==='hibrit'?'selected':'' %>>Hibrit</option>
<option value="lpg" <%= f.yakit==='lpg'?'selected':'' %>>LPG</option>
</select>
</div>

<div>
<label class="text-xs font-semibold text-slate-500 mb-1 block">Vites</label>
<select name="vites" class="w-full rounded-lg border-slate-200 text-sm">
<option value="">Tümü</option>
<option value="otomatik" <%= f.vites==='otomatik'?'selected':'' %>>Otomatik</option>
<option value="manuel" <%= f.vites==='manuel'?'selected':'' %>>Manuel</option>
</select>
</div>

<div>
<label class="text-xs font-semibold text-slate-500 mb-1 block">Şehir</label>
<select name="sehir" class="w-full rounded-lg border-slate-200 text-sm">
<option value="">Tümü</option>
<% cities.forEach(c => { %><option value="<%= c %>" <%= f.sehir===c?'selected':'' %>><%= c %></option><% }) %>
</select>
</div>

<div>
<label class="text-xs font-semibold text-slate-500 mb-1 block">Sıralama</label>
<select name="siralama" class="w-full rounded-lg border-slate-200 text-sm">
<option value="">En Yeni</option>
<option value="fiyat-artan" <%= f.siralama==='fiyat-artan'?'selected':'' %>>Fiyat (Artan)</option>
<option value="fiyat-azalan" <%= f.siralama==='fiyat-azalan'?'selected':'' %>>Fiyat (Azalan)</option>
<option value="yil-yeni" <%= f.siralama==='yil-yeni'?'selected':'' %>>Yıl (Yeni)</option>
<option value="km-az" <%= f.siralama==='km-az'?'selected':'' %>>KM (Az)</option>
</select>
</div>

<button type="submit" class="w-full bg-primary text-white font-bold py-3 rounded-xl hover:bg-primary/90 transition-all">Filtrele</button>
<a href="/ilan" class="block text-center text-sm text-slate-500 hover:text-primary">Filtreleri Temizle</a>
</form>
</aside>

<!-- İlan Listesi -->
<div class="flex-1">
<div class="flex justify-between items-center mb-6">
<p class="text-slate-600"><strong class="text-slate-900"><%= totalCount %></strong> ilan bulundu</p>
</div>

<% if (listings.length === 0) { %>
<div class="bg-white rounded-2xl p-12 text-center border border-slate-100">
<span class="material-symbols-outlined text-6xl text-slate-300 mb-4">search_off</span>
<h3 class="text-xl font-bold text-slate-700 mb-2">İlan bulunamadı</h3>
<p class="text-slate-500">Filtrelerinizi değiştirerek tekrar deneyin.</p>
</div>
<% } else { %>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
<% listings.forEach(l => { %>
<div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-slate-100">
<div class="h-48 bg-slate-100 flex items-center justify-center relative">
<span class="material-symbols-outlined text-6xl text-slate-300">directions_car</span>
<% if (l.is_featured) { %><div class="absolute top-3 left-3 bg-primary text-white text-[10px] px-2 py-1 rounded-full font-bold">ÖNE ÇIKAN</div><% } %>
<div class="absolute top-3 right-3 bg-white/90 backdrop-blur rounded-full p-1.5 cursor-pointer" data-favorite="<%= l.id %>">
<span class="material-symbols-outlined text-slate-600">favorite</span>
</div>
</div>
<div class="p-5">
<h3 class="font-bold text-lg text-slate-900"><%= l.brand_name %> <%= l.model_name %></h3>
<p class="text-primary font-bold text-xl mt-1"><%= formatPrice(l.price) %></p>
<div class="flex flex-wrap items-center gap-3 mt-3 text-slate-500 text-xs">
<span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">speed</span> <%= formatKm(l.km) %> km</span>
<span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">calendar_today</span> <%= l.year %></span>
<span><%= fuelLabel(l.fuel_type) %></span>
<span><%= transLabel(l.transmission) %></span>
</div>
<% if (l.city) { %><p class="text-xs text-slate-400 mt-2 flex items-center gap-1"><span class="material-symbols-outlined text-sm">location_on</span> <%= l.city %></p><% } %>
<a href="/ilan/<%= l.slug %>" class="block w-full mt-4 py-2.5 rounded-xl bg-slate-50 text-slate-900 font-bold text-sm border border-slate-200 hover:bg-slate-100 transition-all text-center">İncele</a>
</div>
</div>
<% }) %>
</div>

<!-- Pagination -->
<% if (totalPages > 1) { %>
<div class="flex justify-center gap-2 mt-10">
<% if (page > 1) { %>
<a href="/ilan?<%= Object.entries(f).filter(([k,v])=>v&&k!=='sayfa').map(([k,v])=>k+'='+encodeURIComponent(v)).join('&') %>&sayfa=<%= page-1 %>" class="px-4 py-2 rounded-lg border border-slate-200 text-sm hover:bg-slate-50">← Önceki</a>
<% } %>
<% for(let i = Math.max(1, page-2); i <= Math.min(totalPages, page+2); i++) { %>
<a href="/ilan?<%= Object.entries(f).filter(([k,v])=>v&&k!=='sayfa').map(([k,v])=>k+'='+encodeURIComponent(v)).join('&') %>&sayfa=<%= i %>" class="px-4 py-2 rounded-lg border text-sm <%= i===page ? 'bg-primary text-white border-primary' : 'border-slate-200 hover:bg-slate-50' %>"><%= i %></a>
<% } %>
<% if (page < totalPages) { %>
<a href="/ilan?<%= Object.entries(f).filter(([k,v])=>v&&k!=='sayfa').map(([k,v])=>k+'='+encodeURIComponent(v)).join('&') %>&sayfa=<%= page+1 %>" class="px-4 py-2 rounded-lg border border-slate-200 text-sm hover:bg-slate-50">Sonraki →</a>
<% } %>
</div>
<% } %>
<% } %>
</div>
</div>
</main>
