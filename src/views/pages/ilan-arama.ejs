<%
function formatPrice(p) { return new Intl.NumberFormat('tr-TR').format(p) + ' ₺'; }
function formatKm(k) { return new Intl.NumberFormat('tr-TR').format(k); }
function fuelLabel(f) { const m={benzin:'Benzin',dizel:'Dizel',elektrik:'Elektrik',hibrit:'Hibrit',lpg:'LPG'}; return m[f]||f||''; }
function transLabel(t) { const m={otomatik:'Otomatik',manuel:'Manuel',yari_otomatik:'Yarı Otomatik'}; return m[t]||t||''; }
const f = filters || {};
%>

<style>
  .ilan-filter-card { background:#fff; border:1px solid #e2e8f0; border-radius:14px; padding:24px; }
  .ilan-filter-label { font-size:12px; font-weight:600; color:#94a3b8; margin-bottom:4px; display:block; letter-spacing:0.02em; }
  .ilan-filter-input { width:100%; border:1px solid #e2e8f0; border-radius:10px; padding:8px 12px; font-size:13px; color:#1e293b; background:#f8fafc; transition:border-color .15s; outline:none; }
  .ilan-filter-input:focus { border-color:#94a3b8; background:#fff; }
  .ilan-filter-btn { width:100%; background:#1e293b; color:#fff; font-weight:700; font-size:13px; padding:11px; border-radius:10px; border:none; cursor:pointer; transition:background .15s; }
  .ilan-filter-btn:hover { background:#334155; }

  .ilan-card { border:1px solid #e2e8f0; border-radius:12px; overflow:hidden; background:#fff; transition:all .2s; }
  .ilan-card:hover { box-shadow:0 4px 20px rgba(0,0,0,0.06); border-color:#cbd5e1; }
  .ilan-card-img { height:180px; background:#f1f5f9; display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden; }
  .ilan-card-img img { width:100%; height:100%; object-fit:cover; }
  .ilan-card-body { padding:16px; }
  .ilan-card-title { font-weight:700; font-size:15px; color:#1e293b; line-height:1.3; }
  .ilan-card-price { font-weight:800; font-size:17px; color:#1e293b; margin-top:6px; }
  .ilan-card-specs { display:flex; flex-wrap:wrap; gap:8px; margin-top:10px; }
  .ilan-card-spec { display:flex; align-items:center; gap:3px; font-size:12px; color:#64748b; }
  .ilan-card-spec .material-symbols-outlined { font-size:14px; }
  .ilan-card-location { font-size:12px; color:#94a3b8; display:flex; align-items:center; gap:4px; margin-top:8px; }
  .ilan-card-location .material-symbols-outlined { font-size:14px; }
  .ilan-card-link { display:block; width:100%; margin-top:12px; padding:9px; border-radius:8px; background:#f8fafc; border:1px solid #e2e8f0; font-size:13px; font-weight:600; color:#1e293b; text-align:center; transition:all .15s; }
  .ilan-card-link:hover { background:#f1f5f9; border-color:#cbd5e1; }

  .ilan-badge { position:absolute; top:10px; left:10px; background:#1e293b; color:#fff; font-size:10px; font-weight:700; padding:4px 10px; border-radius:6px; }
  .ilan-fav-btn { position:absolute; top:10px; right:10px; background:rgba(255,255,255,0.9); backdrop-filter:blur(4px); border-radius:50%; width:32px; height:32px; display:flex; align-items:center; justify-content:center; cursor:pointer; border:none; transition:all .15s; }
  .ilan-fav-btn:hover { background:#fff; }
  .ilan-fav-btn .material-symbols-outlined { font-size:18px; color:#64748b; }

  .ilan-pagination a { padding:8px 14px; border-radius:8px; font-size:13px; font-weight:500; border:1px solid #e2e8f0; color:#64748b; transition:all .15s; }
  .ilan-pagination a:hover { background:#f8fafc; border-color:#cbd5e1; }
  .ilan-pagination a.active { background:#1e293b; color:#fff; border-color:#1e293b; }
</style>

<main class="max-w-7xl mx-auto px-6 py-6">

<!-- Breadcrumb -->
<nav class="flex items-center gap-1.5 text-xs text-slate-400 mb-6">
  <a href="/" class="hover:text-slate-600">Ana Sayfa</a>
  <span class="material-symbols-outlined" style="font-size:14px">chevron_right</span>
  <span class="text-slate-700 font-medium">İlan Arama</span>
</nav>

<div class="flex flex-col lg:flex-row gap-6">

<!-- Filtreler -->
<aside class="lg:w-64 shrink-0">
<form method="GET" action="/ilan" class="ilan-filter-card sticky top-28 space-y-4">
  <h3 class="font-bold text-sm text-slate-800 flex items-center gap-2 mb-1">
    <span class="material-symbols-outlined text-slate-400" style="font-size:18px">tune</span> Filtreler
  </h3>

  <div>
    <label class="ilan-filter-label">Marka</label>
    <select name="marka" class="ilan-filter-input">
      <option value="">Tümü</option>
      <% brands.forEach(b => { %><option value="<%= b.slug %>" <%= f.marka===b.slug?'selected':'' %>><%= b.name %></option><% }) %>
    </select>
  </div>

  <div class="grid grid-cols-2 gap-2">
    <div>
      <label class="ilan-filter-label">Yıl Min</label>
      <input name="yil_min" type="number" placeholder="2000" value="<%= f.yil_min||'' %>" class="ilan-filter-input"/>
    </div>
    <div>
      <label class="ilan-filter-label">Yıl Max</label>
      <input name="yil_max" type="number" placeholder="2026" value="<%= f.yil_max||'' %>" class="ilan-filter-input"/>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-2">
    <div>
      <label class="ilan-filter-label">Fiyat Min</label>
      <input name="fiyat_min" type="number" placeholder="0" value="<%= f.fiyat_min||'' %>" class="ilan-filter-input"/>
    </div>
    <div>
      <label class="ilan-filter-label">Fiyat Max</label>
      <input name="fiyat_max" type="number" placeholder="10.000.000" value="<%= f.fiyat_max||'' %>" class="ilan-filter-input"/>
    </div>
  </div>

  <div>
    <label class="ilan-filter-label">Yakıt Tipi</label>
    <select name="yakit" class="ilan-filter-input">
      <option value="">Tümü</option>
      <option value="benzin" <%= f.yakit==='benzin'?'selected':'' %>>Benzin</option>
      <option value="dizel" <%= f.yakit==='dizel'?'selected':'' %>>Dizel</option>
      <option value="elektrik" <%= f.yakit==='elektrik'?'selected':'' %>>Elektrik</option>
      <option value="hibrit" <%= f.yakit==='hibrit'?'selected':'' %>>Hibrit</option>
      <option value="lpg" <%= f.yakit==='lpg'?'selected':'' %>>LPG</option>
    </select>
  </div>

  <div>
    <label class="ilan-filter-label">Vites</label>
    <select name="vites" class="ilan-filter-input">
      <option value="">Tümü</option>
      <option value="otomatik" <%= f.vites==='otomatik'?'selected':'' %>>Otomatik</option>
      <option value="manuel" <%= f.vites==='manuel'?'selected':'' %>>Manuel</option>
    </select>
  </div>

  <div>
    <label class="ilan-filter-label">Şehir</label>
    <select name="sehir" class="ilan-filter-input">
      <option value="">Tümü</option>
      <% cities.forEach(c => { %><option value="<%= c %>" <%= f.sehir===c?'selected':'' %>><%= c %></option><% }) %>
    </select>
  </div>

  <div>
    <label class="ilan-filter-label">Sıralama</label>
    <select name="siralama" class="ilan-filter-input">
      <option value="">En Yeni</option>
      <option value="fiyat-artan" <%= f.siralama==='fiyat-artan'?'selected':'' %>>Fiyat (Artan)</option>
      <option value="fiyat-azalan" <%= f.siralama==='fiyat-azalan'?'selected':'' %>>Fiyat (Azalan)</option>
      <option value="yil-yeni" <%= f.siralama==='yil-yeni'?'selected':'' %>>Yıl (Yeni)</option>
      <option value="km-az" <%= f.siralama==='km-az'?'selected':'' %>>KM (Az)</option>
    </select>
  </div>

  <button type="submit" class="ilan-filter-btn">Filtrele</button>
  <a href="/ilan" class="block text-center text-xs text-slate-400 hover:text-slate-600 mt-1">Filtreleri Temizle</a>
</form>
</aside>

<!-- İlan Listesi -->
<div class="flex-1 min-w-0">
  <div class="flex justify-between items-center mb-5">
    <p class="text-sm text-slate-500"><span class="font-bold text-slate-800"><%= totalCount %></span> ilan bulundu</p>
  </div>

  <% if (listings.length === 0) { %>
  <div class="bg-white rounded-xl border border-slate-200 p-14 text-center">
    <span class="material-symbols-outlined text-4xl text-slate-300 mb-3 block">search_off</span>
    <h3 class="text-base font-bold text-slate-700 mb-1">İlan bulunamadı</h3>
    <p class="text-sm text-slate-400">Filtrelerinizi değiştirerek tekrar deneyin.</p>
  </div>
  <% } else { %>
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
    <% listings.forEach(l => { %>
    <div class="ilan-card">
      <div class="ilan-card-img">
        <% if (l.image && l.image !== '/images/car-placeholder.svg') { %>
        <img src="<%= l.image %>" alt="<%= l.brand_name %> <%= l.model_name %>">
        <% } else { %>
        <span class="material-symbols-outlined text-5xl text-slate-300">directions_car</span>
        <% } %>
        <% if (l.is_featured) { %><span class="ilan-badge">ÖNE ÇIKAN</span><% } %>
        <button class="ilan-fav-btn" data-favorite="<%= l.id %>">
          <span class="material-symbols-outlined">favorite_border</span>
        </button>
      </div>
      <div class="ilan-card-body">
        <p class="ilan-card-title"><%= l.brand_name %> <%= l.model_name %></p>
        <p class="ilan-card-price"><%= formatPrice(l.price) %></p>
        <div class="ilan-card-specs">
          <span class="ilan-card-spec"><span class="material-symbols-outlined">speed</span> <%= formatKm(l.km) %> km</span>
          <span class="ilan-card-spec"><span class="material-symbols-outlined">calendar_today</span> <%= l.year %></span>
          <span class="ilan-card-spec"><%= fuelLabel(l.fuel_type) %></span>
          <span class="ilan-card-spec"><%= transLabel(l.transmission) %></span>
        </div>
        <% if (l.city) { %><p class="ilan-card-location"><span class="material-symbols-outlined">location_on</span> <%= l.city %></p><% } %>
        <a href="/ilan/<%= l.slug %>" class="ilan-card-link">İncele</a>
      </div>
    </div>
    <% }) %>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
  <div class="ilan-pagination flex justify-center gap-2 mt-8">
    <% if (page > 1) { %>
    <a href="/ilan?<%= Object.entries(f).filter(([k,v])=>v&&k!=='sayfa').map(([k,v])=>k+'='+encodeURIComponent(v)).join('&') %>&sayfa=<%= page-1 %>">← Önceki</a>
    <% } %>
    <% for(let i = Math.max(1, page-2); i <= Math.min(totalPages, page+2); i++) { %>
    <a href="/ilan?<%= Object.entries(f).filter(([k,v])=>v&&k!=='sayfa').map(([k,v])=>k+'='+encodeURIComponent(v)).join('&') %>&sayfa=<%= i %>" class="<%= i===page ? 'active' : '' %>"><%= i %></a>
    <% } %>
    <% if (page < totalPages) { %>
    <a href="/ilan?<%= Object.entries(f).filter(([k,v])=>v&&k!=='sayfa').map(([k,v])=>k+'='+encodeURIComponent(v)).join('&') %>&sayfa=<%= page+1 %>">Sonraki →</a>
    <% } %>
  </div>
  <% } %>
  <% } %>
</div>

</div>
</main>
