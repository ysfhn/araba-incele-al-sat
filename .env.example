# ============================================
# Araba İncele Al Sat — Ortam Değişkenleri Şablonu
# ============================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun
# cp .env.example .env

NODE_ENV=development
PORT=3000

# Veritabanı
# Development: SQLite otomatik kullanılır (DATABASE_URL gerekmez)
# Production: PostgreSQL bağlantı URL'i
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# DB_SSL=true

SESSION_SECRET=change-this-to-a-random-string

RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=./src/public/uploads

BASE_URL=http://localhost:3000
